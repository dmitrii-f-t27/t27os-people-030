// Never cut a UTF-16 surrogate pair or guess a grapheme for a complex name.
// Unsupported composed initials use a neutral avatar marker instead.
pub fn lu_people_initial_unit_safe(first:u64,next:u64)->bool {
    const letter:bool=(first>=65 and first<=90) or (first>=97 and first<=122) or (first>=1040 and first<=1103) or first==1025 or first==1105;
    return letter and !(next>=768 and next<=879) and next!=65039 and next!=8205;
}
fn lu_people_initial(name:u64)->u64 {
    const length:u64=lu_m0(name,lu_sel("length"));
    if(length==0){return lu_cf("?");}
    const first:u64=lu_m1(name,lu_sel("characterAtIndex:"),0);
    const next:u64=if(length>1) lu_m1(name,lu_sel("characterAtIndex:"),1) else 0;
    return if(lu_people_initial_unit_safe(first,next)) lu_m1(name,lu_sel("substringToIndex:"),1) else lu_cf("?");
}
test complex_unicode_names_never_use_a_split_initial {
    assert lu_people_initial_unit_safe(65,0);
    assert lu_people_initial_unit_safe(1040,1085);
    assert !lu_people_initial_unit_safe(55357,56832);
    assert !lu_people_initial_unit_safe(101,769);
    assert !lu_people_initial_unit_safe(65,8205);
}

fn lu_people_fill_image(self:u64,key:u64,container:u64,w:f64,h:f64)->void {
    const view:u64=lu_get(self,key);
    const clip:u64=lu_get(self,container);
    if(lu_m0(view,lu_sel("superview"))!=clip){
        lu_m0(view,lu_sel("removeFromSuperview"));
        lu_m1(clip,lu_sel("addSubview:"),view);
    }
    const representations:u64=lu_m0(lu_m0(view,lu_sel("image")),lu_sel("representations"));
    var ratio:f64=16.0/9.0;
    if(lu_m0(representations,lu_sel("count"))>0){
        const rep:u64=lu_m1(representations,lu_sel("objectAtIndex:"),0);
        const pw:u64=lu_m0(rep,lu_sel("pixelsWide"));
        const ph:u64=lu_m0(rep,lu_sel("pixelsHigh"));
        if(pw>0 and ph>0){ratio=@as(f64,@floatFromInt(pw))/@as(f64,@floatFromInt(ph));}
    }
    const iw:f64=if(w/h>ratio) w else h*ratio;
    const ih:f64=iw/ratio;
    lu_rect(view,lu_sel("setFrame:"),(w-iw)/2.0,(h-ih)/2.0,iw,ih);
    lu_m1(view,lu_sel("setHidden:"),0);
}

fn lu_people_refined_header(self:u64,w:f64,h:f64,chat:u32,audio:u32,rail:f64)->void {
    const call:bool=audio>0 and audio<5;
    const verified:bool=chat==4 or audio==4;
    const compact:bool=w<700.0;
    const x:f64=rail+24.0;
    const cw:f64=w-x-24.0;
    const selected:bool=lu_val(self,2012)>0;
    lu_people_place(self,2703,0.0,0.0,0.0,0.0,false);
    const route:u64=lu_m0(lu_get(self,2703),lu_sel("stringValue"));
    const button:u64=lu_get(self,376);
    lu_m1(button,lu_sel("setTitle:"),route);
    lu_m1(button,lu_sel("setBordered:"),0);
    lu_m1(button,lu_sel("setAlignment:"),0);
    lu_m1(button,lu_sel("setFont:"),lu_font(lu_cls("NSFont"),lu_sel("systemFontOfSize:"),if(compact) @as(f64,12.0) else 14.0));
    lu_m1(button,lu_sel("setAccessibilityLabel:"),lu_cf("\xd0\xa1\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5"));
    lu_m1(button,lu_sel("setToolTip:"),route);
    const symbol:[]const u8=if(!verified) "network" else if(lu_val(self,141)==2) "point.3.connected.trianglepath.dotted" else if(lu_val(self,141)==0 or dn_state(lu_val(self,130),3)==1) "link" else "globe";
    lu_m1(button,lu_sel("setImage:"),lu_m2(lu_cls("NSImage"),lu_sel("imageWithSystemSymbolName:accessibilityDescription:"),lu_cf(symbol),lu_cf("\xd0\xa1\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd0\xb5")));
    lu_m1(button,lu_sel("setImagePosition:"),2);
    lu_m1(lu_get(self,2799),lu_sel("setContentTintColor:"),lu_m0(lu_cls("NSColor"),lu_sel("systemGreenColor")));
    lu_people_symbol(self,2789,"lock","\xd0\x9a\xd0\xbe\xd0\xb4 \xd1\x81\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbd");
    lu_text(self,lu_get(self,2792),lu_cf("\xd0\x9a\xd0\xbe\xd0\xb4 \xd1\x81\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbd"));
    lu_m1(lu_get(self,2792),lu_sel("setFont:"),lu_font(lu_cls("NSFont"),lu_sel("systemFontOfSize:"),14.0));
    if(call){
        lu_people_place(self,2022,64.0,22.0,if(w>760.0) 116.0 else w-140.0,30.0,true);
        lu_people_place(self,2701,0.0,0.0,0.0,0.0,false);
        lu_people_place(self,2789,if(w>760.0) @as(f64,180.0) else 24.0,if(w>760.0) @as(f64,26.0) else 58.0,18.0,18.0,verified);
        lu_people_place(self,2792,if(w>760.0) @as(f64,208.0) else 50.0,if(w>760.0) @as(f64,24.0) else 56.0,130.0,24.0,verified);
        lu_people_place(self,2704,if(w>760.0) 366.0 else w-100.0,if(w>760.0) @as(f64,24.0) else 56.0,76.0,24.0,audio==4);
        lu_people_place(self,376,470.0,20.0,230.0,30.0,w>900.0);
        if(audio==2 or audio==3){lu_people_place(self,103,24.0,112.0,w-48.0,110.0,true);}
        return;
    }
    lu_m1(lu_get(self,2022),lu_sel("setFont:"),lu_font(lu_cls("NSFont"),lu_sel("boldSystemFontOfSize:"),if(compact) @as(f64,16.0) else 19.0));
    const avatar_size:f64=if(compact) @as(f64,36.0) else 48.0;
    lu_people_place(self,2700,x,14.0,avatar_size,avatar_size,selected);
    lu_people_place(self,2022,x+(if(compact) @as(f64,48.0) else 70.0),14.0,if(compact) cw-96.0 else cw-220.0,30.0,true);
    if(compact){
        lu_text(self,lu_get(self,2701),lu_cf(if(verified) "\xd0\x92 \xd1\x81\xd0\xb5\xd1\x82\xd0\xb8 \xc2\xb7 \xd0\xba\xd0\xbe\xd0\xb4 \xd1\x81\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbd" else if(chat==1) "\xd0\xa1\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc\xd1\x81\xd1\x8f" else "\xd0\x9d\xd0\xb5 \xd0\xbf\xd0\xbe\xd0\xb4\xd0\xba\xd0\xbb\xd1\x8e\xd1\x87\xd1\x91\xd0\xbd"));
        lu_people_place(self,2701,x+16.0,48.0,cw-16.0,22.0,selected);
        lu_people_place(self,2799,x,54.0,8.0,8.0,selected and verified);
        lu_people_place(self,376,x,72.0,cw,24.0,selected);
        lu_people_place(self,302,x,104.0,40.0,36.0,selected and chat!=4);
        lu_people_place(self,306,x+48.0,104.0,40.0,36.0,selected);
        lu_people_place(self,346,x+96.0,104.0,40.0,36.0,selected);
        lu_people_place(self,2710,rail,146.0,w-rail,1.0,true);
        lu_people_place(self,2032,x,166.0,cw,h-268.0,selected);
    }
    else{
        lu_text(self,lu_get(self,2701),lu_cf(if(verified) "\xd0\x92 \xd1\x81\xd0\xb5\xd1\x82\xd0\xb8" else if(chat==1) "\xd0\xa1\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc\xd1\x81\xd1\x8f" else "\xd0\x9d\xd0\xb5\xd1\x82 \xd0\xbf\xd1\x80\xd0\xbe\xd0\xb2\xd0\xb5\xd1\x80\xd0\xb5\xd0\xbd\xd0\xbd\xd0\xbe\xd0\xb3\xd0\xbe \xd1\x81\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd0\xb5\xd0\xbd\xd0\xb8\xd1\x8f"));
        lu_people_place(self,2701,x+86.0,46.0,if(verified) 74.0 else cw-86.0,22.0,selected);
        lu_people_place(self,2799,x+70.0,53.0,8.0,8.0,selected and verified);
        lu_people_place(self,2717,x+168.0,48.0,1.0,16.0,selected and verified);
        lu_people_place(self,2789,x+184.0,48.0,16.0,16.0,selected and verified);
        lu_people_place(self,2792,x+208.0,46.0,150.0,24.0,selected and verified);
        lu_people_place(self,376,x+70.0,72.0,if(cw>500.0) 320.0 else cw-100.0,26.0,selected);
    }
    if(chat==2 or chat==3){
        lu_people_place(self,103,x,if(compact) @as(f64,152.0) else 112.0,cw,80.0,true);
        lu_people_place(self,303,x,if(compact) @as(f64,238.0) else 200.0,cw,34.0,chat==2);
        lu_people_place(self,304,x,if(compact) @as(f64,238.0) else 200.0,cw,34.0,chat==3);
        lu_people_place(self,305,x,if(compact) @as(f64,278.0) else 240.0,cw,34.0,chat==3);
        lu_people_place(self,2032,x,286.0,cw,if(h>500.0) h-388.0 else 0.0,h>500.0);
    }
}


pub fn lu_people_reads_visible(panel:u64,selected:bool,visible:u64,call:bool,chat_open:u64)->bool {
    return panel==0 and selected and visible==1 and (!call or chat_open==1);
}
test only_the_visible_pinned_conversation_can_mark_new_messages_read {
    assert lu_people_reads_visible(0,true,1,false,0);
    assert lu_people_reads_visible(0,true,1,true,1);
    assert !lu_people_reads_visible(0,true,1,true,0);
    assert !lu_people_reads_visible(2,true,1,false,0);
    assert !lu_people_reads_visible(3,true,1,false,0);
    assert !lu_people_reads_visible(1,true,1,false,0);
    assert !lu_people_reads_visible(0,false,1,false,0);
    assert !lu_people_reads_visible(0,true,0,false,0);
}


// Recompute before transport polling: activation must never temporarily open reads.
fn lu_sync_read_visibility(self:u64)->void {
    const p:u64=lu_ctx(self);
    if(p==0){ return; }
    var allowed:bool=lu_val(self,115)==1;
    if(lu_val(self,2000)==1){
        const window:u64=lu_get(self,114);
        const scroll:u64=lu_get(self,2001);
        const app:u64=lu_m0(lu_cls("NSApplication"),lu_sel("sharedApplication"));
        const lifecycle:bool=lu_people_read_lifecycle(
            lu_val(self,115),lu_val(self,LP_HELPER_DETACHED),
            window!=0 and lu_bool_result(lu_m0(window,lu_sel("isVisible"))),
            lu_bool_result(lu_m0(window,lu_sel("isMiniaturized"))),
            lu_bool_result(lu_m0(app,lu_sel("isHidden"))),
            scroll!=0 and !lu_bool_result(lu_m0(scroll,lu_sel("isHiddenOrHasHiddenAncestor")))
        );
        const panel:u64=lu_val(self,2013);
        if(panel==5){
            var rect:[4]f64=undefined;
            rect[0]=0.0;
            rect[1]=0.0;
            rect[2]=0.0;
            rect[3]=0.0;
            lu_frame_value(lu_m1(lu_get(self,107),lu_sel("valueForKey:"),lu_cf("visibleRect")),lu_sel("getValue:"),rect);
            allowed=lifecycle and rect[2]>0.0 and rect[3]>0.0;
        }
        else{
            const cards:u64=lu_get(self,2011);
            const selected:u64=lu_val(self,2012);
            const pinned:bool=selected>0 and selected<=lu_m0(cards,lu_sel("count")) and lu_m1(lu_get(self,145),lu_sel("isEqualToString:"),lu_m1(lu_m1(cards,lu_sel("objectAtIndex:"),selected-1),lu_sel("objectForKey:"),lu_cf("identity")))%256!=0;
            const audio:u32=sc_state(p,true);
            allowed=lu_people_reads_visible(panel,pinned,if(lifecycle) 1 else 0,audio>0 and audio<5,lu_val(self,2052));
        }
    }
    sc_visible(p,allowed);
}

pub fn lu_people_read_lifecycle(visible:u64,detached:u64,window_visible:bool,minimized:bool,app_hidden:bool,view_visible:bool)->bool {
    return visible==1 and detached==0 and window_visible and !minimized and !app_hidden and view_visible;
}

test restored_connection_and_closed_call_chat_never_open_reads {
    const restored:bool=lu_people_read_lifecycle(1,0,true,false,false,true);
    assert restored;
    assert !lu_people_reads_visible(2,true,if(restored) 1 else 0,false,0);
    assert !lu_people_reads_visible(0,true,if(restored) 1 else 0,true,0);
    assert lu_people_reads_visible(0,true,if(restored) 1 else 0,false,0);
    assert lu_people_reads_visible(0,true,if(restored) 1 else 0,true,1);
    assert !lu_people_read_lifecycle(0,0,true,false,false,true);
    assert !lu_people_read_lifecycle(1,1,true,false,false,true);
    assert !lu_people_read_lifecycle(1,0,false,false,false,true);
    assert !lu_people_read_lifecycle(1,0,true,true,false,true);
    assert !lu_people_read_lifecycle(1,0,true,false,true,true);
    assert !lu_people_read_lifecycle(1,0,true,false,false,false);
}
