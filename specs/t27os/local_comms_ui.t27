pub fn lu_people_send(self:u64,command:u64,sender:u64)->void {
    lu_dispatch(self,12);
}
fn lu_people_action(self:u64,tag:u64)->bool {
    if(lu_people_refined_action(self,tag)){ return true; }
    if(tag==70){
        lu_mark(self,2013,5);
        lu_people_layout(self);
        return true;
    }
    if(tag==57 or tag==48 or tag==49 or tag==50){
        if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
            lu_error(self,"Finish the session before changing preferred path.");
            return true;
        }
        const mode:u64=if(tag==57) 3 else if(tag==50) 2 else if(tag==49) 1 else 0;
        if(mode!=3){
            lu_select_route(self,mode);
        }
        lu_mark(self,LP_PREFERRED,mode);
        const selected:u64=lu_val(self,2012);
        const contacts:u64=lu_get(self,2011);
        if(selected>0 and selected<=lu_m0(contacts,lu_sel("count"))){
            const item:u64=lu_m1(contacts,lu_sel("objectAtIndex:"),selected-1);
            const card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
            const mesh_only:bool=lu_m1(card,lu_sel("hasPrefix:"),lu_cf("t27m1"))%256!=0;
            lu_mark(self,LP_HISTORY_ONLY,if(lu_people_contact_route(mode,mesh_only)==4) 1 else 0);
            if(mesh_only and (mode==3 or mode==2)){
                lu_select_route(self,2);
                lu_text(self,lu_get(self,106),card);
                lu_dispatch(self,1);
            }
        }
        lu_people_save_preference(self,mode);
        lu_m2(lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults")),lu_sel("setInteger:forKey:"),mode,lu_cf("T27PeopleRouteModeV2"));
        lu_people_layout(self);
        return true;
    }
    if(tag==12 or tag==2 or tag==6 or tag==33 or tag==42 or tag==46 or tag==30){
        if(lu_val(self,LP_HISTORY_ONLY)!=0){
            lu_error(self,"This Mesh contact needs Auto or Mesh before sending or calling.");
            return true;
        }
        const selected:u64=lu_val(self,2012);
        const cards:u64=lu_get(self,2011);
        if(selected==0 or selected>lu_m0(cards,lu_sel("count")) or lu_m1(lu_get(self,145),lu_sel("isEqualToString:"),lu_m1(lu_m1(cards,lu_sel("objectAtIndex:"),selected-1),lu_sel("objectForKey:"),lu_cf("identity")))%256==0){
            lu_error(self,"Recipient changed. Select the intended contact before sending.");
            return true;
        }
    }
    if(tag==1 and lu_m0(lu_get(self,2011),lu_sel("count"))>=16){
        const parts:u64=lu_m1(lu_string(self,lu_get(self,106)),lu_sel("componentsSeparatedByString:"),lu_cf("|"));
        const key:u64=lu_m1(parts,lu_sel("objectAtIndex:"),0);
        const cards:u64=lu_get(self,2011);
        var found:bool=false;
        var i:u64=0;
        while(i<lu_m0(cards,lu_sel("count"))){
            const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),i);
            if(lu_m1(lu_m1(item,lu_sel("objectForKey:"),lu_cf("identity")),lu_sel("isEqualToString:"),key)%256!=0){
                found=true;
            }
            i=i+1;
        }
        if(!found){
            lu_error(self,"Contact book is full. Existing recipient preserved.");
            return true;
        }
    }
    if(tag==66){
        lu_mark(self,2052,if(lu_val(self,2052)==0) 1 else 0);
        lu_people_layout(self);
        return true;
    }
    if(tag==65){
        lu_mark(self,2013,3);
        lu_people_layout(self);
        return true;
    }
    if(tag==60 or tag==61 or tag==62 or tag==64){
        lu_mark(self,2013,if(tag==62) if(lu_val(self,2013)==3) 2 else 0 else if(tag==60) 1 else if(tag==64) 4 else 2);
        lu_people_layout(self);
        return true;
    }
    if(tag==63){
        lu_m2(lu_get(self,2010),lu_sel("setObject:forKey:"),lu_string(self,lu_get(self,2021)),lu_cf("name"));
        lu_people_write(self);
        lu_people_layout(self);
        return true;
    }
    if(tag>=100 and tag<116){
        if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
            lu_error(self,"Finish the current session before selecting another contact.");
            lu_people_layout(self);
            return true;
        }
        const cards:u64=lu_get(self,2011);
        const index:u64=tag-100;
        if(index>=lu_m0(cards,lu_sel("count"))){
            return true;
        }
        const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),index);
        const mode:u64=lu_m0(lu_m1(item,lu_sel("objectForKey:"),lu_cf("route")),lu_sel("unsignedLongLongValue"));
        const saved_card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
        const mesh_only:bool=lu_m1(saved_card,lu_sel("hasPrefix:"),lu_cf("t27m1"))%256!=0;
        // A refused selection must not leave the previous recipient actionable.
        lu_mark(self,2012,0);
        lu_mark(self,LP_PREFERRED,mode);
        const activation:u64=lu_people_contact_route(mode,mesh_only);
        lu_mark(self,LP_HISTORY_ONLY,if(activation==4) 1 else 0);
        const endpoint_mode:u64=if(activation==4) 2 else activation;
        if(endpoint_mode==3){
            lu_people_auto(self);
        }
        else{
            lu_select_route(self,endpoint_mode);
            if(lu_val(self,141)!=endpoint_mode){
                lu_people_layout(self);
                return true;
            }
        }
        const expected:u64=lu_m0(lu_m1(item,lu_sel("objectForKey:"),lu_cf("identity")),lu_sel("retain"));
        lu_text(self,lu_get(self,106),saved_card);
        lu_dispatch(self,1);
        lu_mark(self,LP_HISTORY_ONLY,if(activation==4) 1 else 0);
        if(lu_m1(lu_get(self,145),lu_sel("isEqualToString:"),expected)%256!=0){
            lu_mark(self,2012,index+1);
            lu_mark(self,2013,0);
        }
        lu_release(expected);
        if(activation==4){
            lu_error(self,"History only: this contact has a Mesh endpoint. Choose Auto or Mesh, or add its Direct card.");
        }
        lu_people_layout(self);
        return true;
    }
    return false;
}
pub fn lu_people_visible_control(tag:u64,detail:bool,add:bool,chat:u32,audio:u32)->bool {
    if(detail){
        return tag==13 or tag==40 or (tag>=48 and tag<=56);
    }
    if(add){
        return tag==1 or tag==13 or (tag>=48 and tag<=50);
    }
    if(tag==3){
        return chat==2;
    }
    if(tag==4 or tag==5){
        return chat==3;
    }
    if(tag==7 or tag==47){
        return audio==2;
    }
    if(tag==8 or tag==9){
        return audio==3;
    }
    if(tag==10 or tag==31){
        return audio==4;
    }
    if(tag==11){
        return (audio>0 and audio<5) or (chat>0 and chat<5);
    }
    if(tag==30){
        return audio==4;
    }
    return tag==2 or tag==6 or tag==46 or tag==12;
}
test people_controls_follow_real_handshake_and_keep_end_available {
    assert lu_people_visible_control(7,false,false,0,2);
    assert !lu_people_visible_control(7,false,false,0,4);
    assert lu_people_visible_control(9,false,false,4,3);
    assert lu_people_visible_control(11,false,false,4,1);
    assert lu_people_visible_control(11,false,false,4,0);
    assert !lu_people_visible_control(54,false,false,4,4);
    assert lu_people_visible_control(54,true,false,4,4);
}
fn lu_people_layout(self:u64)->void {
    if(lu_val(self,2013)==5){
        lu_people_previous_layout(self);
        lu_sync_read_visibility(self);
        return;
    }
    var frame:[4]f64=undefined;
    lu_frame_value(lu_m1(lu_get(self,2001),lu_sel("valueForKey:"),lu_cf("frame")),lu_sel("getValue:"),frame);
    const w:f64=if(frame[2]>340.0) frame[2] else 340.0;
    const minimum:f64=if(lu_val(self,2013)==2 and w<700.0) 850.0 else 740.0;
    const h:f64=if(lu_val(self,2013)>=2 and frame[3]<minimum) minimum else if(frame[3]>420.0) frame[3] else 420.0;
    const parent:u64=lu_get(self,125);
    lu_m1(lu_get(self,2001),lu_sel("setHasHorizontalScroller:"),0);
    lu_point(parent,lu_sel("setFrameSize:"),w,h);
    lu_m1(lu_get(self,2001),lu_sel("setHasVerticalScroller:"),if(h>frame[3]+1.0) 1 else 0);
    mn_discover(lu_val(self,148),lu_val(self,LP_PREFERRED)==3);
    const panel:u64=lu_val(self,2013);
    const detail:bool=panel>=2;
    const neighbors:bool=panel==3;
    const profile:bool=panel==4;
    const add:bool=panel==1;
    const chat:u32=sc_state(lu_ctx(self),false);
    const audio:u32=sc_state(lu_ctx(self),true);
    const call:bool=audio>0 and audio<5;
    const rail:f64=lu_people_rail_width(w);
    lu_m1(lu_get(self,2020),lu_sel("setFont:"),lu_font(lu_cls("NSFont"),lu_sel("boldSystemFontOfSize:"),if(w<700.0) 16.0 else 22.0));
    const x:f64=if(detail or call or add) 24.0 else rail+24.0;
    const cw:f64=w-x-24.0;
    const children:u64=lu_m0(parent,lu_sel("subviews"));
    var i:u64=0;
    while(i<lu_m0(children,lu_sel("count"))){
        const child:u64=lu_m1(children,lu_sel("objectAtIndex:"),i);
        lu_m1(child,lu_sel("setHidden:"),1);
        i=i+1;
    }
    lu_people_place(self,2020,20.0,16.0,rail-70.0,32.0,!detail and !call and !add);
    lu_people_place(self,360,rail-52.0,16.0,32.0,32.0,!detail and !call and !add);
    lu_people_place(self,2015,16.0,60.0,rail-32.0,34.0,!detail and !call and !add);
    lu_people_place(self,2040,0.0,106.0,rail,h-158.0,!detail and !call and !add);
    i=0;
    while(i<16){
        lu_m1(lu_get(self,400+i),lu_sel("setHidden:"),1);
        i=i+1;
    }
    const cards:u64=lu_get(self,2011);
    const search:u64=lu_string(self,lu_get(self,2015));
    var row:u64=0;
    i=0;
    while(i<lu_m0(cards,lu_sel("count")) and i<16){
        const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),i);
        const name:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("name"));
        // localizedCaseInsensitiveContainsString: returns a scalar, unlike NSRange.
        const found:bool=lu_m0(search,lu_sel("length"))==0 or lu_m1(name,lu_sel("localizedCaseInsensitiveContainsString:"),search)%256!=0;
        lu_people_color(lu_get(self,400+i),if(lu_val(self,2012)==i+1) 0.20 else 0.08);
        lu_real_set(lu_m0(lu_get(self,400+i),lu_sel("layer")),lu_sel("setCornerRadius:"),9.0);
        lu_m1(lu_get(self,400+i),lu_sel("setTitle:"),name);
        lu_m1(lu_get(self,400+i),lu_sel("setHidden:"),if(found) 0 else 1);
        if(found){
            lu_people_place(self,400+i,12.0,4.0+@as(f64,@floatFromInt(row))*46.0,rail-24.0,40.0,true);
            row=row+1;
        }
        i=i+1;
    }
    lu_point(lu_get(self,2041),lu_sel("setFrameSize:"),rail,@as(f64,@floatFromInt(row))*46.0+12.0);
    lu_people_place(self,364,16.0,h-44.0,rail-32.0,30.0,!detail and !call and !add);
    lu_people_place(self,370,if(detail or add) x else if(w<700.0) w-108.0 else w-310.0,if(detail or add) h-60.0 else 16.0,if(w<700.0 and !detail and !add) 40.0 else 154.0,32.0,true);
    lu_people_title(self,370,"\xd0\x94\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe");
    if(w<700.0 and !detail and !add){
        lu_people_icon(self,370,"ellipsis");
    }
    lu_people_place(self,361,if(w<700.0) w-64.0 else w-150.0,16.0,if(w<700.0) 40.0 else 126.0,32.0,!detail and !add);
    lu_people_place(self,362,w-150.0,16.0,126.0,32.0,detail or add);
    const selected:u64=lu_val(self,2012);
    lu_sync_read_visibility(self);

    if(selected>0 and selected<=lu_m0(cards,lu_sel("count"))){
        lu_text(self,lu_get(self,2022),lu_m1(lu_m1(cards,lu_sel("objectAtIndex:"),selected-1),lu_sel("objectForKey:"),lu_cf("name")));
    }
    lu_people_place(self,2022,x,16.0,if(w<700.0) cw-108.0 else cw-330.0,32.0,!detail and !add);
    lu_people_place(self,2023,x,54.0,cw,42.0,!detail and !add and selected==0);
    if((chat==3 or audio==3) and lu_get(self,122)==0){
        var code:[6]u8=undefined;
