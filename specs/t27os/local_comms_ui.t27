// Legacy 0/1 preferences retain their original meaning; intermediary Mesh is a new index.
pub fn lu_preference_route(has_new:bool,value:u64,legacy:u64)->u64 {
    if(has_new and value<=2){return value;}
    return if(legacy==1) 1 else 0;
}
fn lu_connect_selected(self:u64,audio:bool)->bool {
    const route:u64=lu_val(self,141);const ok:bool=if(route==2) mn_connect(lu_val(self,148),audio) else if(route==1) dn_connect(lu_val(self,130),audio) else sc_connect(lu_ctx(self),audio);
    if(lu_val(self,2000)==1 and lu_val(self,LP_PREFERRED)==3 and ok){lu_mark(self,LP_AUTO_CHANNEL,if(audio) 2 else 1);lu_mark(self,LP_AUTO_TRIED,lu_val(self,LP_AUTO_TRIED)|(if(route==2) @as(u64,4) else if(route==1) @as(u64,3) else @as(u64,1)));lu_mark(self,LP_AUTO_DEADLINE,lu_people_now()+8000);}
    return ok;
}
fn lu_mesh_control(self:u64,tag:u64)->void {
    const mesh:u64=lu_val(self,148);var ok:bool=false;
    if(tag==54){ok=mn_forward(mesh,mn_stat(mesh,1)==0);}
    if(tag==52){
        const card:u64=lu_string(self,lu_get(self,149));const slot:u64=mn_neighbor(mesh,card);ok=slot!=0;
        if(ok){lu_m2(lu_get(self,157),lu_sel("replaceObjectAtIndex:withObject:"),slot-1,card);lu_mesh_save(self);lu_text(self,lu_get(self,149),lu_cf(""));}
    }
    if(tag==55){ok=mn_clear_neighbors(mesh);if(ok){lu_mesh_empty(self);lu_mesh_save(self);}}
    if(tag==53 or tag==56){
        var raw:[16]u8=undefined;const n:usize=lu_bytes(lu_string(self,lu_get(self,if(tag==53) 150 else 151)),raw[0..16]);
        const value:u64=lu_port_bytes(raw[0..n]);
        if(tag==53){const pasted:u64=lu_string(self,lu_get(self,106));const card:u64=if(lu_m0(pasted,lu_sel("length"))>0) pasted else lu_get(self,145);ok=mn_route_to(mesh,card,value);if(ok){lu_m2(lu_get(self,158),lu_sel("setObject:forKey:"),lu_m1(lu_cls("NSNumber"),lu_sel("numberWithUnsignedLongLong:"),value),mn_public_card(card));lu_mesh_save(self);}}
        else{ok=mn_hops(mesh,value);if(ok){lu_mesh_save(self);}}
    }
    if(!ok){lu_error(self,"Mesh change refused. Add a valid neighbor Mesh card; stop forwarding and end your calls before editing neighbors/routes. Route slot and hop limit are 1-4.");}
    lu_render(self);
}
fn lu_mesh_layout(self:u64)->void {
