fn lu_control(self:u64)->void {
    const path:u64=lu_m1(lu_get(self,109),lu_sel("stringByAppendingPathComponent:"),lu_cf("qa-control.plist"));
    const d:u64=lu_m1(lu_cls("NSDictionary"),lu_sel("dictionaryWithContentsOfFile:"),path);
    const seq:u64=lu_m0(lu_m1(d,lu_sel("objectForKey:"),lu_cf("seq")),lu_sel("unsignedLongLongValue"));
    if(seq!=0 and seq!=lu_val(self,113)) {
        lu_mark(self,113,seq);
        const action:u64=lu_m0(lu_m1(d,lu_sel("objectForKey:"),lu_cf("action")),lu_sel("unsignedLongLongValue"));
        if(action==21) {
            sc_qa_target(lu_ctx(self),if(lu_mobile(self)) 50002 else 50001,if(lu_mobile(self)) 50001 else 50002,if(lu_mobile(self)) 49901 else 49902);
        }
        else if(action==22) {
            lu_inactive(self,0,0);
        }
        else if(action==23) {
            lu_active(self,0,0);
        }
        else if(action==25) {
            if(lu_mobile(self)) {
                lu_m1(self,lu_sel("localCapture:"),0);
            }
        }
        else if(action==24) {
            lu_closed(self,0,0);
        }
        else {
            const service:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("service"));
            if(service!=0) {
                lu_text(self,lu_get(self,129),service);
            }
            const address:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("address"));
            if(address!=0) {
                lu_text(self,lu_get(self,104),address);
            }
            const port:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("port"));
            if(port!=0) {
                lu_text(self,lu_get(self,105),port);
            }
            const contact_name:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("contactName"));if(contact_name!=0){lu_text(self,lu_get(self,2014),contact_name);lu_mark(self,2013,1);}
            const peer:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("peerCard"));if(peer!=0){lu_text(self,lu_get(self,106),peer);}
            const neighbor:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("neighborCard"));if(neighbor!=0){lu_text(self,lu_get(self,149),neighbor);}
            const slot:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("meshSlot"));if(slot!=0){lu_text(self,lu_get(self,150),slot);}
            const hops:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("meshHops"));if(hops!=0){lu_text(self,lu_get(self,151),hops);}
            const message:u64=lu_m1(d,lu_sel("objectForKey:"),lu_cf("message"));
            if(message!=0) {
                lu_text(self,lu_get(self,108),message);
            }
            lu_dispatch(self,action);
        }
    }
    lu_report(self);
}
fn lu_methods(cls:u64)->bool {
    return lu_method(cls,"localPress:","lu_pressed","v@:@") and lu_method(cls,"localTick:","lu_tick","v@:@");
}
pub fn lu_open_mac()->u64 {
    const app:u64=lu_m0(lu_cls("NSApplication"),lu_sel("sharedApplication"));
    const existing:u64=lu_get(app,9910);
    if(existing!=0 and lu_ctx(existing)!=0) {
        lu_m1(lu_get(existing,114),lu_sel("makeKeyAndOrderFront:"),0);
        return existing;
    }
    var cls:u64=lu_cls("T27LocalCommsController");
    var created:bool=false;
    if(cls==0) {
        cls=lu_allocate(lu_cls("NSObject"),"T27LocalCommsController",0);
        created=true;
    }
    if(cls==0) {
        return 0;
    }
    if(!lu_methods(cls)) {
        return 0;
    }
    lu_method(cls,"windowWillClose:","lu_closed","v@:@");
    lu_method(cls,"windowDidBecomeKey:","lu_active","v@:@");
    lu_method(cls,"windowDidResignKey:","lu_inactive","v@:@");
    lu_method(cls,"applicationShouldTerminateAfterLastWindowClosed:","lu_quit_after_last","B@:@");
    if(created) {
        lu_register(cls);
    }
    const self:u64=lu_m0(cls,lu_sel("new"));
    lu_set(app,9910,self,1);
    const local_default:u64=lu_m1(lu_m0(lu_cls("NSBundle"),lu_sel("mainBundle")),lu_sel("objectForInfoDictionaryKey:"),lu_cf("T27LocalOnlyDefault"));
    if(lu_m0(local_default,lu_sel("boolValue"))!=0) {
        lu_m1(app,lu_sel("setDelegate:"),self);
    }
    const window:u64=lu_auto(lu_window(lu_m0(lu_cls("NSWindow"),lu_sel("alloc")),lu_sel("initWithContentRect:styleMask:backing:defer:"),80.0,50.0,390.0,950.0,15,2,false));
    lu_set(self,114,window,1);
    lu_m1(window,lu_sel("setTitle:"),lu_cf("T27 OS 0.3.0 - Local encrypted chat & calls"));
    lu_m1(window,lu_sel("setDelegate:"),self);
    const view:u64=lu_m0(window,lu_sel("contentView"));
    lu_m1(view,lu_sel("setWantsLayer:"),1);
    // AppKit coordinates are bottom-up: flip a dedicated native view for shared layout.
    var view_cls:u64=lu_cls("T27LocalFlippedView");
    var new_view:bool=false;
    if(view_cls==0) {
        view_cls=lu_allocate(lu_cls("NSView"),"T27LocalFlippedView",0);
        new_view=true;
    }
    if(view_cls!=0) {
        lu_method(view_cls,"isFlipped","lu_flipped","B@:");
        if(new_view) {
            lu_register(view_cls);
        }
        const flipped:u64=lu_auto(lu_rect(lu_m0(view_cls,lu_sel("alloc")),lu_sel("initWithFrame:"),0.0,0.0,390.0,1450.0));
        const scroll:u64=lu_auto(lu_rect(lu_m0(lu_cls("NSScrollView"),lu_sel("alloc")),lu_sel("initWithFrame:"),0.0,0.0,390.0,850.0));
        lu_m1(scroll,lu_sel("setHasVerticalScroller:"),1);
        lu_m1(scroll,lu_sel("setDocumentView:"),flipped);
        lu_m1(window,lu_sel("setContentView:"),scroll);
        lu_build(self,flipped,false);
    }
    else {
        lu_build(self,view,false);
    }
    lu_m1(window,lu_sel("makeKeyAndOrderFront:"),0);
    return self;
}
pub fn lu_flipped(self:u64,command:u64)->bool {
    return true;
}
pub fn lu_mobile_connect(self:u64,command:u64,scene:u64,session:u64,options:u64)->void {
    const window:u64=lu_auto(lu_m1(lu_m0(lu_cls("UIWindow"),lu_sel("alloc")),lu_sel("initWithWindowScene:"),scene));
    const controller:u64=lu_new("UIViewController");
    const root:u64=lu_m0(controller,lu_sel("view"));
    lu_m1(root,lu_sel("setBackgroundColor:"),lu_m0(lu_cls("UIColor"),lu_sel("systemBackgroundColor")));
    const scroll:u64=lu_auto(lu_rect(lu_m0(lu_cls("UIScrollView"),lu_sel("alloc")),lu_sel("initWithFrame:"),12.0,60.0,390.0,850.0));
    lu_size(scroll,lu_sel("setContentSize:"),390.0,1450.0);
    lu_m1(scroll,lu_sel("setAutoresizingMask:"),18);
    lu_m1(root,lu_sel("addSubview:"),scroll);
    lu_set(self,114,window,1);
    lu_build(self,scroll,true);
    lu_m1(window,lu_sel("setRootViewController:"),controller);
    lu_m0(window,lu_sel("makeKeyAndVisible"));
}
