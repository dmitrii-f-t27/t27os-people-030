pub fn lu_direct_override(tag:u64)->bool { return tag==16 or tag==17 or tag==18 or tag==44; }
test internet_refuses_legacy_direct_overrides_even_in_explicit_qa {
    assert lu_direct_override(16);assert lu_direct_override(17);assert lu_direct_override(18);assert lu_direct_override(44);
    assert !lu_direct_override(33);assert !lu_direct_override(42);assert !lu_direct_override(46);assert !lu_direct_override(48);
