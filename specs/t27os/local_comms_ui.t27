        out[5-i]=@as(u8,@intCast((code>>@as(u6,@intCast(i*8)))&255));
        i=i+1;
    }
    return 6;
}
fn lu_render(self:u64)->void {
    const p:u64=lu_ctx(self);
    const serial:u64=sc_video_stat(p,18);
    if(serial!=0 and serial!=lu_val(self,124) and sc_state(p,true)==4) {
        const data:u64=sc_video_data(p);
        if(data!=0) {
            const image:u64=lu_auto(lu_m1(lu_m0(lu_cls(if(lu_mobile(self)) "UIImage" else "NSImage"),lu_sel("alloc")),lu_sel("initWithData:"),data));
            if(image!=0) {
                lu_m1(lu_get(self,123),lu_sel("setImage:"),image);
                lu_mark(self,124,serial);
            }
            lu_release(data);
        }
    }
    if(sc_state(p,true)!=4) {
        lu_m1(lu_get(self,2031),lu_sel("setImage:"),0);
        lu_mark(self,124,0);
        lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    }
    const chat:u32=sc_state(p,false);
    const audio:u32=sc_state(p,true);
    const cc:u64=sc_code(p,false);
    const ac:u64=sc_code(p,true);
    const status:u64=lu_new("NSMutableString");
    const internet:bool=lu_val(self,141)==1;
    lu_mesh_layout(self);
    if(lu_val(self,141)==2){lu_m1(status,lu_sel("appendString:"),mn_status(lu_val(self,148)));lu_m1(status,lu_sel("appendString:"),lu_cf("\n"));}
    else { lu_m1(status,lu_sel("appendString:"),lu_cf(if(internet) if(dn_endpoint(lu_val(self,130))==0) "Internet: unconfigured; no network activity\n" else if(dn_state(lu_val(self,130),0)==3) if(lu_val(self,LP_PREFERRED)==3) "Auto: operator registered; session path not yet verified\n" else "Internet: operator registered; encrypted relay only\n" else if(dn_state(lu_val(self,130),1)!=0) "Internet: operator unavailable/refused; End cancels a pending call, then retry or change service\n" else if(lu_val(self,LP_PREFERRED)==3) "Auto: registering with operator\n" else "Internet: registering with operator; encrypted relay only\n" else if(lu_val(self,142)==1) "Direct: paired endpoint selected\n" else "Direct: paste a full contact card\n")); }
    lu_m1(lu_get(self,129),lu_sel("setHidden:"),if(internet) 0 else 1);
    lu_m1(lu_get(self,146),lu_sel("setHidden:"),if(internet) 1 else 0);
    lu_m1(lu_get(self,340),lu_sel("setHidden:"),if(internet) 0 else 1);
    if(internet and dn_endpoint(lu_val(self,130))!=0) { lu_m1(status,lu_sel("appendString:"),dn_status(lu_val(self,130)));lu_m1(status,lu_sel("appendString:"),lu_cf("\n")); }
    if(!lu_mobile(self)) {
        lu_m1(lu_get(self,348),lu_sel("setState:"),if(lu_val(self,141)==0) 1 else 0);
        lu_m1(lu_get(self,350),lu_sel("setState:"),if(lu_val(self,141)==2) 1 else 0);
        lu_m1(lu_get(self,354),lu_sel("setState:"),mn_stat(lu_val(self,148),1));
        lu_m1(lu_get(self,349),lu_sel("setState:"),if(internet) 1 else 0);
    }
    const error:u64=lu_get(self,122);
    if(error!=0) {
        lu_m1(status,lu_sel("appendString:"),error);
        lu_m1(status,lu_sel("appendString:"),lu_cf("\n"));
    }
    lu_m1(status,lu_sel("appendString:"),lu_cf(if(chat==4) "Chat verified / encrypted" else if(chat==3) "Chat: compare both devices" else if(chat==2) "Incoming chat - Answer or Decline" else if(chat==1) "\xd0\xa1\xd0\xbe\xd0\xb5\xd0\xb4\xd0\xb8\xd0\xbd\xd1\x8f\xd0\xb5\xd0\xbc \xd1\x87\xd0\xb0\xd1\x82" else "Chat idle / ended"));
    if(sc_stat(p,true,136)==1) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\nListening only: microphone off; silence sent as keepalive."));
    }
    if(audio==4 and sc_stat(p,true,22)!=0) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\nMicrophone muted"));
    }
    var digits:[6]u8=undefined;
    if(chat==3 and lu_code_text(cc,digits[0..6])==6) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("  "));
        lu_m1(status,lu_sel("appendString:"),lu_cf(digits[0..6]));
    }
    const source:u64=sc_stat(p,true,131);
    if(source!=0) {
        lu_m1(status,lu_sel("appendString:"),lu_cf(if(source==2) "\nVIDEO SOURCE: moving TEST frames (no camera)" else if(sc_stat(p,true,130)==2) "\nVIDEO SOURCE: live camera" else if(sc_stat(p,true,130)==3) "\nCamera unavailable/denied; no fallback test frames" else "\nCamera starting; no frames until available"));
    }
    lu_m1(status,lu_sel("appendString:"),lu_cf(if(audio==4) if(sc_stat(p,true,132)==6) "\nVideo-only channel verified; microphone off" else "\nAudio connected" else if(audio==3) if(ac==0) "\nWaiting for verified peer identity and code..." else "\nAudio: compare both devices" else if(audio==2) "\nIncoming audio" else if(audio==1) "\nCalling audio" else if(audio>=5) lu_call_ended_text(sc_stat(p,true,133)) else "\nMicrophone off"));
    if(audio==3 and lu_code_text(ac,digits[0..6])==6) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("  "));
        lu_m1(status,lu_sel("appendString:"),lu_cf(digits[0..6]));
    }
    if(lu_show_connection_hint(chat,audio,sc_stat(p,false,28),sc_stat(p,true,133))) {
        lu_m1(status,lu_sel("appendString:"),lu_cf("\nNo answer. Keep People open on both devices. If macOS asks, allow incoming connections for T27 OS, then retry."));
    }
    lu_text(self,lu_get(self,103),status);
    const transcript:u64=sc_transcript(p);
    lu_m1(lu_get(self,107),lu_sel(if(lu_mobile(self)) "setText:" else "setString:"),transcript);
    lu_m1(lu_get(self,304),lu_sel("setEnabled:"),if(chat==3 and cc!=0) 1 else 0);
    lu_m1(lu_get(self,308),lu_sel("setEnabled:"),if(audio==3 and ac!=0) 1 else 0);
    if(lu_val(self,2000)==1){lu_people_layout(self);}
}
pub fn lu_tick(self:u64,command:u64,timer:u64)->void {
    const p:u64=lu_ctx(self);
    if(p==0) {
        return;
    }
    lu_sync_read_visibility(self);
    if(lu_val(self,2000)==1){
        lu_people_auto_idle(self);
        lu_people_auto_receive(self);
    }
    if(lu_val(self,141)==1) {
        dn_tick(lu_val(self,130));
    }
    if(lu_val(self,141)==2 or mn_stat(lu_val(self,148),1)==1 or lu_val(self,LP_PREFERRED)==3) {
        mn_tick(lu_val(self,148));
    }
    if(lu_val(self,2000)==1){
        const adopted:u64=mn_auto_take(lu_val(self,148));
        if(adopted==1 and lu_val(self,LP_PREFERRED)==3){
            lu_mark(self,141,2);
            lu_mark(self,142,0);
            lu_mark(self,LP_AUTO_MESH_SESSION,1);
            lu_mark(self,LP_AUTO_ADOPTIONS,lu_val(self,LP_AUTO_ADOPTIONS)+1);
        }
        else if(adopted==2){
            lu_mark(self,LP_AUTO_BLOCKED,1);
            lu_mark(self,LP_AUTO_FAILURES,lu_val(self,LP_AUTO_FAILURES)+1);
            lu_error(self,"Auto receive could not prepare a safe route. No session accepted. Reselect a path or reopen People to retry.");
        }
    }
    sc_tick(p);
    if(lu_val(self,2000)==1){
        if(sc_state(p,true)==4){
            if(lu_val(self,LP_CALL_STARTED)==0){lu_mark(self,LP_CALL_STARTED,lu_people_now());}
        }
        else{lu_mark(self,LP_CALL_STARTED,0);lu_mark(self,LP_REMOTE_SERIAL,0);lu_mark(self,LP_REMOTE_SEEN,0);}
        lu_people_auto_tick(self);
    }
    if(lu_video_allowed(lu_val(self,140),sc_state(p,true))) {
        lu_mark(self,140,0);
        if(!sc_video_start(p,1)) {
            lu_error(self,"Camera could not start. Audio remains available; allow Camera in System Settings and retry Start camera video.");
        }
    }
    if(sc_state(p,true)==0 or sc_state(p,true)>=5) {
        lu_mark(self,140,0);
        lu_mark(self,124,0);
        lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
        lu_audio_deactivate(self);
    }
    if(lu_mobile(self)) {
        lu_idle(self,lu_val(self,115)==1 and (sc_state(p,true)==4 or lu_val(self,116)==1));
    }
    const tick:u64=lu_val(self,112)+1;
    lu_mark(self,112,tick);
    if(tick%30==0) {
        lu_render(self);
        if(lu_val(self,116)==1) {
            lu_control(self);
        }
        else if(lu_validation()) {
            lu_report(self);
        }
    }
}
pub fn lu_inactive(self:u64,command:u64,event:u64)->void {
    lu_mark(self,140,0); lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    lu_mark(self,115,0);
    const p:u64=lu_ctx(self);
    sc_visible(p,false);
    sc_video_stop(p);
    sc_action(p,true,5);
    if(lu_mobile(self)) {
        lu_idle(self,false);
        lu_audio_deactivate(self);
    }
}
pub fn lu_active(self:u64,command:u64,event:u64)->void {
    lu_mark(self,115,1);
    lu_sync_read_visibility(self);
}
pub fn lu_closed(self:u64,command:u64,event:u64)->void {
    lu_m0(lu_get(self,LP_HELPER_TIMER),lu_sel("invalidate"));
    lu_set(self,LP_HELPER_TIMER,0,1);
    lu_mark(self,LP_HELPER_DETACHED,0);
    lu_m1(lu_m0(lu_cls("NSNotificationCenter"),lu_sel("defaultCenter")),lu_sel("removeObserver:"),self);
    const p:u64=lu_ctx(self);
    lu_m0(lu_get(self,110),lu_sel("invalidate"));
    const directory:u64=lu_val(self,130);
    lu_mark(self,130,0);
    dn_close(directory);
    mn_close(lu_val(self,148));
    lu_mark(self,148,0);
    sc_close(p);
    if(lu_mobile(self)) {
        lu_idle(self,false);
        lu_audio_deactivate(self);
    }
    lu_mark(self,102,0);
    if(!lu_mobile(self)){
        const app:u64=lu_m0(lu_cls("NSApplication"),lu_sel("sharedApplication"));
        if(lu_get(app,LP_APP_SERVICE)==self){
            lu_set(app,LP_APP_SERVICE,0,1);
        }
    }
}
