fn lu_call_ended_text(reason:u64)->[]const u8 {
    if(reason==7 or reason==8) {
        return "\nCodes differ. Call refused; microphone off.";
    }
    if(reason==9) {
        return "\nCall was not confirmed in time. Microphone off.";
    }
    if(reason==10) {
        return "\nPeer stopped responding. Microphone off.";
    }
    if(reason==13) {
        return "\nAudio device failed. Microphone off; check permission and retry.";
    }
    if(reason==14) {
        return "\nPeer identity check failed. Call refused; microphone off.";
    }
    if(reason==3 or reason==4) {
        return "\nCall declined. Microphone off.";
    }
    return "\nCall ended. Microphone off.";
}
