    if(lu_val(self,LP_CALL_STARTED)==0){lu_mark(self,LP_CALL_STARTED,now);}
    const seconds:u64=(now-lu_val(self,LP_CALL_STARTED))/1000;
    const text:u64=lu_auto(lu_m0(lu_cls("NSMutableString"),lu_sel("new")));
    const minutes:u64=seconds/60;
