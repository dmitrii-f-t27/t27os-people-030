fn lu_people_text_width(text:u64)->f64 {
    const font:u64=lu_font(lu_cls("NSFont"),lu_sel("systemFontOfSize:"),15.0);
    const attrs:u64=lu_m2(lu_cls("NSDictionary"),lu_sel("dictionaryWithObject:forKey:"),font,lu_cf("NSFont"));
    const attr:u64=lu_auto(lu_m2(lu_m0(lu_cls("NSAttributedString"),lu_sel("alloc")),lu_sel("initWithString:attributes:"),text,attrs));
    const line:u64=lu_line(attr);
    if(line==0){
        return 120.0;
    }
    const width:f64=lu_line_width(line,0,0,0);
    lu_release(line);
    return width;
}
fn lu_people_icon(self:u64,key:u64,symbol:[]const u8)->void {
    const button:u64=lu_get(self,key);
    const title:u64=lu_m0(button,lu_sel("title"));
    if(lu_m0(title,lu_sel("length"))>0){
        lu_m1(button,lu_sel("setAccessibilityLabel:"),title);
        lu_m1(button,lu_sel("setToolTip:"),title);
    }
    const image:u64=lu_m2(lu_cls("NSImage"),lu_sel("imageWithSystemSymbolName:accessibilityDescription:"),lu_cf(symbol),lu_m0(button,lu_sel("toolTip")));
    if(image!=0){
        lu_m1(button,lu_sel("setTitle:"),lu_cf(""));
        lu_m1(button,lu_sel("setImage:"),image);
        lu_m1(button,lu_sel("setImagePosition:"),1);
    }
}
pub fn lu_people_keep_helper(mobile:bool,forward:u64,context:bool)->bool{
    return !mobile and forward==1 and context;
}
test helper_retention_requires_explicit_opt_in_and_a_live_desktop_identity {
    assert lu_people_keep_helper(false,1,true);
    assert !lu_people_keep_helper(false,0,true);
    assert !lu_people_keep_helper(true,1,true);
    assert !lu_people_keep_helper(false,1,false);
}
fn mn_discover(p:u64,on:bool)->void {
    @extern("mn_discover");
}
fn lu_people_clock(clock:u32)->u64{
    return @extern("clock_gettime_nsec_np");
}
fn lu_people_now()->u64{
    return lu_people_clock(6)/1000000;
}
pub fn lu_auto_next(tried:u64,direct:bool,mesh:bool,internet:bool)->u64 {
    if(direct and (tried&1)==0){
        return 0;
    }
    if(mesh and (tried&4)==0){
        return 2;
    }
    if(internet and (tried&2)==0){
        return 1;
    }
    return 9;
}
pub fn lu_auto_fallback_allowed(preferred:u64,state:u32,other:u32,reason:u64,expired:bool)->bool {
    return preferred==3 and (other==0 or other>=5) and ((state==1 and expired) or (state>=5 and reason==6));
}
test auto_fallback_is_bounded_to_untried_eligible_paths_before_compare {
    assert lu_auto_next(0,true,true,true)==0;
    assert lu_auto_next(1,true,true,false)==2;
    assert lu_auto_next(3,true,true,true)==2;
    assert lu_auto_next(7,true,true,true)==9;
    assert lu_auto_next(1,true,false,false)==9;
    assert lu_auto_fallback_allowed(3,1,0,0,true);
    assert !lu_auto_fallback_allowed(0,1,0,0,true);
    assert !lu_auto_fallback_allowed(3,3,0,0,true);
    assert !lu_auto_fallback_allowed(3,1,4,0,true);
    assert !lu_auto_fallback_allowed(3,5,0,7,true);
    assert !lu_auto_fallback_allowed(3,5,0,8,true);
    assert !lu_auto_fallback_allowed(3,5,0,9,true);
}
fn lu_people_direct_ready(self:u64)->bool {
    var raw:[64]u8=undefined;
    const n:usize=lu_bytes(lu_string(self,lu_get(self,104)),raw[0..64]);
    return va_ipv4(raw[0..n])!=0 and lu_port(self)!=0;
}
fn lu_people_auto_tick(self:u64)->void {
    const intent:u64=lu_val(self,LP_AUTO_CHANNEL);
    if(intent==0 or lu_val(self,LP_PREFERRED)!=3){
        return;
    }
    const p:u64=lu_ctx(self);
    const audio:bool=intent==2;
    const state:u32=sc_state(p,audio);
    const other:u32=sc_state(p,!audio);
    const reason:u64=sc_stat(p,audio,if(audio) 133 else 28);
    if(state==2 or state==3 or state==4 or (state>=5 and reason!=6)){
        lu_mark(self,LP_AUTO_CHANNEL,0);
        return;
    }
    if(!lu_auto_fallback_allowed(3,state,other,reason,lu_people_now()>=lu_val(self,LP_AUTO_DEADLINE))){
        return;
    }
    const mode:u64=lu_auto_next(lu_val(self,LP_AUTO_TRIED),lu_people_direct_ready(self),mn_stat(lu_val(self,148),3)>0,dn_endpoint(lu_val(self,130))!=0);
    if(mode==9){
        lu_mark(self,LP_AUTO_CHANNEL,0);
        return;
    }
    const camera:u64=lu_val(self,140);
    lu_mark(self,140,0);
    sc_action(p,audio,5);
    lu_sync_read_visibility(self);
    sc_tick(p);
    dn_cancel_pending(lu_val(self,130));
    lu_select_route(self,mode);
    lu_m2(lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults")),lu_sel("setInteger:forKey:"),3,lu_cf("T27PeopleRouteModeV2"));
    if(lu_val(self,141)!=mode){
        lu_mark(self,LP_AUTO_CHANNEL,0);
        return;
    }
    const peer:u64=lu_get(self,145);
    const paired:bool=if(mode==2) mn_pair(lu_val(self,148),peer) else if(mode==1) dn_pair(lu_val(self,130),peer) else true;
    if(mode==1){
        dn_force_relay(lu_val(self,130),false);
    }
    if(!paired or !lu_connect_selected(self,audio)){
        lu_mark(self,LP_AUTO_CHANNEL,0);
        lu_error(self,"Auto could not start the next eligible path. No unverified session was accepted.");
        return;
    }
    if(mode==2){
        lu_mark(self,LP_AUTO_MESH_SESSION,1);
    }
    lu_mark(self,140,camera);
    lu_m2(lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults")),lu_sel("setInteger:forKey:"),3,lu_cf("T27PeopleRouteModeV2"));
}
fn lu_people_save_preference(self:u64,mode:u64)->void {
    const index:u64=lu_val(self,2012);
    const cards:u64=lu_get(self,2011);
    if(index==0 or index>lu_m0(cards,lu_sel("count"))){
        return;
    }
    const updated:u64=lu_m0(lu_m1(cards,lu_sel("objectAtIndex:"),index-1),lu_sel("mutableCopy"));
    lu_m2(updated,lu_sel("setObject:forKey:"),lu_m1(lu_cls("NSNumber"),lu_sel("numberWithUnsignedLongLong:"),mode),lu_cf("route"));
    lu_m2(cards,lu_sel("replaceObjectAtIndex:withObject:"),index-1,updated);
    lu_release(updated);
    lu_people_write(self);
}
fn mn_auto_receive(p:u64,allowed:bool,directory:u64)->void {
    @extern("mn_auto_receive");
}
pub fn lu_auto_receive_allowed(preferred:u64,chat:u32,audio:u32,directory_intent:u64,camera:u64,outbound:u64,blocked:bool)->bool {
    return preferred==3 and !blocked and outbound==0 and lu_route_change_allowed(chat,audio,directory_intent,camera);
}
fn lu_people_auto_receive(self:u64)->void {
    const p:u64=lu_ctx(self);
    const chat_reason:u64=sc_stat(p,false,28);
    const audio_reason:u64=sc_stat(p,true,133);
    if(chat_reason==7 or chat_reason==8 or chat_reason==14 or audio_reason==7 or audio_reason==8 or audio_reason==14){
        lu_mark(self,LP_AUTO_BLOCKED,1);
    }
    const allowed:bool=lu_auto_receive_allowed(lu_val(self,LP_PREFERRED),sc_state(p,false),sc_state(p,true),dn_state(lu_val(self,130),29),lu_val(self,140),lu_val(self,LP_AUTO_CHANNEL),lu_val(self,LP_AUTO_BLOCKED)==1);
    mn_auto_receive(lu_val(self,148),allowed,lu_val(self,130));
}
test auto_receive_refuses_manual_routes_pending_intent_and_mismatch {
    assert lu_auto_receive_allowed(3,0,5,0,0,0,false);
    assert !lu_auto_receive_allowed(0,0,0,0,0,0,false);
    assert !lu_auto_receive_allowed(3,4,0,0,0,0,false);
    assert !lu_auto_receive_allowed(3,0,0,1,0,0,false);
    assert !lu_auto_receive_allowed(3,0,0,0,1,0,false);
    assert !lu_auto_receive_allowed(3,0,0,0,0,1,false);
    assert !lu_auto_receive_allowed(3,0,0,0,0,0,true);
}
fn mn_auto_take(p:u64)->u64{
    return @extern("mn_auto_take");
}
fn lu_people_auto_idle(self:u64)->void {
    if(lu_val(self,LP_PREFERRED)!=3 or lu_val(self,LP_AUTO_MESH_SESSION)!=1 or lu_val(self,141)!=2 or !lu_people_direct_ready(self)){
        return;
    }
    if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
        return;
    }
    lu_mark(self,LP_AUTO_MESH_SESSION,0);
    lu_people_auto(self);
}
fn lu_people_own_ipv4(self:u64)->u64 {
    const explicit:u64=lu_string(self,lu_get(self,146));
    if(lu_m0(explicit,lu_sel("length"))!=0){
        var raw:[64]u8=undefined;
        const n:usize=lu_bytes(explicit,raw[0..64]);
        const ip:u64=va_ipv4(raw[0..n]);
        return if(dc_local_ipv4(ip)) ip else 0;
    }
    var candidates:[145]u8=undefined;
    const n:usize=dc_gather(lu_val(self,2030),candidates[0..145]);
    var i:usize=1;
    while(i+18<=n){
        if(candidates[i+10]==255 and candidates[i+11]==255){
            return @as(u64,candidates[i+12])*16777216+@as(u64,candidates[i+13])*65536+@as(u64,candidates[i+14])*256+@as(u64,candidates[i+15]);
        }
        i=i+18;
    }
    return 0;
}
fn lu_people_mesh_card(self:u64)->u64 {
    const ip:u64=lu_people_own_ipv4(self);
    return if(ip==0) 0 else mn_card(lu_val(self,148),ip);
}
pub fn lu_people_rail_width(width:f64)->f64 {
    if(width<700.0){
        return if(width*0.28<116.0) 116.0 else width*0.28;
    }
    return if(width>900.0) 318.0 else 220.0;
}
test compact_people_keeps_positive_conversation_and_composer_width {
    assert 340.0-lu_people_rail_width(340.0)-48.0>=176.0;
    assert 480.0-lu_people_rail_width(480.0)-48.0>280.0;
    assert lu_people_rail_width(1200.0)==318.0;
}
// The complete successful previous surface remains on the same controller and data root.
// No second builder, identity, socket, call engine or timer is created.
fn lu_people_previous_layout(self:u64)->void {
    const parent:u64=lu_get(self,125);
    const scroll:u64=lu_get(self,2001);
    var bounds:[4]f64=undefined;
    lu_frame_value(lu_m1(scroll,lu_sel("valueForKey:"),lu_cf("frame")),lu_sel("getValue:"),bounds);
    const mesh:bool=lu_val(self,141)==2;
    const internet:bool=lu_val(self,141)==1;
    const width:f64=if(bounds[2]>390.0) bounds[2] else 390.0;
    lu_point(parent,lu_sel("setFrameSize:"),width,if(mesh) 1944.0 else 1624.0);
    lu_m1(scroll,lu_sel("setHasVerticalScroller:"),1);
    lu_m1(scroll,lu_sel("setHasHorizontalScroller:"),if(bounds[2]<390.0) 1 else 0);
    const all:u64=lu_m0(parent,lu_sel("subviews"));
    var i:u64=0;
    while(i<lu_m0(all,lu_sel("count"))){
        lu_m1(lu_m1(all,lu_sel("objectAtIndex:"),i),lu_sel("setHidden:"),1);
        i=i+1;
    }
    const previous:u64=lu_get(self,2080);
    i=0;
    while(i<lu_m0(previous,lu_sel("count"))){
        const view:u64=lu_m1(previous,lu_sel("objectAtIndex:"),i);
        if(view==lu_get(self,123) and lu_m0(view,lu_sel("superview"))!=parent){
            lu_m0(view,lu_sel("removeFromSuperview"));lu_m1(parent,lu_sel("addSubview:"),view);
        }
        const mesh_only:bool=lu_val(view,900)==1;
        var show:bool=if(mesh_only) mesh else true;
        if(view==lu_get(self,129) or view==lu_get(self,340)){
            show=internet;
        }
        if(view==lu_get(self,146)){
            show=!internet;
        }
        const y:f64=@as(f64,@floatFromInt(lu_val(view,902)))/10.0;
        const shift:f64=64.0+(if(mesh and !mesh_only and y>=204.0) @as(f64,320.0) else @as(f64,0.0));
        lu_rect(view,lu_sel("setFrame:"),@as(f64,@floatFromInt(lu_val(view,901)))/10.0,y+shift,@as(f64,@floatFromInt(lu_val(view,906)))/10.0,@as(f64,@floatFromInt(lu_val(view,907)))/10.0);
        lu_m1(view,lu_sel("setHidden:"),if(show) 0 else 1);
        const title:u64=lu_get(view,905);
        if(title!=0){
            lu_m1(view,lu_sel("setTitle:"),title);
            lu_m1(view,lu_sel("setImage:"),0);
            lu_m1(view,lu_sel("setImagePosition:"),0);
        }
        i=i+1;
    }
    lu_m1(lu_get(self,108),lu_sel("setBezeled:"),1);
    lu_people_place(self,362,16.0,16.0,174.0,34.0,true);
    lu_text(self,lu_get(self,2025),lu_cf("\xd0\x94\xd0\xbe\xd0\xbf\xd0\xbe\xd0\xbb\xd0\xbd\xd0\xb8\xd1\x82\xd0\xb5\xd0\xbb\xd1\x8c\xd0\xbd\xd0\xbe"));
    lu_people_place(self,2025,206.0,18.0,width-222.0,32.0,true);
    if(mesh){
        lu_text(self,lu_get(self,147),mn_neighbors_text(lu_val(self,148)));
    }
}


// Mesh cards advertise the Mesh socket, never a Direct session socket.
pub fn lu_people_contact_route(preferred:u64,mesh_only:bool)->u64 {
    if(mesh_only){
        if(preferred==3 or preferred==2){ return 2; }
        return 4;
    }
    return preferred;
}
test saved_mesh_contact_never_reinterprets_its_endpoint_as_direct {
    assert lu_people_contact_route(3,true)==2;
    assert lu_people_contact_route(2,true)==2;
    assert lu_people_contact_route(0,true)==4;
    assert lu_people_contact_route(1,true)==4;
    assert lu_people_contact_route(0,false)==0;
    assert lu_people_contact_route(3,false)==3;
}


