// Main dashboard forwards native-child events without treating them as its controls.
pub fn lu_native_event_window(event_window:u64)->u64 {
    const app:u64=lu_m0(lu_cls("NSApplication"),lu_sel("sharedApplication"));
    const controller:u64=lu_get(app,9910);
    if(controller==0 or lu_ctx(controller)==0){return 0;}
    const window:u64=lu_get(controller,114);
    if(event_window==window){return window;}
    return 0;
}

// Shared permission request for another native controller in the SAME bundle.
// No identity, network request or media starts from this helper.
pub fn lu_request_mac_microphone(owner:u64)->u32 {
    const capture:u64=lu_cls("AVCaptureDevice");
    const status:u64=lu_m1(capture,lu_sel("authorizationStatusForMediaType:"),lu_cf("soun"));
    if(status==0){lu_permission_request(owner,capture);}
    return @as(u32,@intCast(status));
}
// An explicit historical-person action selects a FULL PUBLIC key in the normal
// verified composer. It never equates the new device key with the old identity.
pub fn lu_prepare_public_friend(card:u64)->bool {
    const self:u64=lu_open_mac();
    if(self==0 or card==0){return false;}
    lu_text(self,lu_get(self,106),card);
    lu_status(self,"Historical friend PUBLIC signing key selected. Pair, compare both devices, then choose chat/call. This device's new Keychain identity remains separate.");
    return true;
}

// The existing glass window owns this native page. Back closes transport and media.
pub fn lu_embed_mac(parent:u64,window:u64)->u64 {
    const app:u64=lu_m0(lu_cls("NSApplication"),lu_sel("sharedApplication"));
    const saved:u64=lu_get(app,LP_APP_SERVICE);
    if(saved!=0 and lu_ctx(saved)!=0 and lu_val(saved,LP_HELPER_DETACHED)==1){
        const scroll:u64=lu_get(saved,2001);
        lu_m0(lu_get(saved,LP_HELPER_TIMER),lu_sel("invalidate"));
        lu_set(saved,LP_HELPER_TIMER,0,1);
        lu_mark(saved,LP_HELPER_DETACHED,0);
        lu_m0(scroll,lu_sel("retain"));
        lu_m1(parent,lu_sel("addSubview:"),scroll);
        lu_mark(saved,115,1);
        lu_sync_read_visibility(saved);
        if(lu_val(saved,141)==2){
            mn_active(lu_val(saved,148),true);
        }
        else if(lu_val(saved,141)==1){
            dn_route_active(lu_val(saved,130),true);
        }
        lu_set(saved,110,lu_timer(lu_cls("NSTimer"),lu_sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),0.008,saved,lu_sel("localTick:"),0,true),1);
        return scroll;
    }
    var cls:u64=lu_cls("T27PeopleController");
    if(cls==0) {
        cls=lu_allocate(lu_cls("NSObject"),"T27PeopleController",0);
        if(cls==0 or !lu_methods(cls)) {
            return 0;
        }
        lu_method(cls,"localHelpTick:","lu_people_help_tick","v@:@");
        lu_method(cls,"localSend:","lu_people_send","v@:@");
        lu_method(cls,"peopleInactive:","lu_inactive","v@:@");
        lu_method(cls,"peopleActive:","lu_active","v@:@");
        lu_method(cls,"peopleClosed:","lu_closed","v@:@");
        lu_register(cls);
    }
    const self:u64=lu_m0(cls,lu_sel("new"));
    const center:u64=lu_m0(lu_cls("NSNotificationCenter"),lu_sel("defaultCenter"));
    lu_m4(center,lu_sel("addObserver:selector:name:object:"),self,lu_sel("peopleInactive:"),lu_cf("NSWindowWillMiniaturizeNotification"),window);
    lu_m4(center,lu_sel("addObserver:selector:name:object:"),self,lu_sel("peopleActive:"),lu_cf("NSWindowDidDeminiaturizeNotification"),window);
    lu_m4(center,lu_sel("addObserver:selector:name:object:"),self,lu_sel("peopleClosed:"),lu_cf("NSWindowWillCloseNotification"),window);
    lu_m4(center,lu_sel("addObserver:selector:name:object:"),self,lu_sel("peopleInactive:"),lu_cf("NSApplicationDidHideNotification"),0);
    var vc:u64=lu_cls("T27PeopleFlippedView");
    if(vc==0) {
        vc=lu_allocate(lu_cls("NSView"),"T27PeopleFlippedView",0);
        lu_method(vc,"isFlipped","lu_flipped","B@:");
        lu_register(vc);
    }
    const body:u64=lu_auto(lu_rect(lu_m0(vc,lu_sel("alloc")),lu_sel("initWithFrame:"),0.0,0.0,390.0,1560.0));
    const scroll:u64=lu_rect(lu_m0(lu_cls("NSScrollView"),lu_sel("alloc")),lu_sel("initWithFrame:"),0.0,0.0,390.0,600.0);
    lu_m1(scroll,lu_sel("setHasVerticalScroller:"),1);
    lu_m1(scroll,lu_sel("setDocumentView:"),body);
    lu_m1(parent,lu_sel("addSubview:"),scroll);
    lu_set(scroll,9911,self,1);
    lu_set(self,114,window,1);
    lu_build(self,body,false);
    lu_set(self,2001,scroll,1);
    lu_people_build(self,body);
    lu_set(app,LP_APP_SERVICE,self,1);
    lu_m4(center,lu_sel("addObserver:selector:name:object:"),self,lu_sel("peopleClosed:"),lu_cf("NSApplicationWillTerminateNotification"),app);
    lu_release(self);
    return scroll;
}
pub fn lu_hide_mac(scroll:u64)->void {
    const self:u64=lu_get(scroll,9911);
    if(self!=0 and lu_people_keep_helper(false,mn_stat(lu_val(self,148),1),lu_ctx(self)!=0)){
        lu_people_detach(self);
        return;
    }
    if(self!=0) {
        lu_mark(self,140,0);
        lu_closed(self,0,0);
        lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    }
    lu_set(scroll,9911,0,1);
}
fn lu_contact(self:u64)->u64 {
    if(lu_ctx(self)==0){return 0;}
    if(lu_val(self,141)==1){return sc_card(lu_ctx(self));}
    const ip:u64=lu_people_own_ipv4(self);
    if(ip==0){return 0;}
    if(lu_val(self,141)==2){return mn_card(lu_val(self,148),ip);}
    const result:u64=lu_new("NSMutableString");
    lu_m1(result,lu_sel("appendString:"),sc_card(lu_ctx(self)));
    lu_m1(result,lu_sel("appendString:"),lu_cf("|"));
    var i:u64=0;
    while(i<4){
        if(i>0){lu_m1(result,lu_sel("appendString:"),lu_cf("."));}
        const octet:u64=(ip>>@as(u32,@intCast((3-i)*8)))&255;
        lu_m1(result,lu_sel("appendString:"),lu_m0(lu_m1(lu_cls("NSNumber"),lu_sel("numberWithUnsignedLongLong:"),octet),lu_sel("stringValue")));
        i=i+1;
    }
    lu_m1(result,lu_sel("appendString:"),lu_people_port_text(self));
    return result;
}
pub fn lu_video_allowed(consent:u64,state:u32)->bool { return consent==1 and state==4; }
test people_camera_requires_explicit_request_and_verified_session {
    assert lu_video_allowed(1,4);
    assert !lu_video_allowed(0,4);
    assert !lu_video_allowed(1,2);
    assert !lu_video_allowed(1,3);
    assert !lu_video_allowed(1,5);
    assert 46!=44;
    assert 47!=41;
}

pub fn lu_port_bytes(raw:[]const u8)->u64 {
    if(raw.len==0 or raw.len>5) { return 0; }
    var n:u64=0; var i:usize=0;
    while(i<raw.len) { if(raw[i]<48 or raw[i]>57) { return 0; } n=n*10+@as(u64,raw[i]-48); i=i+1; }
    return if(n>0 and n<=65525) n else 0;
}
fn lu_port(self:u64)->u64 {
    var raw:[16]u8=undefined;
    const n:usize=lu_bytes(lu_string(self,lu_get(self,105)),raw[0..16]);
    return lu_port_bytes(raw[0..n]);
}
test people_contact_port_is_complete_and_bounded {
    assert lu_port_bytes("49901")==49901;
    assert lu_port_bytes("49901x")==0;
    assert lu_port_bytes("0")==0;
    assert lu_port_bytes("65526")==0;
    assert lu_port_bytes("")==0;
}

fn lu_validation()->bool {
    const bundle:u64=lu_m0(lu_cls("NSBundle"),lu_sel("mainBundle"));
    return lu_m1(lu_m0(bundle,lu_sel("bundleIdentifier")),lu_sel("isEqualToString:"),lu_cf("ai.t27.os.people.finalqa"))%256!=0;
}

pub fn lu_mute_action(actual:u64)->u32 { return if(actual==0) @as(u32,6) else @as(u32,7); }
test repeated_call_mute_uses_the_actual_session_state {
    assert lu_mute_action(0)==6;
    assert lu_mute_action(1)==7;
    // A new session reset to unmuted must mute on its very first press.
    assert lu_mute_action(0)==6;
}

pub fn lu_show_connection_hint(chat:u32,audio:u32,chat_reason:u64,audio_reason:u64)->bool {
    return (chat==0 or chat>=5) and (audio==0 or audio>=5) and ((chat>=5 and chat_reason==6) or (audio>=5 and audio_reason==6));
}
test connection_hint_is_contextual_and_never_shows_during_an_active_call {
    assert lu_show_connection_hint(0,5,0,6);
    assert lu_show_connection_hint(5,0,6,0);
    assert !lu_show_connection_hint(5,4,6,0);
    assert !lu_show_connection_hint(1,5,0,6);
    assert !lu_show_connection_hint(0,5,0,3);
    assert !lu_show_connection_hint(5,5,1,2);
}

pub fn lu_route_change_allowed(chat:u32,audio:u32,intent:u64,camera_intent:u64)->bool {
    return (chat==0 or chat>=5) and (audio==0 or audio>=5) and intent==0 and camera_intent==0;
}
pub fn lu_route_action(tag:u64)->bool {
    return tag==1 or (tag>=2 and tag<=10) or tag==12 or tag==30 or tag==33 or tag==34 or tag==42 or tag==43 or tag==46 or tag==47;
}
fn lu_select_route(self:u64,mode:u64)->void {
    if(mode>2) {
        return;
    }
    if(mode==lu_val(self,141) and sc_stat(lu_ctx(self),false,137)==0) {
        return;
    }
    const p:u64=lu_ctx(self);
    const directory:u64=lu_val(self,130);
    if(!lu_route_change_allowed(sc_state(p,false),sc_state(p,true),dn_state(directory,29),lu_val(self,140))) {
        lu_error(self,"End or cancel the current session before switching Direct / Internet / Mesh.");
        return;
    }
    if((mode==1 and directory==0) or (mode==2 and lu_val(self,148)==0)){
        lu_error(self,"Selected path controller is unavailable. The current path was preserved; reopen People to retry.");
        return;
    }
    if((directory!=0 and !dn_route_active(directory,false)) or (lu_val(self,141)==2 and !mn_active(lu_val(self,148),false)) or !sc_route_pause(p,true)) {
        lu_error(self,"Path change refused while a session is pending.");
        return;
    }
    lu_mark(self,141,mode);
    lu_mark(self,124,0);
    lu_mark(self,140,0);
    lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    if(mode==1) {
        dn_force_relay(directory,true);
        if(dn_endpoint(directory)!=0) {
            dn_route_active(directory,true);
            sc_route_pause(p,false);
        }
    }
    else if(mode==2){
        if(mn_active(lu_val(self,148),true)){
            sc_route_pause(p,false);
        }
    }
    else {
        var raw:[64]u8=undefined;
        const n:usize=lu_bytes(lu_string(self,lu_get(self,104)),raw[0..64]);
        const ready:bool=sc_direct(p,va_ipv4(raw[0..n]),lu_port(self));
        lu_mark(self,142,if(ready) 1 else 0);
        if(ready) {
            sc_route_pause(p,false);
        }
    }
    const defaults:u64=lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults"));
    lu_m2(defaults,lu_sel("setInteger:forKey:"),if(mode==1) 1 else 0,lu_cf("T27PeopleInternet"));
    lu_m2(defaults,lu_sel("setInteger:forKey:"),mode,lu_cf("T27PeopleRouteModeV2"));
    lu_render(self);
}
test selected_route_covers_all_outbound_and_accept_variants_and_switch_guards {
    assert lu_route_action(33);assert lu_route_action(34);assert lu_route_action(42);assert lu_route_action(43);
    assert lu_route_action(46);assert lu_route_action(47);assert lu_route_action(1);assert lu_route_action(12);
    assert !lu_route_action(11);assert !lu_route_action(48);
    assert lu_route_change_allowed(0,5,0,0);
    assert !lu_route_change_allowed(1,0,0,0);assert !lu_route_change_allowed(0,2,0,0);
    assert !lu_route_change_allowed(4,5,0,0);assert !lu_route_change_allowed(0,0,1,0);assert !lu_route_change_allowed(5,5,0,1);
}

pub fn lu_cache_endpoint_for_peer(full_card:bool,same_full_key:bool)->bool { return full_card or same_full_key; }
