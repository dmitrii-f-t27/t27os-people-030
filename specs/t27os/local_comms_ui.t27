    const item:u64=lu_auto(lu_m3(lu_m0(lu_cls("NSMenuItem"),lu_sel("alloc")),lu_sel("initWithTitle:action:keyEquivalent:"),lu_cf(title),lu_sel("localPress:"),lu_cf("")));
    lu_m1(item,lu_sel("setTarget:"),self);
