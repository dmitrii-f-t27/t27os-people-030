    lu_m1(text,lu_sel("appendString:"),lu_m0(lu_m1(lu_cls("NSNumber"),lu_sel("numberWithUnsignedLongLong:"),minutes),lu_sel("stringValue")));
    lu_m1(text,lu_sel("appendString:"),lu_cf(if(seconds%60<10) ":0" else ":"));
    lu_m1(text,lu_sel("appendString:"),lu_m0(lu_m1(lu_cls("NSNumber"),lu_sel("numberWithUnsignedLongLong:"),seconds%60),lu_sel("stringValue")));
    return text;
}
