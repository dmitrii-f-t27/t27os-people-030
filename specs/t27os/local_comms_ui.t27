fn lu_people_valid_entry(item:u64)->bool {
    if(lu_m1(item,lu_sel("isKindOfClass:"),lu_cls("NSDictionary"))%256==0){
        return false;
    }
    const name:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("name"));
    const card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
    const identity:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("identity"));
    const route:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("route"));
    return lu_m1(name,lu_sel("isKindOfClass:"),lu_cls("NSString"))%256!=0 and lu_m1(card,lu_sel("isKindOfClass:"),lu_cls("NSString"))%256!=0 and lu_m1(identity,lu_sel("isKindOfClass:"),lu_cls("NSString"))%256!=0 and lu_m0(identity,lu_sel("length"))==136 and lu_m1(route,lu_sel("isKindOfClass:"),lu_cls("NSNumber"))%256!=0 and lu_m0(route,lu_sel("unsignedLongLongValue"))<=3 and lu_m1(mn_public_card(card),lu_sel("isEqualToString:"),identity)%256!=0;
}
fn lu_people_auto(self:u64)->void {
    if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
        return;
    }
    const selected:u64=lu_val(self,2012);
    const cards:u64=lu_get(self,2011);
    var mesh_only:bool=false;
    if(selected>0 and selected<=lu_m0(cards,lu_sel("count"))){
        const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),selected-1);
        const card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
        mesh_only=lu_m1(card,lu_sel("hasPrefix:"),lu_cf("t27m1"))%256!=0;
    }
    const mode:u64=if(mesh_only) 2 else if(dn_endpoint(lu_val(self,130))!=0) 1 else 0;
    lu_select_route(self,mode);
    if(mode==1){
        dn_force_relay(lu_val(self,130),false);
    }
    lu_m2(lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults")),lu_sel("setInteger:forKey:"),3,lu_cf("T27PeopleRouteModeV2"));
}
fn lu_people_detach(self:u64)->void {
    mn_auto_receive(lu_val(self,148),false,lu_val(self,130));
    lu_mark(self,LP_AUTO_CHANNEL,0);
    lu_inactive(self,0,0);
    sc_action(lu_ctx(self),false,5);
    lu_sync_read_visibility(self);
    sc_tick(lu_ctx(self));
    dn_cancel_pending(lu_val(self,130));
    dn_route_active(lu_val(self,130),false);
    mn_active(lu_val(self,148),false);
    lu_m0(lu_get(self,110),lu_sel("invalidate"));
    lu_set(self,110,0,1);
    lu_mark(self,LP_HELPER_DETACHED,1);
    lu_m1(lu_get(self,123),lu_sel("setImage:"),0);
    lu_m1(lu_get(self,2031),lu_sel("setImage:"),0);
    lu_set(self,LP_HELPER_TIMER,lu_timer(lu_cls("NSTimer"),lu_sel("scheduledTimerWithTimeInterval:target:selector:userInfo:repeats:"),0.03,self,lu_sel("localHelpTick:"),0,true),1);
}
pub fn lu_people_help_tick(self:u64,command:u64,timer:u64)->void {
    if(lu_val(self,LP_HELPER_DETACHED)!=1){
        return;
    }
    if(mn_stat(lu_val(self,148),1)!=1){
        lu_m0(lu_get(self,LP_HELPER_TIMER),lu_sel("invalidate"));
        return;
    }
    mn_tick(lu_val(self,148));
}
