fn lu_qa_port(mobile:bool,identity:u32)->u64 {
    const raw:u64=lu_getenv("T27_PEOPLE_QA_PORT\x00");
    if(raw!=0){
        var bytes:[16]u8=undefined;
        const n:usize=lu_bytes(lu_auto(lu_cf_cstr(0,raw,134217984)),bytes[0..16]);
        const port:u64=lu_port_bytes(bytes[0..n]);
        if(lu_qa_port_valid(lu_qa(),identity,port)){
            return port;
        }
    }
    return if(mobile) 49902 else 49901;
}
test people_qa_port_override_is_scoped_and_bounded {
    assert lu_qa_port_valid(true,1,62101);
    assert !lu_qa_port_valid(false,1,62101);
    assert !lu_qa_port_valid(true,0,62101);
    assert !lu_qa_port_valid(true,1,65520);
}
