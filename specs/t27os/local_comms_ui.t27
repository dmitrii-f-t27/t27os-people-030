pub fn lu_register_mobile(delegate:u64,scene:u64)->bool {
    return lu_methods(scene)
    and lu_method(delegate,"application:didFinishLaunchingWithOptions:","lu_launch","B@:@@")
    and lu_method(scene,"scene:willConnectToSession:options:","lu_mobile_connect","v@:@@@")
    and lu_method(scene,"sceneWillResignActive:","lu_inactive","v@:@")
    and lu_method(scene,"sceneDidBecomeActive:","lu_active","v@:@")
    and lu_method(scene,"sceneDidDisconnect:","lu_closed","v@:@")
    and lu_method(scene,"localCapture:","lu_capture_mobile","v@:@");
}
