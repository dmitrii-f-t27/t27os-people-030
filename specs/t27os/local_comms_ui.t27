    lu_record(diagnostic,"activeOK",active_ok);
    lu_m2(diagnostic,lu_sel("setObject:forKey:"),lu_m0(session,lu_sel("category")),lu_cf("category"));
    lu_m2(diagnostic,lu_sel("setObject:forKey:"),lu_m0(session,lu_sel("mode")),lu_cf("mode"));
    lu_record(diagnostic,"sampleRate",@as(u64,@intFromFloat(lu_real(session,lu_sel("sampleRate")))));
    lu_record(diagnostic,"inputChannels",lu_m0(session,lu_sel("inputNumberOfChannels")));
    lu_record(diagnostic,"outputChannels",lu_m0(session,lu_sel("outputNumberOfChannels")));
    const route:u64=lu_m0(session,lu_sel("currentRoute"));
