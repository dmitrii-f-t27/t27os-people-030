+
+// A dedicated live People test keeps unrelated shell effects away from the owner profile.
+// This is separate from replay: replay retains its original no-effects contract.
+pub fn gw_people_qa_allowed(flags:bool,dev:bool,scoped:bool)->bool{
+    return flags and dev and scoped;
+}
+fn gw_people_qa()->bool {
+    const info:u64=msg0(cls("NSProcessInfo"),sel("processInfo"));
+    const args:u64=msg0(info,sel("arguments"));
+    const flags:bool=msg1(args,sel("containsObject:"),cf("--t27-local-qa"))%256!=0 and msg1(args,sel("containsObject:"),cf("--t27-full-ephemeral-qa"))%256!=0;
+    if(!flags or !gw_home_is_dev()){
+        return false;
+    }
+    const local:u64=msg1(msg0(info,sel("environment")),sel("objectForKey:"),cf("T27_LOCAL_HOME"));
+    const home:u64=ns_home();
+    const scoped:bool=local!=0 and msg0(local,sel("isAbsolutePath"))%256!=0 and msg1(local,sel("hasSuffix:"),cf(".t27-qa"))%256!=0 and msg1(home,sel("isEqualToString:"),local)%256!=0;
+    return gw_people_qa_allowed(flags,true,scoped);
+}
+fn gw_effect(mode:u32,fx:u32)->bool {
+    return rm_allows(mode,fx) and !gw_people_qa();
+}
+test people_live_qa_requires_dedicated_home_dev_channel_and_both_flags {
+    assert gw_people_qa_allowed(true,true,true);
+    assert !gw_people_qa_allowed(false,true,true);
+    assert !gw_people_qa_allowed(true,false,true);
+    assert !gw_people_qa_allowed(true,true,false);
+}
+// Both live-People QA flags without the complete isolation boundary fail before shell startup.
+fn gw_people_qa_requested()->bool {
+    const args:u64=msg0(msg0(cls("NSProcessInfo"),sel("processInfo")),sel("arguments"));
+    return msg1(args,sel("containsObject:"),cf("--t27-full-ephemeral-qa"))%256!=0;
+}
+pub fn gw_people_qa_start_allowed(requested:bool,qualified:bool)->bool{
+    return !requested or qualified;
+}
+test live_people_qa_missing_isolation_fails_before_startup {
+    assert gw_people_qa_start_allowed(false,false);
+    assert gw_people_qa_start_allowed(true,true);
+    assert !gw_people_qa_start_allowed(true,false);
+}
