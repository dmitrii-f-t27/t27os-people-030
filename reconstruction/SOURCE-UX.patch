+        const activation:u64=lu_people_contact_route(mode,mesh_only);
+        lu_mark(self,LP_HISTORY_ONLY,if(activation==4) 1 else 0);
+        const endpoint_mode:u64=if(activation==4) 2 else activation;
+        if(endpoint_mode==3){
+            lu_people_auto(self);
+        }
+        else{
+            lu_select_route(self,endpoint_mode);
+            if(lu_val(self,141)!=endpoint_mode){
+                lu_people_layout(self);
+                return true;
+            }
+        }
+        const expected:u64=lu_m0(lu_m1(item,lu_sel("objectForKey:"),lu_cf("identity")),lu_sel("retain"));
+        lu_text(self,lu_get(self,106),saved_card);
+        lu_dispatch(self,1);
+        lu_mark(self,LP_HISTORY_ONLY,if(activation==4) 1 else 0);
+        if(lu_m1(lu_get(self,145),lu_sel("isEqualToString:"),expected)%256!=0){
+            lu_mark(self,2012,index+1);
+            lu_mark(self,2013,0);
+        }
+        lu_release(expected);
+        if(activation==4){
+            lu_error(self,"History only: this contact has a Mesh endpoint. Choose Auto or Mesh, or add its Direct card.");
+        }
+        lu_people_layout(self);
+        return true;
+    }
+    return false;
+}
+pub fn lu_people_visible_control(tag:u64,detail:bool,add:bool,chat:u32,audio:u32)->bool {
+    if(detail){
+        return tag==13 or tag==40 or (tag>=48 and tag<=56);
+    }
+    if(add){
+        return tag==1 or tag==13 or (tag>=48 and tag<=50);
+    }
+    if(tag==3){
+        return chat==2;
+    }
+    if(tag==4 or tag==5){
+        return chat==3;
+    }
+    if(tag==7 or tag==47){
+        return audio==2;
+    }
+    if(tag==8 or tag==9){
+        return audio==3;
+    }
+    if(tag==10 or tag==31){
+        return audio==4;
+    }
+    if(tag==11){
+        return (audio>0 and audio<5) or (chat>0 and chat<5);
+    }
+    if(tag==30){
+        return audio==4;
+    }
+    return tag==2 or tag==6 or tag==46 or tag==12;
+}
+test people_controls_follow_real_handshake_and_keep_end_available {
+    assert lu_people_visible_control(7,false,false,0,2);
+    assert !lu_people_visible_control(7,false,false,0,4);
+    assert lu_people_visible_control(9,false,false,4,3);
+    assert lu_people_visible_control(11,false,false,4,1);
+    assert lu_people_visible_control(11,false,false,4,0);
+    assert !lu_people_visible_control(54,false,false,4,4);
+    assert lu_people_visible_control(54,true,false,4,4);
+}
