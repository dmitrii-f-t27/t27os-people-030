+// The session event can be consumed by a foreground host before chm_tick sees it.
+// Only the actual verified session's pinned peer may reset this log's transport.
+pub fn chm_session_active(m: []u8, s: []const u8, log: []u8, now: u64) -> u32 {
+    if (s.len < CS_LEN or cs_state(s) != CK_ACTIVE) { return 0; }
+    var peer : [10]u8 = undefined;
+    if (cs_peer(s, peer[0..10]) == 0) { return 0; }
+    return chm_begin_verified(m, log, peer[0..10], CK_ACTIVE, now);
+}
+
+fn chm_begin_verified(m: []u8, log: []u8, peer: []const u8, state: u32, now: u64) -> u32 {
+    if (m.len < CHM_LEN or log.len < CL_HDR or peer.len != 10 or state != CK_ACTIVE) { return 0; }
+    const cap : u32 = cl_cap(log);
+    if (cap == 0 or cap > CL_KEEP or log.len < cl_bytes(cap) or cl_count(log) > cap) { return 0; }
+    var i : usize = 0;
+    // chat_core's protected log header pins its peer fingerprint at bytes28..38.
+    while (i < 10) {
+        if (m[M_FP + i] != peer[i] or log[28 + i] != peer[i]) { return 0; }
+        i = i + 1;
+    }
+    var upto : u64 = mg(m, M_READ_UPTO);
+    i = 0;
+    while (i < @as(usize, cl_count(log))) {
+        if (cl_dir(log, i) == CH_DIR_IN and cl_state(log, i) == CH_S_READ) {
+            const msg : u64 = @as(u64, cl_msg(log, i));
+            if (msg > upto) { upto = msg; }
+        }
+        i = i + 1;
+    }
+    ma(m, CHM_SESSIONS);
+    mp(m, M_LAST, now);
+    // Reconstruct only durably READ history, never unseen DELIVERED lines.
+    mp(m, M_READ_UPTO, upto);
+    mp(m, M_READ_SENT, 0);
+    return if (cl_session_start(log) > 0) CHM_E_STATUS else 0;
+}
+
+fn chm_read_packet(m: []const u8, out: []u8) -> usize {
+    const upto : u64 = mg(m, M_READ_UPTO);
+    if (upto == 0 or upto <= mg(m, M_READ_SENT) or out.len < CH_PHDR) { return 0; }
+    return ch_put_read(out, @as(u32, @intCast(upto)));
+}
+
+fn chm_read_sent(m: []u8, now: u64) -> void {
+    ma(m, CHM_READ_TX);
+    mp(m, M_READ_SENT, mg(m, M_READ_UPTO));
+    mp(m, M_LAST, now);
+}
