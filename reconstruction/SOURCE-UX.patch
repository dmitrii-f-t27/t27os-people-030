+fn lu_people_action(self:u64,tag:u64)->bool {
+    if(lu_people_refined_action(self,tag)){ return true; }
+    if(tag==70){
+        lu_mark(self,2013,5);
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag==57 or tag==48 or tag==49 or tag==50){
+        if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
+            lu_error(self,"Finish the session before changing preferred path.");
+            return true;
+        }
+        const mode:u64=if(tag==57) 3 else if(tag==50) 2 else if(tag==49) 1 else 0;
+        if(mode!=3){
+            lu_select_route(self,mode);
+        }
+        lu_mark(self,LP_PREFERRED,mode);
+        const selected:u64=lu_val(self,2012);
+        const contacts:u64=lu_get(self,2011);
+        if(selected>0 and selected<=lu_m0(contacts,lu_sel("count"))){
+            const item:u64=lu_m1(contacts,lu_sel("objectAtIndex:"),selected-1);
+            const card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
+            const mesh_only:bool=lu_m1(card,lu_sel("hasPrefix:"),lu_cf("t27m1"))%256!=0;
+            lu_mark(self,LP_HISTORY_ONLY,if(lu_people_contact_route(mode,mesh_only)==4) 1 else 0);
+            if(mesh_only and (mode==3 or mode==2)){
+                lu_select_route(self,2);
+                lu_text(self,lu_get(self,106),card);
+                lu_dispatch(self,1);
+            }
+        }
+        lu_people_save_preference(self,mode);
+        lu_m2(lu_m0(lu_cls("NSUserDefaults"),lu_sel("standardUserDefaults")),lu_sel("setInteger:forKey:"),mode,lu_cf("T27PeopleRouteModeV2"));
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag==12 or tag==2 or tag==6 or tag==33 or tag==42 or tag==46 or tag==30){
+        if(lu_val(self,LP_HISTORY_ONLY)!=0){
+            lu_error(self,"This Mesh contact needs Auto or Mesh before sending or calling.");
+            return true;
+        }
+        const selected:u64=lu_val(self,2012);
+        const cards:u64=lu_get(self,2011);
+        if(selected==0 or selected>lu_m0(cards,lu_sel("count")) or lu_m1(lu_get(self,145),lu_sel("isEqualToString:"),lu_m1(lu_m1(cards,lu_sel("objectAtIndex:"),selected-1),lu_sel("objectForKey:"),lu_cf("identity")))%256==0){
+            lu_error(self,"Recipient changed. Select the intended contact before sending.");
+            return true;
+        }
+    }
+    if(tag==1 and lu_m0(lu_get(self,2011),lu_sel("count"))>=16){
+        const parts:u64=lu_m1(lu_string(self,lu_get(self,106)),lu_sel("componentsSeparatedByString:"),lu_cf("|"));
+        const key:u64=lu_m1(parts,lu_sel("objectAtIndex:"),0);
+        const cards:u64=lu_get(self,2011);
+        var found:bool=false;
+        var i:u64=0;
+        while(i<lu_m0(cards,lu_sel("count"))){
+            const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),i);
+            if(lu_m1(lu_m1(item,lu_sel("objectForKey:"),lu_cf("identity")),lu_sel("isEqualToString:"),key)%256!=0){
+                found=true;
+            }
+            i=i+1;
+        }
+        if(!found){
+            lu_error(self,"Contact book is full. Existing recipient preserved.");
+            return true;
+        }
+    }
+    if(tag==66){
+        lu_mark(self,2052,if(lu_val(self,2052)==0) 1 else 0);
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag==65){
+        lu_mark(self,2013,3);
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag==60 or tag==61 or tag==62 or tag==64){
+        lu_mark(self,2013,if(tag==62) if(lu_val(self,2013)==3) 2 else 0 else if(tag==60) 1 else if(tag==64) 4 else 2);
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag==63){
+        lu_m2(lu_get(self,2010),lu_sel("setObject:forKey:"),lu_string(self,lu_get(self,2021)),lu_cf("name"));
+        lu_people_write(self);
+        lu_people_layout(self);
+        return true;
+    }
+    if(tag>=100 and tag<116){
+        if(!lu_route_change_allowed(sc_state(lu_ctx(self),false),sc_state(lu_ctx(self),true),dn_state(lu_val(self,130),29),lu_val(self,140))){
+            lu_error(self,"Finish the current session before selecting another contact.");
+            lu_people_layout(self);
+            return true;
+        }
+        const cards:u64=lu_get(self,2011);
+        const index:u64=tag-100;
+        if(index>=lu_m0(cards,lu_sel("count"))){
+            return true;
+        }
+        const item:u64=lu_m1(cards,lu_sel("objectAtIndex:"),index);
+        const mode:u64=lu_m0(lu_m1(item,lu_sel("objectForKey:"),lu_cf("route")),lu_sel("unsignedLongLongValue"));
+        const saved_card:u64=lu_m1(item,lu_sel("objectForKey:"),lu_cf("card"));
+        const mesh_only:bool=lu_m1(saved_card,lu_sel("hasPrefix:"),lu_cf("t27m1"))%256!=0;
+        // A refused selection must not leave the previous recipient actionable.
