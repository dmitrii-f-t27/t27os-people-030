+            window!=0 and lu_bool_result(lu_m0(window,lu_sel("isVisible"))),
+            lu_bool_result(lu_m0(window,lu_sel("isMiniaturized"))),
+            lu_bool_result(lu_m0(app,lu_sel("isHidden"))),
+            scroll!=0 and !lu_bool_result(lu_m0(scroll,lu_sel("isHiddenOrHasHiddenAncestor")))
+        );
+        const panel:u64=lu_val(self,2013);
+        if(panel==5){
+            var rect:[4]f64=undefined;
