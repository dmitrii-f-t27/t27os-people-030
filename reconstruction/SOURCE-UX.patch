+// Never cut a UTF-16 surrogate pair or guess a grapheme for a complex name.
+// Unsupported composed initials use a neutral avatar marker instead.
+pub fn lu_people_initial_unit_safe(first:u64,next:u64)->bool {
+    const letter:bool=(first>=65 and first<=90) or (first>=97 and first<=122) or (first>=1040 and first<=1103) or first==1025 or first==1105;
+    return letter and !(next>=768 and next<=879) and next!=65039 and next!=8205;
+}
+fn lu_people_initial(name:u64)->u64 {
+    const length:u64=lu_m0(name,lu_sel("length"));
+    if(length==0){return lu_cf("?");}
+    const first:u64=lu_m1(name,lu_sel("characterAtIndex:"),0);
+    const next:u64=if(length>1) lu_m1(name,lu_sel("characterAtIndex:"),1) else 0;
+    return if(lu_people_initial_unit_safe(first,next)) lu_m1(name,lu_sel("substringToIndex:"),1) else lu_cf("?");
+}
+test complex_unicode_names_never_use_a_split_initial {
+    assert lu_people_initial_unit_safe(65,0);
+    assert lu_people_initial_unit_safe(1040,1085);
+    assert !lu_people_initial_unit_safe(55357,56832);
+    assert !lu_people_initial_unit_safe(101,769);
+    assert !lu_people_initial_unit_safe(65,8205);
+}
