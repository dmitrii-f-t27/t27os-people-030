+    const tn : usize = kc_get_n(P_GITHUB, 0, tok[0..256]);
+    if (tn == 0) {
+        prfh_wipe(tok[0..256]);
+        return PRF_E_CANCELLED;
+    }
+
+    var auth : [300]u8 = undefined;
+    prfh_wipe(auth[0..300]);
+    const alen : usize = prfh_bearer_value(tok[0..tn], auth[0..300]);
+    prfh_wipe(tok[0..256]);
+    if (alen == 0) {
+        prfh_wipe(auth[0..300]);
+        return PRF_E_UNREADABLE;
+    }
+
+    const api_cf : u64 = text_of(GHA_API_USER_URL);
+    if (api_cf == 0) {
+        prfh_wipe(auth[0..300]);
