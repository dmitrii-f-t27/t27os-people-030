+    assert cs_set(z, CS_K_JB_MAX, CBP_F_JB - CBP_F_TX - 1) and cs_g(z, CS_K_JB_MAX) == CBP_F_JB - CBP_F_TX - 1;
+    // switches are 0 or 1, the leave time at most an hour, the tone amplitude a 16-bit level
+    assert cs_set(z, CS_K_VIDEO, 2) == false and cs_set(z, CS_K_VIDEO, 1) and cs_g(z, CS_K_VIDEO) == 1;
+    assert cs_set(z, CS_K_GSTATS, 1) and cs_set(z, CS_K_GAUTO, 0);
+    assert cs_set(z, CS_K_GLEAVE_S, 3601) == false and cs_set(z, CS_K_GLEAVE_S, 3600);
+    assert cs_set(z, CS_K_TONE_AMP, 99) == false and cs_set(z, CS_K_TONE_AMP, 32768) == false;
+    assert cs_set(z, CS_K_TONE_AMP, 100) and cs_set(z, CS_K_TONE_AMP, 32767) and cs_g(z, CS_K_TONE_AMP) == 32767;
+    assert cs_set(z, CS_K_VDROP, 4294967296) == false and cs_set(z, CS_K_VLIMIT, 4294967295);
+    // a slot that is not a tunable is never written through cs_set
+    assert cs_set(z, CS_ST_SENT, 5) == false and cs_set(z, CS_MAGIC, 0) == false and cs_set(z, 60, 1) == false;
+    // the H.264 loss aid takes a count of parts; the codec blocks are never a tunable
+    assert cs_set(z, CS_K_VHLOSS, 200) and cs_set(z, CS_K_VHENC, 5) == false and cs_set(z, CS_K_VHDEC, 5) == false;
+    assert cs_g(z, CS_MAGIC) == CS_MAGIC_V;
+    // while media flows nothing changes
+    z[1] = @as(u8, @intCast(CK_ACTIVE));
+    assert cs_set(z, CS_K_CALLING_MS, 2000) == false and cs_g(z, CS_K_CALLING_MS) == 1000;
