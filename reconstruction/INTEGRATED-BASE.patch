+test build_7136_and_this_build_read_each_others_parts {
+    var src : [5000]u8 = undefined;
+    t_fill(src[0..5000], 11);
+    var st : [256]u8 = undefined;
+    var buf : [131072]u8 = undefined;
+    var pt : [1176]u8 = undefined;
+    // a version 2 sender (7136) cuts at 1160: five parts of 5000 bytes, put together here byte for byte
+    va_reset(st[0..256]);
+    var k : usize = 0;
+    var v : u32 = VH_NO;
+    while (k < vh_parts_of(5000, VH_PART_V2)) {
+        const c : usize = vh_cut_of(5000, k, VH_PART_V2);
+        const len : usize = vh_part_v(pt[0..1176], 3, 5000, k, true, 0, VH_V2, src[k * 1160..k * 1160 + c]);
+        assert len == VH_HDR + c and vh_ok(pt[0..len]) and pt[14] == VH_V2;
+        v = vh_take(st[0..256], buf[0..131072], pt[0..len], 1);
+        k = k + 1;
+    }
+    assert v == VH_COMPLETE and buf[4639] == src[4639] and buf[1160] == src[1160];
+    // this build sends a 7136 peer version 2 parts, any other peer (or none heard yet) version 3
+    assert vh_send_ver(2) == VH_V2 and vh_send_ver(3) == VH_VERSION and vh_send_ver(9) == VH_VERSION and vh_send_ver(0) == VH_VERSION;
+    // a version 3 part of 1148 is never taken for a version 2 one, nor the other way round
+    const p3 : usize = vh_part_v(pt[0..1176], 4, 5000, 0, false, 0, VH_VERSION, src[0..1148]);
+    assert p3 == VH_HDR + 1148 and vh_ok(pt[0..p3]);
+    pt[14] = VH_V2;
+    assert !vh_ok(pt[0..p3]);
+}
diff --git a/specs/t27os/call_ip6.t27 b/specs/t27os/call_ip6.t27
new file mode 100644
index 000000000..0dde9e45d
--- /dev/null
+++ b/specs/t27os/call_ip6.t27
@@ -0,0 +1,922 @@
+// SPDX-License-Identifier: Apache-2.0
+// specs/t27os/call_ip6.t27 -- calls over IPv6, one to one, between two homes and with no server of ours (owner,
+// 2026-10-23: "calls over the internet go direct over IPv6, without NAT"; Refs dmitrii-f-t27/t27#13,
+// gHashTag/t27#11560). Pure decisions only: no @extern, no socket, no clock. call_session.t27 moves the bytes on one
+// dual-stack socket; glass_window.t27 shows the address, takes the typed one and punches.
+//
+// Why: most homes and phones now have a global IPv6 address of their own. There is no NAT on it, so a friend can be
+// called at "[address]:port" with no port forwarding and no STUN. Two things still stand in the way: a home router
+// drops a datagram nobody inside asked for (a stateful firewall, as a NAT does), and an IPv6 router never cuts a
+// datagram that is too big for the next link: it drops it. Both are handled here.
+//
+// 1. The endpoint. Every address of a call is 18 bytes: the 16 bytes of an IPv6 address and the port, big-endian. An
+//    IPv4 address is the v4-mapped one, ::ffff:a.b.c.d (RFC 4291 section 2.5.5.2), which is what a dual-stack socket
+//    gives for an IPv4 sender (ip6_ep_v4, ip6_mapped, ip6_v4of). The IPv4 rules of call_view.t27 (cv_dial_decide) and
+//    call_nat.t27 (cn_punch_ok) still decide every v4-mapped endpoint, unchanged.
+// 2. The text. The CALL field and T27OS_PUNCH take "a.b.c.d", "a.b.c.d:port", "[v6]", "[v6]:port" or a bare v6
+//    ("3ffe:18::1", no port: the default one). A v6 is 1..8 groups of 1..4 hex digits with at most one "::"; a scope
+//    ("%en0") and a dotted tail ("::ffff:1.2.3.4") are refused, and so is any v4-mapped address typed as a v6: an IPv4
+//    friend is typed as an IPv4 (ip6_parse). The panels print RFC 5952 text: lower case, no leading zeros, the longest
+//    run of two or more zero groups (the first of equal ones) as "::", brackets around it before the port (ip6_text).
+// 3. Which IPv6 is called (ip6_class, ip6_dial_decide). A global unicast address (2000::/3) is called only when the
+//    person typed it and pressed ALLOW for that very address and port, or with T27OS_ALLOW_PUBLIC=1: the rule of a
+//    public IPv4. A unique local address (fc00::/7) is this home's network and is called as a private IPv4 is.
+//    Never: the unspecified address, multicast (ff00::/8), link-local (fe80::/10: this slice has no scope ids),
+//    v4-mapped used as an IPv6 peer, documentation (2001:db8::/32, 3fff::/20), 6to4 (2002::/16), Teredo (2001::/32)
+//    and the rest of the IETF protocol block 2001::/23, and anything outside 2000::/3 and fc00::/7. The loopback ::1
+//    only for a test (T27OS_QA=1). An INVITE over IPv6 is taken only from an address a call may go back to
+//    (ip6_from_ok): global or unique local, ::1 for a test. A probe target follows the dial rule (ip6_punch_ok).
+// 4. Size (ip6_room). The IPv6 minimum link MTU is 1280 (RFC 8200 section 5); less the 40-byte header and the 8-byte UDP
+//    header, IP6_UDP_MAX = 1232 bytes is what a datagram may carry on every IPv6 path. Every datagram to a native v6
+//    endpoint fits it: the sealed audio frame with its redundant copy (1996 bytes) does not, so over IPv6 the copy of
+//    the frame before goes as a datagram of its own (ip6_audio_split; each 52 + 968 + 16 = 1036 bytes); a JPEG part
+//    (1080), a group part, a chat part (788), a probe (16), the handshake and the H.264 part of call_h264.t27 must fit
+//    too (call_session.t27 asserts the sizes). A v4-mapped endpoint keeps the IPv4 path as it was: IPv4 routers cut a
+//    datagram, and the receive buffer is IP6_V4_UDP_MAX.
+// 5. The family a call uses (ip6_fam): "v4" on an IPv4 socket, "v4-mapped" for an IPv4 friend on the dual-stack
+//    socket, "v6" for a native IPv6 friend. The CALL panel and CALLSTAT say which.
+// 6. This device's own address (ip6_own_rank): the address a friend is given is read from the interfaces, no STUN: a
+//    global unicast address of an interface that is up and running, not a loopback and not a point-to-point tunnel
+//    (a VPN), not anycast, tentative, duplicated, detached, deprecated, optimistic or the one kept for 464XLAT
+//    (CLAT46); a stable secured one first (RFC 7217), then any stable one, then a temporary one. The call socket
+//    prefers the stable address as its source (IPV6_PREFER_TEMPADDR = 0), so the address shown is the one the friend
+//    sees.
+// 7. Firewalls. A home router lets an IPv6 datagram in only to an address and port that sent toward its sender a moment
+//    before. The punch of call_nat.t27 (16-byte probes, fast for 3 s, then once a second to 30 s) goes to a v6
+//    endpoint the same way: the caller punches when it dials a public IPv6, the callee is told the caller's address
+//    (the test aid T27OS_PUNCH=[v6]:port, QA only). Nothing about an address is written to a file.
+// 8. On this network IPv4 comes first (ip6_prefer): a friend whose mDNS announcement is fresh is called at its IPv4
+//    address there; an IPv6 endpoint is used only when there is no fresh announcement (a friend in another home).
+// Flat namespace (the window build splices imported modules): every name here starts with ip6_ / IP6_.
+module T27osCallIp6;
+use std::text::hex_value;
+use std::mem::bytes_eq_prefix;
+
+use t27os::call_view::cv_parse_addr;
+use t27os::call_view::cv_addr_ip;
+use t27os::call_view::cv_addr_port;
+use t27os::call_view::cv_addr_text;
+use t27os::call_view::cv_dial_decide;
+use t27os::call_view::CV_D_OK;
+use t27os::call_view::CV_D_ASK;
+use t27os::call_view::CV_D_NO;
+use t27os::call_view::CV_PORT;
+use t27os::call_nat::cn_punch_ok;
+use t27os::session_store::put_dec;
+use t27os::session_store::put_bytes;
+
+// ---------------------------------------------------------------- 1. the endpoint
+
+/// 16 bytes of address, 2 of port (big-endian).
+pub const IP6_EP : usize = 18;
+/// "[ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff]:65535"
+pub const IP6_TEXT_MAX : usize = 47;
+/// sockaddr_in6 and sockaddr_in on macOS (sin6_len first), and their families.
+pub const IP6_SA6 : usize = 28;
+pub const IP6_SA4 : usize = 16;
+pub const IP6_AF_INET : u8 = 2;
+pub const IP6_AF_INET6 : u8 = 30;
+
+pub fn ip6_port(ep: []const u8) -> u64 {
+    if (ep.len < IP6_EP) { return 0; }
+    return (@as(u64, ep[16]) << 8) | @as(u64, ep[17]);
+}
+
+fn ip6_put_port(ep: []u8, port: u64) -> void {
+    ep[16] = @as(u8, @intCast((port >> 8) & 255));
+    ep[17] = @as(u8, @intCast(port & 255));
+}
+
+pub fn ip6_clear(ep: []u8) -> void {
+    var i : usize = 0;
+    while (i < IP6_EP and i < ep.len) {
+        ep[i] = 0;
+        i = i + 1;
+    }
+}
+
+/// Any byte of the endpoint set (an all-zero one is "none").
+pub fn ip6_is_set(ep: []const u8) -> bool {
+    if (ep.len < IP6_EP) { return false; }
+    var i : usize = 0;
+    while (i < IP6_EP) {
+        if (ep[i] != 0) { return true; }
+        i = i + 1;
+    }
+    return false;
+}
+
+pub fn ip6_same(a: []const u8, b: []const u8) -> bool {
+    if (a.len < IP6_EP or b.len < IP6_EP) { return false; }
+    var i : usize = 0;
+    while (i < IP6_EP) {
+        if (a[i] != b[i]) { return false; }
+        i = i + 1;
+    }
+    return true;
+}
+
+pub fn ip6_copy(dst: []u8, src: []const u8) -> bool {
+    if (dst.len < IP6_EP or src.len < IP6_EP) { return false; }
+    var i : usize = 0;
+    while (i < IP6_EP) {
+        dst[i] = src[i];
+        i = i + 1;
+    }
+    return true;
+}
+
+/// The v4-mapped endpoint ::ffff:a.b.c.d of ip (a<<24|b<<16|c<<8|d) and port. False (nothing written) when out is short
+/// or the numbers are out of range.
+pub fn ip6_ep_v4(ip: u64, port: u64, ep: []u8) -> bool {
+    if (ep.len < IP6_EP or ip > 4294967295 or port > 65535) { return false; }
+    var i : usize = 0;
+    while (i < 10) {
+        ep[i] = 0;
+        i = i + 1;
+    }
+    ep[10] = 255;
+    ep[11] = 255;
+    ep[12] = @as(u8, @intCast((ip >> 24) & 255));
+    ep[13] = @as(u8, @intCast((ip >> 16) & 255));
+    ep[14] = @as(u8, @intCast((ip >> 8) & 255));
+    ep[15] = @as(u8, @intCast(ip & 255));
+    ip6_put_port(ep, port);
+    return true;
+}
+
+/// The address is v4-mapped (::ffff:0:0/96).
+pub fn ip6_mapped(ep: []const u8) -> bool {
+    if (ep.len < 16) { return false; }
+    var i : usize = 0;
+    while (i < 10) {
+        if (ep[i] != 0) { return false; }
+        i = i + 1;
+    }
+    return ep[10] == 255 and ep[11] == 255;
+}
+
+/// A v4-mapped endpoint as ip * 65536 + port (the form of call_view and call_nat); 0 for anything else.
+pub fn ip6_v4of(ep: []const u8) -> u64 {
+    if (ep.len < IP6_EP or !ip6_mapped(ep)) { return 0; }
+    const ip : u64 = (@as(u64, ep[12]) << 24) | (@as(u64, ep[13]) << 16) | (@as(u64, ep[14]) << 8) | @as(u64, ep[15]);
+    return ip * 65536 + ip6_port(ep);
+}
+
+// ---------------------------------------------------------------- 2. the text
+
+/// A character the CALL field takes: a hex digit, a dot, a colon or a bracket.
+pub fn ip6_addr_char(cp: u32) -> bool {
+    return (cp >= 48 and cp <= 58) or cp == 46 or (cp >= 65 and cp <= 70) or (cp >= 97 and cp <= 102) or cp == 91 or cp == 93;
+}
+
+fn ip6_hexv(c: u8) -> u64 {
+    const v : i32 = hex_value(c);
+    if (v < 0) { return 16; }
+    return @as(u64, @intCast(v));
+}
+
+/// The IPv6 text t[a..b] (no brackets, no port) into out[0..16]. False for anything that is not 1..8 groups of 1..4
+/// hex digits with at most one "::" (a group count of 8 exactly without one, at most 7 with one); a dot, a scope or a
+/// stray colon is refused.
+pub fn ip6_parse_addr(t: []const u8, a: usize, b: usize, out: []u8) -> bool {
+    if (b <= a or b > t.len or b - a > 39 or out.len < 16) { return false; }
+    var grp : [8]u64 = undefined;
+    var ng : usize = 0;
+    var dc : usize = 99;
+    var i : usize = a;
+    if (t[i] == 58) {
+        if (i + 1 >= b or t[i + 1] != 58) { return false; }
+        dc = 0;
+        i = i + 2;
+    }
+    while (i < b) {
+        var v : u64 = 0;
+        var d : u32 = 0;
+        while (i < b and ip6_hexv(t[i]) < 16) {
+            v = v * 16 + ip6_hexv(t[i]);
+            d = d + 1;
+            if (d > 4) { return false; }
+            i = i + 1;
+        }
+        if (d == 0 or ng == 8) { return false; }
+        grp[ng] = v;
+        ng = ng + 1;
+        if (i == b) { break; }
+        if (t[i] != 58) { return false; }
+        i = i + 1;
+        if (i == b) { return false; }
+        if (t[i] == 58) {
+            if (dc != 99) { return false; }
+            dc = ng;
+            i = i + 1;
+        }
+    }
+    if (dc == 99 and ng != 8) { return false; }
+    if (dc != 99 and ng > 7) { return false; }
+    var k : usize = 0;
+    while (k < 16) {
+        out[k] = 0;
+        k = k + 1;
+    }
+    var head : usize = ng;
+    if (dc != 99) { head = dc; }
+    k = 0;
+    while (k < ng) {
+        var slot : usize = k;
+        if (k >= head) { slot = 8 - (ng - k); }
+        out[2 * slot] = @as(u8, @intCast((grp[k] >> 8) & 255));
+        out[2 * slot + 1] = @as(u8, @intCast(grp[k] & 255));
+        k = k + 1;
+    }
+    return true;
+}
+
+/// The digits t[a..b] as a port 1..65535; 0 when they are not one.
+fn ip6_port_text(t: []const u8, a: usize, b: usize) -> u64 {
+    if (b <= a or b - a > 5) { return 0; }
+    var p : u64 = 0;
+    var i : usize = a;
+    while (i < b) {
+        if (t[i] < 48 or t[i] > 57) { return 0; }
+        p = p * 10 + @as(u64, t[i] - 48);
+        i = i + 1;
+    }
+    if (p > 65535) { return 0; }
+    return p;
+}
+
+/// The typed address t[0..n] as an endpoint: "a.b.c.d[:port]" (call_view cv_parse_addr, v4-mapped), "[v6][:port]" or a
+/// bare v6 (two colons or more, no port). The port is CV_PORT when none is typed. False (ep untouched) when it is not
+/// one of those shapes, or a v6 text names a v4-mapped address.
+pub fn ip6_parse(t: []const u8, n: usize, ep: []u8) -> bool {
+    if (n == 0 or n > IP6_TEXT_MAX or n > t.len or ep.len < IP6_EP) { return false; }
+    var a : [16]u8 = undefined;
+    var port : u64 = CV_PORT;
+    if (t[0] == 91) {
+        var j : usize = 1;
+        while (j < n and t[j] != 93) { j = j + 1; }
+        if (j == n or !ip6_parse_addr(t, 1, j, a[0..16])) { return false; }
+        if (j + 1 < n) {
+            if (t[j + 1] != 58) { return false; }
+            port = ip6_port_text(t, j + 2, n);
+            if (port == 0) { return false; }
+        }
+    } else {
+        var colons : u32 = 0;
+        var i : usize = 0;
+        while (i < n) {
+            if (t[i] == 58) { colons = colons + 1; }
+            i = i + 1;
+        }
+        if (colons < 2) {
+            const v : u64 = cv_parse_addr(t, n);
+            if (v == 0) { return false; }
+            return ip6_ep_v4(cv_addr_ip(v), cv_addr_port(v), ep);
+        }
+        if (!ip6_parse_addr(t, 0, n, a[0..16])) { return false; }
+    }
+    if (ip6_mapped(a[0..16])) { return false; }
+    var k : usize = 0;
+    while (k < 16) {
+        ep[k] = a[k];
+        k = k + 1;
+    }
+    ip6_put_port(ep, port);
+    return true;
+}
+
+fn ip6_put_hex(out: []u8, at: usize, v: u64) -> usize {
+    var n : usize = at;
+    var started : bool = false;
+    var sh : u64 = 12;
+    while (true) {
+        const d : u64 = (v >> sh) & 15;
+        if (d != 0 or started or sh == 0) {
+            if (d < 10) { out[n] = @as(u8, @intCast(48 + d)); } else { out[n] = @as(u8, @intCast(87 + d)); }
+            n = n + 1;
+            started = true;
+        }
+        if (sh == 0) { break; }
+        sh = sh - 4;
+    }
+    return n;
+}
+
+/// RFC 5952 text of the 16-byte address a (no brackets): at most 39 bytes into out (at least 39); the length.
+pub fn ip6_addr_text(a: []const u8, out: []u8) -> usize {
+    if (a.len < 16 or out.len < 39) { return 0; }
+    var g : [8]u64 = undefined;
+    var k : usize = 0;
+    while (k < 8) {
+        g[k] = (@as(u64, a[2 * k]) << 8) | @as(u64, a[2 * k + 1]);
+        k = k + 1;
+    }
+    // the longest run of zero groups, the first of equal ones; a single zero group is not shortened
+    var bs : usize = 8;
+    var bl : usize = 0;
+    k = 0;
+    while (k < 8) {
+        if (g[k] == 0) {
+            var e : usize = k;
+            while (e < 8 and g[e] == 0) { e = e + 1; }
+            if (e - k > bl) {
+                bs = k;
+                bl = e - k;
+            }
+            k = e;
+        } else {
+            k = k + 1;
+        }
+    }
+    if (bl < 2) { bs = 8; }
+    var n : usize = 0;
+    var colon : bool = false;
+    k = 0;
+    while (k < 8) {
+        if (k == bs) {
+            n = put_bytes(out, n, "::");
+            colon = false;
+            k = k + bl;
+        } else {
+            if (colon) { n = put_bytes(out, n, ":"); }
+            n = ip6_put_hex(out, n, g[k]);
+            colon = true;
+            k = k + 1;
+        }
+    }
+    return n;
+}
+
+/// The endpoint as the panels print it: "a.b.c.d:port" for a v4-mapped one, "[v6]:port" otherwise. out: at least
+/// IP6_TEXT_MAX bytes; the length (0 when out is short).
+pub fn ip6_text(ep: []const u8, out: []u8) -> usize {
+    if (ep.len < IP6_EP or out.len < IP6_TEXT_MAX) { return 0; }
+    if (ip6_mapped(ep)) {
+        const v : u64 = ip6_v4of(ep);
+        return cv_addr_text(cv_addr_ip(v), cv_addr_port(v), out);
+    }
+    var n : usize = put_bytes(out, 0, "[");
+    n = n + ip6_addr_text(ep, out[n..out.len]);
+    n = put_bytes(out, n, "]:");
+    return put_dec(out, n, ip6_port(ep));
+}
+
+// ---------------------------------------------------------------- 3. which IPv6 is called
+
+pub const IP6_C_BAD : u32 = 0;
+pub const IP6_C_GLOBAL : u32 = 1;
+pub const IP6_C_ULA : u32 = 2;
+pub const IP6_C_LINKLOCAL : u32 = 3;
+pub const IP6_C_LOOPBACK : u32 = 4;
+pub const IP6_C_UNSPEC : u32 = 5;
+pub const IP6_C_MULTICAST : u32 = 6;
+pub const IP6_C_MAPPED : u32 = 7;
+pub const IP6_C_DOC : u32 = 8;
+pub const IP6_C_6TO4 : u32 = 9;
+pub const IP6_C_TEREDO : u32 = 10;
+pub const IP6_C_IETF : u32 = 11;
+
+/// What kind of IPv6 the 16 bytes at a[0..16] are (section 3 of the header).
+pub fn ip6_class(a: []const u8) -> u32 {
+    if (a.len < 16) { return IP6_C_BAD; }
+    var z : usize = 0;
+    while (z < 15 and a[z] == 0) { z = z + 1; }
+    if (z == 15 and a[15] == 0) { return IP6_C_UNSPEC; }
+    if (z == 15 and a[15] == 1) { return IP6_C_LOOPBACK; }
+    if (ip6_mapped(a)) { return IP6_C_MAPPED; }
+    if (a[0] == 255) { return IP6_C_MULTICAST; }
+    if (a[0] == 254 and (a[1] & 192) == 128) { return IP6_C_LINKLOCAL; }
+    if ((a[0] & 254) == 252) { return IP6_C_ULA; }
+    if (a[0] == 32 and a[1] == 1 and a[2] == 13 and a[3] == 184) { return IP6_C_DOC; }
+    if (a[0] == 63 and a[1] == 255 and (a[2] & 240) == 0) { return IP6_C_DOC; }
+    if (a[0] == 32 and a[1] == 1 and a[2] == 0 and a[3] == 0) { return IP6_C_TEREDO; }
+    if (a[0] == 32 and a[1] == 1 and (a[2] & 254) == 0) { return IP6_C_IETF; }
+    if (a[0] == 32 and a[1] == 2) { return IP6_C_6TO4; }
+    if ((a[0] & 224) == 32) { return IP6_C_GLOBAL; }
+    return IP6_C_BAD;
+}
+
+/// The decision on endpoint ep (CV_D_OK, CV_D_ASK or CV_D_NO) without spending anything. env: T27OS_ALLOW_PUBLIC=1;
+/// consent: the one endpoint ALLOW was pressed for (an empty or all-zero slice = none); qa: T27OS_QA=1 (::1 only
+/// then). A v4-mapped endpoint is decided by the IPv4 rule of call_view (cv_dial_decide).
+pub fn ip6_dial_decide(ep: []const u8, env: bool, consent: []const u8, qa: bool) -> u32 {
+    if (ep.len < IP6_EP or ip6_port(ep) == 0) { return CV_D_NO; }
+    if (ip6_mapped(ep)) {
+        var cv : u64 = 0;
+        if (consent.len >= IP6_EP and ip6_mapped(consent)) { cv = ip6_v4of(consent); }
+        return cv_dial_decide(ip6_v4of(ep), env, cv);
+    }
+    const k : u32 = ip6_class(ep);
+    if (k == IP6_C_ULA) { return CV_D_OK; }
+    if (k == IP6_C_LOOPBACK) {
+        if (qa) { return CV_D_OK; }
+        return CV_D_NO;
+    }
+    if (k != IP6_C_GLOBAL) { return CV_D_NO; }
+    if (env or ip6_same(consent, ep)) { return CV_D_OK; }
+    return CV_D_ASK;
+}
+
+/// An endpoint ALLOW is offered for: a public IPv4 or a global IPv6 with a port.
+pub fn ip6_askable(ep: []const u8) -> bool {
+    return ip6_dial_decide(ep, false, ep[0..0], false) == CV_D_ASK;
+}
+
+/// ALLOW pressed for ep: the consent (18 bytes) becomes ep when ALLOW is offered for it; otherwise nothing changes.
+pub fn ip6_allow(consent: []u8, ep: []const u8) -> bool {
+    if (consent.len < IP6_EP or !ip6_askable(ep)) { return false; }
+    return ip6_copy(consent, ep);
+}
+
+/// One dial: the decision, and the consent is spent (cleared) by any dial, as call_view cv_dial_step.
+pub fn ip6_dial_step(consent: []u8, ep: []const u8, env: bool, qa: bool) -> u32 {
+    const d : u32 = ip6_dial_decide(ep, env, consent, qa);
+    ip6_clear(consent);
+    return d;
+}
+
+/// The row under the debug CALL (call_view cv_pub_row): 0 none, 1 "public address -- allow?", 2 allowed.
+pub fn ip6_pub_row(ep: []const u8, env: bool, consent: []const u8) -> u32 {
+    if (!ip6_askable(ep)) { return 0; }
+    if (ip6_dial_decide(ep, env, consent, false) == CV_D_OK) { return 2; }
+    return 1;
+}
+
+/// An INVITE from sender ep may be answered: an IPv4 sender as before (any; the call still rings and checks the key),
+/// a native IPv6 sender only from an address a call may go back to: global or unique local, ::1 for a test.
+pub fn ip6_from_ok(ep: []const u8, qa: bool) -> bool {
+    if (ep.len < IP6_EP or ip6_port(ep) == 0) { return false; }
+    if (ip6_mapped(ep)) { return true; }
+    const k : u32 = ip6_class(ep);
+    return k == IP6_C_GLOBAL or k == IP6_C_ULA or (qa and k == IP6_C_LOOPBACK);
+}
+
+/// A probe may go to ep: an IPv4 by call_nat cn_punch_ok, an IPv6 that is global or unique local (::1 for a test).
+pub fn ip6_punch_ok(ep: []const u8, qa: bool) -> bool {
+    if (ep.len < IP6_EP) { return false; }
+    if (ip6_mapped(ep)) { return cn_punch_ok(ip6_v4of(ep)); }
+    return ip6_from_ok(ep, qa);
+}
+
+// ---------------------------------------------------------------- 4. size
+
+/// The IPv6 minimum MTU (RFC 8200 section 5) less 40 bytes of IPv6 header and 8 of UDP.
+pub const IP6_MTU_MIN : usize = 1280;
+pub const IP6_UDP_MAX : usize = 1232;
+/// A v4-mapped endpoint: the IPv4 path as before (routers cut a datagram), up to the call socket's receive buffer.
+pub const IP6_V4_UDP_MAX : usize = 2048;
+
+/// The most a datagram to ep may carry.
+pub fn ip6_room(ep: []const u8) -> usize {
+    if (ep.len >= IP6_EP and !ip6_mapped(ep)) { return IP6_UDP_MAX; }
+    return IP6_V4_UDP_MAX;
+}
+
+pub fn ip6_fits(ep: []const u8, n: usize) -> bool { return n <= ip6_room(ep); }
+
+/// The audio frame and its redundant copy (sealed `both` bytes) do not fit one datagram to ep: the copy goes alone.
+pub fn ip6_audio_split(ep: []const u8, both: usize) -> bool { return !ip6_fits(ep, both); }
+
+// ---------------------------------------------------------------- 5. the family in use
+
+pub const IP6_F_NONE : u32 = 0;
+pub const IP6_F_V4 : u32 = 1;
+pub const IP6_F_V6 : u32 = 2;
+pub const IP6_F_MAPPED : u32 = 3;
+
+/// The family of a call with ep on an IPv6 socket (sock6) or an IPv4 one.
+pub fn ip6_fam(sock6: bool, ep: []const u8) -> u32 {
+    if (!ip6_is_set(ep)) { return IP6_F_NONE; }
+    if (!ip6_mapped(ep)) { return IP6_F_V6; }
+    if (sock6) { return IP6_F_MAPPED; }
+    return IP6_F_V4;
+}
+
+pub fn ip6_fam_word(f: u32) -> str {
+    if (f == IP6_F_V4) { return "v4"; }
+    if (f == IP6_F_V6) { return "v6"; }
+    if (f == IP6_F_MAPPED) { return "v4-mapped"; }
+    return "";
+}
+
+// ---------------------------------------------------------------- 6. sockaddr
+
+/// The sockaddr_in6 of ep (28 bytes: length, AF_INET6, port, flow 0, address, scope 0); its length, 0 when out is short.
+pub fn ip6_sa6(ep: []const u8, out: []u8) -> usize {
+    if (ep.len < IP6_EP or out.len < IP6_SA6) { return 0; }
+    var i : usize = 0;
+    while (i < IP6_SA6) {
+        out[i] = 0;
+        i = i + 1;
+    }
+    out[0] = 28;
+    out[1] = IP6_AF_INET6;
+    out[2] = ep[16];
+    out[3] = ep[17];
+    i = 0;
+    while (i < 16) {
+        out[8 + i] = ep[i];
+        i = i + 1;
+    }
+    return IP6_SA6;
+}
+
+/// The sockaddr_in of a v4-mapped ep (16 bytes); 0 when ep is not v4-mapped or out is short.
+pub fn ip6_sa4(ep: []const u8, out: []u8) -> usize {
+    if (ep.len < IP6_EP or out.len < IP6_SA4 or !ip6_mapped(ep)) { return 0; }
+    var i : usize = 0;
+    while (i < IP6_SA4) {
+        out[i] = 0;
+        i = i + 1;
+    }
+    out[0] = 16;
+    out[1] = IP6_AF_INET;
+    out[2] = ep[16];
+    out[3] = ep[17];
+    out[4] = ep[12];
+    out[5] = ep[13];
+    out[6] = ep[14];
+    out[7] = ep[15];
+    return IP6_SA4;
+}
+
+/// The sockaddr a socket of that family sends to: sockaddr_in6 on the dual-stack socket, sockaddr_in on an IPv4 one
+/// (0 for a native IPv6 ep there: an IPv4 socket cannot reach it).
+pub fn ip6_sa_for(sock6: bool, ep: []const u8, out: []u8) -> usize {
+    if (sock6) { return ip6_sa6(ep, out); }
+    return ip6_sa4(ep, out);
+}
+
+/// The sender recvfrom gave (n bytes of sockaddr) as an endpoint: AF_INET (16 bytes or more) or AF_INET6 (28). False
+/// for any other family or a short one; a v4-mapped AF_INET6 sender reads as the IPv4 it is.
+pub fn ip6_sa_take(sa: []const u8, n: usize, ep: []u8) -> bool {
+    if (ep.len < IP6_EP or n > sa.len) { return false; }
+    if (n >= IP6_SA4 and sa[1] == IP6_AF_INET) {
+        const ip : u64 = (@as(u64, sa[4]) << 24) | (@as(u64, sa[5]) << 16) | (@as(u64, sa[6]) << 8) | @as(u64, sa[7]);
+        return ip6_ep_v4(ip, (@as(u64, sa[2]) << 8) | @as(u64, sa[3]), ep);
+    }
+    if (n < IP6_SA6 or sa[1] != IP6_AF_INET6) { return false; }
+    var i : usize = 0;
+    while (i < 16) {
+        ep[i] = sa[8 + i];
+        i = i + 1;
+    }
+    ep[16] = sa[2];
+    ep[17] = sa[3];
+    return true;
+}
+
+/// Where the dual-stack call socket is bound: 0 (every interface) is ::; any other IPv4 is its v4-mapped address.
+/// call_session opens the dual-stack socket only for 0 (cs_dual_stack): T27OS_CALL_BIND=127.0.0.1 is an IPv4 socket,
+/// as before. Into a sockaddr_in6; its length.
+pub fn ip6_bind_sa(bind_ip: u64, port: u64, out: []u8) -> usize {
+    if (bind_ip > 4294967295 or port > 65535) { return 0; }
+    var ep : [18]u8 = undefined;
+    ip6_clear(ep[0..18]);
+    if (bind_ip != 0) { ip6_ep_v4(bind_ip, port, ep[0..18]); } else { ip6_put_port(ep[0..18], port); }
+    return ip6_sa6(ep[0..18], out);
+}
+
+// ---------------------------------------------------------------- 7. this device's own address
+
+/// SIOCGIFAFLAG_IN6 flags (netinet6/in6_var.h) and the interface flags (net/if.h) the rank reads.
+pub const IP6_IFF_ANYCAST : u64 = 1;
+pub const IP6_IFF_TENTATIVE : u64 = 2;
+pub const IP6_IFF_DUPLICATED : u64 = 4;
+pub const IP6_IFF_DETACHED : u64 = 8;
+pub const IP6_IFF_DEPRECATED : u64 = 16;
+pub const IP6_IFF_TEMPORARY : u64 = 128;
+pub const IP6_IFF_OPTIMISTIC : u64 = 512;
+pub const IP6_IFF_SECURED : u64 = 1024;
+pub const IP6_IFF_CLAT46 : u64 = 4096;
+pub const IP6_IF_UP : u64 = 1;
+pub const IP6_IF_LOOPBACK : u64 = 8;
+pub const IP6_IF_P2P : u64 = 16;
+pub const IP6_IF_RUNNING : u64 = 64;
+
+/// How good the address a (16 bytes, flags af, its interface's flags iff) is to give a friend: 0 not at all, 1 a
+/// temporary one, 2 a stable one, 3 a stable secured one. The window keeps the first of the highest. An anycast
+/// address is never one: it names a group of hosts, and no datagram is sent from it.
+pub fn ip6_own_rank(a: []const u8, af: u64, iff: u64) -> u32 {
+    if ((iff & IP6_IF_UP) == 0 or (iff & IP6_IF_RUNNING) == 0 or (iff & IP6_IF_LOOPBACK) != 0 or (iff & IP6_IF_P2P) != 0) { return 0; }
+    if (ip6_class(a) != IP6_C_GLOBAL) { return 0; }
+    const bad : u64 = IP6_IFF_ANYCAST | IP6_IFF_TENTATIVE | IP6_IFF_DUPLICATED | IP6_IFF_DETACHED | IP6_IFF_DEPRECATED | IP6_IFF_OPTIMISTIC | IP6_IFF_CLAT46;
+    if ((af & bad) != 0) { return 0; }
+    if ((af & IP6_IFF_TEMPORARY) != 0) { return 1; }
+    if ((af & IP6_IFF_SECURED) != 0) { return 3; }
+    return 2;
+}
+
+// ---------------------------------------------------------------- 8. IPv4 on this network first
+
+pub const IP6_P_NONE : u32 = 0;
+pub const IP6_P_V4 : u32 = 1;
+pub const IP6_P_V6 : u32 = 2;
+
+/// Where to reach a friend: its IPv4 on this network while its announcement is fresh (lan, ip * 65536 + port), else an
+/// IPv6 endpoint v6 that may be called (global or unique local), else nowhere.
+pub fn ip6_prefer(lan: u64, lan_fresh: bool, v6: []const u8) -> u32 {
+    if (lan_fresh and lan != 0) { return IP6_P_V4; }
+    if (ip6_is_set(v6) and !ip6_mapped(v6) and ip6_from_ok(v6, false)) { return IP6_P_V6; }
+    return IP6_P_NONE;
+}
+
+// ---------------------------------------------------------------- tests
+
+fn ip6_eq(a: []const u8, n: usize, s: []const u8) -> bool {
+    return n == s.len and bytes_eq_prefix(a, s, n);
+}
+
+/// Parse s and print it back.
+fn ip6_round(s: []const u8, out: []u8) -> usize {
+    var ep : [18]u8 = undefined;
+    if (!ip6_parse(s, s.len, ep[0..18])) { return 0; }
+    return ip6_text(ep[0..18], out);
+}
+
+fn ip6_ep_of(s: []const u8, ep: []u8) -> bool { return ip6_parse(s, s.len, ep); }
+
