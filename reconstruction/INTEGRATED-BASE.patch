+    var t : [1500]u8 = undefined;
+    t_fill(t[0..1500], 1500, 5);
+    assert cl_out_add(la[0..T_LOG], t[0..1500], 20) == 2;
+    const ord : [4]u32 = [1, 1, 2, 0];
+    assert t_carry(la[0..T_LOG], 1, lb[0..T_LOG], asm[0..CA_LEN], ord[0..2]) == CH_RX_DUP;
+    assert t_carry(la[0..T_LOG], 1, lb[0..T_LOG], asm[0..CA_LEN], ord[2..3]) == CH_RX_PART;
+    assert cl_count(lb[0..T_LOG]) == 1;
+    assert t_carry(la[0..T_LOG], 1, lb[0..T_LOG], asm[0..CA_LEN], ord[3..4]) == CH_RX_NEW;
+    assert cl_count(lb[0..T_LOG]) == 2;
+    assert cl_len(lb[0..T_LOG], 1) == 1500;
+    assert cl_text(lb[0..T_LOG], 1)[0] == t[0] and cl_text(lb[0..T_LOG], 1)[1499] == t[1499];
+    assert cl_text(lb[0..T_LOG], 1)[700] == t[700];
+    // every part again after the line exists: duplicates, the slot was freed
+    const all : [3]u32 = [0, 1, 2];
+    assert t_carry(la[0..T_LOG], 1, lb[0..T_LOG], asm[0..CA_LEN], all[0..3]) == CH_RX_DUP;
