+    assert st[CV_PS_USED] == 47728 and st[CV_PS_BUSY] == 1 and st[CV_PS_TRIED] == 2;
+    // every one of the ten is taken: the tenth stops the launch, nothing is used
+    var p : [10]u64 = undefined;
+    const n : usize = cv_port_plan(47727, 0, p[0..10]);
+    st[0] = 0;
+    st[1] = 0;
+    st[2] = 0;
+    var i : usize = 0;
+    var go : bool = true;
+    while (go and i < n) {
+        go = cv_port_step(st[0..3], 47727, p[i], false);
+        i = i + 1;
+    }
+    assert i == 10 and go == false;
+    assert st[CV_PS_USED] == 0 and st[CV_PS_BUSY] == 1023 and st[CV_PS_TRIED] == 10;
+    assert cv_port_nbusy(1023) == 10 and cv_port_nbusy(0) == 0 and cv_port_nbusy(5) == 2;
+    // even past the plan a caller is told to stop
+    assert cv_port_step(st[0..3], 47727, 47737, false) == false;
+    assert cv_port_step(st[0..2], 47727, 47727, false) == false;
+    assert cv_port_bit(47727, 47727) == 1 and cv_port_bit(47727, 47736) == 512;
+    assert cv_port_bit(47727, 47737) == 0 and cv_port_bit(47727, 47726) == 0;
+}
