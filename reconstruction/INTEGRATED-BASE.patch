+    z[EP_HAVE_CODE] = 1;
+    cs_p(z, CS_N2, 60);
+    assert cs_confirm(z, false) == false and cs_reason(z) == CS_R_NONE;
+    // a dial needs a free line, an address, a port and a 10-byte key
+    assert cs_call(z, 3232235786, 47727, fp[0..10]) == false;
+    z[1] = @as(u8, @intCast(CK_ACTIVE));
+    assert cs_call(z, 3232235786, 47727, fp[0..10]) == false;
+    z[1] = @as(u8, @intCast(CK_RINGING));
+    assert cs_call(z, 3232235786, 47727, fp[0..10]) == false;
+    z[1] = @as(u8, @intCast(CK_IDLE));
+    assert cs_call(z, 0, 47727, fp[0..10]) == false;
+    assert cs_call(z, 4294967296, 47727, fp[0..10]) == false;
+    assert cs_call(z, 3232235786, 0, fp[0..10]) == false;
+    assert cs_call(z, 3232235786, 65536, fp[0..10]) == false;
+    assert cs_call(z, 3232235786, 47727, fp[0..9]) == false;
+    assert cs_state(z) == CK_IDLE and z[EP_ROLE] == 0;
+    // the camera hands in only a JPEG (SOI 255 216) of 4 .. VC_JPEG_MAX bytes
+    const bad : [4]u8 = [255, 217, 0, 0];
+    assert cs_video_feed(z, bad[0..4]) == false;
+    const short : [3]u8 = [255, 216, 255];
+    assert cs_video_feed(z, short[0..3]) == false;
+    assert cvg(z, VT_CAM_LEN) == 0;
+    // a one block session has no group: no pick, no leave, no link but its own
+    assert csg_add(z, fp[0..10], 3232235786, 47727) == false;
+    assert csg_leave(z) == false;
+    assert csg_link(z, 1, 2) == 0 and csg_link(z, 3, 6) == 0;
