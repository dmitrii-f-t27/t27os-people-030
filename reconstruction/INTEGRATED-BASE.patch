+/// Restrict every local-mode session packet to the explicitly selected IPv4 endpoint.
+pub fn cs_pair_endpoint(s: []u8, ip: u64, port: u64) -> bool {
+    if (!cs_live(s) or s[CS_NET+CN_LOCAL_MODE] != 1 or s[CS_NET+CN_LOCAL_CARD] != 1 or ip==0 or ip>=3758096384 or port == 0 or port > 65535 or cs_state(s) != CK_IDLE) { return false; }
+    put_u64(s,CS_NET+CN_LOCAL_TARGET,ip*65536+port); return true;
+}
+pub fn cs_pair_net(s: []const u8, k: u32) -> u64 {
+    if(s.len<CS_LEN){return 0;} if(k==0){return get_u64(s,CS_NET+CN_LOCAL_TARGET);} if(k==1){return get_u64(s,CS_NET+CN_LOCAL_ATTEMPTS);} return get_u64(s,CS_NET+CN_LOCAL_DENIED);
+}
+
+/// Local-only sessions start deny-all, before any receive/poll can reply.
+pub fn cs_local_deny_all(s: []u8) -> bool {
+    if(!cs_live(s) or cs_state(s)!=CK_IDLE){return false;}
+    s[CS_NET+CN_LOCAL_MODE]=1;s[CS_NET+CN_LOCAL_CARD]=0;put_u64(s,CS_NET+CN_LOCAL_TARGET,0);return true;
+}
