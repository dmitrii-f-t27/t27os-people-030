+    assert li_identity_service(false)=="ai.t27.localcomms.unified.identity.v1";
+    assert li_identity_service(true)=="ai.t27.os.people.finalqa.identity.v1";
+    assert li_identity_service(true)!=li_identity_service(false);
+}
