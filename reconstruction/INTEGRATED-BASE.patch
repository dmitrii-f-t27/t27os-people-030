+    // T27OS_ALLOW_PUBLIC=1 allows a public address without ALLOW
+    assert cv_dial_decide(cv_a("1.2.3.4:5000"), true, 0) == CV_D_OK;
+    // never, with or without consent or the variable
+    const never : [5]u64 = [cv_a("224.0.0.251:5353"), cv_a("255.255.255.255:47727"), cv_a("0.0.0.0:47727"), cv_a("169.254.1.1:47727"), cv_a("240.0.0.1:47727")];
