+test after_a_matched_code_the_key_is_stored_and_the_next_session_skips_the_code {
+    var t : [1108]u8 = undefined;
+    t_two(t[0..1108]);
+    var keys : [2400]u8 = undefined;
+    zero_fill(keys[0..2400]);
+    var ka : [65]u8 = undefined;
+    t_key(8, ka[0..65]);
+    // session 1: a friend from a v1 file, its proof checks; the people compare the code and say match
+    var stored : [65]u8 = undefined;
+    var pinned : bool = fk_get(keys[0..2400], T_FP[0..10], stored[0..65]);
+    var v : u32 = pid_verdict(pinned, true, true, false);
+    assert v == PID_CODE;
+    assert pid_person_may_match(v, false);
+    assert pid_pinnable(pinned, true, true);
+    assert fk_pin(t[0..1108], keys[0..2400], T_FP[0..10], ka[0..65]) == PIN_NEW;
+    var f : [3508]u8 = undefined;
+    ft2_join(t[0..1108], keys[0..2400], f[0..3508]);
+    // the app starts again: the file is read back
+    var t2 : [1108]u8 = undefined;
+    var k2 : [2400]u8 = undefined;
+    assert ft2_split(f[0..3508], 3508, t2[0..1108], k2[0..2400]) == FT_OK;
+    // session 2: the same key with a good signature -> no code, the session says match by itself
+    pinned = fk_get(k2[0..2400], T_FP[0..10], stored[0..65]);
+    assert pinned;
+    v = pid_verdict(pinned, true, true, same_bytes(stored[0..65], ka[0..65]));
+    assert v == PID_TRUSTED;
+    assert pid_auto_match(v);
+    assert pid_pinnable(pinned, true, true) == false;
+    assert pid_message_refused(true, true, v) == false;
+    // session 3: someone in the middle shows its own key with its own good signature -> refused, nothing stored
+    var km : [65]u8 = undefined;
+    t_key(9, km[0..65]);
+    v = pid_verdict(pinned, true, true, same_bytes(stored[0..65], km[0..65]));
+    assert v == PID_REFUSE;
+    assert fk_pin(t2[0..1108], k2[0..2400], T_FP[0..10], km[0..65]) == PIN_CONFLICT;
+    // a proof that does not verify stores nothing
+    assert pid_pinnable(false, true, false) == false;
+    assert pid_pinnable(false, false, false) == false;
+}
