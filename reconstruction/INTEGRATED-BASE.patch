+    }
+    var out : [90]u8 = undefined;
+    // alone: 1 person; 1 friend: 2 people; 7 friends: 8 people; 8 friends: 9 people
+    assert gr_plan(fr[0..FT_LEN], T_A[0..10], others[0..80], 0, out[0..90]) == GR_SIZE;
+    assert gr_plan(fr[0..FT_LEN], T_A[0..10], others[0..80], 1, out[0..90]) == GR_OK;
+    assert gr_plan(fr[0..FT_LEN], T_A[0..10], others[0..80], 7, out[0..90]) == GR_OK;
+    assert gr_plan(fr[0..FT_LEN], T_A[0..10], others[0..80], 8, out[0..90]) == GR_SIZE;
+    // a stranger, itself, someone twice
+    var bad : [20]u8 = undefined;
