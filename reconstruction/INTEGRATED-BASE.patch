+// SPDX-License-Identifier: Apache-2.0
+// Shared signed-integer magnitude for native audio and numeric formatting.
+// Refs #14151. The unsigned result represents the complete i64 domain.
+module std::integer;
+
+pub fn i64_magnitude(value: i64) -> u64 {
+    if (value < 0) {
+        return @as(u64, @intCast(0 - (value + 1))) + 1;
+    }
+    return @as(u64, @intCast(value));
+}
+
+test signed_magnitude_preserves_zero_and_audio_boundaries {
+    assert i64_magnitude(0) == 0;
+    assert i64_magnitude(-1) == 1;
+    assert i64_magnitude(32767) == 32767;
+    assert i64_magnitude(-32768) == 32768;
+}
+
+test signed_magnitude_covers_the_complete_i64_range {
+    assert i64_magnitude(9223372036854775807) == 9223372036854775807;
+    assert i64_magnitude(-9223372036854775807 - 1) == 9223372036854775808;
+}
diff --git a/specs/std/mem.t27 b/specs/std/mem.t27
