+    // a key stored now after a matched code counts as trusted too
+    s[CS_ID + CI_SAME] = 0;
+    s[CS_ID + CI_STORED] = 1;
+    cgp(s[0..CS_LEN], LG_LIST_LEN, 0);
+    assert csg_list_keep(s[0..CS_LEN], l[0..n]) == GR_LR_OK;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == @as(u64, n);
+    assert cs_g(s[0..CS_LEN], CS_ST_ACCEPTED) == 0 and cs_g(s[0..CS_LEN], CS_ST_REJ_OTHER) == 0;
