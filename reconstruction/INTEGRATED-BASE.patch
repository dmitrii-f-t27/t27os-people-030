+test a_fingerprint_compares_byte_by_byte_from_the_first_unsigned_at_its_own_offsets {
+    assert gr_fp_cmp(T_A[0..10], 0, T_B[0..10], 0) == -1;
+    assert gr_fp_cmp(T_B[0..10], 0, T_A[0..10], 0) == 1;
+    assert gr_fp_cmp(T_A[0..10], 0, T_A[0..10], 0) == 0;
+    // the first byte that differs decides, whatever comes after it
+    assert gr_fp_cmp(T_C[0..10], 0, T_A[0..10], 0) == 1;
+    assert gr_fp_cmp(T_X[0..10], 0, T_C[0..10], 0) == -1;
+    // bytes are unsigned: 255 (and a UTF-8 lead byte 208) stands above 0 and 127
+    const hi : [10]u8 = [255, 0, 0, 0, 0, 0, 0, 0, 0, 0];
+    const lo : [10]u8 = [127, 255, 255, 255, 255, 255, 255, 255, 255, 255];
+    const cy : [10]u8 = [208, 175, 0, 0, 0, 0, 0, 0, 0, 0];
+    assert gr_fp_cmp(hi[0..10], 0, lo[0..10], 0) == 1 and gr_fp_cmp(cy[0..10], 0, lo[0..10], 0) == 1;
+    // only 10 bytes are read: a difference at byte 10 is not seen
+    var two : [20]u8 = undefined;
+    copy(two[0..20], 0, T_B[0..10], 0, 10);
+    copy(two[0..20], 10, T_A[0..10], 0, 10);
+    assert gr_fp_cmp(two[0..20], 10, T_A[0..10], 0) == 0;
+    assert gr_fp_cmp(two[0..20], 0, two[0..20], 10) == 1;
+    assert gr_fp_cmp(two[0..20], 1, two[0..20], 1) == 0;
+    var a11 : [11]u8 = undefined;
+    copy(a11[0..11], 0, T_A[0..10], 0, 10);
+    a11[10] = 99;
+    assert gr_fp_cmp(a11[0..11], 0, T_A[0..10], 0) == 0;
+}
