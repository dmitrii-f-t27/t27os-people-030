+    assert cs_set_peer(s[0..CS_LEN], ep[0..18]);
+    // the sockaddr_in6 the socket sends to, its length, the endpoint; cs_peer says "not an IPv4"
+    assert s[CS_NET + CN6_SA] == 28 and s[CS_NET + CN6_SA + 1] == 30 and s[CS_NET + CN6_SA + 2] == 186 and s[CS_NET + CN6_SA + 3] == 111;
+    assert s[CS_NET + CN6_SA + 8] == 63 and s[CS_NET + CN6_SA + 23] == 120 and s[CS_NET + CN6_SALEN] == 28;
+    assert cs_g(s[0..CS_LEN], CS_PEER_IP) == CS_PEER_V6 and cs_net(s[0..CS_LEN], CS_NET_FAM) == @as(u64, IP6_F_V6);
+    // more than 1232 bytes never leaves for an IPv6 peer: counted, not sent
+    var big : [1996]u8 = undefined;
+    ck_wipe(big[0..1996]);
+    assert cs_send(s[0..CS_LEN], big[0..1233]) == false and cs_net(s[0..CS_LEN], CS_NET_BIG) == 1;
+    assert cs_send(s[0..CS_LEN], big[0..1996]) == false and cs_net(s[0..CS_LEN], CS_NET_BIG) == 2;
+    // 1232 bytes is what the size rule lets through to it (the send itself is a host call: call_session_probe CS_V6=1)
+    assert ip6_fits(s[CS_NET + CN6_EP..CS_NET + CN6_EP + IP6_EP], 1232) and cs_g(s[0..CS_LEN], CS_ST_SEND_ERR) == 2;
+    // an IPv4 friend on the dual-stack socket: its v4-mapped sockaddr_in6, its IPv4 for cs_peer, the IPv4 path's size
+    var v4 : [18]u8 = undefined;
+    ip6_ep_v4(3232235786, 47728, v4[0..18]);
+    assert cs_set_peer(s[0..CS_LEN], v4[0..18]);
+    assert s[CS_NET + CN6_SALEN] == 28 and s[CS_NET + CN6_SA + 1] == 30 and s[CS_NET + CN6_SA + 18] == 255 and s[CS_NET + CN6_SA + 20] == 192 and s[CS_NET + CN6_SA + 23] == 10;
+    assert cs_g(s[0..CS_LEN], CS_PEER_IP) == 3232235786 and cs_net(s[0..CS_LEN], CS_NET_FAM) == @as(u64, IP6_F_MAPPED);
+    assert ip6_fits(s[CS_NET + CN6_EP..CS_NET + CN6_EP + IP6_EP], 1996);
+    // an IPv4 socket (no dual-stack one was given): a sockaddr_in, family v4, and no IPv6 peer at all
+    t6_block(s[0..CS_LEN], false);
+    assert cs_set_peer(s[0..CS_LEN], v4[0..18]) and s[CS_NET + CN6_SALEN] == 16 and s[CS_NET + CN6_SA + 1] == 2 and s[CS_NET + CN6_SA + 4] == 192;
+    assert cs_net(s[0..CS_LEN], CS_NET_FAM) == @as(u64, IP6_F_V4) and cs_net(s[0..CS_LEN], CS_NET_SOCK6) == 0;
+    t6_block(s[0..CS_LEN], false);
+    assert cs_set_peer(s[0..CS_LEN], ep[0..18]) == false and s[CS_NET + CN6_SALEN] == 0 and cs_net(s[0..CS_LEN], CS_NET_FAM) == 0;
+    // a new call forgets the last peer's address with the rest of it (cs_fresh clears the last peer: cs_id_fresh)
+    t6_block(s[0..CS_LEN], true);
+    assert cs_set_peer(s[0..CS_LEN], ep[0..18]);
+    cs_id_fresh(s[0..CS_LEN]);
+    assert s[CS_NET + CN6_SALEN] == 0 and cs_net(s[0..CS_LEN], CS_NET_FAM) == 0;
+    assert CS_ID + CI_MSG + CK_HDR + CK_IDENT_PT + CK_TAG <= CS_NET and CS_NET + CN6_EP + IP6_EP <= CS_ID + CS_ID_LEN and CS_ID + CI_PEER < CS_NET;
+}
