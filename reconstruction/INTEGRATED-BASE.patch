+++ b/specs/t27os/github_avatar.t27
@@ -4,14 +4,602 @@
 // phi^2 + 1/phi^2 = 3 | TRINITY
 
 module t27os::github_avatar;
+use std::mem::bytes_eq;
+use t27os::profile::prf_utf8_len;
 
-pub struct GithubAvatar { url: str, fetched: bool };
+pub struct GithubAvatar { url: str, fetched: bool }
 
 pub fn github_avatar_fetched(a: GithubAvatar) -> bool {
     return a.fetched;
 }
 
+pub const GHA_API_USER_URL : str = "https://api.github.com/user";
+pub const GHA_ACCESS_VIEW : u32 = 0;
+pub const GHA_ACCESS_EDIT : u32 = 1;
+pub const GHA_MAX_PEERS : u32 = 4;
+pub const GHA_PEER_STEP : f64 = 28.0;
+pub const GHA_SYNC_Y : f64 = 374.0;
+pub const GHA_CLAW_Y : f64 = 406.0;
+pub const GHA_ACC_LABEL_Y : f64 = 448.0;
+pub const GHA_ACC_BTN_Y : f64 = 456.0;
+pub const GHA_BTN_H : f64 = 26.0;
+pub const GHA_PANEL_H : f64 = 496.0;
+pub const GHA_H_NONE : u32 = 0;
+pub const GHA_H_SYNC : u32 = 10;
+pub const GHA_H_CLAW : u32 = 11;
+pub const GHA_H_ACC_VIEW : u32 = 12;
+pub const GHA_H_ACC_EDIT : u32 = 13;
+
+const GHA_NONE_CP : u32 = 4294967295;
+
+fn gha_same(a: []const u8, b: []const u8) -> bool {
+    return bytes_eq(a, b);
+}
+
+fn gha_ends_with(s: []const u8, suf: []const u8) -> bool {
+    if (suf.len > s.len) { return false; }
+    return gha_same(s[s.len - suf.len .. s.len], suf);
+}
+
+fn gha_is_json_ws(c: u8) -> bool {
+    return c == 32 or c == 9 or c == 10 or c == 13;
+}
+
+fn gha_skip_ws(s: []const u8, from: usize) -> usize {
+    var i : usize = from;
+    while (i < s.len and gha_is_json_ws(s[i])) {
+        i = i + 1;
+    }
+    return i;
+}
+
+// Returns index right after closing quote, or s.len + 1 when unterminated.
+fn gha_skip_json_str(s: []const u8, quote_at: usize) -> usize {
+    var i : usize = quote_at + 1;
+    while (i < s.len) {
+        const c : u8 = s[i];
+        if (c == 34) { return i + 1; }
+        if (c == 92) {
+            if (i + 1 >= s.len) { return s.len + 1; }
+            i = i + 2;
+        } else {
+            i = i + 1;
+        }
+    }
+    return s.len + 1;
+}
+
+fn gha_hex_val(c: u8) -> u32 {
+    if (c >= 48 and c <= 57) { return @as(u32, c - 48); }
+    if (c >= 65 and c <= 70) { return @as(u32, c - 55); }
+    if (c >= 97 and c <= 102) { return @as(u32, c - 87); }
+    return 16;
+}
+
+fn gha_hex4(s: []const u8, at: usize) -> u32 {
+    if (at + 4 > s.len) { return GHA_NONE_CP; }
+    const d0 : u32 = gha_hex_val(s[at]);
+    const d1 : u32 = gha_hex_val(s[at + 1]);
+    const d2 : u32 = gha_hex_val(s[at + 2]);
+    const d3 : u32 = gha_hex_val(s[at + 3]);
+    if (d0 > 15 or d1 > 15 or d2 > 15 or d3 > 15) { return GHA_NONE_CP; }
+    return d0 * 4096 + d1 * 256 + d2 * 16 + d3;
+}
+
+fn gha_put_utf8(out: []u8, at: usize, cp: u32) -> usize {
+    if (cp <= 127) {
+        if (at + 1 > out.len) { return 0; }
+        out[at] = @as(u8, @intCast(cp));
+        return 1;
+    }
+    if (cp <= 2047) {
+        if (at + 2 > out.len) { return 0; }
+        out[at] = @as(u8, @intCast(192 | (cp / 64)));
+        out[at + 1] = @as(u8, @intCast(128 | (cp & 63)));
+        return 2;
+    }
+    if (cp >= 55296 and cp <= 57343) { return 0; }
+    if (cp <= 65535) {
+        if (at + 3 > out.len) { return 0; }
+        out[at] = @as(u8, @intCast(224 | (cp / 4096)));
+        out[at + 1] = @as(u8, @intCast(128 | ((cp / 64) & 63)));
+        out[at + 2] = @as(u8, @intCast(128 | (cp & 63)));
+        return 3;
+    }
+    if (cp <= 1114111) {
+        if (at + 4 > out.len) { return 0; }
+        out[at] = @as(u8, @intCast(240 | (cp / 262144)));
+        out[at + 1] = @as(u8, @intCast(128 | ((cp / 4096) & 63)));
+        out[at + 2] = @as(u8, @intCast(128 | ((cp / 64) & 63)));
+        out[at + 3] = @as(u8, @intCast(128 | (cp & 63)));
+        return 4;
+    }
+    return 0;
+}
+
+fn gha_decode_json_str(json: []const u8, quote_at: usize, out: []u8) -> usize {
+    var q : usize = quote_at + 1;
+    var w : usize = 0;
+    while (q < json.len) {
+        const c : u8 = json[q];
+        if (c == 34) { return w; }
+        if (c == 92) {
+            if (q + 1 >= json.len) { return 0; }
+            const esc : u8 = json[q + 1];
+            if (esc == 117) {
+                var cp : u32 = gha_hex4(json, q + 2);
+                if (cp == GHA_NONE_CP) { return 0; }
+                var adv : usize = 6;
+                if (cp >= 55296 and cp <= 56319) {
+                    if (q + 12 > json.len or json[q + 6] != 92 or json[q + 7] != 117) { return 0; }
+                    const lo : u32 = gha_hex4(json, q + 8);
+                    if (lo < 56320 or lo > 57343) { return 0; }
+                    cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
+                    adv = 12;
+                }
+                const wn : usize = gha_put_utf8(out, w, cp);
+                if (wn == 0) { return 0; }
+                w = w + wn;
+                q = q + adv;
+            } else {
+                var dec : u8 = esc;
+                if (esc == 34) {
+                    dec = 34;
+                } else if (esc == 92) {
+                    dec = 92;
+                } else if (esc == 47) {
+                    dec = 47;
+                } else if (esc == 98) {
+                    dec = 8;
+                } else if (esc == 102) {
+                    dec = 12;
+                } else if (esc == 110) {
+                    dec = 10;
+                } else if (esc == 114) {
+                    dec = 13;
+                } else if (esc == 116) {
+                    dec = 9;
+                } else {
+                    return 0;
+                }
+                if (w >= out.len) { return 0; }
+                out[w] = dec;
+                w = w + 1;
+                q = q + 2;
+            }
+        } else {
+            if (c < 32) { return 0; }
+            if (w >= out.len) { return 0; }
+            out[w] = c;
+            w = w + 1;
+            q = q + 1;
+        }
+    }
+    return 0;
+}
+
+/// Extract a top-level JSON string field (e.g. "login", "name", "avatar_url") into `out`.
+/// Returns 0 for missing key, null/non-string value, nested-only match, malformed escapes, or `out` overflow.
+pub fn gha_json_str(json: []const u8, key: []const u8, out: []u8) -> usize {
+    if (json.len == 0 or key.len == 0 or out.len == 0) { return 0; }
+    var i : usize = 0;
+    var depth : u32 = 0;
+    while (i < json.len) {
+        const c : u8 = json[i];
+        if (c == 34) {
+            const after_s : usize = gha_skip_json_str(json, i);
+            if (after_s > json.len) { return 0; }
+            if (depth == 1) {
+                const colon : usize = gha_skip_ws(json, after_s);
+                if (colon < json.len and json[colon] == 58) {
+                    const matched : bool = gha_same(json[i + 1 .. after_s - 1], key);
+                    const val_at : usize = gha_skip_ws(json, colon + 1);
+                    if (val_at >= json.len) { return 0; }
+                    if (matched) {
+                        if (json[val_at] != 34) { return 0; }
+                        return gha_decode_json_str(json, val_at, out);
+                    }
+                    i = val_at;
+                } else {
+                    i = after_s;
+                }
+            } else {
+                i = after_s;
+            }
+        } else if (c == 123 or c == 91) {
+            depth = depth + 1;
+            i = i + 1;
+        } else if (c == 125 or c == 93) {
+            if (depth == 0) { return 0; }
+            depth = depth - 1;
+            i = i + 1;
+        } else {
+            i = i + 1;
+        }
+    }
+    return 0;
+}
+
+fn gha_utf8_len(lead: u8) -> usize {
+    return prf_utf8_len(lead);
+}
+
+fn gha_utf8_cp(s: []const u8, at: usize) -> u32 {
+    if (at >= s.len) { return GHA_NONE_CP; }
+    const n : usize = gha_utf8_len(s[at]);
+    if (n == 0 or n > s.len - at) { return GHA_NONE_CP; }
+    if (n == 1) { return @as(u32, s[at]); }
+    var cp : u32 = 0;
+    if (n == 2) { cp = @as(u32, s[at] & 31); }
+    if (n == 3) { cp = @as(u32, s[at] & 15); }
+    if (n == 4) { cp = @as(u32, s[at] & 7); }
+    var i : usize = 1;
+    while (i < n) {
+        const b : u8 = s[at + i];
+        if ((b & 192) != 128) { return GHA_NONE_CP; }
+        cp = cp * 64 + @as(u32, b & 63);
+        i = i + 1;
+    }
+    if (n == 3 and cp < 2048) { return GHA_NONE_CP; }
+    if (n == 4 and cp < 65536) { return GHA_NONE_CP; }
+    if (cp >= 55296 and cp <= 57343) { return GHA_NONE_CP; }
+    if (cp > 1114111) { return GHA_NONE_CP; }
+    return cp;
+}
+
+fn gha_bad_nick_cp(cp: u32) -> bool {
+    if (cp <= 31 or cp == 127 or (cp >= 128 and cp <= 159) or cp == 8232 or cp == 8233) { return true; }
+    if (cp == 173 or cp == 1564 or cp == 6158 or cp == 65279) { return true; }
+    if (cp >= 8203 and cp <= 8207) { return true; }
+    if (cp >= 8234 and cp <= 8238) { return true; }
+    if (cp >= 8288 and cp <= 8292) { return true; }
+    if (cp >= 8294 and cp <= 8303) { return true; }
+    return cp >= 65529 and cp <= 65531;
+}
+
+fn gha_nick_valid(s: []const u8) -> bool {
+    if (s.len == 0 or s.len > 64) { return false; }
+    var cps : u32 = 0;
+    var at : usize = 0;
+    while (at < s.len) {
+        const cp : u32 = gha_utf8_cp(s, at);
+        if (cp == GHA_NONE_CP or gha_bad_nick_cp(cp)) { return false; }
+        at = at + gha_utf8_len(s[at]);
+        cps = cps + 1;
+        if (cps > 24) { return false; }
+    }
+    return cps >= 1 and cps <= 24;
+}
+
+/// Normalize `name` (trim leading/trailing spaces, collapse repeated spaces); if 1..24 UTF-8 codepoints and <= 64
+/// bytes with no control/invisible chars, copy to `out`; else trim `login` to 1..24 chars and copy to `out`.
+pub fn gha_pick_nick(name: []const u8, login: []const u8, out: []u8) -> usize {
+    var tmp : [64]u8 = undefined;
+    var ns : usize = 0;
+    while (ns < name.len and name[ns] == 32) { ns = ns + 1; }
+    var ne : usize = name.len;
+    while (ne > ns and name[ne - 1] == 32) { ne = ne - 1; }
+    if (ne > ns) {
+        var tn : usize = 0;
+        var over : bool = false;
+        var prev_sp : bool = false;
+        var i : usize = ns;
+        while (i < ne and over == false) {
+            const b : u8 = name[i];
+            if (b == 32) {
+                if (prev_sp == false) {
+                    if (tn >= 64) {
+                        over = true;
+                    } else {
+                        tmp[tn] = 32;
+                        tn = tn + 1;
+                        prev_sp = true;
+                    }
+                }
+            } else {
+                if (tn >= 64) {
+                    over = true;
+                } else {
+                    tmp[tn] = b;
+                    tn = tn + 1;
+                    prev_sp = false;
+                }
+            }
+            i = i + 1;
+        }
+        if (over == false and tn <= out.len and gha_nick_valid(tmp[0..tn])) {
+            var k : usize = 0;
+            while (k < tn) {
+                out[k] = tmp[k];
+                k = k + 1;
+            }
+            return tn;
+        }
+    }
+    var ls : usize = 0;
+    while (ls < login.len and gha_is_json_ws(login[ls])) { ls = ls + 1; }
+    var le : usize = login.len;
+    while (le > ls and gha_is_json_ws(login[le - 1])) { le = le - 1; }
+    if (le <= ls) { return 0; }
+    var ln : usize = 0;
+    var cps : u32 = 0;
+    var at : usize = ls;
+    while (at < le and cps < 24) {
+        const cp : u32 = gha_utf8_cp(login[0..le], at);
+        if (cp == GHA_NONE_CP or gha_bad_nick_cp(cp)) { return 0; }
+        const seq : usize = gha_utf8_len(login[at]);
+        if (ln + seq > 64) { return 0; }
+        if (seq == 1 and login[at] == 32 and (ln == 0 or tmp[ln - 1] == 32)) {
+            at = at + 1;
+        } else {
+            var m : usize = 0;
+            while (m < seq) {
+                tmp[ln + m] = login[at + m];
+                m = m + 1;
+            }
+            ln = ln + seq;
+            cps = cps + 1;
+            at = at + seq;
+        }
+    }
+    while (ln > 0 and tmp[ln - 1] == 32) { ln = ln - 1; }
+    if (ln == 0 or ln > out.len or gha_nick_valid(tmp[0..ln]) == false) { return 0; }
+    var c : usize = 0;
+    while (c < ln) {
+        out[c] = tmp[c];
+        c = c + 1;
+    }
+    return ln;
+}
+
+fn gha_host_char_ok(c: u8) -> bool {
+    if (c >= 97 and c <= 122) { return true; }
+    if (c >= 48 and c <= 57) { return true; }
+    return c == 45 or c == 46;
+}
+
+/// Validate a GitHub avatar URL: https:// prefix, githubusercontent.com or github.com host (or subdomain),
+/// printable ASCII with no spaces/control bytes, at most 256 bytes.
+pub fn gha_avatar_url_ok(url: []const u8) -> bool {
+    if (url.len < 18 or url.len > 256) { return false; }
+    var i : usize = 0;
+    while (i < url.len) {
+        if (url[i] <= 32 or url[i] >= 127) { return false; }
+        i = i + 1;
+    }
+    if (gha_same(url[0..8], "https://") == false) { return false; }
+    var he : usize = 8;
+    while (he < url.len and url[he] != 47 and url[he] != 63 and url[he] != 35) {
+        he = he + 1;
+    }
+    if (he <= 8) { return false; }
+    var host : [256]u8 = undefined;
+    const hlen : usize = he - 8;
+    if (url[8] == 46 or url[he - 1] == 46) { return false; }
+    var k : usize = 0;
+    while (k < hlen) {
+        var ch : u8 = url[8 + k];
+        if (ch >= 65 and ch <= 90) { ch = ch + 32; }
+        if (gha_host_char_ok(ch) == false) { return false; }
+        if (ch == 46 and k > 0 and host[k - 1] == 46) { return false; }
+        host[k] = ch;
+        k = k + 1;
+    }
+    const h : []const u8 = host[0..hlen];
+    if (gha_same(h, "githubusercontent.com") or gha_ends_with(h, ".githubusercontent.com")) { return true; }
+    if (gha_same(h, "github.com") or gha_ends_with(h, ".github.com")) { return true; }
+    return false;
+}
+
+pub fn gha_peer_cx(anchor_left: f64, idx: u32) -> f64 {
+    return anchor_left - 19.0 - @as(f64, @floatFromInt(idx)) * GHA_PEER_STEP;
+}
+
+pub fn gha_peer_fits(cx: f64, brand_end: f64) -> bool {
+    return cx - 11.0 >= brand_end + 12.0;
+}
+
+pub fn gha_peer_hit(x: f64, y: f64, anchor_left: f64, title_h: f64, brand_end: f64, count: u32) -> u32 {
+    var lim : u32 = count;
+    if (lim > GHA_MAX_PEERS) { lim = GHA_MAX_PEERS; }
+    const cy : f64 = 0.5 * title_h;
+    const dy : f64 = y - cy;
+    var idx : u32 = 0;
+    while (idx < lim) {
+        const cx : f64 = gha_peer_cx(anchor_left, idx);
+        if (gha_peer_fits(cx, brand_end)) {
+            const dx : f64 = x - cx;
+            if (dx * dx + dy * dy <= 121.0) { return idx; }
+        }
+        idx = idx + 1;
+    }
+    return GHA_MAX_PEERS;
+}
+
+fn gha_parse_u64(s: []const u8) -> u64 {
+    if (s.len == 0) { return 0; }
+    var v : u64 = 0;
+    var i : usize = 0;
+    while (i < s.len) {
+        const c : u8 = s[i];
+        if (c < 48 or c > 57) { return 0; }
+        const d : u64 = @as(u64, c - 48);
+        if (v > (18446744073709551615 - d) / 10) { return 0; }
+        v = v * 10 + d;
+        i = i + 1;
+    }
+    return v;
+}
+
+fn gha_peer_seen(names: []const u8, count: u32, host: []const u8) -> bool {
+    var k : u32 = 0;
+    while (k < count) {
+        const base : usize = @as(usize, k) * 32;
+        const n : usize = @as(usize, names[base]);
+        if (gha_same(names[base + 1 .. base + 1 + n], host)) { return true; }
+        k = k + 1;
+    }
+    return false;
+}
+
+/// Extract online peer hostnames from `A|<host>|<epoch>|...` feed lines into 32-byte length-prefixed slots in `names`.
+pub fn gha_extract_peers(feed: []const u8, now: u64, self_host: []const u8, names: []u8, count_cap: u32) -> u32 {
+    var count : u32 = 0;
+    var ls : usize = 0;
+    while (ls < feed.len and count < count_cap and (@as(usize, count) + 1) * 32 <= names.len) {
+        var nl : usize = ls;
+        while (nl < feed.len and feed[nl] != 10) { nl = nl + 1; }
+        var le : usize = nl;
+        if (le > ls and feed[le - 1] == 13) { le = le - 1; }
+        if (le - ls >= 4 and feed[ls] == 65 and feed[ls + 1] == 124) {
+            var p1 : usize = ls + 2;
+            while (p1 < le and feed[p1] != 124) { p1 = p1 + 1; }
+            if (p1 < le and p1 > ls + 2) {
+                var p2 : usize = p1 + 1;
+                while (p2 < le and feed[p2] != 124) { p2 = p2 + 1; }
+                const epoch : u64 = gha_parse_u64(feed[p1 + 1 .. p2]);
+                if (epoch > 0 and (now <= epoch or now - epoch < 1800)) {
+                    const raw_host : []const u8 = feed[ls + 2 .. p1];
+                    var hlen : usize = raw_host.len;
+                    if (hlen > 31) { hlen = 31; }
+                    var clean : bool = hlen > 0;
+                    var hi : usize = 0;
+                    while (hi < hlen) {
+                        if (raw_host[hi] <= 32 or raw_host[hi] >= 127) { clean = false; }
+                        hi = hi + 1;
+                    }
+                    const hslice : []const u8 = raw_host[0..hlen];
+                    if (clean and gha_same(raw_host, self_host) == false and gha_same(hslice, self_host) == false) {
+                        if (gha_peer_seen(names, count, hslice) == false) {
+                            const base : usize = @as(usize, count) * 32;
+                            names[base] = @as(u8, @intCast(hlen));
+                            var bi : usize = 0;
+                            while (bi < 31) {
+                                if (bi < hlen) {
+                                    names[base + 1 + bi] = hslice[bi];
+                                } else {
+                                    names[base + 1 + bi] = 0;
+                                }
+                                bi = bi + 1;
+                            }
+                            count = count + 1;
+                        }
+                    }
+                }
+            }
+        }
+        ls = nl + 1;
+    }
+    return count;
+}
+
+pub fn gha_extra_hit(x: f64, y: f64, l: f64, w: f64, top: f64) -> u32 {
+    if (x < l + 20.0 or x > l + w - 20.0) { return GHA_H_NONE; }
+    if (y >= top + GHA_SYNC_Y and y <= top + GHA_SYNC_Y + GHA_BTN_H) { return GHA_H_SYNC; }
+    if (y >= top + GHA_CLAW_Y and y <= top + GHA_CLAW_Y + GHA_BTN_H) { return GHA_H_CLAW; }
+    if (y >= top + GHA_ACC_BTN_Y and y <= top + GHA_ACC_BTN_Y + GHA_BTN_H) {
+        const mid : f64 = l + 0.5 * w;
+        if (x <= mid - 4.0) { return GHA_H_ACC_VIEW; }
+        if (x >= mid + 4.0) { return GHA_H_ACC_EDIT; }
+    }
+    return GHA_H_NONE;
+}
+
+pub fn gha_access_toggle(cur: u32, hit: u32) -> u32 {
+    if (hit == GHA_H_ACC_VIEW) { return GHA_ACCESS_VIEW; }
+    if (hit == GHA_H_ACC_EDIT) { return GHA_ACCESS_EDIT; }
+    return cur;
+}
