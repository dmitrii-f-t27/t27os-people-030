+use t27os::pty_proto::get_u64;
+
+/// Copy and decode one little-endian word from an already validated native address.
+pub fn sys_peek_u64(at: u64) -> u64 {
+    var c : [8]u8 = undefined;
+    sys_peek(c[0..8], at, 8);
+    return get_u64(c[0..8], 0);
+}
+
+/// The diagnostic line used by native smoke checks; the verdict is unchanged.
+pub fn sys_check_line(s: []const u8, ok: bool) -> bool {
+    if (ok) { sys_write(1, "ok   ", 5); } else { sys_write(1, "FAIL ", 5); }
+    sys_write(1, s, @as(u64, s.len));
+    sys_write(1, "\n", 1);
+    return ok;
+}
