+    // from the side I called (not the initiator of the link): refused, trusted or not
+    assert gr_list_admit(l[0..n], false, true) == GR_LR_NOT_INITIATOR;
+    assert gr_list_admit(l[0..n], false, false) == GR_LR_NOT_INITIATOR;
+    // from the initiator that is not a trusted friend: refused
+    assert gr_list_admit(l[0..n], true, false) == GR_LR_UNTRUSTED;
+    // trusted: the proof verified and the key is the stored one (before the call, or stored now)
+    assert gr_trusted(true, true, false);
