+test the_identity_verdict_for_every_proof {
+    // no stored key: the code, whatever the proof says
+    assert pid_verdict(false, false, false, false) == PID_CODE;
+    assert pid_verdict(false, true, true, false) == PID_CODE;
+    assert pid_verdict(false, true, false, false) == PID_CODE;
+    // a stored key and the same key with a signature that verifies: no code
+    assert pid_verdict(true, true, true, true) == PID_TRUSTED;
+    // a stored key and no proof (yet, or an old build): the code
+    assert pid_verdict(true, false, false, false) == PID_CODE;
+    // a stored key and a signature that does not verify: refused
+    assert pid_verdict(true, true, false, true) == PID_REFUSE;
+    // a stored key and another key, even one with a good signature of its own: refused
+    assert pid_verdict(true, true, true, false) == PID_REFUSE;
+    assert pid_verdict(true, true, false, false) == PID_REFUSE;
+}
