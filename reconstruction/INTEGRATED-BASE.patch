+    assert ft2_split(a[0..3508], 3508, t2[0..1108], k2[0..2400]) == FT_KEY_BAD;
+    // slot 1 repeats the friend of slot 0
+    var b : [3508]u8 = a;
+    b[FT2_OFF_KEYS + 75] = f[FT2_OFF_KEYS];
+    put_u32le(b[0..3508], FT2_OFF_CRC, crc32(b[0..3508], FT2_OFF_CRC));
+    assert ft2_split(b[0..3508], 3508, t2[0..1108], k2[0..2400]) == FT_KEY_BAD;
+    // a key that is not an uncompressed point
+    var c : [3508]u8 = f;
+    c[FT2_OFF_KEYS + 10] = 3;
+    put_u32le(c[0..3508], FT2_OFF_CRC, crc32(c[0..3508], FT2_OFF_CRC));
+    assert ft2_split(c[0..3508], 3508, t2[0..1108], k2[0..2400]) == FT_KEY_BAD;
