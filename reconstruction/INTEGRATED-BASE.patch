+test cv_the_port_file_reads_back_and_refuses_anything_else {
+    var f : [80]u8 = undefined;
+    const n : usize = cv_cp_text(47728, 1792000000, f[0..80]);
+    assert n > CV_CP_MAGIC.len and n <= CV_CP_CAP;
+    assert f[0] == 116 and f[n - 1] == 10;
+    assert cv_cp_parse(f[0..n]) == 47728;
+    // one byte changed, cut short, a byte after it: refused
+    f[CV_CP_MAGIC.len] = 57;
+    assert cv_cp_parse(f[0..n]) == 0;
+    f[CV_CP_MAGIC.len] = 52;
+    assert cv_cp_parse(f[0..n]) == 47728;
+    assert cv_cp_parse(f[0..n - 1]) == 0;
+    var g : [81]u8 = undefined;
+    var i : usize = 0;
+    while (i < n) {
+        g[i] = f[i];
+        i = i + 1;
+    }
+    g[n] = 10;
+    assert cv_cp_parse(g[0..n + 1]) == 0;
+    assert cv_cp_parse("t27os-callport v2\n47728 1\ncrc 0\n") == 0;
+    assert cv_cp_parse("") == 0;
+    // nothing to write for a bad port, a zero time or a launch where no port opened
+    assert cv_cp_text(0, 1792000000, f[0..80]) == 0;
+    assert cv_cp_text(65536, 1792000000, f[0..80]) == 0;
+    assert cv_cp_text(47728, 0, f[0..80]) == 0;
+    var st : [3]u64 = undefined;
+    st[0] = 0;
+    st[1] = 1023;
+    st[2] = 10;
+    assert cv_port_save_text(st[0..3], 1792000000, f[0..80]) == 0;
+    st[0] = 47730;
+    const m : usize = cv_port_save_text(st[0..3], 1792000000, f[0..80]);
