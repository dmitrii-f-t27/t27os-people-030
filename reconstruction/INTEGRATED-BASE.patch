+test a_third_part_that_would_make_the_message_longer_than_2000_bytes_is_refused_and_writes_nothing {
+    var log : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    ck_wipe(asm[0..CA_LEN]);
+    assert cl_init(log[0..T_LOG], T_A[0..10], T_CAP);
+    var t : [700]u8 = undefined;
+    t_fill(t[0..700], 700, 2);
+    // a third part may carry 600 bytes at most: 2 * 700 + 600 = CH_MSG_MAX
+    var p : [720]u8 = undefined;
+    put_phdr(p[0..720], CH_K_TEXT, 5, 2, 3, 1, 600);
+    copy(p[0..720], CH_PHDR, t[0..700], 0, 600);
+    assert ch_kind(p[0..CH_PHDR + 600]) == CH_K_TEXT;
+    put_phdr(p[0..720], CH_K_TEXT, 5, 2, 3, 1, 601);
+    assert ch_kind(p[0..CH_PHDR + 601]) == 0;
+    put_phdr(p[0..720], CH_K_TEXT, 5, 2, 3, 1, 700);
+    copy(p[0..720], CH_PHDR, t[0..700], 0, 700);
+    assert ch_kind(p[0..CH_PHDR + 700]) == 0;
+    assert ch_put_part(p[0..720], 5, 2, 3, 1, t[0..700]) == 0;
+    assert ch_put_part(p[0..720], 5, 2, 3, 1, t[0..600]) == CH_PHDR + 600;
+    // the hostile third part after two full ones: refused, the next slot and the log untouched
+    var q : [720]u8 = undefined;
+    assert ch_put_part(q[0..720], 5, 0, 3, 1, t[0..700]) == CH_PHDR + 700;
+    assert ch_rx_text(log[0..T_LOG], asm[0..CA_LEN], q[0..CH_PHDR + 700]) == CH_RX_PART;
+    assert ch_put_part(q[0..720], 5, 1, 3, 1, t[0..700]) == CH_PHDR + 700;
+    assert ch_rx_text(log[0..T_LOG], asm[0..CA_LEN], q[0..CH_PHDR + 700]) == CH_RX_PART;
+    put_phdr(p[0..720], CH_K_TEXT, 5, 2, 3, 1, 700);
+    assert ch_rx_text(log[0..T_LOG], asm[0..CA_LEN], p[0..CH_PHDR + 700]) == CH_RX_BAD;
+    assert cl_count(log[0..T_LOG]) == 0;
+    var k : usize = CA_SLOT;
+    var clean : bool = true;
+    while (k < CA_SLOT + 16) {
+        if (asm[k] != 0) { clean = false; }
+        k = k + 1;
+    }
+    assert clean;
+}
+
+fn t_zero(b: []const u8) -> bool {
+    var i : usize = 0;
+    while (i < b.len) {
+        if (b[i] != 0) { return false; }
+        i = i + 1;
+    }
+    return true;
+}
