+    mp(m[0..384], M_INFO_AT, 5);
+    assert chm_stat(m[0..384], 26) == 0 and chm_stat(m[0..384], 32) == 0;
+    assert M_INFO_AT * 8 >= M_FP + 10 and @as(usize, CHM_INFO_WHY) * 8 + 8 <= CHM_LEN;
+    assert m[M_FP] == 200 and m[M_FP + 9] == 9;
+    assert (CHM_E_GINFO & (CHM_E_NEW | CHM_E_STATUS | CHM_E_DIRTY | CHM_E_OTHER | CHM_E_INVITE | CHM_E_STRANGER | CHM_E_GNEW | CHM_E_GSTATUS | CHM_E_GDIRTY)) == 0;
