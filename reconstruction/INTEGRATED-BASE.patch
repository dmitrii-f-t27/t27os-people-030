+test the_parts_of_a_frame_are_cut_as_before_whoever_made_its_jpeg {
+    // a 4500-byte JPEG of frame 7: five parts of 1000, 1000, 1000, 1000 and 500 bytes, each behind its 12-byte header
+    var jpeg : [4500]u8 = undefined;
+    ck_fill_session(jpeg[0..4500], 3);
+    jpeg[0] = 255;
+    jpeg[1] = 216;
+    assert vc_parts_for(4500) == 5;
+    var k : usize = 0;
+    while (k < 5) {
+        var pt : [1012]u8 = undefined;
+        const pn : usize = vc_part(pt[0..1012], 7, jpeg[0..4500], k);
+        if (k < 4) { assert pn == 1012; } else { assert pn == 512; }
+        // frame 7, part k of 5, total 4500 (LE)
+        assert pt[0] == 7 and pt[1] == 0 and pt[2] == 0 and pt[3] == 0;
+        assert pt[4] == @as(u8, @intCast(k)) and pt[5] == 0 and pt[6] == 5 and pt[7] == 0;
+        assert pt[8] == 148 and pt[9] == 17 and pt[10] == 0 and pt[11] == 0;
+        var i : usize = 0;
+        var same : bool = true;
+        while (i + 12 < pn) {
+            if (pt[12 + i] != jpeg[k * 1000 + i]) { same = false; }
+            i = i + 1;
+        }
+        assert same;
+        k = k + 1;
+    }
+    var pt : [1012]u8 = undefined;
+    assert vc_part(pt[0..1012], 7, jpeg[0..4500], 5) == 0;
+}
