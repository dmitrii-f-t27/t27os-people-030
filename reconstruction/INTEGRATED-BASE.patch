+/// A live block as cs_open leaves it on a dual-stack socket (sock6) or an IPv4 one, with no socket (fd -1).
+fn t6_block(s: []u8, sock6: bool) -> void {
+    ck_wipe(s[0..CS_LEN]);
+    const fp : [10]u8 = [7, 7, 7, 7, 7, 7, 7, 7, 7, 7];
+    ck_put(s, EP_ME, fp[0..10]);
+    s[1] = @as(u8, @intCast(CK_IDLE));
+    cs_p(s, CS_MAGIC, CS_MAGIC_V);
+    cs_p(s, CS_MODE, @as(u64, CS_AUDIO_TEST));
+    if (sock6) { cs_p(s, CS_SOCK6, 1); }
+}
+
+/// The 16 bytes of 3ffe:18:1917:f34e::ff78 (3ffe::/16 is no network's: a test address), then a port.
+fn t6_ep(ep: []u8, port: u64) -> void {
+    const a : [16]u8 = [63, 254, 0, 24, 25, 23, 243, 78, 0, 0, 0, 0, 0, 0, 255, 120];
+    var i : usize = 0;
+    while (i < 16) {
+        ep[i] = a[i];
+        i = i + 1;
+    }
+    ep[16] = @as(u8, @intCast((port >> 8) & 255));
+    ep[17] = @as(u8, @intCast(port & 255));
+}
