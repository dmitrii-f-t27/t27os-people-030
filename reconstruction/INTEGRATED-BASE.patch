+        t[i] = 97 + @as(u8, @intCast(i % 26));
+        i = i + 1;
+    }
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 2, 20, t[0..1500]) == CH_RX_NEW;
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 2, 20, t[0..1500]) == CH_RX_DUP;
+    assert cl_count(log[0..T_LOG]) == 3;
