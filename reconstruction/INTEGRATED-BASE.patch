+module T27DirectoryHealth;
+use t27os::owner_directory::directory_http::dt_line;
+pub fn dh_health_request(b:[2048]u8,n:i64)->bool {
+    return n>=16
+    and b[0]==71
+    and b[1]==69
+    and b[2]==84
+    and b[3]==32
+    and b[4]==47
+    and b[5]==104
+    and b[6]==101
+    and b[7]==97
+    and b[8]==108
+    and b[9]==116
+    and b[10]==104
+    and b[11]==32
+    and b[12]==72
+    and b[13]==84
+    and b[14]==84
+    and b[15]==80;
+}
+test health_route_does_not_accept_root_or_arbitrary_paths {
+    var b:[2048]u8=undefined;
+    var i:u32=0;
+    while(i<2048) {
+        b[i]=0;
+        i=i+1;
+    }
+    assert !dh_health_request(b,0);
+    const text:str="GET /health HTTP";
+    i=0;
+    while(i<16) {
+        b[i]=text[i];
+        i=i+1;
+    }
+    assert dh_health_request(b,16);
+    b[4]=46;
+    assert !dh_health_request(b,16);
+    b[4]=47;
+    b[5]=46;
+    assert !dh_health_request(b,16);
+}
+fn dh_line(out:[512]u8,at:u32,text:str,n:u32)->u32 {
+    return dt_line(out,at,text,n);
+}
+pub fn dh_response(out:[512]u8,ok:bool)->u32 {
+    var at:u32=0;
+    if(ok) {
+        at=dh_line(out,at,"HTTP/1.1 200 OK",15);
+        at=dh_line(out,at,"Content-Type: application/json",30);
+        at=dh_line(out,at,"Content-Length: 40",18);
+        at=dh_line(out,at,"Cache-Control: no-store",23);
+    }
+    else {
+        at=dh_line(out,at,"HTTP/1.1 404 Not Found",22);
+        at=dh_line(out,at,"Content-Length: 0",17);
+    }
+    at=dh_line(out,at,"Connection: close",17);
+    out[at]=13;
+    out[at+1]=10;
+    at=at+2;
+    if(ok) {
+        const body:str="{\"service\":\"t27-owner-qa\",\"health\":\"ok\"}";
+        var i:u32=0;
+        while(i<40) {
+            out[at+i]=body[i];
+            i=i+1;
+        }
+        at=at+40;
+    }
+    return at;
+}
+test response_has_real_crlf_and_bounded_body {
+    var b:[512]u8=undefined;
+    const n:u32=dh_response(b,true);
+    assert n<512 and b[15]==13 and b[16]==10;
+    assert b[n-1]==125 and b[n-40]==123;
+    const m:u32=dh_response(b,false);
+    assert m<512 and b[m-4]==13 and b[m-3]==10 and b[m-2]==13 and b[m-1]==10;
+}
diff --git a/specs/t27os/owner_directory/directory_host.t27 b/specs/t27os/owner_directory/directory_host.t27
new file mode 100644
index 000000000..92ae3e6c5
--- /dev/null
+++ b/specs/t27os/owner_directory/directory_host.t27
@@ -0,0 +1,138 @@
+module T27DirectoryHost;
+// gen-C SDK host: product entry is dt_owner_run mapped to main by the compiler flag.
+// Tests retain the generated T27_TEST_MAIN instead; no generated code is edited.
+// Bounded signed-key directory and pair-authorized opaque relay.
+// No private keys, content keys, file serving, redirects or third-party service calls.
+fn dt_now()->u64 {
+    var tv:[2]i64=undefined;
+    if(gettimeofday(tv,0)!=0) {
+        return 0;
+    }
+    return @as(u64,@intCast(tv[0]))*1000+@as(u64,@intCast(tv[1]))/1000;
+}
+fn dt_send_all(fd:i32,packet:[65536]u8,n:u32)->bool {
+    var at:u32=0;
+    while(at<n) {
+        const sent:i64=send(fd,packet+at,n-at,16384);
+        if(sent<=0) {
+            return false;
+        }
+        at=at+@as(u32,@intCast(sent));
+    }
+    return true;
+}
+pub fn dt_service_port()->u32 {
+    return 49300;
+}
+pub fn dt_owner_run()->i32 {
+    const fd:i32=socket(10,1,0);
+    if(fd<0) {
+        return 1;
+    }
+    var on:[1]i32=undefined;
+    on[0]=1;
+    var off:[1]i32=undefined;
+    off[0]=0;
+    setsockopt(fd,1,2,on,4);
+    if(setsockopt(fd,41,26,off,4)!=0) {
+        close(fd);
+        return 2;
+    }
+    var sa:[28]u8=undefined;
+    var i:u32=0;
+    while(i<28) {
+        sa[i]=0;
+        i=i+1;
+    }
+    sa[0]=10;
+    const port:u32=dt_service_port();
+    sa[2]=@as(u8,@intCast(port/256));
+    sa[3]=@as(u8,@intCast(port%256));
+    if(bind(fd,sa,28)!=0 or listen(fd,8)!=0) {
+        close(fd);
+        return 3;
+    }
+    var db:[600000]u8=undefined;
+    i=0;
+    while(i<600000) {
+        db[i]=0;
+        i=i+1;
+    }
+    while(true) {
+        var from:[28]u8=undefined;
+        var size:[1]u32=undefined;
+        size[0]=28;
+        const client:i32=accept(fd,from,size);
+        if(client<0) {
+            continue;
+        }
+        var timeout:[2]i64=undefined;
+        timeout[0]=2;
+        timeout[1]=0;
+        setsockopt(client,1,20,timeout,16);
+        setsockopt(client,1,21,timeout,16);
+        var request:[65536]u8=undefined;
+        var used:u32=0;
+        var end:u32=0;
+        const started:u64=dt_now();
+        while(used<8192 and end==0 and dt_now()-started<3000) {
+            const n:i64=recv(client,request+used,8192-used,0);
+            if(n<=0) {
+                break;
+            }
+            used=used+@as(u32,@intCast(n));
+            end=dt_header_end(request,used);
+        }
+        if(end==0) {
+            close(client);
+            continue;
+        }
+        const length:i64=dt_content_length(request,end);
+        if(length<0 or length>32768) {
+            close(client);
+            continue;
+        }
+        const total:u32=end+@as(u32,@intCast(length));
+        while(used<total and dt_now()-started<3000) {
+            const n:i64=recv(client,request+used,total-used,0);
+            if(n<=0) {
+                break;
+            }
+            used=used+@as(u32,@intCast(n));
+        }
+        if(used!=total) {
+            close(client);
+            continue;
+        }
+        if(dt_post(request,end)) {
+            var packet:[32768]u8=undefined;
+            i=0;
+            while(i<@as(u32,@intCast(length))) {
+                packet[i]=request[end+i];
+                i=i+1;
+            }
+            var random:[16]u8=undefined;
+            if(getrandom(random,16,0)!=16) {
+                close(client);
+                continue;
+            }
+            var response:[65536]u8=undefined;
+            const count:u32=dp_process(db,packet,@as(u32,@intCast(length)),response,dt_now(),random);
+            var head:[512]u8=undefined;
+            const h:u32=dt_binary_head(head,count);
+            send(client,head,h,16384);
+            dt_send_all(client,response,count);
+        }
+        else {
+            var response:[512]u8=undefined;
+            const count:u32=dh_response(response,dh_health_request(request,used));
+            send(client,response,count,16384);
+        }
+        close(client);
+    }
+    close(fd);
+    return 0;
+}
+test owner_directory_uses_unprivileged_fixed_service_port {
+    assert dt_service_port()==49300 and dt_service_port()>1024 and dt_service_port()<65536;
+}
diff --git a/specs/t27os/owner_directory/directory_http.t27 b/specs/t27os/owner_directory/directory_http.t27
new file mode 100644
index 000000000..3c494aad2
--- /dev/null
+++ b/specs/t27os/owner_directory/directory_http.t27
@@ -0,0 +1,199 @@
+module T27DirectoryHTTP;
+// Bounded HTTP/1 framing for one dedicated endpoint. No chunked bodies or file routing.
+pub fn dt_header_end(b:[65536]u8,n:u32)->u32 {
+    if(n>65536) {
+        return 0;
+    }
+    var i:u32=0;
+    while(i+3<n and i<8192) {
+        if(b[i]==13 and b[i+1]==10 and b[i+2]==13 and b[i+3]==10) {
+            return i+4;
+        }
+        i=i+1;
+    }
+    return 0;
+}
+fn dt_lower(v:u8)->u8 {
+    return if(v>=65 and v<=90) v+32 else v;
+}
+fn dt_name(b:[65536]u8,at:u32,n:u32,text:str,length:u32)->bool {
+    if(n!=length) {
+        return false;
+    }
+    var i:u32=0;
+    while(i<n) {
+        if(dt_lower(b[at+i])!=@as(u8,text[i])) {
+            return false;
+        }
+        i=i+1;
+    }
+    return true;
+}
+pub fn dt_content_length(b:[65536]u8,end:u32)->i64 {
+    if(end<4 or end>8196) {
+        return -1;
+    }
+    var cursor:u32=0;
+    while(cursor+1<end) {
+        if(b[cursor]==13 and b[cursor+1]==10) {
+            cursor=cursor+2;
+            break;
+        }
+        cursor=cursor+1;
+    }
+    var found:bool=false;
+    var length:u32=0;
+    while(cursor+1<end) {
+        if(b[cursor]==13 and b[cursor+1]==10) {
+            break;
+        }
+        const start:u32=cursor;
+        var colon:u32=0;
+        while(cursor+1<end and !(b[cursor]==13 and b[cursor+1]==10)) {
+            if(b[cursor]==0) {
+                return -1;
+            }
+            if(b[cursor]==58 and colon==0) {
+                colon=cursor;
+            }
+            cursor=cursor+1;
+        }
+        if(cursor+1>=end or colon==0) {
+            return -1;
+        }
+        if(dt_name(b,start,colon-start,"transfer-encoding",17)) {
+            return -1;
+        }
+        if(dt_name(b,start,colon-start,"content-length",14)) {
+            if(found) {
+                return -1;
+            }
+            found=true;
+            var at:u32=colon+1;
+            while(at<cursor and b[at]==32) {
+                at=at+1;
+            }
+            if(at==cursor) {
+                return -1;
+            }
+            while(at<cursor) {
+                if(b[at]<48 or b[at]>57) {
+                    return -1;
+                }
+                length=length*10+@as(u32,b[at]-48);
+                if(length>32768) {
+                    return -1;
+                }
+                at=at+1;
+            }
+        }
+        cursor=cursor+2;
+    }
+    return @as(i64,length);
+}
+pub fn dt_post(b:[65536]u8,n:u32)->bool {
+    return n>=18
+    and b[0]==80
+    and b[1]==79
+    and b[2]==83
+    and b[3]==84
+    and b[4]==32
+    and b[5]==47
+    and b[6]==116
+    and b[7]==50
+    and b[8]==55
+    and b[9]==32
+    and b[10]==72
+    and b[11]==84
+    and b[12]==84
+    and b[13]==80
+    and b[14]==47
+    and b[15]==49
+    and b[16]==46
+    and b[17]==49;
+}
+pub fn dt_line(out:[512]u8,at:u32,text:str,n:u32)->u32 {
+    var i:u32=0;
+    while(i<n) {
+        out[at+i]=text[i];
+        i=i+1;
+    }
+    out[at+n]=13;
+    out[at+n+1]=10;
+    return at+n+2;
+}
+pub fn dt_binary_head(out:[512]u8,length:u32)->u32 {
+    var at:u32=dt_line(out,0,"HTTP/1.1 200 OK",15);
+    at=dt_line(out,at,"Content-Type: application/octet-stream",38);
+    const name:str="Content-Length: ";
+    var i:u32=0;
+    while(i<16) {
+        out[at+i]=name[i];
+        i=i+1;
+    }
+    at=at+16;
+    var digits:[10]u8=undefined;
+    var count:u32=0;
+    var value:u32=length;
+    while(true) {
+        digits[count]=@as(u8,@intCast(value%10))+48;
+        count=count+1;
+        value=value/10;
+        if(value==0) {
+            break;
+        }
+    }
+    while(count>0) {
+        count=count-1;
+        out[at]=digits[count];
+        at=at+1;
+    }
+    out[at]=13;
+    out[at+1]=10;
+    at=at+2;
+    at=dt_line(out,at,"Cache-Control: no-store",23);
+    at=dt_line(out,at,"Connection: close",17);
+    out[at]=13;
+    out[at+1]=10;
+    return at+2;
+}
+test strict_http_framing_refuses_ambiguous_or_oversized_lengths {
+    var b:[65536]u8=undefined;
+    var i:u32=0;
+    while(i<65536) {
+        b[i]=0;
+        i=i+1;
+    }
+    // Build real CRLF bytes rather than relying on target string escape differences.
+    const line:str="POST /t27 HTTP/1.1";
+    i=0;
+    while(i<18) {
+        b[i]=line[i];
+        i=i+1;
+    }
+    b[18]=13;
+    b[19]=10;
+    const header:str="Content-Length: 304";
+    i=0;
+    while(i<19) {
+        b[20+i]=header[i];
+        i=i+1;
+    }
+    b[39]=13;
+    b[40]=10;
+    b[41]=13;
+    b[42]=10;
+    assert dt_header_end(b,43)==43 and dt_content_length(b,43)==304 and dt_post(b,43);
+    b[36]=57;
+    b[37]=57;
+    b[38]=57;
+    assert dt_content_length(b,43)==999;
+    b[20]=0;
+    assert dt_content_length(b,43)==-1;
+    assert dt_header_end(b,65537)==0;
+}
+test binary_response_header_is_bounded_and_uses_crlf {
+    var out:[512]u8=undefined;
+    const n:u32=dt_binary_head(out,32832);
+    assert n<512 and out[15]==13 and out[16]==10 and out[n-4]==13 and out[n-3]==10 and out[n-2]==13 and out[n-1]==10;
+}
diff --git a/specs/t27os/owner_directory/directory_protocol.t27 b/specs/t27os/owner_directory/directory_protocol.t27
new file mode 100644
index 000000000..439dcb7b9
--- /dev/null
+++ b/specs/t27os/owner_directory/directory_protocol.t27
@@ -0,0 +1,857 @@
+module T27DirectoryProtocol;
+// Fixed bounded HTTP envelope. Private keys and content keys never enter this process.
+const DP_HELLO:u8=1;
+const DP_PROVE:u8=2;
+const DP_POLL:u8=3;
+const DP_LOOKUP:u8=4;
+const DP_ROOM_REQUEST:u8=5;
+const DP_ROOM_CONSENT:u8=6;
+const DP_DATA:u8=7;
+const DP_CLOSE:u8=8;
+const DP_ADVERTISE:u8=9;
+const DS_ADVERTISED:u8=11;
+const DP_PROOF_LENGTHS:u32=545000;
+const DP_PROOFS:u32=550000;
+const DP_PROOF_SIZE:u32=512;
+const DS_CHALLENGE:u8=1;
+const DS_REGISTERED:u8=2;
+const DS_INBOX:u8=3;
+const DS_ONLINE:u8=4;
+const DS_ROOM_PENDING:u8=5;
+const DS_ROOM_ADMITTED:u8=6;
+const DS_ROOM_READY:u8=7;
+const DS_OFFLINE:u8=8;
+const DS_CLOSED:u8=9;
+const DS_FORWARDED:u8=10;
+const DS_MALFORMED:u8=20;
+const DS_BUSY:u8=21;
+const DS_BAD_NONCE:u8=22;
+const DS_BAD_SIGNATURE:u8=23;
+const DS_SESSION:u8=24;
+const DS_REPLAY:u8=25;
+const DS_ROOM_REFUSED:u8=26;
+const DS_RATE_LIMIT:u8=27;
+const DP_PUBLIC:u32=56;
+const DP_TARGET:u32=121;
+const DP_HASH:u32=186;
+const DP_SIGNATURE_LENGTH:u32=218;
+const DP_BODY_LENGTH:u32=220;
+const DP_SIGNATURE:u32=224;
+const DP_REGS:u32=16;
+const DP_REG_SIZE:u32=320;
+const DP_PENDING:u32=8192;
+const DP_PENDING_SIZE:u32=192;
+const DP_ROOMS:u32=12288;
+const DP_ROOM_SIZE:u32=256;
+const DP_QUEUES:u32=16384;
+const DP_QUEUE_SIZE:u32=32768;
+const DP_HEADER:u32=304;
+const DP_BODY_MAX:u32=32464;
+fn dp_u32(b:[32768]u8,at:u32)->u32 {
+    return @as(u32,b[at])|(@as(u32,b[at+1])<<8)|(@as(u32,b[at+2])<<16)|(@as(u32,b[at+3])<<24);
+}
+fn dp_u64(b:[32768]u8,at:u32)->u64 {
+    var v:u64=0;
+    var i:u32=0;
+    while(i<8) {
+        v=v|(@as(u64,b[at+i])<<(i*8));
+        i=i+1;
+    }
+    return v;
+}
+fn dp_db64(db:[600000]u8,at:u32)->u64 {
+    var v:u64=0;
+    var i:u32=0;
+    while(i<8) {
+        v=v|(@as(u64,db[at+i])<<(i*8));
+        i=i+1;
+    }
+    return v;
+}
+fn dp_db32(db:[600000]u8,at:u32)->u32 {
+    var v:u32=0;
+    var i:u32=0;
+    while(i<4) {
+        v=v|(@as(u32,db[at+i])<<(i*8));
+        i=i+1;
+    }
+    return v;
+}
+fn dp_put64(db:[600000]u8,at:u32,v:u64)->void {
+    var i:u32=0;
+    while(i<8) {
+        db[at+i]=@as(u8,@intCast((v>>(i*8))&255));
+        i=i+1;
+    }
+}
+fn dp_put32(db:[600000]u8,at:u32,v:u32)->void {
+    var i:u32=0;
+    while(i<4) {
+        db[at+i]=@as(u8,@intCast((v>>(i*8))&255));
+        i=i+1;
+    }
+}
+fn dp_eq(db:[600000]u8,at:u32,b:[32768]u8,bt:u32,n:u32)->bool {
+    var i:u32=0;
+    var diff:u8=0;
+    while(i<n) {
+        diff=diff|(db[at+i]^b[bt+i]);
+        i=i+1;
+    }
+    return diff==0;
+}
+fn dp_copy_in(db:[600000]u8,at:u32,b:[32768]u8,bt:u32,n:u32)->void {
+    var i:u32=0;
+    while(i<n) {
+        db[at+i]=b[bt+i];
+        i=i+1;
+    }
+}
+pub fn dp_shape(b:[32768]u8,n:u32)->bool {
+    if(n<DP_HEADER or n>DP_HEADER+DP_BODY_MAX) {
+        return false;
+    }
+    if(b[0]!=84 or b[1]!=50 or b[2]!=55 or b[3]!=68 or b[4]!=1 or b[5]<1 or b[5]>9 or b[DP_PUBLIC]!=4) {
+        return false;
+    }
+    const body:u32=dp_u32(b,DP_BODY_LENGTH);
+    const sig:u32=@as(u32,b[DP_SIGNATURE_LENGTH])+(@as(u32,b[DP_SIGNATURE_LENGTH+1])<<8);
+    if(body>DP_BODY_MAX or n!=DP_HEADER+body or sig>80) {
+        return false;
+    }
+    if(b[5]==1) {
+        return sig==0 and body==0;
+    }
+    return sig>=8;
+}
+fn dp_signature(b:[32768]u8)->bool {
+    var public_key:[65]u8=undefined;
+    var message:[512]u8=undefined;
+    var signature:[80]u8=undefined;
+    var digest:[32]u8=undefined;
+    const n:u32=dp_u32(b,DP_BODY_LENGTH);
+    SHA256(b+DP_HEADER,n,digest);
+    var diff:u8=0;
+    var i:u32=0;
+    while(i<32) {
+        diff=diff|(digest[i]^b[DP_HASH+i]);
+        i=i+1;
+    }
+    if(diff!=0) {
+        return false;
+    }
+    i=0;
+    while(i<65) {
+        public_key[i]=b[DP_PUBLIC+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<218) {
+        message[i]=b[i];
+        i=i+1;
+    }
+    i=0;
+    while(i<4) {
+        message[218+i]=b[DP_BODY_LENGTH+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<80) {
+        signature[i]=b[DP_SIGNATURE+i];
+        i=i+1;
+    }
+    return dr_verify(public_key,message,222,signature,@as(u32,b[DP_SIGNATURE_LENGTH])+(@as(u32,b[DP_SIGNATURE_LENGTH+1])<<8));
+}
+fn dp_reply(out:[65536]u8,b:[32768]u8,status:u8,expiry:u64,nonce:[16]u8)->u32 {
+    var i:u32=0;
+    while(i<64) {
+        out[i]=0;
+        i=i+1;
+    }
+    out[0]=84;
+    out[1]=50;
+    out[2]=55;
+    out[3]=65;
+    out[4]=1;
+    out[5]=status;
+    out[6]=b[5];
+    i=0;
+    while(i<24) {
+        out[8+i]=b[8+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<8) {
+        out[32+i]=@as(u8,@intCast((expiry>>(i*8))&255));
+        i=i+1;
+    }
+    i=0;
+    while(i<16) {
+        out[40+i]=nonce[i];
+        i=i+1;
+    }
+    return 64;
+}
+fn dp_reply_length(out:[65536]u8,n:u32)->void {
+    var i:u32=0;
+    while(i<4) {
+        out[56+i]=@as(u8,@intCast((n>>(i*8))&255));
+        i=i+1;
+    }
+}
+fn dp_find(db:[600000]u8,b:[32768]u8,offset:u32,now:u64)->u32 {
+    var i:u32=0;
+    while(i<DP_REGS) {
+        const at:u32=i*DP_REG_SIZE;
+        if(db[at]==1 and dp_db64(db,at+96)>now and dp_eq(db,at+8,b,offset,65)) {
+            return i;
+        }
+        i=i+1;
+    }
+    return DP_REGS;
+}
+fn dp_room_valid(db:[600000]u8,at:u32,now:u64)->bool {
+    if(db[at]==0 or dp_db64(db,at+24)<=now or db[at+1]>=16 or db[at+2]>=16) {
+        return false;
+    }
+    const a:u32=@as(u32,db[at+1])*DP_REG_SIZE;
+    const b:u32=@as(u32,db[at+2])*DP_REG_SIZE;
+    if(db[a]!=1 or db[b]!=1 or dp_db64(db,a+96)<=now or dp_db64(db,b+96)<=now) {
+        return false;
+    }
+    var i:u32=0;
+    while(i<16) {
+        if(db[a+80+i]!=db[at+32+i] or db[b+80+i]!=db[at+48+i]) {
+            return false;
+        }
+        i=i+1;
+    }
+    return true;
+}
+fn dp_enqueue(db:[600000]u8,to:u32,kind:u8,channel:u8,room:u32,from:u32,b:[32768]u8,payload:u32,n:u32)->bool {
+    if(to>=16 or from>=16 or room<DP_ROOMS or room+DP_ROOM_SIZE>DP_QUEUES or n>2048) {
+        return false;
+    }
+    const current:u32=dp_db32(db,to*DP_REG_SIZE+112);
+    const length:u32=85+n;
+    if(current>DP_QUEUE_SIZE or length>DP_QUEUE_SIZE-current) {
+        return false;
+    }
+    const at:u32=DP_QUEUES+to*DP_QUEUE_SIZE+current;
+    db[at]=kind;
+    db[at+1]=channel;
+    db[at+2]=@as(u8,@intCast(n&255));
+    db[at+3]=@as(u8,@intCast(n>>8));
+    var i:u32=0;
+    while(i<16) {
+        db[at+4+i]=db[room+8+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<65) {
+        db[at+20+i]=db[from*DP_REG_SIZE+8+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<n) {
+        db[at+85+i]=b[payload+i];
+        i=i+1;
+    }
+    dp_put32(db,to*DP_REG_SIZE+112,current+length);
+    return true;
+}
+fn dp_reject(out:[65536]u8,status:u8)->u32 {
+    var i:u32=0;
+    while(i<64) {
+        out[i]=0;
+        i=i+1;
+    }
+    out[0]=84;
+    out[1]=50;
+    out[2]=55;
+    out[3]=65;
+    out[4]=1;
+    out[5]=status;
+    return 64;
+}
+fn dp_room_ack(db:[600000]u8,pos:u32,reg:u32,peer:u32,b:[32768]u8,now:u64)->u8 {
+    const mask:u8=if(db[pos+1]==reg) 1 else 2;
+    const next:u8=db[pos+4]|mask;
+    const kind:u8=if(next==3) 2 else 1;
+    if(!dp_enqueue(db,peer,kind,0,pos,reg,b,0,304)) {
+        return 21;
+    }
+    db[pos+4]=next;
+    if(next==3) {
+        db[pos]=3;
+        dp_put64(db,pos+24,now+120000);
+        return 7;
+    }
+    return 6;
+}
+fn dp_batch_space(db:[600000]u8,peer:u32,b:[32768]u8,length:u32)->bool {
+    if(peer>=16 or length>DP_BODY_MAX) {
+        return false;
+    }
+    var cursor:u32=0;
+    var needed:u32=0;
+    while(cursor<length) {
+        if(cursor+2>length) {
+            return false;
+        }
+        const size:u32=@as(u32,b[DP_HEADER+cursor])+(@as(u32,b[DP_HEADER+cursor+1])<<8);
+        if(size<52 or size>2048 or cursor+2+size>length) {
+            return false;
+        }
+        needed=needed+85+size;
+        cursor=cursor+2+size;
+    }
+    const current:u32=dp_db32(db,peer*DP_REG_SIZE+112);
+    return current<=DP_QUEUE_SIZE and needed<=DP_QUEUE_SIZE-current;
+}
+fn dp_poll(db:[600000]u8,reg:u32,b:[32768]u8,out:[65536]u8,expiry:u64)->u32 {
+    const at:u32=reg*DP_REG_SIZE;
+    const input:u32=dp_u32(b,DP_BODY_LENGTH);
+    var zero:[16]u8=undefined;
+    var i:u32=0;
+    while(i<16) {
+        zero[i]=0;
+        i=i+1;
+    }
+    if(input!=0 and input!=8) {
+        return dp_reply(out,b,DS_MALFORMED,expiry,zero);
+    }
+    const ack:u64=if(input==8) dp_u64(b,304) else 0;
+    var serial:u64=dp_db64(db,at+128);
+    var sent:u32=dp_db32(db,at+116);
+    var length:u32=dp_db32(db,at+112);
+    if(length>DP_QUEUE_SIZE or sent>length or ack>serial) {
+        return dp_reply(out,b,DS_MALFORMED,expiry,zero);
+    }
+    if(sent>0 and ack==serial) {
+        i=sent;
+        while(i<length) {
+            db[DP_QUEUES+reg*DP_QUEUE_SIZE+i-sent]=db[DP_QUEUES+reg*DP_QUEUE_SIZE+i];
+            i=i+1;
+        }
+        length=length-sent;
+        sent=0;
+        dp_put32(db,at+112,length);
+        dp_put32(db,at+116,0);
+    }
+    if(sent==0 and length>0) {
+        serial=serial+1;
+        sent=length;
+        dp_put64(db,at+128,serial);
+        dp_put32(db,at+116,sent);
+    }
+    if(sent>0) {
+        i=0;
+        while(i<8) {
+            zero[i]=@as(u8,@intCast((serial>>(i*8))&255));
+            i=i+1;
+        }
+    }
+    dp_reply(out,b,DS_INBOX,expiry,zero);
+    i=0;
+    while(i<sent) {
+        out[64+i]=db[DP_QUEUES+reg*DP_QUEUE_SIZE+i];
+        i=i+1;
+    }
+    dp_reply_length(out,sent);
+    return 64+sent;
+}
+fn dp_drop_reg_rooms(db:[600000]u8,reg:u32)->void {
+    var i:u32=0;
+    while(i<DP_REGS) {
+        const at:u32=DP_ROOMS+i*DP_ROOM_SIZE;
+        if(db[at]!=0 and (db[at+1]==reg or db[at+2]==reg)) {
+            db[at]=0;
+        }
+        i=i+1;
+    }
+}
+fn dp_rate(db:[600000]u8,now:u64,hello:bool)->bool {
+    const at:u32=if(hello) 599016 else 599000;
+    const second:u64=now/1000;
+    if(dp_db64(db,at)!=second) {
+        dp_put64(db,at,second);
+        dp_put32(db,at+8,0);
+    }
+    const count:u32=dp_db32(db,at+8);
+    const limit:u32=if(hello) 16 else 128;
+    if(count>=limit) {
+        return false;
+    }
+    dp_put32(db,at+8,count+1);
+    return true;
+}
+pub fn dp_process(db:[600000]u8,b:[32768]u8,n:u32,out:[65536]u8,now:u64,random:[16]u8)->u32 {
+    var empty:[16]u8=undefined;
+    var i:u32=0;
+    while(i<16) {
+        empty[i]=0;
+        i=i+1;
+    }
+    if(!dp_shape(b,n)) {
+        return dp_reject(out,DS_MALFORMED);
+    }
+    const operation:u8=b[5];
+    if(!dp_rate(db,now,operation==DP_HELLO)) {
+        return dp_reply(out,b,DS_RATE_LIMIT,0,empty);
+    }
+    if(operation==DP_HELLO) {
+        var slot:u32=16;
+        i=0;
+        while(i<16) {
+            const at:u32=DP_PENDING+i*DP_PENDING_SIZE;
+            if(db[at]==0 or dp_db64(db,at+112)<=now) {
+                slot=i;
+                break;
+            }
+            i=i+1;
+        }
+        if(slot==16) {
+            return dp_reply(out,b,DS_BUSY,0,empty);
+        }
+        const at:u32=DP_PENDING+slot*DP_PENDING_SIZE;
+        db[at]=1;
+        dp_copy_in(db,at+8,b,DP_PUBLIC,65);
+        dp_copy_in(db,at+80,b,8,16);
+        i=0;
+        while(i<16) {
+            db[at+96+i]=random[i];
+            i=i+1;
+        }
+        dp_put64(db,at+112,now+10000);
+        return dp_reply(out,b,DS_CHALLENGE,now+10000,random);
+    }
+    if(operation==DP_PROVE) {
+        var slot:u32=16;
+        i=0;
+        while(i<16) {
+            const at:u32=DP_PENDING+i*DP_PENDING_SIZE;
+            if(db[at]==1
+            and dp_db64(db,at+112)>now
+            and dp_db64(db,at+112)==dp_u64(b,32)
+            and dp_eq(db,at+8,b,DP_PUBLIC,65)
+            and dp_eq(db,at+80,b,8,16)
+            and dp_eq(db,at+96,b,40,16)) {
+                slot=i;
+                break;
+            }
+            i=i+1;
+        }
+        if(slot==16) {
+            return dp_reply(out,b,DS_BAD_NONCE,0,empty);
+        }
+        if(!dp_signature(b)) {
+            return dp_reply(out,b,DS_BAD_SIGNATURE,0,empty);
+        }
+        const pending:u32=DP_PENDING+slot*DP_PENDING_SIZE;
+        db[pending]=0;
+        var reg:u32=dp_find(db,b,DP_PUBLIC,now);
+        if(reg==16) {
+            i=0;
+            while(i<16) {
+                const at:u32=i*DP_REG_SIZE;
+                if(db[at]==0 or dp_db64(db,at+96)<=now) {
+                    reg=i;
+                    break;
+                }
+                i=i+1;
+            }
+        }
+        if(reg==16) {
+            return dp_reply(out,b,DS_BUSY,0,empty);
+        }
+        const at:u32=reg*DP_REG_SIZE;
+        dp_drop_reg_rooms(db,reg);
+        i=0;
+        while(i<DP_REG_SIZE) {
+            db[at+i]=0;
+            i=i+1;
+        }
+        db[at]=1;
+        dp_copy_in(db,at+8,b,DP_PUBLIC,65);
+        dp_copy_in(db,at+80,b,8,16);
+        dp_put64(db,at+96,now+60000);
+        dp_put64(db,at+104,dp_u64(b,24));
+        dp_put32(db,DP_PROOF_LENGTHS+reg*4,0);
+        return dp_reply(out,b,DS_REGISTERED,now+60000,empty);
+    }
+    const reg:u32=dp_find(db,b,DP_PUBLIC,now);
+    if(reg==16) {
+        return dp_reply(out,b,DS_SESSION,0,empty);
+    }
+    const at:u32=reg*DP_REG_SIZE;
+    if(!dp_eq(db,at+80,b,8,16) or (dp_u64(b,32)<=now or dp_u64(b,32)>dp_db64(db,at+96))) {
+        return dp_reply(out,b,DS_SESSION,0,empty);
+    }
+    if(dp_u64(b,24)<=dp_db64(db,at+104)) {
+        return dp_reply(out,b,DS_REPLAY,0,empty);
+    }
+    if(!dp_signature(b)) {
+        return dp_reply(out,b,DS_BAD_SIGNATURE,0,empty);
+    }
+    dp_put64(db,at+104,dp_u64(b,24));
+    dp_put64(db,at+96,now+60000);
+    if(operation==DP_ADVERTISE) {
+        const length:u32=dp_u32(b,DP_BODY_LENGTH);
+        if(!dp_candidates(b,length) or !dp_eq(db,at+8,b,DP_TARGET,65)) {
+            return dp_reply(out,b,DS_MALFORMED,now+60000,empty);
+        }
+        dp_copy_in(db,DP_PROOFS+reg*DP_PROOF_SIZE,b,0,DP_HEADER+length);
+        dp_put32(db,DP_PROOF_LENGTHS+reg*4,DP_HEADER+length);
+        return dp_reply(out,b,DS_ADVERTISED,now+60000,empty);
+    }
+    if(operation==DP_POLL) {
+        return dp_poll(db,reg,b,out,now+60000);
+    }
+    if(operation==DP_CLOSE) {
+        var target_zero:bool=true;
+        i=0;
+        while(i<65) {
+            if(b[DP_TARGET+i]!=0) {
+                target_zero=false;
+            }
+            i=i+1;
+        }
+        if(target_zero) {
+            dp_drop_reg_rooms(db,reg);
+            db[at]=0;
+            return dp_reply(out,b,DS_CLOSED,0,empty);
+        }
+    }
+    const peer:u32=dp_find(db,b,DP_TARGET,now);
+    if(peer==16 or peer==reg) {
+        return dp_reply(out,b,DS_OFFLINE,now+60000,empty);
+    }
+    if(operation==DP_LOOKUP) {
+        dp_reply(out,b,DS_ONLINE,now+60000,empty);
+        const length:u32=dp_db32(db,DP_PROOF_LENGTHS+peer*4);
+        if(length>=305 and length<=449 and dp_db64(db,DP_PROOFS+peer*DP_PROOF_SIZE+32)>now) {
+            dp_reply_length(out,length);
+            i=0;
+            while(i<length) {
+                out[64+i]=db[DP_PROOFS+peer*DP_PROOF_SIZE+i];
+                i=i+1;
+            }
+            return 64+length;
+        }
+        return 64;
+    }
+    if(operation==DP_ROOM_REQUEST) {
+        var room:u32=16;
+        var pending_count:u32=0;
+        i=0;
+        while(i<16) {
+            const pos:u32=DP_ROOMS+i*DP_ROOM_SIZE;
+            if(dp_room_valid(db,pos,now)) {
+                if(db[pos+1]==reg and db[pos]!=3) {
+                    pending_count=pending_count+1;
+                }
+            }
+            else {
+                if(room==16) {
+                    room=i;
+                }
+            }
+            i=i+1;
+        }
+        if(room==16 or pending_count>=2) {
+            return dp_reply(out,b,DS_BUSY,now+60000,empty);
+        }
+        const pos:u32=DP_ROOMS+room*DP_ROOM_SIZE;
+        i=0;
+        while(i<DP_ROOM_SIZE) {
+            db[pos+i]=0;
+            i=i+1;
+        }
+        db[pos]=1;
+        db[pos+1]=@as(u8,@intCast(reg));
+        db[pos+2]=@as(u8,@intCast(peer));
+        i=0;
+        while(i<16) {
+            db[pos+8+i]=random[i];
+            db[pos+32+i]=db[at+80+i];
+            db[pos+48+i]=db[peer*DP_REG_SIZE+80+i];
+            i=i+1;
+        }
+        dp_put64(db,pos+24,now+15000);
+        return dp_reply(out,b,DS_ROOM_PENDING,now+60000,random);
+    }
+    var room:u32=16;
+    i=0;
+    while(i<16) {
+        const pos:u32=DP_ROOMS+i*DP_ROOM_SIZE;
+        if(dp_room_valid(db,pos,now) and dp_eq(db,pos+8,b,40,16) and ((db[pos+1]==reg and db[pos+2]==peer) or (db[pos+2]==reg and db[pos+1]==peer))) {
+            room=i;
+            break;
+        }
+        i=i+1;
+    }
+    if(room==16) {
+        return dp_reply(out,b,DS_ROOM_REFUSED,now+60000,empty);
+    }
+    const pos:u32=DP_ROOMS+room*DP_ROOM_SIZE;
+    if(operation==DP_ROOM_CONSENT) {
+        return dp_reply(out,b,dp_room_ack(db,pos,reg,peer,b,now),now+60000,empty);
+    }
+    if(operation==DP_CLOSE) {
+        db[pos]=0;
+        return dp_reply(out,b,DS_CLOSED,now+60000,empty);
+    }
+    if(operation!=DP_DATA or db[pos]!=3 or (b[6]!=1 and b[6]!=2)) {
+        return dp_reply(out,b,DS_ROOM_REFUSED,now+60000,empty);
+    }
+    const length:u32=dp_u32(b,DP_BODY_LENGTH);
+    var cursor:u32=0;
+    // Validate the entire batch before enqueueing any frame.
+    while(cursor<length) {
+        if(cursor+2>length) {
+            return dp_reply(out,b,DS_MALFORMED,now+60000,empty);
+        }
+        const size:u32=@as(u32,b[DP_HEADER+cursor])+(@as(u32,b[DP_HEADER+cursor+1])<<8);
+        if(size<52 or size>2048 or cursor+2+size>length) {
+            return dp_reply(out,b,DS_MALFORMED,now+60000,empty);
+        }
+        cursor=cursor+2+size;
+    }
+    if(!dp_batch_space(db,peer,b,length)) {
+        return dp_reply(out,b,DS_BUSY,now+60000,empty);
+    }
+    cursor=0;
+    while(cursor<length) {
+        const size:u32=@as(u32,b[DP_HEADER+cursor])+(@as(u32,b[DP_HEADER+cursor+1])<<8);
+        if(!dp_enqueue(db,peer,3,b[6],pos,reg,b,306+cursor,size)) {
+            return dp_reply(out,b,DS_BUSY,now+60000,empty);
+        }
+        cursor=cursor+2+size;
+    }
+    dp_put64(db,pos+24,now+120000);
+    return dp_reply(out,b,DS_FORWARDED,now+60000,empty);
+}
+test protocol_layout_and_wire_bounds_are_closed {
+    assert DP_REGS*DP_REG_SIZE<=DP_PENDING;
+    assert DP_PENDING+DP_REGS*DP_PENDING_SIZE<=DP_ROOMS;
+    assert DP_ROOMS+DP_REGS*DP_ROOM_SIZE==DP_QUEUES;
+    assert DP_QUEUES+DP_REGS*DP_QUEUE_SIZE<=600000;
+    var b:[32768]u8=undefined;
+    var i:u32=0;
+    while(i<32768) {
+        b[i]=0;
+        i=i+1;
+    }
+    assert !dp_shape(b,0);
+    b[0]=84;
+    b[1]=50;
+    b[2]=55;
+    b[3]=68;
+    b[4]=1;
+    b[5]=1;
+    b[DP_PUBLIC]=4;
+    assert dp_shape(b,304);
+    b[220]=1;
+    assert !dp_shape(b,304);
+    b[220]=0;
+    b[5]=2;
+    assert !dp_shape(b,304);
+}
+test one_participant_cannot_extend_the_other_lease {
