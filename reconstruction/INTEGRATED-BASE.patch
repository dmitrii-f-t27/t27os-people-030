+fn csg_t_list(out: []u8, n: usize) -> usize {
+    gr_list_init(out);
+    var f : [10]u8 = undefined;
+    ck_fill_session(f[0..10], 3);
+    var k : usize = 0;
+    while (k < n) {
+        f[0] = @as(u8, @intCast(k + 1));
+        gr_list_add(out, f[0..10], 3232235777 + @as(u64, k), 47727);
+        k = k + 1;
+    }
+    return GR_LIST_HDR + gr_list_count(out) * GR_ENTRY;
+}
