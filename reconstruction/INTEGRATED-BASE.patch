+    assert cs_vstat(z, CS_V_SHOWN) == 201 and cs_vstat(z, CS_V_SKIPPED) == 202 and cs_vstat(z, CS_V_RXPARTS) == 203;
+    assert cs_vstat(z, CS_V_REFUSED) == 204 and cs_vstat(z, CS_V_STALE) == 205 and cs_vstat(z, CS_V_RXHASH) == 206;
+    assert cs_vstat(z, CS_V_LASTAT) == 207 and cs_vstat(z, CS_V_LASTSIZE) == 208 and cs_vstat(z, CS_V_LASTFRAME) == 209;
+    assert cs_vstat(z, CS_V_TXFRAMES) == 300 + VT_FRAMES and cs_vstat(z, CS_V_TXPARTS) == 300 + VT_PARTS;
+    assert cs_vstat(z, CS_V_TXDROPPED) == 300 + VT_DROPPED and cs_vstat(z, CS_V_TXHASH) == 300 + VT_HASH;
+    assert cs_vstat(z, CS_V_GEN) == 300 + VT_GEN and cs_vstat(z, CS_V_CAM) == 300 + VT_CAM;
+    assert cs_vstat(z, CS_V_ERR) == 300 + VT_ERR and cs_vstat(z, CS_V_SENDERR) == 300 + VT_SENDERR;
+    assert cs_vstat(z, CS_V_MAKE_MAX) == 300 + VT_MAKE_MAX and cs_vstat(z, CS_V_SERIAL) == 300 + VT_SERIAL;
+    assert cs_vstat(z, CS_V_DROPHASH) == 300 + VT_DROPHASH and cs_vstat(z, CS_V_ENCSKIP) == 300 + VT_ENCSKIP;
+    assert cs_vstat(z, 21) == 0;
+    assert cs_vlen(z) == 300 + VT_LASTLEN;
+    // a short slice reads nothing
+    assert cs_vstat(s[0..CS_LEN - 1], CS_V_SHOWN) == 0 and cs_vlen(s[0..CS_LEN - 1]) == 0;
+    // "video on": a frame completed within the last second
+    put_u64(z, CS_VID + VR_AT * 8, 5000);
