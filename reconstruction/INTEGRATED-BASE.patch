+test cv_a_launch_takes_the_first_free_port_and_goes_back_to_a_free_base {
+    // the launch as the window runs it, over a set of taken ports
+    var taken : [3]u64 = undefined;
+    taken[0] = 47727;
+    taken[1] = 47729;
+    taken[2] = 0;
+    var round : usize = 0;
+    var saved : u64 = 0;
+    while (round < 2) {
+        var p : [10]u64 = undefined;
+        const n : usize = cv_port_plan(47727, saved, p[0..10]);
+        var st : [3]u64 = undefined;
+        st[0] = 0;
+        st[1] = 0;
+        st[2] = 0;
+        var i : usize = 0;
+        var go : bool = true;
+        while (go and i < n) {
+            const ok : bool = p[i] != taken[0] and p[i] != taken[1];
+            go = cv_port_step(st[0..3], 47727, p[i], ok);
+            i = i + 1;
+        }
+        var f : [80]u8 = undefined;
+        const fl : usize = cv_port_save_text(st[0..3], 1792000000, f[0..80]);
+        if (round == 0) {
+            // 47727 taken: 47728 opens, the file names it, the panel says so
+            assert st[CV_PS_USED] == 47728 and fl > 0;
+            var t : [96]u8 = undefined;
+            assert cv_eq(t[0..96], cv_port_busy_text(47727, st[CV_PS_USED], st[CV_PS_BUSY], t[0..96]), "port 47727 busy, using 47728");
+            assert cv_eq(t[0..96], cv_port_line(true, st[CV_PS_USED], st[CV_PS_BUSY], st[CV_PS_TRIED], t[0..96]), "ONLINE  port 47728");
+            // the next launch: the base is free again
+            taken[0] = 0;
+        } else {
+            assert st[CV_PS_USED] == 47727 and st[CV_PS_TRIED] == 1 and st[CV_PS_BUSY] == 0;
+            assert cv_cp_parse(f[0..fl]) == 47727;
+        }
+        saved = cv_cp_parse(f[0..fl]);
+        round = round + 1;
+    }
+}
