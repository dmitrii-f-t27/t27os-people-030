+/// A group call of `secs` seconds polled every 10 ms, two FULL links, the encoder job taking `cost` ms: frames, jobs,
+/// skips, sends, the most jobs in flight and the shortest gap between two frames.
+fn vg_sim(secs: u64, cost: u64, out: []u64) -> void {
+    var st : [5]u64 = undefined;
+    var i : usize = 0;
+    while (i < VG_N) {
+        st[i] = 0;
+        i = i + 1;
+    }
+    var req : u64 = 0;
+    var done : u64 = 0;
+    var due : u64 = 0;
+    var have : bool = false;
+    var maxfly : u64 = 0;
+    var gap : u64 = 1000000;
+    var last : u64 = 0;
+    var t : u64 = 1000;
+    while (t < 1000 + secs * 1000) {
+        if (req > done and t >= due) {
+            done = done + 1;
+            have = true;
+        }
+        const a : u32 = vg_step(st[0..5], t, 3, false, have, req > done);
+        if ((a & VG_A_SEND) != 0) {
+            have = false;
+            if (last != 0 and t - last < gap) { gap = t - last; }
+            last = t;
+        }
+        if ((a & VG_A_KICK) != 0) {
+            req = req + 1;
+            due = t + cost;
+        }
+        if (req - done > maxfly) { maxfly = req - done; }
+        t = t + 10;
+    }
+    out[0] = st[VG_FRAMES];
+    out[1] = st[VG_ENC];
+    out[2] = st[VG_SKIP];
+    out[3] = st[VG_SENDS];
+    out[4] = maxfly;
+    out[5] = gap;
+}
