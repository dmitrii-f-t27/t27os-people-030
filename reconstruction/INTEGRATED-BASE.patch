+    assert(((DP_PENDING + (DP_REGS * DP_PENDING_SIZE)) <= DP_ROOMS));
+    assert(((DP_ROOMS + (DP_REGS * DP_ROOM_SIZE)) == DP_QUEUES));
+    assert(((DP_QUEUES + (DP_REGS * DP_QUEUE_SIZE)) <= 600000));
+    uint8_t b[32768] = {0};
+    uint32_t i = 0;
+    while ((i < 32768)) {
+        b[i] = 0;
+        i = (i + 1);
+    }
+    assert(!dp_shape(b, 0));
+    b[0] = 84;
+    b[1] = 50;
+    b[2] = 55;
+    b[3] = 68;
+    b[4] = 1;
+    b[5] = 1;
+    b[DP_PUBLIC] = 4;
+    assert(dp_shape(b, 304));
+    b[220] = 1;
+    assert(!dp_shape(b, 304));
+    b[220] = 0;
+    b[5] = 2;
+    assert(!dp_shape(b, 304));
+}
+
+void test_one_participant_cannot_extend_the_other_lease(void) {
+    uint8_t db[600000] = {0};
+    uint32_t i = 0;
+    while ((i < 600000)) {
+        db[i] = 0;
+        i = (i + 1);
+    }
+    db[0] = 1;
+    db[DP_REG_SIZE] = 1;
+    dp_put64(db, 96, 1000);
+    dp_put64(db, (DP_REG_SIZE + 96), 50);
+    db[DP_ROOMS] = 3;
+    db[(DP_ROOMS + 1)] = 0;
+    db[(DP_ROOMS + 2)] = 1;
+    dp_put64(db, (DP_ROOMS + 24), 1000);
+    assert(!dp_room_valid(db, DP_ROOMS, 60));
+    dp_put64(db, (DP_REG_SIZE + 96), 1000);
+    assert(dp_room_valid(db, DP_ROOMS, 60));
+    db[(DP_REG_SIZE + 80)] = 1;
+    assert(!dp_room_valid(db, DP_ROOMS, 60));
+}
+
+void test_full_queue_never_partially_commits_batch_or_room_consent(void) {
+    uint8_t db[600000] = {0};
+    uint8_t b[32768] = {0};
+    uint32_t i = 0;
+    while ((i < 600000)) {
+        db[i] = 0;
+        i = (i + 1);
+    }
+    i = 0;
+    while ((i < 32768)) {
+        b[i] = 0;
+        i = (i + 1);
+    }
+    db[DP_ROOMS] = 1;
+    db[(DP_ROOMS + 1)] = 0;
+    db[(DP_ROOMS + 2)] = 1;
+    db[(DP_ROOMS + 4)] = 1;
+    dp_put32(db, 112, DP_QUEUE_SIZE);
+    assert((dp_room_ack(db, DP_ROOMS, 1, 0, b, 100) == 21));
+    assert((((db[DP_ROOMS] == 1) && (db[(DP_ROOMS + 4)] == 1)) && (dp_db32(db, 112) == DP_QUEUE_SIZE)));
+    dp_put32(db, 112, 0);
+    assert((((dp_room_ack(db, DP_ROOMS, 1, 0, b, 100) == 7) && (db[DP_ROOMS] == 3)) && (db[(DP_ROOMS + 4)] == 3)));
+    b[304] = 52;
+    b[305] = 0;
+    b[358] = 52;
+    b[359] = 0;
+    dp_put32(db, 112, (DP_QUEUE_SIZE - 137));
+    assert((!dp_batch_space(db, 0, b, 108) && (dp_db32(db, 112) == (DP_QUEUE_SIZE - 137))));
+}
+
+void test_malformed_short_request_response_copies_no_input_fields(void) {
+    uint8_t b[32768] = {0};
+    uint8_t out[65536] = {0};
+    uint8_t random[16] = {0};
+    uint8_t db[600000] = {0};
+    uint32_t i = 0;
+    while ((i < 32768)) {
+        b[i] = 255;
+        i = (i + 1);
+    }
+    i = 0;
+    while ((i < 16)) {
+        random[i] = 0;
+        i = (i + 1);
+    }
+    assert((dp_process(db, b, 0, out, 0, random) == 64));
+    i = 8;
+    while ((i < 64)) {
+        assert((out[i] == 0));
+        i = (i + 1);
+    }
+}
+
+void test_lost_poll_response_repeats_immutable_batch_until_signed_ack(void) {
+    uint8_t db[600000] = {0};
+    uint8_t b[32768] = {0};
+    uint8_t out[65536] = {0};
+    uint32_t i = 0;
+    while ((i < 600000)) {
+        db[i] = 0;
+        i = (i + 1);
+    }
+    i = 0;
+    while ((i < 32768)) {
+        b[i] = 0;
+        i = (i + 1);
+    }
+    dp_put32(db, 112, 3);
+    db[DP_QUEUES] = 11;
+    db[(DP_QUEUES + 1)] = 12;
+    db[(DP_QUEUES + 2)] = 13;
+    assert((((dp_poll(db, 0, b, out, 1000) == 67) && (dp_db32(db, 112) == 3)) && (out[64] == 11)));
+    uint64_t serial = dp_db64(db, 128);
+    assert((serial == 1));
+    dp_put32(db, 112, 4);
+    db[(DP_QUEUES + 3)] = 14;
+    assert((((dp_poll(db, 0, b, out, 1001) == 67) && (dp_db32(db, 112) == 4)) && (out[66] == 13)));
+    b[220] = 8;
+    b[304] = 1;
+    assert(((((dp_poll(db, 0, b, out, 1002) == 65) && (out[64] == 14)) && (dp_db32(db, 112) == 1)) && (dp_db64(db, 128) == 2)));
+    b[304] = 2;
+    assert(((dp_poll(db, 0, b, out, 1003) == 64) && (dp_db32(db, 112) == 0)));
+}
+
+void test_signature_and_challenge_rates_are_finite(void) {
+    uint8_t db[600000] = {0};
+    uint32_t i = 0;
+    while ((i < 600000)) {
+        db[i] = 0;
+        i = (i + 1);
+    }
+    i = 0;
+    while ((i < 128)) {
+        assert(dp_rate(db, 1, false));
+        i = (i + 1);
+    }
+    assert((!dp_rate(db, 1, false) && dp_rate(db, 1000, false)));
+    i = 0;
+    while ((i < 16)) {
+        assert(dp_rate(db, 1000, true));
+        i = (i + 1);
+    }
+    assert((!dp_rate(db, 1000, true) && dp_rate(db, 2000, true)));
+}
+
+void test_candidate_proofs_fit_disjoint_database_ranges(void) {
+    assert(((DP_QUEUES + (DP_REGS * DP_QUEUE_SIZE)) <= DP_PROOF_LENGTHS));
+    assert(((DP_PROOF_LENGTHS + (DP_REGS * 4)) <= DP_PROOFS));
+    assert((((DP_PROOFS + (DP_REGS * DP_PROOF_SIZE)) < 599000) && ((DP_HEADER + 145) <= DP_PROOF_SIZE)));
+    uint8_t b[32768] = {0};
+    uint32_t i = 0;
+    while ((i < 32768)) {
+        b[i] = 0;
+        i = (i + 1);
+    }
+    assert(dp_candidates(b, 1));
+    b[DP_HEADER] = 9;
+    assert(!dp_candidates(b, 163));
+    b[DP_HEADER] = 1;
+    b[(DP_HEADER + 11)] = 255;
+    b[(DP_HEADER + 12)] = 255;
+    b[(DP_HEADER + 13)] = 192;
+    b[(DP_HEADER + 14)] = 168;
+    b[(DP_HEADER + 15)] = 1;
+    b[(DP_HEADER + 16)] = 25;
+    b[(DP_HEADER + 17)] = 194;
+    b[(DP_HEADER + 18)] = 237;
+    assert(dp_candidates(b, 19));
+    b[(DP_HEADER + 13)] = 169;
+    assert(!dp_candidates(b, 19));
+}
+
+
+/* -------------------------------------------------------
+   Test runner (compile with -DT27_TEST_MAIN to execute)
+   ------------------------------------------------------- */
+
+#ifdef T27_TEST_MAIN
+#include <stdio.h>
+int main(void) {
+    test_protocol_layout_and_wire_bounds_are_closed();
+    test_one_participant_cannot_extend_the_other_lease();
+    test_full_queue_never_partially_commits_batch_or_room_consent();
+    test_malformed_short_request_response_copies_no_input_fields();
+    test_lost_poll_response_repeats_immutable_batch_until_signed_ack();
+    test_signature_and_challenge_rates_are_finite();
+    test_candidate_proofs_fit_disjoint_database_ranges();
+    printf("All %d tests passed.\n", 7);
+    return 0;
+}
+#endif /* T27_TEST_MAIN */
+
+#endif /* T27DIRECTORYPROTOCOL_H */
