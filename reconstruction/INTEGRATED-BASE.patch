+    assert gi_put(p[0..160], GI_ANNOUNCE, T_DIGEST[0..8], T_A[0..10], r[0..30], 3, "", 0) == 0;
+    assert gi_put(p[0..160], 2, T_DIGEST[0..8], T_A[0..10], r[0..30], 3, "trio", 0) == 0;
+    assert gi_put(p[0..63], GI_ANNOUNCE, T_DIGEST[0..8], T_A[0..10], r[0..30], 3, "trio", 0) == 0;
+    // refused when read: cut, one byte long, a name length that disagrees, nine members, unsorted, a creator outside,
