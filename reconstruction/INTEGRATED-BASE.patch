+/// A local explicit selection before media starts; the remote still requires signed SAS consent.
+pub fn cs_media_select(s:[]u8,video_only:bool)->bool {
+ if(!cs_live(s)) {return false;}
+ const state:u32=ckh_state(s[0..EP_LEN]);
+ if(state!=CK_IDLE and state!=CK_RINGING and state!=CK_ENDED and state!=CK_FAILED){return false;}
+ cs_set(s,CS_K_SILENT_MS,cs_media_wait_ms(video_only));
+ cs_p(s,CS_MODE,if(video_only) @as(u64,CS_VIDEO_ONLY) else @as(u64,CS_AUDIO_DEV));
+ return true;
+}
