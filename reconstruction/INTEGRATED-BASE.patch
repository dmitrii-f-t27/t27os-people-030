+test a_group_message_from_someone_outside_the_group_is_dropped_with_its_reason {
+    var t : [4240]u8 = undefined;
+    t_table(t[0..GT_LEN]);
+    var p : [738]u8 = undefined;
+    const hi : [2]u8 = [104, 105];
+    // B writes to the group; C receives it over its session with B
+    const n : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 1, 0, 50, hi[0..2]);
+    assert n == GM_HDR + 2 and gm_kind(p[0..n]) == GM_K_TEXT;
+    assert gr_gate(t[0..GT_LEN], p[0..n], T_C[0..10], T_B[0..10], true) == GR_OK;
+    // the key of B is not stored here
+    assert gr_gate(t[0..GT_LEN], p[0..n], T_C[0..10], T_B[0..10], false) == GR_UNTRUSTED;
+    // X (not a member) sends it over its own session
+    const nx : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_X[0..10], 1, 0, 50, hi[0..2]);
+    assert gr_gate(t[0..GT_LEN], p[0..nx], T_C[0..10], T_X[0..10], true) == GR_NOT_MEMBER;
+    // B's message relayed by A: the sender is not the peer
+    gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 1, 0, 50, hi[0..2]);
+    assert gr_gate(t[0..GT_LEN], p[0..n], T_C[0..10], T_A[0..10], true) == GR_SPOOF;
+    // a device that is not in the group, an unknown group
+    assert gr_gate(t[0..GT_LEN], p[0..n], T_X[0..10], T_B[0..10], true) == GR_NOT_ME;
+    const other : [8]u8 = [9, 9, 9, 9, 9, 9, 9, 9];
+    const no : usize = gm_put_text(p[0..738], other[0..8], T_B[0..10], 1, 0, 50, hi[0..2]);
+    assert gr_gate(t[0..GT_LEN], p[0..no], T_C[0..10], T_B[0..10], true) == GR_UNKNOWN;
+    // an ACK must name this device as the author
+    var a : [38]u8 = undefined;
+    assert gm_put_ack(a[0..38], T_DIGEST[0..8], T_A[0..10], 1, 0) == GM_HDR;
+    assert gr_gate(t[0..GT_LEN], a[0..38], T_A[0..10], T_B[0..10], true) == GR_OK;
+    assert gr_gate(t[0..GT_LEN], a[0..38], T_C[0..10], T_B[0..10], true) == GR_SPOOF;
+    // malformed: a reserved byte, a number at 2^24, a short middle part, an ACK with a time
+    gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 1, 0, 50, hi[0..2]);
+    p[1] = 1;
+    assert gr_gate(t[0..GT_LEN], p[0..n], T_C[0..10], T_B[0..10], true) == GR_BAD;
+    assert gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], GM_SEQ, 0, 50, hi[0..2]) == 0;
+    put32(a[0..38], 20, GM_SEQ);
+    assert gm_kind(a[0..38]) == 0;
+    gm_put_ack(a[0..38], T_DIGEST[0..8], T_A[0..10], 1, 0);
+    put_u64(a[0..38], 28, 7);
+    assert gm_kind(a[0..38]) == 0;
+    assert gm_is_group(p[0..n]) and gm_is_group(hi[0..2]) == false;
+}
