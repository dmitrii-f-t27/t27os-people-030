+    assert gl_place(log[0..T_LOG], 1, 0) == 0;
+    assert gl_place(log[0..T_LOG], 2, 0) == 1;
+    assert cl_time(log[0..T_LOG], 0) == 100 and cl_time(log[0..T_LOG], 1) == 200 and cl_time(log[0..T_LOG], 2) == 300;
+    assert cl_msg(log[0..T_LOG], 0) == 2 and cl_msg(log[0..T_LOG], 1) == 3 and cl_msg(log[0..T_LOG], 2) == 1;
+    // a line already in its place stays
+    assert gl_place(log[0..T_LOG], 1, 0) == 1 and cl_msg(log[0..T_LOG], 1) == 3;
+    // an own line written at 50 at the end moves to the front
+    assert cl_out_add(log[0..T_LOG], x[0..1], 50) == 4;
+    assert gl_place(log[0..T_LOG], 3, 0) == 0 and cl_msg(log[0..T_LOG], 0) == 4 and cl_msg(log[0..T_LOG], 3) == 1;
+    // a line at 900 in front of 100 and 200 moves forward to the end
+    var l3 : [16296]u8 = undefined;
+    t_log(l3[0..T_LOG]);
+    assert cl_out_add(l3[0..T_LOG], x[0..1], 900) == 1;
+    assert cl_out_add(l3[0..T_LOG], x[0..1], 100) == 2;
+    assert cl_out_add(l3[0..T_LOG], x[0..1], 200) == 3;
+    assert gl_place(l3[0..T_LOG], 0, 0) == 2;
+    assert cl_msg(l3[0..T_LOG], 0) == 2 and cl_msg(l3[0..T_LOG], 1) == 3 and cl_msg(l3[0..T_LOG], 2) == 1;
+    // equal times: the sender's index decides, and an own line counts as this device's index
+    var l2 : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    var fl : [32]u8 = undefined;
+    ck_wipe(asm[0..CA_LEN]);
+    ck_wipe(fl[0..32]);
+    t_log(l2[0..T_LOG]);
+    assert cl_out_add(l2[0..T_LOG], x[0..1], 500) == 1;
+    assert t_deliver(l2[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 1, 500, x[0..1]) == CH_RX_NEW;
+    const own : usize = cl_find(l2[0..T_LOG], CH_DIR_OUT, 1);
+    const inb : usize = cl_find(l2[0..T_LOG], CH_DIR_IN, gl_key(1, 1));
+    // seen as member 0 the own line goes before B's; seen as member 2, after it
+    assert gl_after(l2[0..T_LOG], own, inb, 0) == false and gl_after(l2[0..T_LOG], inb, own, 0);
+    assert gl_after(l2[0..T_LOG], own, inb, 2) and gl_after(l2[0..T_LOG], inb, own, 2) == false;
+    // same time and sender: the number decides
+    assert t_deliver(l2[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 2, 500, x[0..1]) == CH_RX_NEW;
+    const inb2 : usize = cl_find(l2[0..T_LOG], CH_DIR_IN, gl_key(1, 2));
+    assert gl_after(l2[0..T_LOG], inb2, inb, 2) and gl_after(l2[0..T_LOG], inb, inb2, 2) == false;
+}
