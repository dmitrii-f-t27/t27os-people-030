+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 1, 10, x[0..1]) == CH_RX_NEW;
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 1, 10, x[0..1]) == CH_RX_DUP;
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_A[0..10], 0, 1, 10, x[0..1]) == CH_RX_NEW;
