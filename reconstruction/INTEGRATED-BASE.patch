+    s[CS_ID + CI_SAME] = 1;
+    assert csg_list_keep(s[0..CS_LEN], big[0..152]) == GR_LR_SIZE;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == 0 and cg(s[0..CS_LEN], LG_L_SIZE) == 1;
+    // the trusted friend that called me: kept for the group manager, and a refused list never counted as media
+    assert csg_list_keep(s[0..CS_LEN], l[0..n]) == GR_LR_OK;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == @as(u64, n);
