+        put32(g[0..200], bn - 4, crc32(g[0..200], bn - 4));
+        assert cl_init(lc[0..4104], T_A[0..10], 2) and cf_decode(g[0..bn], lc[0..4104]) == CF_BAD;
+        k = k + 1;
+    }
