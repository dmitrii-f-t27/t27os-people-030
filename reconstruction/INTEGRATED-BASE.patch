+    var t2 : [1108]u8 = undefined;
+    var k2 : [2400]u8 = undefined;
+    // slot 1 names a stranger (sealed again, so only the key rule can refuse it)
+    var a : [3508]u8 = f;
+    var i : usize = 0;
+    while (i < 75) {
+        a[FT2_OFF_KEYS + 75 + i] = f[FT2_OFF_KEYS + i];
+        i = i + 1;
