+/// Opt-in owner relay registration, scoped to the already-paired exact endpoint.
+/// A/B are reachability slots, never device identities or authentication keys.
+pub fn cs_relay_start(s:[]u8,role:u32)->bool {
+ if(!cs_live(s) or (role!=1 and role!=2) or s[CS_NET+CN_LOCAL_CARD]!=1 or cs_state(s)!=CK_IDLE){return false;}
+ const target:u64=get_u64(s,CS_NET+CN_LOCAL_TARGET);if(target==0){return false;}
+ var endpoint:[18]u8=undefined;ip6_ep_v4(target/65536,target%65536,endpoint[0..18]);if(!cs_set_peer(s,endpoint[0..18])){return false;}
+ s[CS_NET+CN_RELAY_ROLE]=@as(u8,@intCast(role));s[CS_NET+CN_RELAY_READY]=0;put_u64(s,CS_NET+CN_RELAY_LAST,0);return true;
+}
+pub fn cs_relay_ready(s:[]const u8)->u64 {if(s.len<CS_LEN){return 0;}return s[CS_NET+CN_RELAY_READY];}
+fn cs_relay_tick(s:[]u8,now:u64)->void {
+ if(s[CS_NET+CN_RELAY_ROLE]==0 or now-get_u64(s,CS_NET+CN_RELAY_LAST)<(if(s[CS_NET+CN_RELAY_READY]==1) @as(u64,5000) else @as(u64,500))){return;}
+ var reg:[8]u8=undefined;ck_wipe(reg[0..8]);reg[0]=84;reg[1]=50;reg[2]=55;reg[3]=82;reg[4]=49;reg[5]=64+s[CS_NET+CN_RELAY_ROLE];cs_send(s,reg[0..8]);put_u64(s,CS_NET+CN_RELAY_LAST,now);
+}
+fn cs_relay_packet(s:[]u8,packet:[]const u8,from:[]const u8)->bool {
+ if(s[CS_NET+CN_RELAY_ROLE]==0 or (packet.len!=8 and packet.len!=24)){return false;}
+ if(packet[0]!=84 or packet[1]!=50 or packet[2]!=55){return false;}
+ var endpoint:[18]u8=undefined;if(!ip6_sa_take(from,from.len,endpoint[0..18]) or ip6_v4of(endpoint[0..18])!=get_u64(s,CS_NET+CN_LOCAL_TARGET)){return true;}
+ if(packet.len==24 and packet[3]==67 and packet[4]==49 and packet[5]==64+s[CS_NET+CN_RELAY_ROLE]){var proof:[24]u8=undefined;ck_put(proof[0..24],0,packet);proof[3]=80;cs_send(s,proof[0..24]);}
+ if(packet.len==8 and packet[3]==79 and packet[4]==75 and packet[5]==64+s[CS_NET+CN_RELAY_ROLE]){s[CS_NET+CN_RELAY_READY]=1;}
+ return true;
+}
+
+pub fn cs_relay_stop(s:[]u8)->bool {
+    if(!cs_live(s) or cs_state(s)!=CK_IDLE){return false;}
+    s[CS_NET+CN_RELAY_ROLE]=0;s[CS_NET+CN_RELAY_READY]=0;put_u64(s,CS_NET+CN_RELAY_LAST,0);return true;
+}
