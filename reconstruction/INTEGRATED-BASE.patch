+fn vt_us() -> u64 { return @as(u64, @intFromFloat(vt_now() * 1000000.0)); }
+
+fn vt_cf(s: []const u8) -> u64 { return vt_cf_str(0, s, s.len, VT_UTF8, false); }
+
+/// The value a framework constant holds (a CFStringRef key, kCFBooleanTrue ..), read through its dlsym address.
+pub fn vt_konst(name: []const u8) -> u64 {
+    const a : u64 = vt_dlsym(VT_RTLD_DEFAULT, name);
+    if (a == 0) { return 0; }
+    return cbp_get(a);
+}
+
+/// A CFNumber of an integer (SInt32) or of a double given as its IEEE-754 bits, made in `tmp` (8 bytes of memory).
+fn vt_num_i(tmp: u64, v: u64) -> u64 {
+    cbp_put(tmp, v & 4294967295);
+    return vt_cf_num(0, VT_NUM_I32, tmp);
+}
+
+fn vt_num_f(tmp: u64, bits: u64) -> u64 {
+    cbp_put(tmp, bits);
+    return vt_cf_num(0, VT_NUM_F64, tmp);
+}
+
+/// A dictionary of one key and value (CFType callbacks), made with `tmp` (16 bytes of memory).
+fn vt_dict1(tmp: u64, k: u64, v: u64) -> u64 {
+    cbp_put(tmp, k);
+    cbp_put(tmp + 8, v);
+    return vt_cf_dict(0, tmp, tmp + 8, 1, vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryKeyCallBacks"), vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryValueCallBacks"));
+}
+
+fn vt_dict2(tmp: u64, k1: u64, v1: u64, k2: u64, v2: u64) -> u64 {
+    cbp_put(tmp, k1);
+    cbp_put(tmp + 8, k2);
+    cbp_put(tmp + 16, v1);
+    cbp_put(tmp + 24, v2);
+    return vt_cf_dict(0, tmp, tmp + 16, 2, vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryKeyCallBacks"), vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryValueCallBacks"));
+}
+
+/// A big-endian u32 written at address a.
+fn vt_be32(a: u64, v: u64) -> void {
+    var b : [4]u8 = undefined;
+    b[0] = @as(u8, @intCast((v >> 24) & 255));
+    b[1] = @as(u8, @intCast((v >> 16) & 255));
+    b[2] = @as(u8, @intCast((v >> 8) & 255));
+    b[3] = @as(u8, @intCast(v & 255));
+    vt_poke(a, b[0..4], 4);
+}
+
+/// One call through libffi of a function with up to 12 integer or pointer arguments (VideoToolbox and CoreMedia have
+/// a few with 9 or 10: t27b passes at most 8). `mem` is 512 bytes of scratch memory that stays put during the call;
+/// kinds[i] 1 = pointer / u64, 4 = sint32, 5 = uint32; the value of each argument is vals[i]. The i32 result.
+fn vt_ffi(mem: u64, f: u64, kinds: []const u8, vals: []const u64) -> i32 {
+    const n : usize = kinds.len;
+    if (f == 0 or n > 12 or vals.len < n) { return -1; }
+    const tp : u64 = vt_dlsym(VT_RTLD_DEFAULT, "ffi_type_pointer");
+    const ts32 : u64 = vt_dlsym(VT_RTLD_DEFAULT, "ffi_type_sint32");
+    const tu32 : u64 = vt_dlsym(VT_RTLD_DEFAULT, "ffi_type_uint32");
+    if (tp == 0 or ts32 == 0 or tu32 == 0) { return -1; }
+    // cif at mem, the type list at mem + 64, the values at mem + 192, the pointers to them at mem + 320, result + 448
+    cbp_zero(mem, 512);
+    var i : usize = 0;
+    while (i < n) {
+        var t : u64 = tp;
+        if (kinds[i] == 4) { t = ts32; }
+        if (kinds[i] == 5) { t = tu32; }
+        cbp_put(mem + 64 + @as(u64, i) * 8, t);
+        cbp_put(mem + 192 + @as(u64, i) * 8, vals[i]);
+        cbp_put(mem + 320 + @as(u64, i) * 8, mem + 192 + @as(u64, i) * 8);
+        i = i + 1;
+    }
+    if (vt_ffi_prep(mem, VT_FFI_SYSV, @as(u32, @intCast(n)), ts32, mem + 64) != 0) { return -1; }
+    vt_ffi_call(mem, f, mem + 448, mem + 320);
+    const r : u64 = cbp_get(mem + 448) & 4294967295;
+    if (r >= 2147483648) { return @as(i32, @intCast(@as(i64, @intCast(r)) - 4294967296)); }
+    return @as(i32, @intCast(r));
+}
+
+// ---------------------------------------------------------------- the mailbox of one picture
+
+/// A one-slot mailbox at `at` (16 bytes: an os_unfair_lock, then the CVPixelBuffer): put keeps its own reference to
+/// pb and releases the one it replaces (the second result bit: 1 when a picture was there untaken); take hands the
+/// newest picture to the caller, who releases it. Any thread may put, one thread takes.
+pub fn vtm_put(at: u64, pb: u64) -> u64 {
+    if (at == 0 or pb == 0) { return 0; }
+    vt_pb_retain(pb);
+    vt_lock(at);
+    const old : u64 = cbp_get(at + 8);
+    cbp_put(at + 8, pb);
+    vt_unlock(at);
+    if (old != 0) {
+        vt_pb_release(old);
+        return 3;
+    }
+    return 1;
+}
+
+pub fn vtm_take(at: u64) -> u64 {
+    if (at == 0) { return 0; }
+    vt_lock(at);
+    const pb : u64 = cbp_get(at + 8);
+    cbp_put(at + 8, 0);
+    vt_unlock(at);
+    return pb;
+}
+
+// ---------------------------------------------------------------- the encoder
+
+const VE_MAGIC_V : u64 = 7505702094815069249;
+pub const VE_SESS : u64 = 1;
+pub const VE_W : u64 = 2;
+pub const VE_H : u64 = 3;
+pub const VE_RUNG : u64 = 4;
+pub const VE_WANT_RUNG : u64 = 5;
+pub const VE_WANT_KBPS : u64 = 6;
+pub const VE_KBPS : u64 = 7;
+pub const VE_FORCE : u64 = 8;
+pub const VE_GEN : u64 = 9;
+pub const VE_IN : u64 = 10;
+pub const VE_OUT : u64 = 11;
+pub const VE_DROP : u64 = 12;
+pub const VE_ERR : u64 = 13;
+pub const VE_KEYS : u64 = 14;
+pub const VE_BYTES : u64 = 15;
+pub const VE_OVER : u64 = 16;
+pub const VE_CFAIL : u64 = 17;
+pub const VE_WI : u64 = 18;
+pub const VE_RI : u64 = 19;
+pub const VE_CSTAT : u64 = 20;
+pub const VE_LAT_MAX : u64 = 21;
+pub const VE_LAT_SUM : u64 = 22;
+pub const VE_LAT_N : u64 = 23;
+pub const VE_LOWLAT : u64 = 24;
+pub const VE_CREATES : u64 = 25;
+pub const VE_FN_OUT : u64 = 26;
+pub const VE_BIG : u64 = 27;
+pub const VE_PROPFAIL : u64 = 28;
+pub const VE_NAL4 : u64 = 29;
+pub const VE_CALL_MAX : u64 = 30;
+pub const VE_SRCW : u64 = 31;
+pub const VE_SRCH : u64 = 32;
+/// Submit time of frame i at slot VE_TS + i % 64.
+const VE_TS : u64 = 64;
+/// Scratch: libffi (512 bytes), CF building (64), the presentation time and the duration (24 each), info flags,
+/// parameter set pointers and sizes.
+const VE_FFI : u64 = 1024;
+const VE_TMP : u64 = 1536;
+const VE_PTS : u64 = 1600;
+const VE_DUR : u64 = 1632;
+const VE_INFO : u64 = 1664;
+const VE_PSP : u64 = 1680;
+pub const VE_RING : u64 = 4096;
+pub const VE_SLOTS : u64 = 8;
+/// An entry: length, meta (1 = key frame, rung << 8, generation << 16), the time it came out of the encoder (us), then
+/// the frame.
+pub const VE_ENT : u64 = 131096;
+pub const VE_SIZE : u64 = 1052864;
+
+fn ve(e: u64, k: u64) -> u64 { return cbp_get(e + k * 8); }
+fn vep(e: u64, k: u64, v: u64) -> void { cbp_put(e + k * 8, v); }
+fn ve_ok(e: u64) -> bool { return e != 0 and cbp_get(e) == VE_MAGIC_V; }
+
+/// A new encoder block (no session yet: the camera thread makes it at its first frame). 0 without memory.
+pub fn vte_new() -> u64 {
+    const e : u64 = vt_calloc(1, VE_SIZE);
+    if (e == 0) { return 0; }
+    cbp_put(e, VE_MAGIC_V);
+    vep(e, VE_RUNG, 255);
+    vep(e, VE_WANT_RUNG, 0);
+    vep(e, VE_WANT_KBPS, 1200);
+    // Never true: makes sure the callbacks are emitted and exported for dlsym.
+    if (ve(e, VE_GEN) == 99) { vte_out(0, 0, 0, 0, 0); vtd_out(0, 0, 0, 0, 0, 0, 0); }
+    vep(e, VE_FN_OUT, vt_dlsym(VT_RTLD_DEFAULT, "vte_out"));
+    return e;
+}
+
+/// The rung and the bitrate the next frames should have (polling thread; the camera thread applies them).
+pub fn vte_want(e: u64, rung: u32, kbps: u64) -> void {
+    if (!ve_ok(e)) { return; }
+    var r : u64 = @as(u64, rung);
+    if (r >= @as(u64, VL_RUNGS)) { r = @as(u64, VL_RUNGS) - 1; }
+    vep(e, VE_WANT_RUNG, r);
+    vep(e, VE_WANT_KBPS, kbps);
+}
+
+/// The next frame is a key frame.
+pub fn vte_force(e: u64) -> void {
+    if (ve_ok(e)) { vep(e, VE_FORCE, 1); }
+}
+
+fn vte_rate(e: u64, s: u64, kbps: u64) -> void {
+    const tmp : u64 = e + VE_TMP;
+    const br : u64 = vt_num_i(tmp, kbps * 1000);
+    if (vt_set_prop(s, vt_konst("kVTCompressionPropertyKey_AverageBitRate"), br) != 0) { vep(e, VE_PROPFAIL, ve(e, VE_PROPFAIL) + 1); }
+    vt_release(br);
+    // at most 1.5 times the average in any one second: [bytes, seconds]
+    const by : u64 = vt_num_i(tmp, kbps * 1000 / 8 * 3 / 2);
+    // 1.0 = 0x3FF0000000000000
+    const one : u64 = vt_num_f(tmp + 8, 4607182418800017408);
+    cbp_put(tmp + 16, by);
+    cbp_put(tmp + 24, one);
+    const arr : u64 = vt_cf_array(0, tmp + 16, 2, vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeArrayCallBacks"));
+    if (arr != 0) {
+        if (vt_set_prop(s, vt_konst("kVTCompressionPropertyKey_DataRateLimits"), arr) != 0) { vep(e, VE_PROPFAIL, ve(e, VE_PROPFAIL) + 1); }
+        vt_release(arr);
+    }
+    vt_release(by);
+    vt_release(one);
+    vep(e, VE_KBPS, kbps);
+}
+
+fn vte_prop(e: u64, s: u64, key: []const u8, val: u64) -> void {
+    if (val == 0 or vt_set_prop(s, vt_konst(key), val) != 0) { vep(e, VE_PROPFAIL, ve(e, VE_PROPFAIL) + 1); }
+}
+
+/// Close the session of the block, if any: the frames it still holds come out first (camera queue).
+fn vte_drop_session(e: u64) -> void {
+    const s : u64 = ve(e, VE_SESS);
+    if (s == 0) { return; }
+    // kCMTimeInvalid: all zeros
+    cbp_zero(e + VE_DUR, 24);
+    vt_enc_complete(s, e + VE_DUR);
+    vt_enc_invalidate(s);
+    vt_release(s);
+    vep(e, VE_SESS, 0);
+    vep(e, VE_RUNG, 255);
+}
+
+/// A session at the size of rung r (camera queue). True when one runs.
+fn vte_open(e: u64, r: u64) -> bool {
+    vte_drop_session(e);
+    const w : u64 = vl_w(@as(u32, @intCast(r)));
+    const h : u64 = vl_h(@as(u32, @intCast(r)));
+    const f : u64 = vt_dlsym(VT_RTLD_DEFAULT, "VTCompressionSessionCreate");
+    const tmp : u64 = e + VE_TMP;
+    const tru : u64 = vt_konst("kCFBooleanTrue");
+    const fals : u64 = vt_konst("kCFBooleanFalse");
+    // the low-latency rate control first (macOS 11.3+); a plain real-time session when it is refused
+    const spec : u64 = vt_dict1(tmp, vt_konst("kVTVideoEncoderSpecification_EnableLowLatencyRateControl"), tru);
+    var kinds : [10]u8 = undefined;
+    kinds[0] = 1; kinds[1] = 4; kinds[2] = 4; kinds[3] = 5; kinds[4] = 1;
+    kinds[5] = 1; kinds[6] = 1; kinds[7] = 1; kinds[8] = 1; kinds[9] = 1;
+    var vals : [10]u64 = undefined;
+    vals[0] = 0; vals[1] = w; vals[2] = h; vals[3] = @as(u64, VT_AVC1); vals[4] = spec;
+    vals[5] = 0; vals[6] = 0; vals[7] = ve(e, VE_FN_OUT); vals[8] = e; vals[9] = e + VE_SESS * 8;
+    vep(e, VE_SESS, 0);
+    var st : i32 = vt_ffi(e + VE_FFI, f, kinds[0..10], vals[0..10]);
+    vep(e, VE_LOWLAT, 1);
+    if (spec != 0) { vt_release(spec); }
+    if (st != 0 or ve(e, VE_SESS) == 0) {
+        vals[4] = 0;
+        vep(e, VE_SESS, 0);
+        st = vt_ffi(e + VE_FFI, f, kinds[0..10], vals[0..10]);
+        vep(e, VE_LOWLAT, 0);
+    }
+    vep(e, VE_CSTAT, @as(u64, @intCast(@as(i64, st) & 4294967295)));
+    const s : u64 = ve(e, VE_SESS);
+    if (st != 0 or s == 0) {
+        vep(e, VE_SESS, 0);
+        vep(e, VE_CFAIL, ve(e, VE_CFAIL) + 1);
+        return false;
+    }
+    vte_prop(e, s, "kVTCompressionPropertyKey_RealTime", tru);
+    vte_prop(e, s, "kVTCompressionPropertyKey_AllowFrameReordering", fals);
+    if (ve(e, VE_LOWLAT) == 1) {
+        vte_prop(e, s, "kVTCompressionPropertyKey_ProfileLevel", vt_konst("kVTProfileLevel_H264_ConstrainedBaseline_AutoLevel"));
+    } else {
+        vte_prop(e, s, "kVTCompressionPropertyKey_ProfileLevel", vt_konst("kVTProfileLevel_H264_Main_AutoLevel"));
+    }
+    const fr : u64 = vt_num_i(tmp, 30);
+    vte_prop(e, s, "kVTCompressionPropertyKey_ExpectedFrameRate", fr);
+    vt_release(fr);
+    const ki : u64 = vt_num_i(tmp, 60);
+    vte_prop(e, s, "kVTCompressionPropertyKey_MaxKeyFrameInterval", ki);
+    vt_release(ki);
+    // 2.0 = 0x4000000000000000
+    const kd : u64 = vt_num_f(tmp, 4611686018427387904);
+    vte_prop(e, s, "kVTCompressionPropertyKey_MaxKeyFrameIntervalDuration", kd);
+    vt_release(kd);
+    vte_rate(e, s, ve(e, VE_WANT_KBPS));
+    vep(e, VE_W, w);
+    vep(e, VE_H, h);
+    vep(e, VE_RUNG, r);
+    vep(e, VE_GEN, ve(e, VE_GEN) + 1);
+    vep(e, VE_CREATES, ve(e, VE_CREATES) + 1);
+    // the first frame of a new session is a key frame by itself; asking makes sure
+    vep(e, VE_FORCE, 1);
+    return true;
+}
+
+/// Encode one camera frame (camera thread): the session follows the wanted rung and bitrate first. False when no
+/// session could be made or the encoder refused the frame.
+pub fn vte_encode(e: u64, pb: u64, now_us: u64) -> bool {
+    if (!ve_ok(e) or pb == 0) { return false; }
+    const t0 : u64 = vt_us();
+    const want : u64 = ve(e, VE_WANT_RUNG);
+    if (ve(e, VE_SESS) == 0 or ve(e, VE_RUNG) != want) {
+        if (!vte_open(e, want)) { return false; }
+    }
+    const s : u64 = ve(e, VE_SESS);
+    if (ve(e, VE_WANT_KBPS) != ve(e, VE_KBPS)) { vte_rate(e, s, ve(e, VE_WANT_KBPS)); }
+    vep(e, VE_SRCW, vt_pb_w(pb));
+    vep(e, VE_SRCH, vt_pb_h(pb));
+    var props : u64 = 0;
+    if (ve(e, VE_FORCE) != 0) {
+        vep(e, VE_FORCE, 0);
+        props = vt_dict1(e + VE_TMP, vt_konst("kVTEncodeFrameOptionKey_ForceKeyFrame"), vt_konst("kCFBooleanTrue"));
+    }
+    // presentation time: now in microseconds (value i64, timescale i32 1000000, flags 1 = valid, epoch 0)
+    cbp_put(e + VE_PTS, now_us);
+    cbp_put(e + VE_PTS + 8, 1000000 | (@as(u64, 1) << 32));
+    cbp_put(e + VE_PTS + 16, 0);
+    cbp_zero(e + VE_DUR, 24);
+    const idx : u64 = ve(e, VE_IN);
+    vep(e, VE_TS + idx % 64, t0);
+    vep(e, VE_IN, idx + 1);
+    const st : i32 = vt_enc_frame(s, pb, e + VE_PTS, e + VE_DUR, props, idx | (ve(e, VE_GEN) << 48), e + VE_INFO);
+    if (props != 0) { vt_release(props); }
+    const took : u64 = vt_us() - t0;
+    if (took > ve(e, VE_CALL_MAX)) { vep(e, VE_CALL_MAX, took); }
+    if (st != 0) {
+        vep(e, VE_ERR, ve(e, VE_ERR) + 1);
+        return false;
+    }
+    return true;
+}
+
+/// VTCompressionOutputCallback (the encoder's thread): one coded frame into the ring in the wire layout.
+pub fn vte_out(ref: u64, src: u64, status: i32, flags: u32, sb: u64) -> u64 {
+    const e : u64 = ref;
+    if (!ve_ok(e)) { return 0; }
+    if (status != 0 or sb == 0) {
+        vep(e, VE_DROP, ve(e, VE_DROP) + 1);
+        return 0;
+    }
+    const now : u64 = vt_us();
+    const idx : u64 = src & 281474976710655;
+    const t0 : u64 = ve(e, VE_TS + idx % 64);
+    if (t0 != 0 and now >= t0) {
+        const lat : u64 = now - t0;
+        if (lat > ve(e, VE_LAT_MAX)) { vep(e, VE_LAT_MAX, lat); }
+        vep(e, VE_LAT_SUM, ve(e, VE_LAT_SUM) + lat);
+        vep(e, VE_LAT_N, ve(e, VE_LAT_N) + 1);
+    }
+    const data : u64 = vt_sb_data(sb);
+    if (data == 0) { vep(e, VE_DROP, ve(e, VE_DROP) + 1); return 0; }
+    const len : u64 = vt_bb_len(data);
+    // a key frame has no kCMSampleAttachmentKey_NotSync (or it is false)
+    var key : bool = true;
+    const att : u64 = vt_sb_attach(sb, false);
+    if (att != 0 and vt_arr_count(att) > 0) {
+        const d : u64 = vt_arr_at(att, 0);
+        if (d != 0) {
+            const ns : u64 = vt_dict_get(d, vt_konst("kCMSampleAttachmentKey_NotSync"));
+            if (ns != 0 and ns != vt_konst("kCFBooleanFalse")) { key = false; }
+        }
+    }
+    var p0 : u64 = 0;
+    var s0 : u64 = 0;
+    var p1 : u64 = 0;
+    var s1 : u64 = 0;
+    const ps : u64 = e + VE_PSP;
+    if (key) {
+        const fmt : u64 = vt_sb_fmt(sb);
+        cbp_zero(ps, 48);
+        if (fmt == 0 or vt_ps_at(fmt, 0, ps, ps + 8, ps + 16, ps + 24) != 0) { vep(e, VE_ERR, ve(e, VE_ERR) + 1); return 0; }
+        p0 = cbp_get(ps);
+        s0 = cbp_get(ps + 8);
+        // the length prefix of the encoder's units must be 4 bytes, as call_h264 reads them
+        if ((cbp_get(ps + 24) & 4294967295) != 4) { vep(e, VE_NAL4, ve(e, VE_NAL4) + 1); return 0; }
+        if (vt_ps_at(fmt, 1, ps + 32, ps + 40, ps + 16, ps + 24) != 0) { vep(e, VE_ERR, ve(e, VE_ERR) + 1); return 0; }
+        p1 = cbp_get(ps + 32);
+        s1 = cbp_get(ps + 40);
+        if (p0 == 0 or p1 == 0 or s0 == 0 or s1 == 0 or s0 > 256 or s1 > 256) { vep(e, VE_ERR, ve(e, VE_ERR) + 1); return 0; }
+    }
+    var total : u64 = len;
+    if (key) { total = total + 8 + s0 + s1; }
+    if (len == 0 or total > @as(u64, VH_FRAME_MAX)) {
+        vep(e, VE_BIG, ve(e, VE_BIG) + 1);
+        vep(e, VE_FORCE, 1);
+        return 0;
+    }
+    const w : u64 = ve(e, VE_WI);
+    vt_fence();
+    const r : u64 = ve(e, VE_RI);
+    if (w - r >= VE_SLOTS) {
+        vep(e, VE_OVER, ve(e, VE_OVER) + 1);
+        vep(e, VE_FORCE, 1);
+        return 0;
+    }
+    const ent : u64 = e + VE_RING + (w % VE_SLOTS) * VE_ENT;
+    var at : u64 = ent + 24;
+    if (key) {
+        vt_be32(at, s0);
+        vt_copy(at + 4, p0, s0);
+        at = at + 4 + s0;
+        vt_be32(at, s1);
+        vt_copy(at + 4, p1, s1);
+        at = at + 4 + s1;
+    }
+    if (vt_bb_copy(data, 0, len, at) != 0) { vep(e, VE_ERR, ve(e, VE_ERR) + 1); return 0; }
+    cbp_put(ent, total);
+    var meta : u64 = (ve(e, VE_RUNG) & 255) << 8;
+    if (key) { meta = meta | 1; }
+    meta = meta | ((src >> 48) << 16);
+    cbp_put(ent + 8, meta);
+    cbp_put(ent + 16, now);
+    vt_fence();
+    vep(e, VE_WI, w + 1);
+    vep(e, VE_OUT, ve(e, VE_OUT) + 1);
+    vep(e, VE_BYTES, ve(e, VE_BYTES) + total);
+    if (key) { vep(e, VE_KEYS, ve(e, VE_KEYS) + 1); }
+    return 0;
+}
+
+/// A coded frame waits in the ring (polling thread).
+pub fn vte_ready(e: u64) -> bool {
+    if (!ve_ok(e)) { return false; }
+    const w : u64 = ve(e, VE_WI);
+    vt_fence();
+    return ve(e, VE_RI) < w;
+}
+
+/// Coded frames waiting.
+pub fn vte_waiting(e: u64) -> u64 {
+    if (!ve_ok(e)) { return 0; }
+    const w : u64 = ve(e, VE_WI);
+    vt_fence();
+    return w - ve(e, VE_RI);
+}
+
+fn vte_ent(e: u64) -> u64 { return e + VE_RING + (ve(e, VE_RI) % VE_SLOTS) * VE_ENT; }
+
+/// The oldest waiting frame: its length, its meta (1 = key, rung << 8), when it came out of the encoder (us).
+pub fn vte_len(e: u64) -> u64 { if (!vte_ready(e)) { return 0; } return cbp_get(vte_ent(e)); }
+pub fn vte_meta(e: u64) -> u64 { if (!vte_ready(e)) { return 0; } return cbp_get(vte_ent(e) + 8); }
+pub fn vte_at(e: u64) -> u64 { if (!vte_ready(e)) { return 0; } return cbp_get(vte_ent(e) + 16); }
+
+/// Bytes off .. off + out.len of the oldest waiting frame into out; false past its end.
+pub fn vte_read(e: u64, off: u64, out: []u8) -> bool {
+    if (!vte_ready(e)) { return false; }
+    const ent : u64 = vte_ent(e);
+    if (off + @as(u64, out.len) > cbp_get(ent)) { return false; }
+    sys_peek(out, ent + 24 + off, @as(u64, out.len));
+    return true;
+}
+
+/// The oldest waiting frame was sent (or dropped): its entry is free again.
+pub fn vte_pop(e: u64) -> void {
+    if (!vte_ready(e)) { return; }
+    vt_fence();
+    vep(e, VE_RI, ve(e, VE_RI) + 1);
+}
+
+/// The end of a call (camera queue, after the camera stopped): the session goes, the ring is emptied.
+pub fn vte_close(e: u64) -> void {
+    if (!ve_ok(e)) { return; }
+    vte_drop_session(e);
+    vt_fence();
+    vep(e, VE_RI, ve(e, VE_WI));
+}
+
+pub fn vte_stat(e: u64, k: u64) -> u64 {
+    if (!ve_ok(e) or k >= 64) { return 0; }
+    return ve(e, k);
+}
+
+// ---------------------------------------------------------------- the decoder
+
+// The decoder runs on its own serial queue, never on the polling thread (that thread carries the sound: a session is
+// made in about 70 ms). vtd_post copies the frame the gate let through -- its parameter sets apart, the picture without
+// them -- into a job of its own and queues it; vtd_job, on the queue, remakes the session when the parameter sets
+// changed and hands the picture to the decoder asynchronously; vtd_out, on the decoder's thread, puts the result in the
+// mailbox. The jobs run in the order they were queued, so the decoder sees the frames in order.
+const VD_MAGIC_V : u64 = 7505702094815069250;
+pub const VDK_SESS : u64 = 1;
+pub const VDK_FMT : u64 = 2;
+pub const VDK_SPSN : u64 = 3;
+pub const VDK_PPSN : u64 = 4;
+pub const VDK_W : u64 = 5;
+pub const VDK_H : u64 = 6;
+pub const VDK_FED : u64 = 7;
+pub const VDK_OUT : u64 = 8;
+pub const VDK_BAD : u64 = 9;
+pub const VDK_CREATES : u64 = 10;
+pub const VDK_CFAIL : u64 = 11;
+/// The mailbox: lock (slot 12) and picture (slot 13).
+pub const VDK_BOX : u64 = 12;
+pub const VDK_REPL : u64 = 15;
+pub const VDK_DERR : u64 = 16;
+pub const VDK_LAT_MAX : u64 = 17;
+pub const VDK_LAT_SUM : u64 = 18;
+pub const VDK_LAT_N : u64 = 19;
+pub const VDK_Q : u64 = 20;
+pub const VDK_FN : u64 = 21;
+pub const VDK_CALL_MAX : u64 = 22;
+pub const VDK_IDX : u64 = 23;
+pub const VDK_DROPPED : u64 = 24;
+pub const VDK_POSTED : u64 = 25;
+pub const VDK_DONE : u64 = 26;
+pub const VDK_BUSY : u64 = 27;
+pub const VDK_FN_JOB : u64 = 28;
+pub const VDK_FN_CLOSE : u64 = 29;
+pub const VDK_POST_MAX : u64 = 30;
+const VDK_TS : u64 = 32;
+const VDK_REC : u64 = 1024;
+const VDK_FFI : u64 = 1040;
+const VDK_TMP : u64 = 1552;
+const VDK_PSP : u64 = 1616;
+const VDK_SIZE1 : u64 = 1680;
+const VDK_OUTP : u64 = 1696;
+const VDK_SPS : u64 = 2048;
+const VDK_PPS : u64 = 2304;
+pub const VDK_SIZE : u64 = 4096;
+/// Jobs queued and not yet run past this: the frame is not queued (the caller asks for a key frame).
+pub const VDK_DEPTH : u64 = 6;
+/// A job: the block, the picture's length, the two parameter sets' lengths (0 for a frame without them), the
+/// parameter sets (256 bytes each), then the picture.
+const VJ_HDR : u64 = 544;
+
+fn vd(d: u64, k: u64) -> u64 { return cbp_get(d + k * 8); }
+fn vdp(d: u64, k: u64, v: u64) -> void { cbp_put(d + k * 8, v); }
+fn vd_ok(d: u64) -> bool { return d != 0 and cbp_get(d) == VD_MAGIC_V; }
+fn vt_malloc(n: u64) -> u64 { return @extern("malloc"); }
+fn vt_free(p: u64) -> void { @extern("free"); }
+fn vt_memcmp(a: u64, b: u64, n: u64) -> i32 { return @extern("memcmp"); }
+fn vt_queue(label: []const u8, attr: u64) -> u64 { return @extern("dispatch_queue_create"); }
+fn vt_async(q: u64, ctx: u64, f: u64) -> void { @extern("dispatch_async_f"); }
+fn vt_sync(q: u64, ctx: u64, f: u64) -> void { @extern("dispatch_sync_f"); }
+
+/// A new decoder block and its queue (the session comes with the first key frame). 0 without memory.
+pub fn vtd_new() -> u64 {
+    const d : u64 = vt_calloc(1, VDK_SIZE);
+    if (d == 0) { return 0; }
+    cbp_put(d, VD_MAGIC_V);
+    // Never true: makes sure the callbacks and the jobs are emitted and exported for dlsym.
+    if (vd(d, VDK_IDX) == 99) { vtd_out(0, 0, 0, 0, 0, 0, 0); vte_out(0, 0, 0, 0, 0); vtd_job(0); vtd_close_job(0); }
+    vdp(d, VDK_FN, vt_dlsym(VT_RTLD_DEFAULT, "vtd_out"));
+    vdp(d, VDK_FN_JOB, vt_dlsym(VT_RTLD_DEFAULT, "vtd_job"));
+    vdp(d, VDK_FN_CLOSE, vt_dlsym(VT_RTLD_DEFAULT, "vtd_close_job"));
+    vdp(d, VDK_Q, vt_queue("t27.callvideo.decode", 0));
+    if (vd(d, VDK_Q) == 0 or vd(d, VDK_FN_JOB) == 0 or vd(d, VDK_FN) == 0) { return 0; }
+    return d;
+}
+
+/// Jobs queued and not run yet.
+pub fn vtd_depth(d: u64) -> u64 {
+    if (!vd_ok(d)) { return 0; }
+    const done : u64 = vd(d, VDK_DONE);
+    vt_fence();
+    return vd(d, VDK_POSTED) - done;
+}
+
+/// Queue one complete frame that the gate let through (polling thread, returns at once). 0 queued; 1 not well formed
+/// or nothing to decode; 2 the queue is behind (VDK_DEPTH jobs wait) or no memory: the frame is not queued.
+pub fn vtd_post(d: u64, body: []const u8) -> u32 {
+    if (!vd_ok(d) or vh_nals(body) == 0) { return 1; }
+    const n : usize = vh_strip_len(body);
+    if (n == 0) { return 1; }
+    if (vtd_depth(d) >= VDK_DEPTH) {
+        vdp(d, VDK_BUSY, vd(d, VDK_BUSY) + 1);
+        return 2;
+    }
+    const t0 : u64 = vt_us();
+    const j : u64 = vt_malloc(VJ_HDR + @as(u64, n));
+    if (j == 0) { return 2; }
+    cbp_put(j, d);
+    cbp_put(j + 8, @as(u64, n));
+    cbp_put(j + 16, 0);
+    cbp_put(j + 24, 0);
+    const sps : usize = vh_find(body, VH_NAL_SPS);
+    const pps : usize = vh_find(body, VH_NAL_PPS);
+    if (sps != VH_NONE and pps != VH_NONE) {
+        const sl : usize = vh_nal_len(body, sps);
+        const pl : usize = vh_nal_len(body, pps);
+        if (sl <= 256 and pl <= 256) {
+            cbp_put(j + 16, @as(u64, sl));
+            cbp_put(j + 24, @as(u64, pl));
+            vt_poke(j + 32, body[sps + 4..sps + 4 + sl], @as(u64, sl));
+            vt_poke(j + 288, body[pps + 4..pps + 4 + pl], @as(u64, pl));
+        }
+    }
+    var at : usize = 0;
+    var w : u64 = 0;
+    while (at < body.len) {
+        const len : usize = vh_nal_len(body, at);
+        const t : u32 = @as(u32, body[at + 4] & 31);
+        if (t != VH_NAL_SPS and t != VH_NAL_PPS) {
+            vt_poke(j + VJ_HDR + w, body[at..at + 4 + len], @as(u64, 4 + len));
+            w = w + @as(u64, 4 + len);
+        }
+        at = at + 4 + len;
+    }
+    vdp(d, VDK_POSTED, vd(d, VDK_POSTED) + 1);
+    vt_async(vd(d, VDK_Q), j, vd(d, VDK_FN_JOB));
+    const took : u64 = vt_us() - t0;
+    if (took > vd(d, VDK_POST_MAX)) { vdp(d, VDK_POST_MAX, took); }
+    return 0;
+}
+
+fn vtd_drop_session(d: u64) -> void {
+    const s : u64 = vd(d, VDK_SESS);
+    if (s != 0) {
+        vt_dec_wait(s);
+        vt_dec_invalidate(s);
+        vt_release(s);
+        vdp(d, VDK_SESS, 0);
+    }
+    const f : u64 = vd(d, VDK_FMT);
+    if (f != 0) {
+        vt_release(f);
+        vdp(d, VDK_FMT, 0);
+    }
+}
+
+/// A format description and a session for the parameter sets of job j (the decode queue).
+fn vtd_open(d: u64, j: u64) -> bool {
+    vtd_drop_session(d);
+    const sl : u64 = cbp_get(j + 16);
+    const pl : u64 = cbp_get(j + 24);
+    const ps : u64 = d + VDK_PSP;
+    cbp_put(ps, j + 32);
+    cbp_put(ps + 8, j + 288);
+    cbp_put(ps + 16, sl);
+    cbp_put(ps + 24, pl);
+    cbp_put(d + VDK_OUTP, 0);
+    if (vt_fmt_from_ps(0, 2, ps, ps + 16, 4, d + VDK_OUTP) != 0 or cbp_get(d + VDK_OUTP) == 0) {
+        vdp(d, VDK_CFAIL, vd(d, VDK_CFAIL) + 1);
+        return false;
+    }
+    const fmt : u64 = cbp_get(d + VDK_OUTP);
+    vdp(d, VDK_FMT, fmt);
+    const dims : u64 = vt_dims(fmt);
+    vdp(d, VDK_W, dims & 4294967295);
+    vdp(d, VDK_H, dims >> 32);
+    // the pictures: BGRA on an IOSurface, so a layer shows them as they are
+    const tmp : u64 = d + VDK_TMP;
+    const empty : u64 = vt_cf_dict(0, 0, 0, 0, vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryKeyCallBacks"), vt_dlsym(VT_RTLD_DEFAULT, "kCFTypeDictionaryValueCallBacks"));
+    const fnum : u64 = vt_num_i(tmp + 32, @as(u64, VT_BGRA));
+    const attrs : u64 = vt_dict2(tmp, vt_konst("kCVPixelBufferPixelFormatTypeKey"), fnum, vt_konst("kCVPixelBufferIOSurfacePropertiesKey"), empty);
+    cbp_put(d + VDK_REC, vd(d, VDK_FN));
+    cbp_put(d + VDK_REC + 8, d);
+    cbp_put(d + VDK_OUTP, 0);
+    const st : i32 = vt_dec_create(0, fmt, 0, attrs, d + VDK_REC, d + VDK_OUTP);
+    if (attrs != 0) { vt_release(attrs); }
+    if (fnum != 0) { vt_release(fnum); }
+    if (empty != 0) { vt_release(empty); }
+    if (st != 0 or cbp_get(d + VDK_OUTP) == 0) {
+        vdp(d, VDK_CFAIL, vd(d, VDK_CFAIL) + 1);
+        return false;
+    }
+    vdp(d, VDK_SESS, cbp_get(d + VDK_OUTP));
+    vt_copy(d + VDK_SPS, j + 32, sl);
+    vt_copy(d + VDK_PPS, j + 288, pl);
+    vdp(d, VDK_SPSN, sl);
+    vdp(d, VDK_PPSN, pl);
+    vdp(d, VDK_CREATES, vd(d, VDK_CREATES) + 1);
+    return true;
+}
+
+/// One queued frame (the decode queue): the session follows the parameter sets, the picture goes to the decoder.
+pub fn vtd_job(j: u64) -> u64 {
+    if (j == 0) { return 0; }
+    const d : u64 = cbp_get(j);
+    if (!vd_ok(d)) { vt_free(j); return 0; }
+    const t0 : u64 = vt_us();
+    const sl : u64 = cbp_get(j + 16);
+    const pl : u64 = cbp_get(j + 24);
+    if (sl != 0 and pl != 0) {
+        const same : bool = vd(d, VDK_SESS) != 0 and sl == vd(d, VDK_SPSN) and pl == vd(d, VDK_PPSN) and vt_memcmp(d + VDK_SPS, j + 32, sl) == 0 and vt_memcmp(d + VDK_PPS, j + 288, pl) == 0;
+        if (!same and !vtd_open(d, j)) { vtd_job_end(d, j, t0); return 0; }
+    }
+    const s : u64 = vd(d, VDK_SESS);
+    const n : u64 = cbp_get(j + 8);
+    if (s == 0) {
+        // a picture before any key frame: nothing to decode it with
+        vdp(d, VDK_DERR, vd(d, VDK_DERR) + 1);
+        vtd_job_end(d, j, t0);
+        return 0;
+    }
+    cbp_put(d + VDK_OUTP, 0);
+    if (vt_bb_empty(0, 0, 0, d + VDK_OUTP) != 0 or cbp_get(d + VDK_OUTP) == 0) {
+        vdp(d, VDK_DERR, vd(d, VDK_DERR) + 1);
+        vtd_job_end(d, j, t0);
+        return 0;
+    }
+    const bb : u64 = cbp_get(d + VDK_OUTP);
+    if (vt_bb_append(bb, 0, n, 0, 0, 0, n, 1) != 0 or vt_bb_replace(j + VJ_HDR, bb, 0, n) != 0) {
+        vt_release(bb);
+        vdp(d, VDK_DERR, vd(d, VDK_DERR) + 1);
+        vtd_job_end(d, j, t0);
+        return 0;
+    }
+    // CMSampleBufferCreateReady(alloc, bb, fmt, 1 sample, 0 timings, NULL, 1 size, &size, &out): 9 arguments
+    cbp_put(d + VDK_SIZE1, n);
+    cbp_put(d + VDK_OUTP, 0);
+    var kinds : [9]u8 = undefined;
+    kinds[0] = 1; kinds[1] = 1; kinds[2] = 1; kinds[3] = 1; kinds[4] = 1;
+    kinds[5] = 1; kinds[6] = 1; kinds[7] = 1; kinds[8] = 1;
+    var vals : [9]u64 = undefined;
+    vals[0] = 0; vals[1] = bb; vals[2] = vd(d, VDK_FMT); vals[3] = 1; vals[4] = 0;
+    vals[5] = 0; vals[6] = 1; vals[7] = d + VDK_SIZE1; vals[8] = d + VDK_OUTP;
+    const cs : i32 = vt_ffi(d + VDK_FFI, vt_dlsym(VT_RTLD_DEFAULT, "CMSampleBufferCreateReady"), kinds[0..9], vals[0..9]);
+    vt_release(bb);
+    const sb : u64 = cbp_get(d + VDK_OUTP);
+    if (cs != 0 or sb == 0) {
+        vdp(d, VDK_DERR, vd(d, VDK_DERR) + 1);
+        vtd_job_end(d, j, t0);
+        return 0;
+    }
+    const idx : u64 = vd(d, VDK_IDX);
+    vdp(d, VDK_TS + idx % 64, t0);
+    vdp(d, VDK_IDX, idx + 1);
+    // kVTDecodeFrame_EnableAsynchronousDecompression
+    const ds : i32 = vt_dec_frame(s, sb, 1, idx, 0);
+    vt_release(sb);
+    if (ds != 0) { vdp(d, VDK_DERR, vd(d, VDK_DERR) + 1); } else { vdp(d, VDK_FED, vd(d, VDK_FED) + 1); }
+    vtd_job_end(d, j, t0);
+    return 0;
+}
+
+fn vtd_job_end(d: u64, j: u64, t0: u64) -> void {
+    const took : u64 = vt_us() - t0;
+    if (took > vd(d, VDK_CALL_MAX)) { vdp(d, VDK_CALL_MAX, took); }
+    vt_free(j);
+    vt_fence();
+    vdp(d, VDK_DONE, vd(d, VDK_DONE) + 1);
+}
+
+/// VTDecompressionOutputCallback (the decoder's thread): the picture into the mailbox, or a refusal counted.
+pub fn vtd_out(ref: u64, src: u64, status: i32, flags: u32, img: u64, pts: u64, dur: u64) -> u64 {
+    const d : u64 = ref;
+    if (!vd_ok(d)) { return 0; }
+    // kVTDecodeInfo_FrameDropped
+    if ((flags & 2) != 0) { vdp(d, VDK_DROPPED, vd(d, VDK_DROPPED) + 1); return 0; }
+    if (status != 0 or img == 0) {
+        vdp(d, VDK_BAD, vd(d, VDK_BAD) + 1);
+        return 0;
+    }
+    const now : u64 = vt_us();
+    const t0 : u64 = vd(d, VDK_TS + src % 64);
+    if (t0 != 0 and now >= t0) {
+        const lat : u64 = now - t0;
+        if (lat > vd(d, VDK_LAT_MAX)) { vdp(d, VDK_LAT_MAX, lat); }
+        vdp(d, VDK_LAT_SUM, vd(d, VDK_LAT_SUM) + lat);
+        vdp(d, VDK_LAT_N, vd(d, VDK_LAT_N) + 1);
+    }
+    if (vtm_put(d + VDK_BOX * 8, img) == 3) { vdp(d, VDK_REPL, vd(d, VDK_REPL) + 1); }
+    vdp(d, VDK_OUT, vd(d, VDK_OUT) + 1);
+    return 0;
+}
+
+/// The newest decoded picture, owned by the caller (vt_pb_release); 0 when none came since the last take.
+pub fn vtd_take(d: u64) -> u64 {
+    if (!vd_ok(d)) { return 0; }
+    return vtm_take(d + VDK_BOX * 8);
+}
+
+/// Refusals so far (the decoder said no, or a frame could not be built): the window compares it with what it saw.
+pub fn vtd_errors(d: u64) -> u64 {
+    if (!vd_ok(d)) { return 0; }
+    return vd(d, VDK_BAD) + vd(d, VDK_DERR) + vd(d, VDK_CFAIL);
+}
+
+/// The end of a call, on the decode queue after the jobs before it: the session goes.
+pub fn vtd_close_job(d: u64) -> u64 {
+    if (!vd_ok(d)) { return 0; }
+    vtd_drop_session(d);
+    vdp(d, VDK_SPSN, 0);
+    vdp(d, VDK_PPSN, 0);
+    return 0;
+}
+
+/// The end of a call (polling thread): waits for the queued jobs, the session goes, a picture not taken is released.
+pub fn vtd_close(d: u64) -> void {
+    if (!vd_ok(d)) { return; }
+    vt_sync(vd(d, VDK_Q), d, vd(d, VDK_FN_CLOSE));
+    const pb : u64 = vtm_take(d + VDK_BOX * 8);
+    if (pb != 0) { vt_pb_release(pb); }
+}
+
+pub fn vtd_stat(d: u64, k: u64) -> u64 {
+    if (!vd_ok(d) or k >= 32) { return 0; }
+    return vd(d, k);
+}
+
+// ---------------------------------------------------------------- tests
+
+test the_blocks_keep_their_slots_apart {
+    assert VE_TS + 64 <= VE_FFI / 8 and VE_FFI + 512 <= VE_TMP and VE_TMP + 64 <= VE_PTS and VE_PTS + 24 <= VE_DUR;
+    assert VE_DUR + 24 <= VE_INFO and VE_INFO + 16 <= VE_PSP and VE_PSP + 48 <= VE_RING;
+    assert VE_ENT == 24 + 131072 and VE_SIZE == VE_RING + VE_SLOTS * VE_ENT;
+    assert VE_CALL_MAX < VE_TS and VE_SRCH < VE_TS;
+    assert VDK_TS + 64 <= VDK_REC / 8 and VDK_REC + 16 <= VDK_FFI and VDK_FFI + 512 <= VDK_TMP and VDK_TMP + 64 <= VDK_PSP;
+    assert VDK_PSP + 32 <= VDK_SIZE1 and VDK_SIZE1 + 8 <= VDK_OUTP and VDK_OUTP + 8 <= VDK_SPS and VDK_SPS + 256 <= VDK_PPS;
+    assert VDK_PPS + 256 <= VDK_SIZE and VDK_POST_MAX < VDK_TS and VDK_BOX + 1 < VDK_REPL and VJ_HDR == 32 + 256 + 256;
+    assert VT_AVC1 == 1635148593 and VT_BGRA == 1111970369;
+}
+
+test a_missing_block_does_nothing {
+    assert !vte_ready(0) and vte_len(0) == 0 and vte_waiting(0) == 0 and vte_stat(0, 1) == 0;
+    assert vtd_post(0, "abc") == 1 and vtd_take(0) == 0 and vtd_depth(0) == 0 and vtd_errors(0) == 0 and vtd_stat(0, 1) == 0;
+    assert vtm_take(0) == 0 and vtm_put(0, 5) == 0;
+    var b : [8]u8 = undefined;
+    assert !vte_read(0, 0, b[0..8]);
+    assert !vte_encode(0, 1, 0);
+}
diff --git a/specs/t27os/callback_probe.t27 b/specs/t27os/callback_probe.t27
new file mode 100644
index 000000000..9b467f7e7
--- /dev/null
+++ b/specs/t27os/callback_probe.t27
@@ -0,0 +1,1810 @@
+// SPDX-License-Identifier: Apache-2.0
+// specs/t27os/callback_probe.t27 -- can the OS call back into a t27b fn? Evidence for the in-OS call audio
+// (owner, 2026-10-21: avatar calls inside T27 OS, no servers). Every streaming audio API on macOS (AudioQueue,
+// AudioUnit, AVAudioEngine) hands its buffers to a C callback, and the language cannot take a fn's address.
+// t27b does export every all-scalar fn as the global `_<name>` (cli/t27b/README.md, "exported"), and the window
+// is linked with no export list, so dlsym(RTLD_DEFAULT, "<name>") may return that fn's address. This program
+// checks exactly that, three ways, and prints one line per check. Not part of the app.
+//   1. libc qsort sorts 8 bytes with cbp_cmp, reached only through its dlsym address (a synchronous callback).
+//   2. A CFRunLoop timer calls cbp_tick on this thread while CFRunLoopRunInMode runs: the shape an AudioQueue
+//      created with the main run loop would use, so a callback never runs on another thread.
+//   3. An AudioQueue output queue with cbp_out as its callback, run on this run loop for 0.3 s. It never decides
+//      the exit code and prints AUDIO VERIFIED, AUDIO UNVERIFIED or AUDIO SKIP. Exit 0 says nothing about
+//      audio: playback, capture and duplex audio need their own acceptance on a Mac with devices.
+// Build (Apple silicon):
+//   t27b build specs/t27os/callback_probe.t27 -o probe.o --macho
+//   ld -arch arm64 -platform_version macos 11.0 $(xcrun --show-sdk-version) -syslibroot $(xcrun --show-sdk-path) \
+//      -e _main -lSystem -framework CoreFoundation -framework AudioToolbox -o probe probe.o
+// Step 4 (ABI probe): part A is a 10 ms timer for 10 s with first/last time marks; part B is a 440 Hz tone, 10 ms
+// buffers (960 bytes, 48 kHz mono 16 bit), 4 buffers, 60 s, callbacks counted. Exits 0 only when the direct calls and checks 1 and 2 pass. ASCII only (L3).
+// Part C (capture): an AudioQueue INPUT queue, same format and buffers, cbp_in on this run loop for 10 s; prints
+// the NewInput and Start statuses, callbacks, nonzero samples, mean |sample| and the first 4 bytes. It never
+// decides the exit code of the full run. On macOS a microphone denied by TCC usually does not fail NewInput or
+// Start: the queue runs and delivers zero samples, so the verdict comes from the samples, not the statuses.
+// CBP_ONLY_C=1 skips A and B (no 60 s tone); then the exit code is 0 only when C ran with callbacks.
+// Part D (foreign thread): an AudioQueue OUTPUT queue created with inCallbackRunLoop = NULL, so the system calls
+// cbp_outd on a thread of its own while main sleeps. Same 440 Hz format and buffers, 10 s. The state block holds a
+// magic and its own address; every call checks both, counts calls and integrity errors, and compares pthread_self
+// with the main thread's. CBP_ONLY_D=1 runs only D, and then the exit code is 0 only when D ran clean on another
+// thread. This is the precondition for VoiceProcessingIO, whose render callback runs on a realtime thread.
+// Part E (duplex loop): an input and an output queue at once, both on this run loop, joined by a ring of 8 slots
+// of 960 bytes in one preallocated block (no allocation in a callback). cbp_ein copies each captured buffer into
+// the next slot or counts an overrun; cbp_eout plays the oldest slot or zeros and counts an underrun. The output
+// volume is set to 0.05 and read back before the output starts (no start otherwise), against acoustic feedback.
+// Both queues start together; the output plays warm-up silence (counted apart from underruns) until the ring
+// holds 2 slots, keeps 3 buffers in flight, and runs exactly 20 s. It prints
+// statuses, callbacks, underruns, overruns, bytes, checksums, time marks, ring residence and a latency estimate.
+// CBP_ONLY_E=1 runs only E; the exit code is 0 only for a clean loop.
+// Part F (network loop on 127.0.0.1): E with a UDP hop in the middle, no encryption yet. cbp_fin puts each captured
+// 10 ms frame into a tx ring; the main loop (CFRunLoopRunInMode 2 ms at a time) sends every ready frame from one
+// socket to a second socket bound to 127.0.0.1:47727, then reads that socket until EAGAIN (O_NONBLOCK set through
+// __fcntl, the non-variadic stub: fcntl itself is variadic and its third argument would go on the stack on arm64).
+// Packet: seq u32, length u16 (960), flags u16, 960 bytes PCM; with flag 1 the previous frame follows as a
+// redundant copy (CBP_NO_FEC=1 turns it off). The receiver keeps 64 slots by seq % 64; cbp_fout plays them in seq
+// order once 6 frames are buffered: a missing frame is taken from the redundant copy, else concealed (the last
+// frame at half amplitude); an empty buffer is silence and an underrun; more than 12 frames ahead is an overrun
+// and playback skips back to 6 frames, so latency cannot build up. Storm: every 20th packet is dropped, packets 50
+// and 51 of every 100 are sent swapped, and every 2 s the socket is not read for 40 ms. 20 s, volume 0.05.
+// CBP_ONLY_F=1 runs only F; the exit code is 0 only for a run with no underrun, no concealed frame, balanced
+// counters and no latency growth.
+// Part G (two hosts): F between two Macs on one LAN. CBP_PEER=a.b.c.d turns it on; CBP_BIND (default 0.0.0.0) and
+// CBP_PORT (default 47727) set the local address. One socket bound to CBP_BIND:CBP_PORT both sends to
+// CBP_PEER:CBP_PORT and receives, so the peer's packets answer our own flow. No storm (the LAN is the storm).
+// CBP_SECONDS (default 25) is the run; CBP_START_AT (unix seconds) makes both sides start the output together.
+// CBP_JB_TARGET / CBP_JB_MAX (default 6 / 12 frames) size the jitter buffer for Wi-Fi bursts. A sendto that answers
+// EAGAIN keeps its frame in the tx ring and is tried again on the next pass (a full ring is a counted tx overrun).
+// The run ends early when the peer has been silent for 300 ms after sending, and underruns are counted only up to
+// the last packet the peer sent, so a peer that stops first does not count as an underrun. Clocks are not shared,
+// so one-way latency is not measured; the report gives the jitter-buffer depth and a software latency estimate.
+// It counts nonzero samples in received frames (the other side's microphone). CBP_ONLY_F=1 is still required.
+// Verdict: received >= 2000, lost <= 10 %, underruns <= 5, nonzero received samples > 0.
+
+module T27osCallbackProbe;
+use t27os::pty_sys::sys_check_line;
+use t27os::pty_sys::sys_peek_u64;
+
+use t27os::pty_sys::sys_write;
+use t27os::pty_sys::sys_exit;
+use t27os::pty_sys::sys_peek;
+use t27os::pty_sys::sys_addr;
+use t27os::pty_proto::put_u64;
+use t27os::pty_proto::get_u64;
+use t27os::pty_sys::sys_getenv;
+use t27os::pty_sys::sys_strlen;
+
+const CBP_RTLD_DEFAULT : u64 = 18446744073709551614;
+/// kAudioFormatLinearPCM, 'lpcm'.
+const CBP_LPCM : u32 = 1819304813;
+/// kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked.
+const CBP_PCM_FLAGS : u32 = 12;
+
+fn cbp_dlsym(h: u64, name: []const u8) -> u64 { return @extern("dlsym"); }
+/// memmove with a raw destination address: copy n bytes of src to memory at dst.
+fn cbp_poke(dst: u64, src: []const u8, n: u64) -> u64 { return @extern("memmove"); }
+fn cbp_qsort(base: []u8, n: u64, width: u64, cmp: u64) -> void { @extern("qsort"); }
+fn cbp_rl_current() -> u64 { return @extern("CFRunLoopGetCurrent"); }
+fn cbp_now() -> f64 { return @extern("CFAbsoluteTimeGetCurrent"); }
+fn cbp_timer_create(alloc: u64, fire: f64, every: f64, flags: u64, order: i64, callout: u64, ctx: []const u8) -> u64 { return @extern("CFRunLoopTimerCreate"); }
+fn cbp_add_timer(rl: u64, timer: u64, mode: u64) -> void { @extern("CFRunLoopAddTimer"); }
+fn cbp_run(mode: u64, seconds: f64, after_one: bool) -> i32 { return @extern("CFRunLoopRunInMode"); }
+fn cbp_timer_invalidate(timer: u64) -> void { @extern("CFRunLoopTimerInvalidate"); }
+fn cbp_release(x: u64) -> void { @extern("CFRelease"); }
+fn cbp_aq_new_output(fmt: []const u8, cb: u64, user: u64, rl: u64, mode: u64, flags: u32, out_aq: []u8) -> i32 { return @extern("AudioQueueNewOutput"); }
+fn cbp_aq_new_input(fmt: []const u8, cb: u64, user: u64, rl: u64, mode: u64, flags: u32, out_aq: []u8) -> i32 { return @extern("AudioQueueNewInput"); }
+fn cbp_aq_alloc(aq: u64, size: u32, out_buf: []u8) -> i32 { return @extern("AudioQueueAllocateBuffer"); }
+fn cbp_aq_enqueue(aq: u64, buf: u64, n: u32, descs: u64) -> i32 { return @extern("AudioQueueEnqueueBuffer"); }
+fn cbp_aq_start(aq: u64, at: u64) -> i32 { return @extern("AudioQueueStart"); }
+fn cbp_sin(x: f64) -> f64 { return @extern("sin"); }
+fn cbp_aq_dispose(aq: u64, now: bool) -> i32 { return @extern("AudioQueueDispose"); }
+fn cbp_thread() -> u64 { return @extern("pthread_self"); }
+fn cbp_is_main() -> i32 { return @extern("pthread_main_np"); }
+fn cbp_usleep(us: u32) -> i32 { return @extern("usleep"); }
+fn cbp_aq_set_param(aq: u64, id: u32, v: f32) -> i32 { return @extern("AudioQueueSetParameter"); }
+fn cbp_aq_get_param(aq: u64, id: u32, out: []u8) -> i32 { return @extern("AudioQueueGetParameter"); }
+/// memcpy and bzero between raw addresses (the ring and the AudioQueue buffers); no allocation.
+fn cbp_copy(dst: u64, src: u64, n: u64) -> u64 { return @extern("memcpy"); }
+fn cbp_zero(dst: u64, n: u64) -> void { @extern("bzero"); }
+
+/// Part D magic, 0x5432374400000D27 ("T27D" over 0x0D27).
+const CBP_D_MAGIC : u64 = 6066972413218786599;
+
+fn cbp_get(at: u64) -> u64 { return sys_peek_u64(at); }
+
+fn cbp_put(at: u64, v: u64) -> void {
+    var c : [8]u8 = undefined;
+    put_u64(c[0..8], 0, v);
+    cbp_poke(at, c[0..8], 8);
+}
+
+/// Microseconds on the CF absolute clock.
+fn cbp_us() -> u64 { return @as(u64, @intFromFloat(cbp_now() * 1000000.0)); }
+
+/// qsort comparator. a and b are the addresses of two 1-byte elements.
+pub fn cbp_cmp(a: u64, b: u64) -> i32 {
+    var x : [1]u8 = undefined;
+    var y : [1]u8 = undefined;
+    sys_peek(x[0..1], a, 1);
+    sys_peek(y[0..1], b, 1);
+    return @as(i32, @intCast(x[0])) - @as(i32, @intCast(y[0]));
+}
+
+/// State block at `st` (u64 slots): 0 count, 1 info as received, 2 magic, 3 first us, 4 last us, 5 sample index.
+/// CFRunLoopTimer callout (timer, info): info is the address of the state block.
+pub fn cbp_tick(timer: u64, info: u64) -> u64 {
+    const n : u64 = cbp_get(info) + 1;
+    cbp_put(info, n);
+    cbp_put(info + 8, info);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(info + 24, t); }
+    cbp_put(info + 32, t);
+    return n;
+}
+
+/// Fill the AudioQueue buffer with 480 samples (10 ms) of 440 Hz and enqueue it.
+fn cbp_fill(st: u64, aq: u64, buf: u64) -> i32 {
+    var pcm : [960]u8 = undefined;
+    const base : u64 = cbp_get(st + 40);
+    var i : usize = 0;
+    while (i < 480) {
+        const ph : f64 = 6.283185307179586 * 440.0 * @as(f64, @floatFromInt(base + @as(u64, i))) / 48000.0;
+        const v : i32 = @as(i32, @intFromFloat(cbp_sin(ph) * 8000.0)) + 32768;
+        pcm[i * 2] = @as(u8, @intCast(v & 255));
+        pcm[i * 2 + 1] = @as(u8, @intCast((v >> 8) & 255)) ^ 128;
+        i = i + 1;
+    }
+    cbp_put(st + 40, base + 480);
+    cbp_poke(cbp_get(buf + 8), pcm[0..960], 960);
+    var sz : [4]u8 = undefined;
+    sz[0] = 192; sz[1] = 3; sz[2] = 0; sz[3] = 0;
+    cbp_poke(buf + 16, sz[0..4], 4);
+    return cbp_aq_enqueue(aq, buf, 0, 0);
+}
+
+/// AudioQueue output callback (user, queue, buffer): user is the address of the state block.
+pub fn cbp_out(user: u64, aq: u64, buf: u64) -> u64 {
+    const n : u64 = cbp_get(user) + 1;
+    cbp_put(user, n);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(user + 24, t); }
+    cbp_put(user + 32, t);
+    cbp_fill(user, aq, buf);
+    return n;
+}
+
+/// Part D state block (u64 slots): 0 calls, 1 own address, 2 magic, 3 first us, 4 last us, 5 sample index,
+/// 6 integrity errors, 7 main pthread, 8 first callback pthread, 9 calls on the main pthread,
+/// 10 calls where pthread_main_np != 0, 11 failed enqueues.
+/// AudioQueue output callback for a queue with no run loop: runs on a system thread.
+pub fn cbp_outd(user: u64, aq: u64, buf: u64) -> u64 {
+    if (cbp_get(user + 16) != CBP_D_MAGIC or cbp_get(user + 8) != user) {
+        cbp_put(user + 48, cbp_get(user + 48) + 1);
+        return 0;
+    }
+    const n : u64 = cbp_get(user) + 1;
+    cbp_put(user, n);
+    const t : u64 = cbp_us();
+    const th : u64 = cbp_thread();
+    if (n == 1) { cbp_put(user + 24, t); cbp_put(user + 64, th); }
+    cbp_put(user + 32, t);
+    if (th == cbp_get(user + 56)) { cbp_put(user + 72, cbp_get(user + 72) + 1); }
+    if (cbp_is_main() != 0) { cbp_put(user + 80, cbp_get(user + 80) + 1); }
+    if (cbp_fill(user, aq, buf) != 0) { cbp_put(user + 88, cbp_get(user + 88) + 1); }
+    return n;
+}
+
+/// Capture state block (u64 slots): 0 callbacks, 1 first 4 bytes, 2 first-buffer flag, 3 first us, 4 last us,
+/// 5 samples, 6 nonzero samples, 7 sum of |sample|, 8 bytes, 9 failed re-enqueues, 10 max |sample|.
+/// AudioQueue input callback (user, queue, buffer, start time, packet count, packet descs).
+pub fn cbp_in(user: u64, aq: u64, buf: u64, ts: u64, npk: u32, pd: u64) -> u64 {
+    const n : u64 = cbp_get(user) + 1;
+    cbp_put(user, n);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(user + 24, t); }
+    cbp_put(user + 32, t);
+    var hd : [4]u8 = undefined;
+    sys_peek(hd[0..4], buf + 16, 4);
+    var sz : u64 = @as(u64, @intCast(hd[0])) | (@as(u64, @intCast(hd[1])) << 8) | (@as(u64, @intCast(hd[2])) << 16) | (@as(u64, @intCast(hd[3])) << 24);
+    if (sz > 960) { sz = 960; }
+    var pcm : [960]u8 = undefined;
+    const data : u64 = cbp_get(buf + 8);
+    if (data == 0) { sz = 0; }
+    if (sz > 0) { sys_peek(pcm[0..960], data, sz); }
+    if (n == 1 and sz >= 4) {
+        cbp_put(user + 8, @as(u64, @intCast(pcm[0])) | (@as(u64, @intCast(pcm[1])) << 8) | (@as(u64, @intCast(pcm[2])) << 16) | (@as(u64, @intCast(pcm[3])) << 24));
+        cbp_put(user + 16, 1);
+    }
+    var nz : u64 = 0;
+    var sum : u64 = 0;
+    var mx : u64 = cbp_get(user + 80);
+    var i : u64 = 0;
+    while (i < sz / 2) {
+        var v : i64 = @as(i64, @intCast(pcm[i * 2])) | (@as(i64, @intCast(pcm[i * 2 + 1])) << 8);
+        if (v >= 32768) { v = v - 65536; }
+        if (v < 0) { v = 0 - v; }
+        const a : u64 = @as(u64, @intCast(v));
+        if (a != 0) { nz = nz + 1; }
+        if (a > mx) { mx = a; }
+        sum = sum + a;
+        i = i + 1;
+    }
+    cbp_put(user + 40, cbp_get(user + 40) + sz / 2);
+    cbp_put(user + 48, cbp_get(user + 48) + nz);
+    cbp_put(user + 56, cbp_get(user + 56) + sum);
+    cbp_put(user + 64, cbp_get(user + 64) + sz);
+    cbp_put(user + 80, mx);
+    if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_put(user + 72, cbp_get(user + 72) + 1); }
+    return n;
+}
+
+/// Part E ring: 8 slots of 960 bytes after a 448-byte header of u64 slots:
+/// 0 in calls, 1 out calls, 2 slots written, 3 slots read, 4 underruns, 5 overruns, 6 bytes into the ring,
+/// 7 bytes out of the ring, 8 first in us, 9 last in us, 10 first out us, 11 last out us, 12 ring base,
+/// 13 sum of fill at out calls, 14 max fill, 15 failed in enqueues, 16 failed out enqueues, 17 bytes dropped,
+/// 18 bytes received by input, 19 age sum us, 20 age max us, 21 age min us, 22 checksum mismatches,
+/// 23 checksum sum in, 24 checksum sum out, 25 nonzero samples out, 26 magic, 27 stopping, 28 zero bytes out,
+/// 29 min fill at out calls, 30 max out interval us, 31 max in interval us,
+/// 32..39 slot sizes, 40..47 slot write us, 48..55 slot checksums, 56 warming, 57 warm-up silent buffers,
+/// 58 warm-up end us.
+const CBP_E_SLOTS : u64 = 8;
+const CBP_E_HDR : u64 = 472;
+const CBP_E_BYTES : usize = 8152;
+/// While warming, the output plays silence (not an underrun) until the ring holds this many slots; output buffers in flight.
+const CBP_E_PRE : u64 = 2;
+const CBP_E_OUTBUFS : u32 = 3;
+/// kAudioQueueParam_Volume, and the bits of 0.04f / 0.06f (the accepted read-back range of 0.05f).
+const CBP_VOLUME : u32 = 1;
+const CBP_VOL_LO : u64 = 1025758986;
+const CBP_VOL_HI : u64 = 1031127695;
+
+fn cbp_inc(at: u64, by: u64) -> void { cbp_put(at, cbp_get(at) + by); }
+fn cbp_emax(at: u64, v: u64) -> void { if (v > cbp_get(at)) { cbp_put(at, v); } }
+fn cbp_emin(at: u64, v: u64) -> void { if (v < cbp_get(at)) { cbp_put(at, v); } }
+
+/// Position-weighted byte checksum of n bytes at addr (n <= 960).
+fn cbp_sum(addr: u64, n: u64) -> u64 {
+    var b : [960]u8 = undefined;
+    if (n == 0) { return 0; }
+    sys_peek(b[0..960], addr, n);
+    var s : u64 = 0;
+    var i : u64 = 0;
+    while (i < n) { s = s + (@as(u64, @intCast(b[i])) + 1) * (i + 1); i = i + 1; }
+    return s;
+}
+
+/// Nonzero 16-bit samples in n bytes at addr.
+fn cbp_nz(addr: u64, n: u64) -> u64 {
+    var b : [960]u8 = undefined;
+    if (n == 0) { return 0; }
+    sys_peek(b[0..960], addr, n);
+    var c : u64 = 0;
+    var i : u64 = 0;
+    while (i + 1 < n) { if (b[i] != 0 or b[i + 1] != 0) { c = c + 1; } i = i + 2; }
+    return c;
+}
+
+/// Ring and its slot tables are the block itself; the header geometry must fit the declared size.
+fn cbp_e_size() -> u64 { return CBP_E_HDR + CBP_E_SLOTS * 960; }
+
+/// Part E input callback: copy the captured buffer into the next ring slot, or count an overrun and drop it.
+pub fn cbp_ein(user: u64, aq: u64, buf: u64, ts: u64, npk: u32, pd: u64) -> u64 {
+    if (cbp_get(user + 216) != 0) { return 0; }
+    const n : u64 = cbp_get(user) + 1;
+    cbp_put(user, n);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(user + 64, t); } else { cbp_emax(user + 248, t - cbp_get(user + 72)); }
+    cbp_put(user + 72, t);
+    var hd : [4]u8 = undefined;
+    sys_peek(hd[0..4], buf + 16, 4);
+    var sz : u64 = @as(u64, @intCast(hd[0])) | (@as(u64, @intCast(hd[1])) << 8) | (@as(u64, @intCast(hd[2])) << 16) | (@as(u64, @intCast(hd[3])) << 24);
+    if (sz > 960) { sz = 960; }
+    const data : u64 = cbp_get(buf + 8);
+    if (data == 0) { sz = 0; }
+    cbp_inc(user + 144, sz);
+    const w : u64 = cbp_get(user + 16);
+    const r : u64 = cbp_get(user + 24);
+    if (w - r >= CBP_E_SLOTS) {
+        cbp_inc(user + 40, 1);
+        cbp_inc(user + 136, sz);
+    } else {
+        const slot : u64 = w % CBP_E_SLOTS;
+        const dst : u64 = cbp_get(user + 96) + slot * 960;
+        if (sz > 0) { cbp_copy(dst, data, sz); }
+        const cs : u64 = cbp_sum(dst, sz);
+        cbp_put(user + 256 + slot * 8, sz);
+        cbp_put(user + 320 + slot * 8, t);
+        cbp_put(user + 384 + slot * 8, cs);
+        cbp_put(user + 16, w + 1);
+        cbp_inc(user + 48, sz);
+        cbp_inc(user + 184, cs);
+        cbp_emax(user + 112, w + 1 - r);
+    }
+    if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_inc(user + 120, 1); }
+    return n;
+}
+
+/// Fill one output buffer from the ring (zeros and an underrun when it is empty) and enqueue it.
+fn cbp_epull(user: u64, aq: u64, buf: u64) -> i32 {
+    const data : u64 = cbp_get(buf + 8);
+    if (data == 0) { return -1; }
+    const w : u64 = cbp_get(user + 16);
+    const r : u64 = cbp_get(user + 24);
+    if (cbp_get(user + 448) != 0 and w - r >= CBP_E_PRE) {
+        cbp_put(user + 448, 0);
+        cbp_put(user + 464, cbp_us());
+    }
+    if (cbp_get(user + 448) != 0) {
+        cbp_zero(data, 960);
+        cbp_inc(user + 456, 1);
+    } else if (w == r) {
+        cbp_zero(data, 960);
+        cbp_inc(user + 32, 1);
+        cbp_inc(user + 224, 960);
+    } else {
+        const slot : u64 = r % CBP_E_SLOTS;
+        const sz : u64 = cbp_get(user + 256 + slot * 8);
+        if (sz > 0) { cbp_copy(data, cbp_get(user + 96) + slot * 960, sz); }
+        if (sz < 960) { cbp_zero(data + sz, 960 - sz); }
+        const cs : u64 = cbp_sum(data, sz);
+        if (cs != cbp_get(user + 384 + slot * 8)) { cbp_inc(user + 176, 1); }
+        cbp_inc(user + 192, cs);
+        cbp_inc(user + 200, cbp_nz(data, sz));
+        const age : u64 = cbp_us() - cbp_get(user + 320 + slot * 8);
+        cbp_inc(user + 152, age);
+        cbp_emax(user + 160, age);
+        cbp_emin(user + 168, age);
+        cbp_inc(user + 56, sz);
+        cbp_put(user + 24, r + 1);
+    }
+    var sz4 : [4]u8 = undefined;
+    sz4[0] = 192; sz4[1] = 3; sz4[2] = 0; sz4[3] = 0;
+    cbp_poke(buf + 16, sz4[0..4], 4);
+    return cbp_aq_enqueue(aq, buf, 0, 0);
+}
+
+/// Part E output callback (user, queue, buffer).
+pub fn cbp_eout(user: u64, aq: u64, buf: u64) -> u64 {
+    if (cbp_get(user + 216) != 0) { return 0; }
+    const n : u64 = cbp_get(user + 8) + 1;
+    cbp_put(user + 8, n);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(user + 80, t); } else { cbp_emax(user + 240, t - cbp_get(user + 88)); }
+    cbp_put(user + 88, t);
+    const fill : u64 = cbp_get(user + 16) - cbp_get(user + 24);
+    cbp_inc(user + 104, fill);
+    cbp_emin(user + 232, fill);
+    if (cbp_epull(user, aq, buf) != 0) { cbp_inc(user + 128, 1); }
+    return n;
+}
+
+/// Part F sockets: libc calls with fixed arities only (sendto/recvfrom/setsockopt/close and the __fcntl stub).
+fn cbp_sendto(fd: i32, b: []const u8, n: u64, flags: i32, to: []const u8, tolen: u32) -> i64 { return @extern("sendto"); }
+fn cbp_recvfrom(fd: i32, b: []u8, n: u64, flags: i32, from: u64, fromlen: u64) -> i64 { return @extern("recvfrom"); }
+fn cbp_setsockopt(fd: i32, level: i32, name: i32, v: []const u8, n: u32) -> i32 { return @extern("setsockopt"); }
+fn cbp_fcntl(fd: i32, cmd: i32, arg: u64) -> i32 { return @extern("__fcntl"); }
+fn cbp_errloc() -> u64 { return @extern("__error"); }
+fn cbp_socket(domain: i32, kind: i32, proto: i32) -> i32 { return @extern("socket"); }
+fn cbp_bind(fd: i32, addr: []const u8, n: u32) -> i32 { return @extern("bind"); }
+fn cbp_close(fd: i32) -> i32 { return @extern("close"); }
+
+const CBP_F_PORT : u64 = 47727;
+const CBP_EAGAIN : u64 = 35;
+const CBP_F_TX : u64 = 24;
+const CBP_F_JB : u64 = 64;
+/// Playback starts at, and is trimmed back to, this many buffered frames; more than CBP_F_MAX is an overrun.
+const CBP_F_TARGET : u64 = 6;
+const CBP_F_MAX : u64 = 12;
+const CBP_F_GROW : u64 = 2;
+const CBP_F_CAP : u64 = 30;
+/// A call starts with this many buffered frames (180 ms) and this jitter max; the probes keep CBP_F_TARGET / CBP_F_MAX.
+pub const CBP_F_PRE : u64 = 18;
+pub const CBP_F_PREMAX : u64 = 26;
+/// A call keeps this many buffers in each AudioQueue (input 4 -> CBP_F_INQ, output 3 -> CBP_F_OUTQ), so a stall of the
+/// main loop shorter than that many 10 ms frames costs the device nothing; the tx ring holds the burst that follows.
+pub const CBP_F_INQ : u32 = 16;
+pub const CBP_F_OUTQ : u32 = 8;
+/// Concealment of a refill: one silent buffer in every CBP_F_STRETCH callbacks, never the whole refill at once.
+const CBP_F_STRETCH : u64 = 4;
+const CBP_F_SLACK : u64 = 8;
+const CBP_F_QUIET : u64 = 5000000;
+/// Part F block: 64 u64 header slots (512 bytes), tx ring 24 x 960, rx seq+1 per slot, rx kind per slot
+/// (1 primary, 2 redundant copy), capture us per seq % 64, rx data 64 x 960, last played frame 960.
+/// Header: 0 in calls, 1 out calls, 2 frames captured, 3 frames handled by the sender, 4 underruns, 5 overruns,
+/// 6 frames skipped by overruns, 7 tx ring overruns, 8 stopping, 9 magic, 10 tx fd, 11 rx fd, 12 next seq to play,
+/// 13 highest seq received + 1, 14 warming, 15 warm-up silent buffers, 16 packets sent, 17 dropped by the storm,
+/// 18 swaps, 19 send errors, 20 last send errno, 21 packets received, 22 unique primaries, 23 duplicates,
+/// 24 late, 25 reordered, 26 redundant copies stored, 27 played primary, 28 played from a redundant copy,
+/// 29 concealed, 30 bad packets, 31 recv errors, 32 last recv errno, 33 reads ended by EAGAIN, 34 read stalls,
+/// 35 no read until us, 36 next stall us, 37 max packets in one read, 38 checksum sum sent, 39 checksum sum
+/// received, 40 age sum us, 41 age max, 42 age min, 43 ages, 44 age sum first 10 s, 45 ages first 10 s,
+/// 46 age sum last 10 s, 47 ages last 10 s, 48 depth sum, 49 depth max, 50 depth min, 51 nonzero samples played,
+/// 52 failed in enqueues, 53 failed out enqueues, 54 output start us, 55 redundancy on, 56 warm-up end us,
+/// 57 max out interval us, 58 max in interval us, 59 bytes sent, 60 bytes received, 61 first in us, 62 last in us,
+/// 63 last out us.
+const CBP_F_TXD : u64 = 512;
+const CBP_F_RXS : u64 = 23552;
+const CBP_F_KIND : u64 = 24064;
+const CBP_F_CAPT : u64 = 24576;
+const CBP_F_RXD : u64 = 25088;
+const CBP_F_LAST : u64 = 86528;
+/// Extension (part G), 16 u64 slots after the last frame: 0 two hosts, 1 peer IPv4 (a<<24|b<<16|c<<8|d), 2 port,
+/// 3 nonzero samples in received primary frames, 4 received frames with a nonzero sample, 5 run us,
+/// 6 first seq received + 1, 7 underruns at the last packet received, 8 last packet received us,
+/// 9 ended because the peer went silent, 10 max gap between received packets us, 11 bind IPv4,
+/// 12 jitter target frames, 13 jitter max frames, 14 sendto EAGAIN retries (the frame stays queued),
+/// 15 discard captured frames (the queues run before the shared start time).
+/// Adaptive jitter buffer (calls only, 8 more u64 slots 16..23): 16 adaptive on, 17 floor target frames (the target
+/// the call started with), 18 time us of the last underrun event or shrink, 19 grow events, 20 shrink events,
+/// 21 highest target reached, 22 gap buffers (silence played to conceal a missing frame or to refill, apart from
+/// underruns and from the start warm-up in slot 15 of the header), 23 refill debt in frames. A call never stops
+/// playing: an empty buffer plays one silent buffer (an underrun and a gap), the target rises by CBP_F_GROW up to
+/// CBP_F_CAP, and that many silent buffers are spread over later callbacks (one in CBP_F_STRETCH) so the buffer
+/// refills without a pause; CBP_F_QUIET us without an event lower the target by one frame down to the floor. The overrun limit follows the target: target + CBP_F_SLACK, at most CBP_F_CAP + CBP_F_SLACK.
+const CBP_F_EXT : u64 = 87488;
+const CBP_F_BYTES : usize = 87680;
+const CBP_LOOPBACK : u64 = 2130706433;
+
+fn cbp_f_size() -> u64 { return CBP_F_EXT + 192; }
+
+/// What the storm does with packet seq: 0 send, 1 drop (every 20th), 2 send seq+1 first, then seq (every 100).
+pub fn cbp_storm(seq: u64) -> u64 {
+    if (seq % 20 == 19) { return 1; }
+    if (seq % 100 == 50) { return 2; }
+    return 0;
+}
+
+/// struct sockaddr_in for ip:port, ip as a<<24|b<<16|c<<8|d (BSD layout: length, family, port and address big-endian).
+fn cbp_sockaddr(out: []u8, ip: u64, port: u64) -> void {
+    var i : usize = 0;
+    while (i < 16) { out[i] = 0; i = i + 1; }
+    out[0] = 16;
+    out[1] = 2;
+    out[2] = @as(u8, @intCast((port >> 8) & 255));
+    out[3] = @as(u8, @intCast(port & 255));
+    out[4] = @as(u8, @intCast((ip >> 24) & 255));
+    out[5] = @as(u8, @intCast((ip >> 16) & 255));
+    out[6] = @as(u8, @intCast((ip >> 8) & 255));
+    out[7] = @as(u8, @intCast(ip & 255));
+}
+
+/// struct sockaddr_in for 127.0.0.1:port.
+fn cbp_inaddr(out: []u8, port: u64) -> void { cbp_sockaddr(out, CBP_LOOPBACK, port); }
+
+/// Dotted quad in the first n bytes of s, as a<<24|b<<16|c<<8|d; 2^32 when it is not four numbers 0..255.
+fn cbp_parse_ip(s: []const u8, n: usize) -> u64 {
+    var ip : u64 = 0;
+    var part : u64 = 0;
+    var digits : u64 = 0;
+    var dots : u64 = 0;
+    var i : usize = 0;
+    while (i < n) {
+        const c : u8 = s[i];
+        if (c >= 48 and c <= 57) {
+            part = part * 10 + @as(u64, @intCast(c - 48));
+            digits = digits + 1;
+            if (part > 255 or digits > 3) { return 4294967296; }
+        } else if (c == 46) {
+            if (digits == 0 or dots == 3) { return 4294967296; }
+            ip = (ip << 8) | part;
+            part = 0;
+            digits = 0;
+            dots = dots + 1;
+        } else {
+            return 4294967296;
+        }
+        i = i + 1;
+    }
+    if (digits == 0 or dots != 3) { return 4294967296; }
+    return (ip << 8) | part;
+}
+
+/// Decimal number in the first n bytes of s; 2^32 when empty, not a number or above 2^32 - 1.
+fn cbp_parse_u(s: []const u8, n: usize) -> u64 {
+    if (n == 0 or n > 10) { return 4294967296; }
+    var v : u64 = 0;
+    var i : usize = 0;
+    while (i < n) {
+        const c : u8 = s[i];
+        if (c < 48 or c > 57) { return 4294967296; }
+        v = v * 10 + @as(u64, @intCast(c - 48));
+        i = i + 1;
+    }
+    if (v > 4294967295) { return 4294967296; }
+    return v;
+}
+
+/// Environment variable `name` copied into out (at most 32 bytes); its length, or 0 when it is unset.
+fn cbp_env(name: []const u8, out: []u8) -> usize {
+    const a : u64 = sys_getenv(name);
+    if (a == 0) { return 0; }
+    var n : u64 = sys_strlen(a);
+    if (n > 32) { n = 32; }
+    sys_peek(out[0..32], a, n);
+    return @as(usize, @intCast(n));
+}
+
+/// IPv4 from the environment: dflt when unset, 2^32 when malformed.
+fn cbp_env_ip(name: []const u8, dflt: u64) -> u64 {
+    var b : [32]u8 = undefined;
+    const n : usize = cbp_env(name, b[0..32]);
+    if (n == 0) { return dflt; }
+    return cbp_parse_ip(b[0..32], n);
+}
+
+/// Number from the environment: dflt when unset, 2^32 when malformed.
+fn cbp_env_u(name: []const u8, dflt: u64) -> u64 {
+    var b : [32]u8 = undefined;
+    const n : usize = cbp_env(name, b[0..32]);
+    if (n == 0) { return dflt; }
+    return cbp_parse_u(b[0..32], n);
+}
+
+fn cbp_errno() -> u64 {
+    var c : [4]u8 = undefined;
+    sys_peek(c[0..4], cbp_errloc(), 4);
+    return @as(u64, @intCast(c[0])) | (@as(u64, @intCast(c[1])) << 8) | (@as(u64, @intCast(c[2])) << 16) | (@as(u64, @intCast(c[3])) << 24);
+}
+
+/// Halve every 16-bit sample of the 960 bytes at addr, in place (concealment fades a repeated frame).
+fn cbp_half(addr: u64) -> void {
+    var b : [960]u8 = undefined;
+    sys_peek(b[0..960], addr, 960);
+    var i : usize = 0;
+    while (i < 960) {
+        var v : i64 = @as(i64, @intCast(b[i])) | (@as(i64, @intCast(b[i + 1])) << 8);
+        if (v >= 32768) { v = v - 65536; }
+        if (v < 0) { v = 0 - ((0 - v) / 2); } else { v = v / 2; }
+        if (v < 0) { v = v + 65536; }
+        b[i] = @as(u8, @intCast(v & 255));
+        b[i + 1] = @as(u8, @intCast((v >> 8) & 255));
+        i = i + 2;
+    }
+    cbp_poke(addr, b[0..960], 960);
+}
+
+/// Part F input callback: the captured buffer becomes frame `seq` in the tx ring (one slot is kept for the
+/// redundant copy), or a tx overrun.
+pub fn cbp_fin(user: u64, aq: u64, buf: u64, ts: u64, npk: u32, pd: u64) -> u64 {
+    if (cbp_get(user + 64) != 0) { return 0; }
+    if (cbp_get(user + CBP_F_EXT + 120) != 0) {
+        if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_inc(user + 416, 1); }
+        return 0;
+    }
+    const n : u64 = cbp_get(user) + 1;
+    cbp_put(user, n);
+    const t : u64 = cbp_us();
+    if (n == 1) { cbp_put(user + 488, t); } else { cbp_emax(user + 464, t - cbp_get(user + 496)); }
+    cbp_put(user + 496, t);
+    var hd : [4]u8 = undefined;
+    sys_peek(hd[0..4], buf + 16, 4);
+    var sz : u64 = @as(u64, @intCast(hd[0])) | (@as(u64, @intCast(hd[1])) << 8) | (@as(u64, @intCast(hd[2])) << 16) | (@as(u64, @intCast(hd[3])) << 24);
+    if (sz > 960) { sz = 960; }
+    const data : u64 = cbp_get(buf + 8);
+    if (data == 0) { sz = 0; }
+    const w : u64 = cbp_get(user + 16);
+    if (w - cbp_get(user + 24) >= CBP_F_TX - 1) {
+        cbp_inc(user + 56, 1);
+    } else {
+        const dst : u64 = user + CBP_F_TXD + (w % CBP_F_TX) * 960;
+        if (sz > 0) { cbp_copy(dst, data, sz); }
+        if (sz < 960) { cbp_zero(dst + sz, 960 - sz); }
+        cbp_put(user + CBP_F_CAPT + (w % CBP_F_JB) * 8, t);
+        cbp_put(user + 16, w + 1);
+    }
+    if (cbp_aq_enqueue(aq, buf, 0, 0) != 0) { cbp_inc(user + 416, 1); }
+    return n;
+}
