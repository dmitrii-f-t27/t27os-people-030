+// Deterministic fixture bytes only; never used to generate a runtime identity.
+pub fn pi_test_fp(seed: u8, out: []u8) -> void {
+    var i : usize = 0;
+    while (i < FP_BYTES) {
+        out[i] = seed + @as(u8, @intCast(i)) * 3;
+        i = i + 1;
+    }
+}
+
+test shared_fingerprint_fixture_keeps_exact_bytes_and_tail {
+    var out : [12]u8 = [_]u8{99} ** 12;
+    pi_test_fp(5, out[0..12]);
+    const expected : [10]u8 = [5, 8, 11, 14, 17, 20, 23, 26, 29, 32];
+    assert bytes_eq(out[0..10], expected[0..10]);
+    assert out[10] == 99 and out[11] == 99;
+}
