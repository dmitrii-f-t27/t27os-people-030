+++ b/specs/t27os/personal_account.t27
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: Apache-2.0
+// Local account inventory. The macOS login is the security boundary; this is
+// not an app.t27.ai session. No credential values are requested by this module.
+use std::mem::bytes_eq;
+pub fn account_button_y(top: f64) -> f64 { return top + 470.0; }
+pub fn account_button_hit(x: f64, y: f64, left: f64, top: f64, width: f64) -> bool {
+    return x >= left + 20.0 and x <= left + width - 20.0 and y >= account_button_y(top) and y <= account_button_y(top) + 28.0;
+}
+pub fn account_provider(i: u32) -> []const u8 {
+    if (i == 0) { return "Claude"; }
+    if (i == 1) { return "Codex"; }
+    if (i == 2) { return "Antigravity"; }
+    if (i == 3) { return "OpenCode"; }
+    return "Devin";
+}
+pub fn account_connect(i: u32) -> []const u8 {
+    if (i == 0) { return "t27-connect-claude"; }
+    if (i == 1) { return "t27-connect-codex"; }
+    if (i == 3) { return "t27-connect-opencode"; }
+    if (i == 4) { return "t27-connect-devin"; }
+    return "";
+}
+pub fn account_launch_kind(name: []const u8) -> u32 {
+    var i : u32 = 0;
+    while (i < 5) {
+        const expected : []const u8 = account_connect(i);
+        if (expected.len > 0 and name.len == expected.len) {
+            var same : bool = true;
+            var n : usize = 0;
+            while (n < name.len) { if (name[n] != expected[n]) { same = false; } n = n + 1; }
+            if (same) { return i; }
+        }
+        i = i + 1;
+    }
+    return 99;
+}
+
+test profile_account_entry_is_bounded {
+    assert account_button_hit(30.0, 480.0, 0.0, 0.0, 300.0);
+    assert account_button_hit(30.0, 460.0, 0.0, 0.0, 300.0) == false;
+    assert account_button_hit(301.0, 480.0, 0.0, 0.0, 300.0) == false;
+}
+test antigravity_never_uses_an_unsupported_cli_login {
+    assert account_connect(2).len == 0;
+    assert account_connect(0).len > 0;
+    assert account_connect(1).len > 0;
+}
+
+pub fn account_header_hit(x: f64, y: f64, width: f64) -> bool { return width >= 650.0 and x >= 112.0 and x <= 178.0 and y >= 3.0 and y <= 31.0; }
+test header_profile_entry_has_a_separate_bounded_slot {
+    assert account_header_hit(140.0, 16.0, 650.0);
+    assert account_header_hit(90.0, 16.0, 650.0) == false;
+    assert account_header_hit(140.0, 40.0, 650.0) == false;
+    assert account_header_hit(140.0, 16.0, 400.0) == false;
+}
+
+pub fn account_command(i: u32) -> []const u8 {
+    if (i == 0) { return "/Applications/Orca.app/Contents/Resources/bin/orca account add --agent claude"; }
+    if (i == 1) { return "/Applications/Orca.app/Contents/Resources/bin/orca account add --agent codex"; }
+    if (i == 3) { return "/Applications/Orca.app/Contents/Resources/bin/orca account add --agent opencode"; }
+    if (i == 4) { return "/Applications/Orca.app/Contents/Resources/bin/orca account add --agent devin"; }
+    return "";
+}
+test connection_fallback_is_allowlisted_and_never_invents_antigravity_cli {
+    assert account_command(0).len > 0;
+    assert account_command(1).len > 0;
+    assert account_command(2).len == 0;
+    assert account_command(4).len > 0;
+}
+
+test native_connect_names_are_exactly_allowlisted {
+    assert account_launch_kind("t27-connect-claude") == 0;
+    assert account_launch_kind("t27-connect-codex") == 1;
+    assert account_launch_kind("t27-connect-opencode") == 3;
+    assert account_launch_kind("t27-connect-devin") == 4;
+    assert account_launch_kind("t27-connect-antigravity") == 99;
+    assert account_launch_kind("t27-connect-claude extra") == 99;
+}
+
+// Account contract, issue #14136. Presence, association and response are separate.
+pub const PA3_SOURCE_MANAGED : u32 = 1;
+pub const PA3_SOURCE_SYSTEM : u32 = 2;
+pub const PA3_SOURCE_ENV : u32 = 3;
+pub const PA3_SOURCE_CREDENTIAL : u32 = 4;
+pub const PA3_SOURCE_CLI : u32 = 5;
+pub const PA3_USE : u32 = 1;
+pub const PA3_CONNECT : u32 = 2;
+pub const PA3_REQUEST_LIFETIME : u64 = 30;
+pub const PA3_DEFAULTS_SUITE : str = "ai.t27.os.accounts";
+pub fn pa3_provider_supported(kind: u32) -> bool { return kind == 0 or kind == 1 or kind == 3 or kind == 4; }
+pub fn pa3_total(managed: u64, system_present: bool, same_identity: bool) -> u64 {
+    if (system_present and (managed == 0 or same_identity == false)) { return managed + 1; }
+    return managed;
+}
+pub fn pa3_presence(known: bool, present: bool, source: u32) -> []const u8 {
+    if (known == false) { return "Not checked"; }
+    if (present == false) { return "Not discovered"; }
+    if (source == 0) { return "Configuration type unknown"; }
+    if (source == PA3_SOURCE_CLI) { return "Installed CLI - login not verified"; }
+    if (source == PA3_SOURCE_ENV) { return "Environment configuration"; }
+    if (source == PA3_SOURCE_CREDENTIAL) { return "Credential configuration"; }
+    if (source == PA3_SOURCE_SYSTEM) { return "System login"; }
+    return "Saved Orca profile";
+}
+pub fn pa3_response_label(verified: bool) -> []const u8 {
+    if (verified) { return "Response verified"; }
+    return "Response not tested";
+}
+pub fn pa3_request_ok(owner: u64, current: u64, provider: u32, requested_provider: u32, action: u32, timestamp: u64, now: u64) -> bool {
+    return owner == current and pa3_provider_supported(provider) and provider == requested_provider and (action == PA3_USE or action == PA3_CONNECT) and now >= timestamp and now - timestamp <= PA3_REQUEST_LIFETIME;
+}
+pub fn pa3_binding_ok(owner: u64, current: u64, source: u32, has_reference: bool) -> bool {
+    return owner == current and has_reference and source >= PA3_SOURCE_MANAGED and source <= PA3_SOURCE_CLI;
+}
+pub fn pa3_private_reference(provider: u32, source: u32, slot: u32) -> u64 {
+    return @as(u64, provider) * 100000 + @as(u64, source) * 1000 + @as(u64, slot);
+}
+test system_connections_are_not_hidden_by_zero_managed_profiles {
+    assert pa3_total(0, true, false) == 1;
+    assert pa3_total(0, false, false) == 0;
+    assert pa3_total(2, true, false) == 3;
+    assert pa3_total(2, true, true) == 2;
+}
+pub fn pa3_same(a: []const u8, b: []const u8) -> bool {
+    return bytes_eq(a, b);
+}
+pub fn pa3_cli_name(kind: u32) -> []const u8 {
+    if (kind == 0) { return "claude"; }
+    if (kind == 1) { return "codex"; }
+    if (kind == 2) { return "agy"; }
+    if (kind == 3) { return "opencode"; }
+    if (kind == 4) { return "devin"; }
+    if (kind == 5) { return "orca"; }
+    return "";
+}
+test configuration_is_not_a_verified_response {
+    assert pa3_same(pa3_presence(true, true, PA3_SOURCE_ENV), "Environment configuration");
+    assert pa3_same(pa3_presence(true, true, PA3_SOURCE_CREDENTIAL), "Credential configuration");
+    assert pa3_same(pa3_presence(false, true, PA3_SOURCE_SYSTEM), "Not checked");
+    assert pa3_same(pa3_response_label(false), "Response not tested");
+}
+test launch_requests_are_current_user_short_lived_and_allowlisted {
+    assert pa3_request_ok(501, 501, 0, 0, PA3_USE, 100, 101);
+    assert pa3_request_ok(501, 502, 0, 0, PA3_USE, 100, 101) == false;
+    assert pa3_request_ok(501, 501, 0, 1, PA3_USE, 100, 101) == false;
+    assert pa3_request_ok(501, 501, 2, 2, PA3_USE, 100, 101) == false;
+    assert pa3_request_ok(501, 501, 0, 0, PA3_CONNECT, 100, 131) == false;
+    assert pa3_request_ok(501, 501, 0, 0, PA3_CONNECT, 100, 99) == false;
+    assert pa3_request_ok(501, 501, 0, 0, 99, 100, 101) == false;
+}
+test local_binding_cannot_be_reused_by_another_native_user {
+    assert pa3_binding_ok(501, 501, PA3_SOURCE_SYSTEM, true);
+    assert pa3_binding_ok(501, 502, PA3_SOURCE_SYSTEM, true) == false;
+    assert pa3_binding_ok(501, 501, PA3_SOURCE_ENV, false) == false;
+    assert pa3_private_reference(0, PA3_SOURCE_SYSTEM, 1) != pa3_private_reference(1, PA3_SOURCE_SYSTEM, 1);
+}
+
+pub fn account_event_type(event_type: u64, event_window: u64, account_window: u64) -> u64 {
+    if (account_window != 0 and event_window == account_window) { return 0; }
+    return event_type;
+}
+test native_account_events_do_not_activate_main_window_controls {
+    assert account_event_type(1, 42, 42) == 0;
+    assert account_event_type(1, 43, 42) == 1;
+    assert account_event_type(1, 0, 0) == 1;
+}
+
+test installed_antigravity_cli_is_not_a_verified_identity {
+    assert pa3_same(pa3_cli_name(2),"agy");
+    assert pa3_same(pa3_presence(true,true,PA3_SOURCE_CLI),"Installed CLI - login not verified");
+    assert !pa3_same(pa3_presence(true,true,PA3_SOURCE_CLI),"System login");
+    assert pa3_binding_ok(501,501,PA3_SOURCE_CLI,true);
+    assert !pa3_binding_ok(501,502,PA3_SOURCE_CLI,true);
+}
