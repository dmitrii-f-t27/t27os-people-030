+    // the sender's counters stand in link 0's block
+    cvp(z, VT_G + VG_FRAMES, 51);
+    cvp(z, VT_G + VG_ENC, 52);
+    cvp(z, VT_G + VG_SKIP, 53);
+    cvp(z, VT_G + VG_SENDS, 54);
+    assert csg_vstat(z, 0) == 51 and csg_vstat(z, 1) == 52 and csg_vstat(z, 2) == 53 and csg_vstat(z, 3) == 54 and csg_vstat(z, 4) == 0;
+    // shown: only ACTIVE links that sent a frame, the earliest first
+    assert csg_vshow(z) == 255 | (255 << 8);
+    z[CS_LEN + 1] = @as(u8, @intCast(CK_ACTIVE));
+    assert csg_vshow(z) == 1 | (255 << 8);
+    z[1] = @as(u8, @intCast(CK_ACTIVE));
+    cvkp(z, 0, VT_FIRST, 40);
