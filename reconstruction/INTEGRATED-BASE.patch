+test a_strangers_message_session_ends_as_an_invitation_with_its_proven_key_and_nothing_else_does {
+    // the verdict: a stranger's proven message session is an invitation; a friend that is not trusted is refused as
+    // before; a call goes on (the code is compared there); a refused key stays refused; a trusted one opens
+    assert cs_id_why(true, true, true, PID_CODE, true) == CS_R_INVITE;
+    assert cs_id_why(true, true, true, PID_CODE, false) == CS_R_UNVERIFIED;
+    assert cs_id_why(false, true, true, PID_CODE, true) == CS_R_NONE;
+    assert cs_id_why(true, true, true, PID_REFUSE, true) == CS_R_IDENTITY;
+    assert cs_id_why(true, true, true, PID_TRUSTED, false) == CS_R_NONE;
+    assert cs_id_why(true, true, false, PID_CODE, true) == CS_R_NONE;
+    assert cs_id_why(true, false, false, PID_CODE, false) == CS_R_UNVERIFIED;
+    // the proven key is handed out only after CS_R_INVITE, only for a stranger, only for a proof that checked
+    var s : [299648]u8 = undefined;
+    var fp : [10]u8 = undefined;
+    var k : [65]u8 = undefined;
+    cs_t_live(s[0..CS_LEN]);
+    s[CS_ID + CI_ON] = 1;
+    s[CS_ID + CI_GOT] = 1;
+    s[CS_ID + CI_OK] = 1;
+    s[CS_ID + CI_STRANGER] = 1;
+    ck_fill_session(s[EP_PEER..EP_PEER + 10], 3);
+    ck_fill_session(s[CS_ID + CI_RX..CS_ID + CI_RX + 65], 9);
+    assert cs_id_proven(s[0..CS_LEN], fp[0..10], k[0..65]) == false;
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_INVITE));
+    assert cs_id_proven(s[0..CS_LEN], fp[0..10], k[0..65]);
+    assert ck_same(fp[0..10], s[EP_PEER..EP_PEER + 10]) and ck_same(k[0..65], s[CS_ID + CI_RX..CS_ID + CI_RX + 65]);
+    s[CS_ID + CI_OK] = 0;
+    assert cs_id_proven(s[0..CS_LEN], fp[0..10], k[0..65]) == false;
+    s[CS_ID + CI_OK] = 1;
+    s[CS_ID + CI_STRANGER] = 0;
+    assert cs_id_proven(s[0..CS_LEN], fp[0..10], k[0..65]) == false;
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_UNVERIFIED));
+    s[CS_ID + CI_STRANGER] = 1;
+    assert cs_id_proven(s[0..CS_LEN], fp[0..10], k[0..65]) == false;
+    // a new session forgets that the last peer was a stranger
+    cs_id_fresh(s[0..CS_LEN]);
+    assert s[CS_ID + CI_STRANGER] == 0;
+}
