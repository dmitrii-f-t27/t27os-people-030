+test a_have_from_a_member_sends_its_unacknowledged_lines_again {
+    // A made {A, B, C}; its line to B and C failed while they did not know the group
+    var t : [4240]u8 = undefined;
+    t_table(t[0..GT_LEN]);
+    var log : [16296]u8 = undefined;
+    var fl : [32]u8 = undefined;
+    ck_wipe(fl[0..32]);
+    t_log(log[0..T_LOG]);
+    const x : [1]u8 = [120];
+    assert gl_out_add(log[0..T_LOG], fl[0..32], 0, x[0..1], 0, 6) == 1;
+    var now : u64 = 1000;
+    var k : u32 = 0;
+    while (k < 20) {
+        gl_due_for(log[0..T_LOG], 0, 1, now);
+        gl_due_for(log[0..T_LOG], 0, 2, now + 1);
+        now = now + CH_RETRY_MS;
+        k = k + 1;
+    }
+    assert cl_state(log[0..T_LOG], 0) == CH_S_FAILED and gl_pending_for(log[0..T_LOG], 1) == 0;
+    var fra : [1108]u8 = undefined;
+    ft_init(fra[0..FT_LEN]);
+    assert t_friend(fra[0..FT_LEN], T_B[0..10], T_A[0..10]);
+    var h : [160]u8 = undefined;
+    const hn : usize = gi_put_rec(h[0..160], GI_HAVE, t[0..GT_LEN], 0);
+    // B says it has the group while another group is open: nothing restarts here
+    var r : u32 = gi_apply(t[0..GT_LEN], fra[0..FT_LEN], T_A[0..10], T_B[0..10], true, h[0..hn], T_DIGEST[0..8], log[0..T_LOG], GT_NONE);
+    assert r == GI_JOINED and cl_state(log[0..T_LOG], 0) == CH_S_FAILED;
+    // not pinned, not a member: refused
+    assert gi_apply(t[0..GT_LEN], fra[0..FT_LEN], T_A[0..10], T_B[0..10], false, h[0..hn], T_DIGEST[0..8], log[0..T_LOG], 0) == GR_UNTRUSTED;
+    assert gi_apply(t[0..GT_LEN], fra[0..FT_LEN], T_A[0..10], T_X[0..10], true, h[0..hn], T_DIGEST[0..8], log[0..T_LOG], 0) == GR_NOT_MEMBER;
+    assert cl_state(log[0..T_LOG], 0) == CH_S_FAILED;
+    // with the group open: the failed line is owed to B again and goes out at once
+    r = gi_apply(t[0..GT_LEN], fra[0..FT_LEN], T_A[0..10], T_B[0..10], true, h[0..hn], T_DIGEST[0..8], log[0..T_LOG], 0);
+    assert (r & 255) == GI_JOINED and (r >> 8) == 1;
+    assert cl_state(log[0..T_LOG], 0) == CH_S_PENDING and cl_tries(log[0..T_LOG], 0) == 0;
+    assert gl_pending_for(log[0..T_LOG], 1) == 1;
+    assert gl_due_for(log[0..T_LOG], 0, 1, now) == CH_R_SEND;
+    // the announces a new group owes: every member but its creator
+    assert gi_owe_new(t[0..GT_LEN], 0, T_A[0..10]) == 6 and gi_owe_new(t[0..GT_LEN], 0, T_B[0..10]) == 5;
+    assert gi_mine(t[0..GT_LEN], 0, T_A[0..10]) and gi_mine(t[0..GT_LEN], 0, T_B[0..10]) == false;
+}
