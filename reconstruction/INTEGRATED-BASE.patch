+/// Parse up to 39 bytes read from github.txt: strip trailing \r/\n/spaces, reject control/non-ASCII bytes.
+pub fn prfh_parse_login_bytes(got: i64, raw: []const u8, out: []u8) -> usize {
+    if (got <= 0) { return 0; }
+    var n : usize = @as(usize, @intCast(got));
+    if (n > raw.len) { n = raw.len; }
+    while (n > 0 and (raw[n - 1] == 13 or raw[n - 1] == 10 or raw[n - 1] == 32)) {
+        n = n - 1;
+    }
+    if (n == 0 or n > 39 or n > out.len) { return 0; }
+    var i : usize = 0;
+    while (i < n) {
+        if (raw[i] <= 32 or raw[i] >= 127) { return 0; }
+        i = i + 1;
+    }
+    var c : usize = 0;
+    while (c < n) {
+        out[c] = raw[c];
+        c = c + 1;
+    }
+    return n;
+}
+
+/// Build `Bearer <tok>` header value into `out`; 0 when empty, control bytes present, or `out` too small.
+pub fn prfh_bearer_value(tok: []const u8, out: []u8) -> usize {
+    if (tok.len == 0 or 7 + tok.len > out.len) { return 0; }
+    var i : usize = 0;
+    while (i < tok.len) {
+        if (tok[i] <= 32 or tok[i] >= 127) { return 0; }
+        i = i + 1;
+    }
