+test ch_put_part_frames_one_cut_part_as_ch_put_text_would_and_refuses_what_cannot_be_one {
+    var t : [1500]u8 = undefined;
+    t_fill(t[0..1500], 1500, 5);
+    var a : [720]u8 = undefined;
+    var b : [720]u8 = undefined;
+    // each part cut by hand is byte for byte the part ch_put_text cuts from the whole text
+    var k : u32 = 0;
+    while (k < 3) {
+        const from : usize = @as(usize, k) * CH_PART_MAX;
+        var n : usize = 1500 - from;
+        if (n > CH_PART_MAX) { n = CH_PART_MAX; }
+        const na : usize = ch_put_part(a[0..720], 11, k, 3, 1099511627781, t[from..from + n]);
+        const nb : usize = ch_put_text(b[0..720], 11, k, 1099511627781, t[0..1500]);
+        assert na == nb and na == CH_PHDR + n;
+        var i : usize = 0;
+        while (i < na) { assert a[i] == b[i]; i = i + 1; }
+        assert ch_kind(a[0..na]) == CH_K_TEXT;
+        k = k + 1;
+    }
+    // Cyrillic bytes travel unchanged; the last part may be short
+    const ru : [12]u8 = [208, 191, 209, 128, 208, 184, 208, 178, 208, 181, 209, 130];
+    const nr : usize = ch_put_part(a[0..720], 4, 1, 2, 9, ru[0..12]);
+    assert nr == CH_PHDR + 12 and ch_kind(a[0..nr]) == CH_K_TEXT;
+    assert ch_msg(a[0..nr]) == 4 and ch_part(a[0..nr]) == 1 and ch_parts(a[0..nr]) == 2 and ch_time(a[0..nr]) == 9 and ch_len(a[0..nr]) == 12;
+    assert a[CH_PHDR] == 208 and a[CH_PHDR + 11] == 130;
+    // a short part before the last frames, but the reader refuses it: the cut is the caller's job
+    const ns : usize = ch_put_part(a[0..720], 4, 0, 2, 9, ru[0..12]);
+    assert ns == CH_PHDR + 12 and ch_kind(a[0..ns]) == 0;
+    // what cannot be a part: no message, no parts, more than three, a part past the end, no bytes, too many bytes
+    assert ch_put_part(a[0..720], 0, 0, 1, 9, ru[0..12]) == 0;
+    assert ch_put_part(a[0..720], 4, 0, 0, 9, ru[0..12]) == 0;
+    assert ch_put_part(a[0..720], 4, 0, 4, 9, t[0..700]) == 0;
+    assert ch_put_part(a[0..720], 4, 2, 2, 9, ru[0..12]) == 0;
+    assert ch_put_part(a[0..720], 4, 0, 1, 9, ru[0..0]) == 0;
+    assert ch_put_part(a[0..720], 4, 0, 1, 9, t[0..701]) == 0;
+    assert ch_put_part(a[0..720], 4, 0, 1, 9, t[0..700]) == CH_PAYLOAD_MAX;
+    // out must hold the header and every byte: one byte short is nothing, exactly enough is the part
+    assert ch_put_part(a[0..31], 4, 0, 1, 9, ru[0..12]) == 0;
+    assert ch_put_part(a[0..32], 4, 0, 1, 9, ru[0..12]) == 32;
+}
