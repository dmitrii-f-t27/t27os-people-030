+test a_group_info_is_kept_only_from_a_trusted_creator_with_this_device_in_it_under_its_own_id {
+    // A announces the group {A, B} to B over their message session
+    var r2 : [20]u8 = undefined;
+    copy(r2[0..20], 0, T_A[0..10], 0, 10);
+    copy(r2[0..20], 10, T_B[0..10], 0, 10);
+    const id2 : [8]u8 = [4, 23, 205, 1, 40, 87, 215, 222];
+    var p : [160]u8 = undefined;
+    const n : usize = gi_put(p[0..160], GI_ANNOUNCE, id2[0..8], T_A[0..10], r2[0..20], 2, "pair", 777);
+    var frb : [1108]u8 = undefined;
+    ft_init(frb[0..FT_LEN]);
+    assert t_friend(frb[0..FT_LEN], T_A[0..10], T_B[0..10]);
+    var fre : [1108]u8 = undefined;
+    ft_init(fre[0..FT_LEN]);
+    var frc : [1108]u8 = undefined;
+    ft_init(frc[0..FT_LEN]);
+    assert t_friend(frc[0..FT_LEN], T_A[0..10], T_C[0..10]);
+    var t : [4240]u8 = undefined;
+    gt_init(t[0..GT_LEN]);
+    var z : [1]u8 = undefined;
+    // A's key is not stored at B
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], false, p[0..n], id2[0..8], z[0..0], GT_NONE) == GR_UNTRUSTED;
+    // A is not B's friend
+    assert gi_apply(t[0..GT_LEN], fre[0..FT_LEN], T_B[0..10], T_A[0..10], true, p[0..n], id2[0..8], z[0..0], GT_NONE) == GR_NOT_FRIEND;
+    // C is not in the group
+    assert gi_apply(t[0..GT_LEN], frc[0..FT_LEN], T_C[0..10], T_A[0..10], true, p[0..n], id2[0..8], z[0..0], GT_NONE) == GR_NOT_ME;
+    // the roster hashes to another id than the frame names
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], true, p[0..n], T_DIGEST[0..8], z[0..0], GT_NONE) == GR_ID_BAD;
+    var p2 : [160]u8 = undefined;
+    const n2 : usize = gi_put(p2[0..160], GI_ANNOUNCE, T_DIGEST[0..8], T_A[0..10], r2[0..20], 2, "pair", 777);
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], true, p2[0..n2], id2[0..8], z[0..0], GT_NONE) == GR_ID_BAD;
+    // relayed by someone else than its creator
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_C[0..10], true, p[0..n], id2[0..8], z[0..0], GT_NONE) == GR_SPOOF;
+    // cut
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], true, p[0..n - 1], id2[0..8], z[0..0], GT_NONE) == GR_BAD;
+    // none of these was kept
+    assert gt_count(t[0..GT_LEN]) == 0;
+    // from its trusted creator, B in it, its own id: kept with A its creator, the name and the time
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], true, p[0..n], id2[0..8], z[0..0], GT_NONE) == GI_KEPT;
+    assert gt_count(t[0..GT_LEN]) == 1 and gt_find(t[0..GT_LEN], id2[0..8]) == 0 and gt_creator(t[0..GT_LEN], 0) == 0;
+    assert gt_n(t[0..GT_LEN], 0) == 2 and gt_name(t[0..GT_LEN], 0)[0] == 112 and gt_time(t[0..GT_LEN], 0) == 777 and gt_idx(t[0..GT_LEN], 0, T_B[0..10]) == 1;
+    // the same again: already here, nothing added
+    assert gi_apply(t[0..GT_LEN], frb[0..FT_LEN], T_B[0..10], T_A[0..10], true, p[0..n], id2[0..8], z[0..0], GT_NONE) == GI_ALREADY;
+    assert gt_count(t[0..GT_LEN]) == 1;
+    // a HAVE of a group not in a table
+    var t2 : [4240]u8 = undefined;
