+test fv_trust_reads_as_verified_not_verified_or_key_mismatch {
+    var o : [96]u8 = undefined;
+    // the bits: nothing stored is not verified; a stored key is verified; a refusal with a stored key is a mismatch
+    assert fv_trust_of(0) == FV_T_UNVERIFIED;
+    assert fv_trust_of(FV_TB_PIN) == FV_T_VERIFIED;
+    assert fv_trust_of(FV_TB_PIN | FV_TB_BAD) == FV_T_MISMATCH;
+    assert fv_trust_of(FV_TB_BAD) == FV_T_UNVERIFIED;
+    // not verified -> verified once the key of a matched call is stored; a later refusal is a mismatch, a proof clears it
+    var b : u32 = 0;
+    b = fv_trust_step(b, false, false, false);
+    assert fv_trust_of(b) == FV_T_UNVERIFIED;
+    b = fv_trust_step(b, true, false, false);
+    assert fv_trust_of(b) == FV_T_VERIFIED;
+    b = fv_trust_step(b, false, false, true);
+    assert fv_trust_of(b) == FV_T_MISMATCH;
+    b = fv_trust_step(b, false, true, false);
+    assert fv_trust_of(b) == FV_T_VERIFIED;
+    // a code compared in a call with no key yet (neither stored nor proven) changes nothing
+    assert fv_trust_step(0, false, false, false) == 0;
+    // the card's words and the hints: the unverified one says a message invites (invites.t27)
+    assert fv_eq(o[0..96], fv_trust_word_put(o[0..96], FV_T_UNVERIFIED), "not verified");
+    assert fv_eq(o[0..96], fv_trust_word_put(o[0..96], FV_T_MISMATCH), "! key mismatch");
+    const n : usize = fv_trust_word_put(o[0..96], FV_T_VERIFIED);
+    assert n == 12 and o[0] == 226 and o[1] == 156 and o[2] == 147 and fv_eq(o[3..96], n - 3, " verified");
+    assert fv_eq(o[0..96], put_bytes(o[0..96], 0, fv_trust_hint(FV_T_UNVERIFIED)), "Not verified yet: your first message asks them to accept you; a call compares a code.");
+    assert fv_trust_hint(FV_T_VERIFIED).len > 0 and fv_trust_hint(FV_T_MISMATCH).len > 0;
+    assert fv_eq(o[0..96], put_bytes(o[0..96], 0, fv_trust_hint(FV_T_MISMATCH)), "Key mismatch: the last call offered another key than the stored one and was refused.");
+}
