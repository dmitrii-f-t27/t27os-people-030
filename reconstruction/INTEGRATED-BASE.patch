+test a_stranger_needs_the_code_and_a_message_session_needs_trust {
+    const v : u32 = pid_verdict(false, true, true, false);
+    assert pid_auto_match(v) == false;
+    assert pid_person_may_match(v, false);
+    assert pid_person_may_match(v, true) == false;
+    assert pid_message_refused(true, true, v);
+    // no proof yet in a message session: wait (the session times out if none comes)
+    assert pid_message_refused(true, false, PID_CODE) == false;
+    // no own identity: nothing to prove, the message session ends
+    assert pid_message_refused(false, false, PID_CODE);
+    // trusted: the message session opens by itself
+    assert pid_message_refused(true, true, PID_TRUSTED) == false;
+    assert pid_auto_match(PID_TRUSTED);
+    // refused: nobody's "match" counts
+    assert pid_person_may_match(PID_REFUSE, false) == false;
+    assert pid_auto_match(PID_REFUSE) == false;
+}
