+    // B sorts the same three the same way (C, A, B as given)
+    var cab : [30]u8 = undefined;
+    copy(cab[0..30], 0, T_C[0..10], 0, 10);
+    copy(cab[0..30], 10, T_A[0..10], 0, 10);
+    copy(cab[0..30], 20, T_B[0..10], 0, 10);
