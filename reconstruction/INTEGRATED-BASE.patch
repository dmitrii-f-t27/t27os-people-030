+    pubk[0] = 4;
+    var priv : [97]u8 = undefined;
+    ck_fill_session(priv[0..97], 5);
+    ck_put(priv[0..97], 0, pubk[0..65]);
+    // wrong lengths
+    assert !cs_identity(s[0..2 * CS_LEN], pubk[0..64], priv[0..97]);
+    assert !cs_identity(s[0..2 * CS_LEN], pubk[0..65], priv[0..96]);
+    assert !cs_identity(s[0..2 * CS_LEN], pubk[0..0], priv[0..0]);
+    // a public key that is not uncompressed (first byte 4)
+    var bad : [65]u8 = undefined;
+    ck_put(bad[0..65], 0, pubk[0..65]);
