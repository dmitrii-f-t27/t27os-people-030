+    assert keyfleet_total(fw) == 704;
+    var fb : [16]u8 = undefined;
+    const fn0 : usize = keyfleet_short_text(fw, fb[0..16]);
+    assert same_bytes(fb[0..fn0], "45/704");
+    assert keyfleet_short_text(keyfleet_pack(0, 0), fb[0..16]) == 0;
+
+    var sd : [11]u64 = undefined;
+    var p : usize = 0;
+    while (p < 11) { sd[p] = 0; p = p + 1; }
+    sd[P_NVIDIA] = 0x3FFFFFFFF;
+    assert ky_in_body(90.0, 35.0, 700.0) == false;
+    assert ky_in_body(92.0, 35.0, 700.0);
+    assert ky_in_body(700.0, 35.0, 700.0) == false;
+    const vh : f64 = ky_view_h(35.0, 635.0);
+    assert vh == 544.0;
+    const ch : f64 = ky_panel_content_h(sd[0..11], 512, 80.0);
+    assert ch > vh;
+    const smx : u32 = ky_scroll_max(ch, vh);
+    assert smx > 1000;
+    assert ky_scroll_clamp(0, -50, ch, vh) == 0;
+    assert ky_scroll_clamp(100, 40, ch, vh) == 140;
+    assert ky_scroll_clamp(@as(i64, smx), 200, ch, vh) == smx;
+    assert ky_scroll_clamp(100, 0, 300.0, 544.0) == 0;
+    assert ky_thumb_h(300.0, 544.0) == 0.0;
+    const th : f64 = ky_thumb_h(ch, vh);
+    assert th >= 20.0 and th < vh;
+    assert ky_thumb_y(91.0, 0, ch, vh) == 91.0;
+    assert ky_thumb_y(91.0, smx, ch, vh) > 91.0 + vh - th - 0.01;
+}
