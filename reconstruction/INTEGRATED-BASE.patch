+    assert j == 2 and cl_text(log[0..T_LOG], j).len == 1500 and cl_text(log[0..T_LOG], j)[1499] == t[1499];
+    // a number at or below the sender's floor is a duplicate (it was trimmed away)
+    put32(fl[0..32], 4, 5);
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 5, 30, x[0..1]) == CH_RX_DUP;
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_B[0..10], 1, 6, 30, x[0..1]) == CH_RX_NEW;
+    // a frame claiming to be from this device itself is refused
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, T_C[0..10], 2, 9, 30, x[0..1]) == CH_RX_BAD;
+    // unread per group, read when opened
+    assert cl_unread(log[0..T_LOG]) == 4;
+    assert cl_open_read(log[0..T_LOG]) != 0 and cl_unread(log[0..T_LOG]) == 0;
+}
