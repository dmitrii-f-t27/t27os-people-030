+fn dn_discard_route_sockets(b:[]u8)->void {
+    var channel:u32=0;
+    while(channel<3) {
+        const stored:u64=get_u64(b,if(channel==0) DN_CHAT_FD else if(channel==1) DN_MEDIA_FD else DN_NET_FD);
+        if(stored!=0) {
+            var count:u32=0;
+            while(count<64) {
+                var packet:[2049]u8=undefined;var from:[28]u8=undefined;var size:[1]u32=undefined;size[0]=28;
+                if(dn_recv(@as(i32,@intCast(stored-1)),packet[0..2049],2049,0,from[0..28],size)<=0) { break; }
+                count=count+1;
+            }
+        }
+        channel=channel+1;
+    }
+}
+fn dn_cancel_route(b:[]u8)->void {
+    const connection:u64=get_u64(b,DN_CONNECTION);
+    put_u64(b,DN_CONNECTION,0);
+    if(connection!=0) { dn_m0(connection,dn_sel("cancel"));dn_release(connection); }
+    const data:u64=get_u64(b,DN_DATA);put_u64(b,DN_DATA,0);if(data!=0) { dn_release(data); }
+    put_u64(b,DN_INTENT,0);put_u64(b,DN_BOUND,0);put_u64(b,DN_ROOM_STATE,0);put_u64(b,DN_ROUTE,0);
+    put_u64(b,DN_TX_HEAD,0);put_u64(b,DN_TX_TAIL,0);put_u64(b,DN_INFLIGHT_FRAMES,0);
+    put_u64(b,DN_DIRECT_ADMITTED,0);put_u64(b,DN_DIRECT_STATE,0);put_u64(b,DN_OFFLINE,0);
+    ck_wipe(b[DN_QUEUE..DN_QUEUE_END]);ck_wipe(b[DN_PEER_CANDIDATES..DN_PEER_CANDIDATES+145]);
+    dn_discard_route_sockets(b);
+}
+pub fn dn_route_active(p:u64,active:bool)->bool {
+    if(p==0) { return false; }
+    const v:DNView=dn_view(p);const b:[]u8=v.bytes;
+    const root:u64=get_u64(b,DN_ROOT);
+    if(!dn_route_idle(dn_root_state(root,false),dn_root_state(root,true),get_u64(b,DN_INTENT))) { return false; }
+    put_u64(b,DN_ACTIVE,0);dn_cancel_route(b);
+    put_u64(b,DN_ACTIVE,if(active) 1 else 0);put_u64(b,DN_STATE,1);put_u64(b,DN_LOOKUP,1);put_u64(b,DN_NEXT,0);
+    if(active and get_u64(b,DN_URL)!=0) { dn_sync_peer(b); }
+    return true;
+}
+pub fn dn_route_idle(chat:u32,audio:u32,intent:u64)->bool {
+    return (chat==0 or chat>=5) and (audio==0 or audio>=5) and intent==0;
+}
+test route_switch_cancels_only_idle_work_and_not_pending_calls {
+    assert dn_route_idle(0,0,0);assert dn_route_idle(5,6,0);
+    assert !dn_route_idle(0,0,1);assert !dn_route_idle(2,0,0);assert !dn_route_idle(0,4,0);
+    assert !dn_route_active(0,true);
+    assert DN_DIRECT_INBOUND+8<=DN_ACTIVE and DN_ACTIVE+8<DN_OWN_PUBLIC;
+}
+
+/// End/cancel may explicitly discard an asynchronous outbound intent before a session exists.
+pub fn dn_cancel_pending(p:u64)->void {
+    if(p==0) { return; }
+    const v:DNView=dn_view(p);
+    if(get_u64(v.bytes,DN_INTENT)!=0) { dn_cancel_route(v.bytes);put_u64(v.bytes,DN_STATE,1);put_u64(v.bytes,DN_NEXT,0); }
+}
+
+test cancellation_clears_pending_work_and_queues_without_changing_the_pinned_key {
+    var b:[DN_BYTES]u8=undefined;ck_wipe(b[0..DN_BYTES]);
+    put_u64(b[0..DN_BYTES],DN_INTENT,2);put_u64(b[0..DN_BYTES],DN_TX_TAIL,4);put_u64(b[0..DN_BYTES],DN_ROOM_STATE,5);
+    b[DN_PEER_PUBLIC]=4;b[DN_PEER_PUBLIC+64]=77;b[DN_QUEUE+2]=99;
+    dn_cancel_route(b[0..DN_BYTES]);
+    assert get_u64(b[0..DN_BYTES],DN_INTENT)==0 and get_u64(b[0..DN_BYTES],DN_TX_TAIL)==0;
+    assert get_u64(b[0..DN_BYTES],DN_ROOM_STATE)==0 and b[DN_QUEUE+2]==0;
+    assert b[DN_PEER_PUBLIC]==4 and b[DN_PEER_PUBLIC+64]==77;
+}
+
+/// Explicitly clearing an idle operator makes Internet unconfigured and inert.
+pub fn dn_clear(p:u64)->bool {
+    if(p==0 or !dn_route_active(p,false)) { return false; }
+    const v:DNView=dn_view(p);const url:u64=get_u64(v.bytes,DN_URL);put_u64(v.bytes,DN_URL,0);
+    if(url!=0) { dn_release(url); }
+    put_u64(v.bytes,DN_STATE,0);put_u64(v.bytes,DN_ERROR,0);return true;
+}
+test clearing_a_missing_operator_never_opens_or_sends { assert !dn_clear(0); }
diff --git a/specs/t27os/directory_wire.t27 b/specs/t27os/directory_wire.t27
new file mode 100644
index 000000000..a6b36e5e5
--- /dev/null
+++ b/specs/t27os/directory_wire.t27
@@ -0,0 +1,189 @@
+// Native counterpart of the bounded directory wire. SDK crypto only; no private output.
+use t27os::keysync_host::ks_sha256;
+use t27os::keysync_host::ks_sign;
+use t27os::keysync_host::ks_verify;
+use t27os::call_core::ck_wipe;
+use t27os::call_core::ck_same;
+use t27os::call_core::get_u64;
+use t27os::call_core::put_u64;
+pub const DW_HEADER:usize=304;
+pub const DW_MAX:usize=32768;
+pub const DW_PUBLIC:usize=56;
+pub const DW_TARGET:usize=121;
+pub const DW_HASH:usize=186;
+pub const DW_SIGLEN:usize=218;
+pub const DW_LENGTH:usize=220;
+pub const DW_SIGNATURE:usize=224;
+pub const DW_HELLO:u8=1;
+pub const DW_PROVE:u8=2;
+pub const DW_POLL:u8=3;
+pub const DW_LOOKUP:u8=4;
+pub const DW_ROOM:u8=5;
+pub const DW_CONSENT:u8=6;
+pub const DW_DATA:u8=7;
+pub const DW_CLOSE:u8=8;
+pub const DW_ADVERTISE:u8=9;
+pub fn dw_u32(b:[]const u8,at:usize)->u32 {
+    if(at+4>b.len) {
+        return 0;
+    }
+    return @as(u32,b[at])|(@as(u32,b[at+1])<<8)|(@as(u32,b[at+2])<<16)|(@as(u32,b[at+3])<<24);
+}
+pub fn dw_put32(b:[]u8,at:usize,value:u32)->bool {
+    if(at+4>b.len) {
+        return false;
+    }
+    var i:usize=0;
+    while(i<4) {
+        b[at+i]=@as(u8,@intCast((value>>@as(u5,@intCast(i*8)))&255));
+        i=i+1;
+    }
+    return true;
+}
+pub fn dw_init(packet:[]u8,op:u8,flags:u8,session:[]const u8,public_key:[]const u8,target:[]const u8)->bool {
+    if(packet.len<DW_HEADER or session.len!=16 or public_key.len!=65 or public_key[0]!=4 or (target.len!=0 and target.len!=65) or op<1 or op>9) {
+        return false;
+    }
+    ck_wipe(packet[0..DW_HEADER]);
+    packet[0]=84;
+    packet[1]=50;
+    packet[2]=55;
+    packet[3]=68;
+    packet[4]=1;
+    packet[5]=op;
+    packet[6]=flags;
+    var i:usize=0;
+    while(i<16) {
+        packet[8+i]=session[i];
+        i=i+1;
+    }
+    i=0;
+    while(i<65) {
+        packet[DW_PUBLIC+i]=public_key[i];
+        if(target.len==65) {
+            packet[DW_TARGET+i]=target[i];
+        }
+        i=i+1;
+    }
+    return true;
+}
+pub fn dw_payload(packet:[]u8,seq:u64,expiry:u64,nonce:[]const u8,body:[]const u8)->usize {
+    if(packet.len<DW_HEADER or body.len>DW_MAX-DW_HEADER or packet.len<DW_HEADER+body.len or (nonce.len!=0 and nonce.len!=16)) {
+        return 0;
+    }
+    put_u64(packet,24,seq);
+    put_u64(packet,32,expiry);
+    var i:usize=0;
+    while(i<16) {
+        packet[40+i]=if(nonce.len==16) nonce[i] else 0;
+        i=i+1;
+    }
+    dw_put32(packet,DW_LENGTH,@as(u32,@intCast(body.len)));
+    i=0;
+    while(i<body.len) {
+        packet[DW_HEADER+i]=body[i];
+        i=i+1;
+    }
+    var hash:[32]u8=undefined;
+    if(!ks_sha256(body,hash[0..32])) {
+        return 0;
+    }
+    i=0;
+    while(i<32) {
+        packet[DW_HASH+i]=hash[i];
+        i=i+1;
+    }
+    return DW_HEADER+body.len;
+}
+pub fn dw_canonical(packet:[]const u8,out:[]u8)->bool {
+    if(packet.len<DW_HEADER or out.len<222) {
+        return false;
+    }
+    var i:usize=0;
+    while(i<218) {
+        out[i]=packet[i];
+        i=i+1;
+    }
+    i=0;
+    while(i<4) {
+        out[218+i]=packet[DW_LENGTH+i];
+        i=i+1;
+    }
+    return true;
+}
+pub fn dw_sign(packet:[]u8,private_key:[]const u8)->bool {
+    if(packet.len<DW_HEADER or private_key.len!=97 or !ck_same(private_key[0..65],packet[DW_PUBLIC..DW_PUBLIC+65])) {
+        return false;
+    }
+    var canonical:[222]u8=undefined;
+    if(!dw_canonical(packet,canonical[0..222])) {
+        return false;
+    }
+    var signature:[128]u8=undefined;
+    const n:usize=ks_sign(private_key,canonical[0..222],signature[0..128]);
+    if(n<8 or n>80) {
+        return false;
+    }
+    packet[DW_SIGLEN]=@as(u8,@intCast(n));
+    packet[DW_SIGLEN+1]=0;
+    var i:usize=0;
+    while(i<80) {
+        packet[DW_SIGNATURE+i]=if(i<n) signature[i] else 0;
+        i=i+1;
+    }
+    return true;
+}
+pub fn dw_verify(packet:[]const u8,public_key:[]const u8,target:[]const u8)->bool {
+    if(packet.len<DW_HEADER
+    or public_key.len!=65
+    or target.len!=65
+    or !ck_same(public_key,packet[DW_PUBLIC..DW_PUBLIC+65])
+    or !ck_same(target,packet[DW_TARGET..DW_TARGET+65])) {
+        return false;
+    }
+    const body:usize=@as(usize,dw_u32(packet,DW_LENGTH));
+    if(body>DW_MAX-DW_HEADER or packet.len!=DW_HEADER+body) {
+        return false;
+    }
+    const sig:usize=@as(usize,packet[DW_SIGLEN])+(@as(usize,packet[DW_SIGLEN+1])<<8);
+    if(sig<8 or sig>80) {
+        return false;
+    }
+    var hash:[32]u8=undefined;
+    if(!ks_sha256(packet[DW_HEADER..DW_HEADER+body],hash[0..32]) or !ck_same(hash[0..32],packet[DW_HASH..DW_HASH+32])) {
+        return false;
+    }
+    var canonical:[222]u8=undefined;
+    if(!dw_canonical(packet,canonical[0..222])) {
+        return false;
+    }
+    return ks_verify(public_key,canonical[0..222],packet[DW_SIGNATURE..DW_SIGNATURE+sig]);
+}
+pub fn dw_reply(response:[]const u8,session:[]const u8,seq:u64)->bool {
+    if(response.len<64 or response.len>65536 or session.len!=16) {
+        return false;
+    }
+    if(response[0]!=84
+    or response[1]!=50
+    or response[2]!=55
+    or response[3]!=65
+    or response[4]!=1
+    or !ck_same(response[8..24],session)
+    or get_u64(response,24)!=seq) {
+        return false;
+    }
+    return @as(usize,dw_u32(response,56))+64==response.len;
+}
+test directory_wire_bounds_and_domain_are_explicit {
+    var b:[304]u8=undefined;
+    var session:[16]u8=undefined;
+    var public_key:[65]u8=undefined;
+    ck_wipe(session[0..16]);
+    ck_wipe(public_key[0..65]);
+    public_key[0]=4;
+    assert !dw_init(b[0..303],1,0,session[0..16],public_key[0..65],public_key[0..0]);
+    assert dw_init(b[0..304],1,0,session[0..16],public_key[0..65],public_key[0..0]);
+    assert b[0]==84 and b[3]==68 and b[4]==1 and b[DW_PUBLIC]==4;
+    assert DW_PUBLIC+65==DW_TARGET and DW_TARGET+65==DW_HASH and DW_SIGNATURE+80==DW_HEADER;
+    assert !dw_put32(b[0..304],302,1);
+}
