+module T27DirectoryCrypto;
+// Platform adapter only. P-256/SHA-256/DER validation is OpenSSL libcrypto, not new crypto.
+// The build supplies official OpenSSL headers; pointer handles remain process-local.
+pub fn dr_crypto_shape(message_len:u32,signature_len:u32)->bool {
+    return message_len>0 and message_len<=512 and signature_len>=8 and signature_len<=80;
+}
+pub fn dr_verify(public_key:[65]u8,message:[512]u8,message_len:u32,signature:[80]u8,signature_len:u32)->bool {
+    if(public_key[0]!=4 or !dr_crypto_shape(message_len,signature_len)) {
+        return false;
+    }
+    const key:u64=EC_KEY_new_by_curve_name(415);
+    if(key==0) {
+        return false;
+    }
+    const group:u64=EC_KEY_get0_group(key);
+    const point:u64=EC_POINT_new(group);
+    var ok:bool=false;
+    if(point!=0) {
+        if(EC_POINT_oct2point(group,point,public_key,65,0)==1 and EC_KEY_set_public_key(key,point)==1) {
+            var digest:[32]u8=undefined;
+            SHA256(message,message_len,digest);
+            ok=ECDSA_verify(0,digest,32,signature,signature_len,key)==1;
+        }
+        EC_POINT_free(point);
+    }
+    EC_KEY_free(key);
+    return ok;
+}
+test crypto_input_bounds_refuse_empty_and_oversized_messages {
+    assert !dr_crypto_shape(0,70) and !dr_crypto_shape(513,70);
+    assert !dr_crypto_shape(32,7) and !dr_crypto_shape(32,81);
+    assert dr_crypto_shape(32,70) and dr_crypto_shape(512,80);
+}
diff --git a/specs/t27os/owner_directory/directory_crypto_probe.t27 b/specs/t27os/owner_directory/directory_crypto_probe.t27
new file mode 100644
index 000000000..4390171b9
--- /dev/null
+++ b/specs/t27os/owner_directory/directory_crypto_probe.t27
@@ -0,0 +1,59 @@
+module T27DirectoryCryptoProbe;
+// Reads synthetic PUBLIC verification data from a private pipe; emits no payload.
+pub fn main()->i32 {
+    var packet:[178]u8=undefined;
+    var at:u32=0;
+    // read into one-byte offset through the ordinary C pointer expression emitted by gen-c.
+    while(at<178) {
+        const n:i64=read(0,packet+at,178-at);
+        if(n<=0) {
+            return 10;
+        }
+        at=at+@as(u32,@intCast(n));
+    }
+    var public_key:[65]u8=undefined;
+    var message:[512]u8=undefined;
+    var signature:[80]u8=undefined;
+    var i:u32=0;
+    while(i<65) {
+        public_key[i]=packet[i];
+        i=i+1;
+    }
+    i=0;
+    while(i<80) {
+        signature[i]=packet[66+i];
+        i=i+1;
+    }
+    i=0;
+    while(i<512) {
+        message[i]=0;
+        i=i+1;
+    }
+    i=0;
+    while(i<32) {
+        message[i]=packet[146+i];
+        i=i+1;
+    }
+    const signature_len:u32=packet[65];
+    if(!dr_verify(public_key,message,32,signature,signature_len)) {
+        return 11;
+    }
+    message[0]=message[0]^1;
+    if(dr_verify(public_key,message,32,signature,signature_len)) {
+        return 12;
+    }
+    message[0]=message[0]^1;
+    signature[signature_len-1]=signature[signature_len-1]^1;
+    if(dr_verify(public_key,message,32,signature,signature_len)) {
+        return 13;
+    }
+    signature[signature_len-1]=signature[signature_len-1]^1;
+    public_key[0]=0;
+    if(dr_verify(public_key,message,32,signature,signature_len)) {
+        return 14;
+    }
+    return 0;
+}
+test pipe_probe_record_is_fixed_and_public_only {
+    assert 65+1+80+32==178;
+}
