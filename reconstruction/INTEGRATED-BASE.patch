+    assert gr_known(frb[0..FT_LEN], T_X[0..10], r[0..30], 3, 0) == GR_NOT_ME;
+    assert gr_known(frb[0..FT_LEN], T_B[0..10], r[0..30], 1, 0) == GR_SIZE;
+    assert gr_known(frb[0..FT_LEN], T_B[0..10], r[0..30], 3, 3) == GR_SIZE;
+    const nl : [3]u8 = [97, 10, 98];
+    assert gr_name_ok("trio") and gr_name_ok("") == false and gr_name_ok(nl[0..3]) == false;
+    assert gr_name_ok("0123456789012345678901234567890123") == false;
