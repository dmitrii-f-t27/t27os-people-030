+    ck_fill_session(s[CS_ID + CI_PUB..CS_ID + CI_PUB + 65], 4);
+    ck_fill_session(s[CS_ID + CI_PRIV..CS_ID + CI_PRIV + 97], 4);
+    s[CS_ID + CI_PIN] = 1;
+    s[CS_ID + CI_GOT] = 1;
+    s[CS_ID + CI_OK] = 1;
+    s[CS_ID + CI_SAME] = 1;
+    s[CS_ID + CI_VERDICT] = @as(u8, @intCast(PID_TRUSTED));
+    s[CS_ID + CI_STORED] = 1;
+    s[CS_ID + CI_MSGN] = 206;
+    ck_fill_session(s[CS_ID + CI_PEER..CS_ID + CI_PEER + 65], 8);
+    ck_fill_session(s[CS_ID + CI_RX..CS_ID + CI_RX + 65], 8);
+    assert cs_id_state(s[0..CS_LEN]) == CS_ID_STORED;
+    s[CS_ID + CI_STORED] = 0;
+    assert cs_id_state(s[0..CS_LEN]) == CS_ID_VERIFIED;
+    var keep : [97]u8 = undefined;
+    ck_put(keep[0..97], 0, s[CS_ID + CI_PRIV..CS_ID + CI_PRIV + 97]);
+    s[CS_ID + CI_STORED] = 1;
+    cs_id_fresh(s[0..CS_LEN]);
+    assert s[CS_ID + CI_ON] == 1;
+    assert ck_same(s[CS_ID + CI_PRIV..CS_ID + CI_PRIV + 97], keep[0..97]);
+    var z : u32 = 0;
+    var i : usize = CI_PIN;
+    while (i < CI_PUB) {
+        z = z + @as(u32, s[CS_ID + i]);
+        i = i + 1;
+    }
+    i = CI_PEER;
+    while (i < CS_ID_LEN) {
+        z = z + @as(u32, s[CS_ID + i]);
+        i = i + 1;
+    }
