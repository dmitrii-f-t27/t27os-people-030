+    put32(log[0..4104], 16, CH_MSG_TOP - 2);
+    assert cl_out_add(log[0..4104], a[0..1], 5) == CH_MSG_TOP - 1;
+    assert cl_out_add(log[0..4104], a[0..1], 6) == 0;
+    put32(log[0..4104], 16, 4294967295);
+    assert cl_out_add(log[0..4104], a[0..1], 7) == 0;
+    // on read: a floor, a last number or a line number at or above 2^31 is a file that does not check
