+test a_group_text_that_is_not_text_or_comes_from_a_wrong_index_or_is_broken_makes_no_line {
+    var log : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    var fl : [32]u8 = undefined;
+    ck_wipe(asm[0..CA_LEN]);
+    ck_wipe(fl[0..32]);
+    t_log(log[0..T_LOG]);
+    var p : [738]u8 = undefined;
+    const ok : [4]u8 = [208, 175, 208, 175];
+    const n : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 1, 0, 10, ok[0..4]);
+    // a member index past the group, this device's own index, a cut frame, an ACK
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, GR_MEMBERS, p[0..n]) == CH_RX_BAD;
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 2, p[0..n]) == CH_RX_BAD;
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..n - 1]) == CH_RX_BAD;
+    var a : [38]u8 = undefined;
+    gm_put_ack(a[0..38], T_DIGEST[0..8], T_C[0..10], 1, 0);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, a[0..38]) == CH_RX_BAD;
+    // broken UTF-8: a lone continuation byte, a Cyrillic letter cut in half
+    const bad1 : [2]u8 = [65, 175];
+    const bad2 : [3]u8 = [65, 66, 208];
+    const n1 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 2, 0, 10, bad1[0..2]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..n1]) == CH_RX_BAD;
+    const n2 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 3, 0, 10, bad2[0..3]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..n2]) == CH_RX_BAD;
+    assert cl_count(log[0..T_LOG]) == 0;
+    // the good one is taken byte for byte, once
+    gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 1, 0, 10, ok[0..4]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..n]) == CH_RX_NEW;
+    assert cl_count(log[0..T_LOG]) == 1 and cl_text(log[0..T_LOG], 0).len == 4 and cl_text(log[0..T_LOG], 0)[3] == 175;
+    assert cl_msg(log[0..T_LOG], 0) == gl_key(1, 1);
+    // a letter split across two parts (an ASCII byte first, so byte 700 is the middle of one) joins whole
+    var t : [801]u8 = undefined;
+    t[0] = 33;
+    var i : usize = 1;
+    while (i < 801) {
+        t[i] = 208;
+        t[i + 1] = 175;
+        i = i + 2;
+    }
+    const q0 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_A[0..10], 9, 0, 20, t[0..801]);
+    assert q0 == GM_HDR + 700 and p[GM_HDR + 699] == 208;
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 0, p[0..q0]) == CH_RX_PART;
+    const q1 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_A[0..10], 9, 1, 20, t[0..801]);
+    assert p[GM_HDR] == 175;
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 0, p[0..q1]) == CH_RX_NEW;
+    const j : usize = cl_find(log[0..T_LOG], CH_DIR_IN, gl_key(0, 9));
+    assert j != CL_NONE and cl_text(log[0..T_LOG], j).len == 801 and cl_text(log[0..T_LOG], j)[800] == 175;
+    // A's line (time 20) stands after B's (time 10)
+    assert j == 1;
+}
+
+test a_line_owes_a_member_only_while_it_is_an_open_own_line_to_that_recipient_with_a_part_unacknowledged {
+    var log : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    var fl : [32]u8 = undefined;
+    ck_wipe(asm[0..CA_LEN]);
+    ck_wipe(fl[0..32]);
+    t_log(log[0..T_LOG]);
+    var t : [800]u8 = undefined;
+    var i : usize = 0;
+    while (i < 800) {
+        t[i] = 65;
+        i = i + 1;
+    }
+    // A's own line in 2 parts for C only (rcpt 4)
+    assert gl_out_add(log[0..T_LOG], fl[0..32], 0, t[0..800], 100, 4) == 1;
+    assert gl_owes(log[0..T_LOG], 0, 2);
+    assert gl_owes(log[0..T_LOG], 0, 1) == false;
+    assert gl_owes(log[0..T_LOG], 0, 0) == false;
+    assert gl_owes(log[0..T_LOG], 0, GR_MEMBERS) == false and gl_owes(log[0..T_LOG], 0, 4294967295) == false;
+    // one part acknowledged: still owed; both: no longer
+    var a : [38]u8 = undefined;
+    gm_put_ack(a[0..38], T_DIGEST[0..8], T_A[0..10], 1, 0);
+    assert gl_rx_ack(log[0..T_LOG], 2, a[0..38]);
+    assert gl_owes(log[0..T_LOG], 0, 2);
+    gm_put_ack(a[0..38], T_DIGEST[0..8], T_A[0..10], 1, 1);
+    assert gl_rx_ack(log[0..T_LOG], 2, a[0..38]);
+    assert gl_owes(log[0..T_LOG], 0, 2) == false and cl_state(log[0..T_LOG], 0) == CH_S_DELIVERED;
+    // a FAILED line is still owed (a session restarts it)
+    const x : [1]u8 = [120];
+    assert gl_out_add(log[0..T_LOG], fl[0..32], 0, x[0..1], 200, 6) == 2;
+    log[cl_line_at(1) + 1] = @as(u8, @intCast(CH_S_FAILED));
+    assert gl_owes(log[0..T_LOG], 1, 1) and gl_owes(log[0..T_LOG], 1, 2);
+    log[cl_line_at(1) + 1] = @as(u8, @intCast(CH_S_READ));
+    assert gl_owes(log[0..T_LOG], 1, 1) == false;
+    // an incoming line owes nobody
+    assert t_deliver(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 0, T_B[0..10], 1, 1, 300, x[0..1]) == CH_RX_NEW;
+    const k : usize = cl_find(log[0..T_LOG], CH_DIR_IN, gl_key(1, 1));
+    assert gl_owes(log[0..T_LOG], k, 1) == false and gl_owes(log[0..T_LOG], k, 2) == false;
+    // even one read back from a file (cf_decode takes any state 1..5 for an incoming line) as FAILED with a
+    // recipient mask in its extension bytes
+    log[cl_line_at(k) + 1] = @as(u8, @intCast(CH_S_FAILED));
+    log[cl_line_at(k) + CL_EXT + X_RCPT] = 255;
+    assert gl_owes(log[0..T_LOG], k, 1) == false and gl_owes(log[0..T_LOG], k, 2) == false;
+}
+
+test a_group_third_part_that_would_make_the_message_longer_than_2000_bytes_is_refused {
+    var log : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    var fl : [32]u8 = undefined;
+    ck_wipe(asm[0..CA_LEN]);
+    ck_wipe(fl[0..32]);
+    t_log(log[0..T_LOG]);
+    var t : [2000]u8 = undefined;
+    var i : usize = 0;
+    while (i < 2000) {
+        t[i] = 97 + @as(u8, @intCast(i % 26));
+        i = i + 1;
+    }
+    var p : [738]u8 = undefined;
+    const a0 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 4, 0, 10, t[0..2000]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..a0]) == CH_RX_PART;
+    const a1 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 4, 1, 10, t[0..2000]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..a1]) == CH_RX_PART;
+    // an honest last part is 600 bytes; one of 700 would put the join 100 bytes past the slot
+    const a2 : usize = gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 4, 2, 10, t[0..2000]);
+    assert a2 == GM_HDR + 600 and gm_kind(p[0..a2]) == GM_K_TEXT;
+    put_ghdr(p[0..738], GM_K_TEXT, T_DIGEST[0..8], T_B[0..10], 4, 2, 3, 10, 601);
+    assert gm_kind(p[0..GM_HDR + 601]) == 0;
+    put_ghdr(p[0..738], GM_K_TEXT, T_DIGEST[0..8], T_B[0..10], 4, 2, 3, 10, 700);
+    assert gm_kind(p[0..GM_HDR + 700]) == 0;
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..GM_HDR + 700]) == CH_RX_BAD;
+    assert cl_count(log[0..T_LOG]) == 0;
+    // the honest one completes the 2000-byte message
+    gm_put_text(p[0..738], T_DIGEST[0..8], T_B[0..10], 4, 2, 10, t[0..2000]);
+    assert gl_rx_text(log[0..T_LOG], asm[0..CA_LEN], fl[0..32], 2, 1, p[0..a2]) == CH_RX_NEW;
+    assert cl_count(log[0..T_LOG]) == 1 and cl_text(log[0..T_LOG], 0).len == 2000;
+}
