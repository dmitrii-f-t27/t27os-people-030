+    if (lens[0] > 0) {
+        var ll : usize = lens[0];
+        if (ll > 39) { ll = 39; }
+        var li : usize = 0;
+        while (li < ll) {
+            pf[PF_LOGIN + li] = login_b[li];
+            li = li + 1;
+        }
+        pf_set(pf, PF_LOGIN_LEN, @as(u32, @intCast(ll)));
+        pf_set(pf, PF_GH_SIGNED, 1);
+    }
+    if (code == PRF_OK) {
+        var nl : usize = lens[1];
+        if (nl > PRF_NICK_MAX_BYTES) { nl = PRF_NICK_MAX_BYTES; }
+        var ni : usize = 0;
+        while (ni < nl) {
+            pf[PF_SAVED + ni] = nick_b[ni];
+            pf[PF_TYPED + ni] = nick_b[ni];
+            ni = ni + 1;
+        }
+        pf_set(pf, PF_SLEN, @as(u32, @intCast(nl)));
+        pf_set(pf, PF_LEN, @as(u32, @intCast(nl)));
+        if (lens[2] == 1) {
+            const img : u64 = pf_decode();
+            if (img != 0) {
+                if (tg[TPG_PF_IMG] != 0) { cg_image_release(tg[TPG_PF_IMG]); }
+                tg[TPG_PF_IMG] = img;
+                pf_set(pf, PF_HAS, 1);
+            }
+        }
+        pf_set(pf, PF_CODE, PRF_OK_SAVED);
+    } else if (code == PRF_E_CANCELLED) {
+        pf_set(pf, PF_CODE, PRF_OK);
+    } else {
+        pf_set(pf, PF_CODE, code);
+    }
+}
