+test a_message_session_queues_text_and_a_call_refuses_it {
+    var s : [299648]u8 = undefined;
+    cs_t_live(s[0..CS_LEN]);
+    var pt : [720]u8 = undefined;
+    var out : [720]u8 = undefined;
+    // the whole 720-byte text is written before it is queued: the full-size take below copies every byte
+    kfill(pt[0..720], 0);
+    pt[0] = 1;
+    pt[1] = 0;
+    pt[2] = 7;
+    // a call with audio neither sends nor takes text, and an idle message session does not send it
+    cs_p(s[0..CS_LEN], CS_MODE, @as(u64, CS_AUDIO_TEST));
+    assert cs_text_send(s[0..CS_LEN], pt[0..20]) == false;
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 0;
+    cs_p(s[0..CS_LEN], CS_MODE, @as(u64, CS_AUDIO_NONE));
+    assert cs_text_send(s[0..CS_LEN], pt[0..20]) == false;
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 0;
+    // queued in arrival order, taken once each
+    cs_take_text(s[0..CS_LEN], pt[0..20]);
+    pt[2] = 8;
+    cs_take_text(s[0..CS_LEN], pt[0..720]);
+    assert cs_stat(s[0..CS_LEN], CS_ST_TEXT_RX) == 2;
+    assert cs_text_take(s[0..CS_LEN], out[0..10]) == 0;
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 20 and out[2] == 7;
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 720 and out[2] == 8;
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 0;
+    // a full queue drops the newest and counts it
+    var k : u64 = 0;
+    while (k < CS_TXQ_N + 3) {
+        cs_take_text(s[0..CS_LEN], pt[0..20]);
+        k = k + 1;
+    }
+    assert cs_stat(s[0..CS_LEN], CS_ST_TEXT_DROP) == 3;
+    // a session with audio never hands queued text out
+    cs_p(s[0..CS_LEN], CS_MODE, @as(u64, CS_AUDIO_DEV));
+    assert cs_text_take(s[0..CS_LEN], out[0..720]) == 0;
+    cs_p(s[0..CS_LEN], CS_MODE, @as(u64, CS_AUDIO_NONE));
+    k = 0;
+    while (cs_text_take(s[0..CS_LEN], out[0..720]) == 20) { k = k + 1; }
+    assert k == CS_TXQ_N;
+    assert cs_text_send(s[0..CS_LEN - 1], pt[0..20]) == false;
+}
