+/// Sync GitHub profile (`GET https://api.github.com/user` using Keychain P_GITHUB slot 0): writes `<dir>/github.txt`,
+/// updates nickname and downloads/installs `avatar_url` through `prfh_install_picture` without large stack buffers.
+pub fn prfh_sync_github(cur_nick: []const u8, had: bool, login_out: []u8, nick_out: []u8, lens_out: []usize) -> u32 {
+    var init_nl : usize = cur_nick.len;
+    if (init_nl > nick_out.len) { init_nl = nick_out.len; }
+    var ci : usize = 0;
+    while (ci < init_nl) {
+        nick_out[ci] = cur_nick[ci];
+        ci = ci + 1;
+    }
+    lens_out[0] = 0;
+    lens_out[1] = init_nl;
+    if (had) { lens_out[2] = 1; } else { lens_out[2] = 0; }
