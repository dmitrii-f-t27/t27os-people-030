+    const serial:u64=dp_db64(db,128);
+    assert serial==1;
+    // A later packet is appended, but a lost HTTP response must repeat only the first batch.
+    dp_put32(db,112,4);
+    db[DP_QUEUES+3]=14;
+    assert dp_poll(db,0,b,out,1001)==67 and dp_db32(db,112)==4 and out[66]==13;
+    b[220]=8;
+    b[304]=1;
+    assert dp_poll(db,0,b,out,1002)==65 and out[64]==14 and dp_db32(db,112)==1 and dp_db64(db,128)==2;
+    b[304]=2;
+    assert dp_poll(db,0,b,out,1003)==64 and dp_db32(db,112)==0;
+}
+test signature_and_challenge_rates_are_finite {
+    var db:[600000]u8=undefined;
+    var i:u32=0;
+    while(i<600000) {
+        db[i]=0;
+        i=i+1;
+    }
+    i=0;
+    while(i<128) {
+        assert dp_rate(db,1,false);
+        i=i+1;
+    }
+    assert !dp_rate(db,1,false) and dp_rate(db,1000,false);
+    i=0;
+    while(i<16) {
+        assert dp_rate(db,1000,true);
+        i=i+1;
+    }
+    assert !dp_rate(db,1000,true) and dp_rate(db,2000,true);
+}
+// Candidate advertisements are signed by the authenticated registering principal.
+fn dp_candidates(b:[32768]u8,length:u32)->bool {
+    if(length<1 or length>145 or b[DP_HEADER]>8 or length!=1+@as(u32,b[DP_HEADER])*18) {
+        return false;
+    }
+    var i:u32=0;
+    while(i<@as(u32,b[DP_HEADER])) {
+        const at:u32=DP_HEADER+1+i*18;
+        if(b[at+16]==0 and b[at+17]==0) {
+            return false;
+        }
+        var mapped:bool=b[at+10]==255 and b[at+11]==255;
+        var k:u32=0;
+        while(k<10) {
+            if(b[at+k]!=0) {
+                mapped=false;
+            }
+            k=k+1;
+        }
+        if(mapped) {
+            if(b[at+12]==0 or b[at+12]==127 or b[at+12]==169 or b[at+12]>=224) {
+                return false;
+            }
+        }
+        else {
+            if((b[at]&224)!=32) {
+                return false;
+            }
+        }
+        var j:u32=0;
+        while(j<i) {
+            var same:bool=true;
+            k=0;
+            while(k<18) {
+                if(b[at+k]!=b[DP_HEADER+1+j*18+k]) {
+                    same=false;
+                }
+                k=k+1;
+            }
+            if(same) {
+                return false;
+            }
+            j=j+1;
+        }
+        i=i+1;
+    }
+    return true;
+}
+test candidate_proofs_fit_disjoint_database_ranges {
+    assert DP_QUEUES+DP_REGS*DP_QUEUE_SIZE<=DP_PROOF_LENGTHS;
+    assert DP_PROOF_LENGTHS+DP_REGS*4<=DP_PROOFS;
+    assert DP_PROOFS+DP_REGS*DP_PROOF_SIZE<599000 and DP_HEADER+145<=DP_PROOF_SIZE;
+    var b:[32768]u8=undefined;
+    var i:u32=0;
+    while(i<32768) {
+        b[i]=0;
+        i=i+1;
+    }
+    assert dp_candidates(b,1);
+    b[DP_HEADER]=9;
+    assert !dp_candidates(b,163);
+    b[DP_HEADER]=1;
+    b[DP_HEADER+11]=255;
+    b[DP_HEADER+12]=255;
+    b[DP_HEADER+13]=192;
+    b[DP_HEADER+14]=168;
+    b[DP_HEADER+15]=1;
+    b[DP_HEADER+16]=25;
+    b[DP_HEADER+17]=194;
+    b[DP_HEADER+18]=237;
+    assert dp_candidates(b,19);
+    b[DP_HEADER+13]=169;
+    assert !dp_candidates(b,19);
+}
diff --git a/specs/t27os/peer_id.t27 b/specs/t27os/peer_id.t27
new file mode 100644
index 000000000..c43cd120c
--- /dev/null
+++ b/specs/t27os/peer_id.t27
@@ -0,0 +1,358 @@
+// SPDX-License-Identifier: Apache-2.0
+// specs/t27os/peer_id.t27 -- Unique T27 OS User Number and Peer Target Addressing.
+// Pure .t27 specification (zero @extern calls, ASCII/English only, L3/L4 compliant).
+// Derives a deterministic, human-shareable 8-digit T27 number ("T27-XXXX-XXXX") from
+// the local ~/.t27os/identity key file so any other T27 OS user can find this user in
+// Peer Chat or place a Voice Call using that number.
+//
+// Namespace prefix: pid_ / PID_ (flat-namespace safe across all t27b imports).
+
+module T27osPeerId;
+use std::mem::bytes_eq;
+
+pub const PID_LEN : usize = 13;
+pub const PID_DIGITS : usize = 8;
+pub const PID_DEFAULT_PORT : u32 = 47727;
+pub const PID_PORT_MIN : u32 = 1024;
+pub const PID_PORT_MAX : u32 = 65535;
+pub const PID_HOST_MAX : usize = 64;
+pub const PID_SHARE_MAX : usize = 128;
+pub const PID_ID_MIN_BYTES : usize = 8;
+pub const PID_PATH_MAX : usize = 512;
+
+// ---------------------------------------------------------------- 1. Deterministic hash
+
+/// Overflow-safe 64-bit mixing hash (no wrapping ops in t27 dialect).
+/// Masks to 32 bits before multiplying by FNV prime 16777619 (max product < 2^56).
+pub fn pid_hash64(data: []const u8) -> u64 {
+    var h1 : u64 = 2166136261;
+    var h2 : u64 = 3735928559;
+    var i : usize = 0;
+    while (i < data.len) {
+        const b : u64 = @as(u64, data[i]);
+        h1 = ((h1 ^ b) & 4294967295) * 16777619;
+        h1 = (h1 ^ (h1 >> 16)) & 4294967295;
+        h2 = ((h2 ^ (b + @as(u64, i & 255))) & 4294967295) * 2246822519;
+        h2 = (h2 ^ (h2 >> 13)) & 4294967295;
+        i = i + 1;
+    }
+    return ((h1 & 4294967295) << 32) | (h2 & 4294967295);
+}
+
+/// Write a single decimal digit (0..9) as ASCII '0'..'9'.
+fn pid_digit_ch(v: u64) -> u8 {
+    return @as(u8, @intCast(48 + (v % 10)));
+}
+
+/// Derive canonical unique number "T27-DDDD-DDDD" (13 bytes) from identity bytes.
+/// Returns 13 on success, 0 if data is too short (< 8 bytes) or out < 13 bytes.
+pub fn pid_from_identity(data: []const u8, out: []u8) -> usize {
+    if (data.len < PID_ID_MIN_BYTES or out.len < PID_LEN) { return 0; }
+    const h : u64 = pid_hash64(data);
+    // Use high and low 32-bit halves mod 10000 so both 4-digit groups are uniformly spread.
+    // Avoid 0000-0000 by folding if both halves are zero.
+    var hi : u64 = ((h >> 32) & 4294967295) % 10000;
+    var lo : u64 = (h & 4294967295) % 10000;
+    if (hi == 0 and lo == 0) { hi = 2727; lo = 9999; }
+    out[0] = 84;  // 'T'
+    out[1] = 50;  // '2'
+    out[2] = 55;  // '7'
+    out[3] = 45;  // '-'
+    out[4] = pid_digit_ch(hi / 1000);
+    out[5] = pid_digit_ch((hi / 100) % 10);
+    out[6] = pid_digit_ch((hi / 10) % 10);
+    out[7] = pid_digit_ch(hi % 10);
+    out[8] = 45;  // '-'
+    out[9] = pid_digit_ch(lo / 1000);
+    out[10] = pid_digit_ch((lo / 100) % 10);
+    out[11] = pid_digit_ch((lo / 10) % 10);
+    out[12] = pid_digit_ch(lo % 10);
+    return PID_LEN;
+}
+
+// ---------------------------------------------------------------- 2. Validation & normalization
+
+fn pid_is_digit(c: u8) -> bool {
+    return c >= 48 and c <= 57;
+}
+
+fn pid_is_space(c: u8) -> bool {
+    return c == 32 or c == 9 or c == 10 or c == 13;
+}
+
+/// Exact canonical check: "T27-DDDD-DDDD" (13 ASCII bytes).
+pub fn pid_valid(s: []const u8) -> bool {
+    if (s.len != PID_LEN) { return false; }
+    if (s[0] != 84 or s[1] != 50 or s[2] != 55 or s[3] != 45 or s[8] != 45) { return false; }
+    if (pid_is_digit(s[4]) == false or pid_is_digit(s[5]) == false) { return false; }
+    if (pid_is_digit(s[6]) == false or pid_is_digit(s[7]) == false) { return false; }
+    if (pid_is_digit(s[9]) == false or pid_is_digit(s[10]) == false) { return false; }
+    if (pid_is_digit(s[11]) == false or pid_is_digit(s[12]) == false) { return false; }
+    return true;
+}
+
+/// Normalize user input ("t27-1234-5678", "1234-5678", "1234 5678", "12345678", "T2712345678")
+/// into canonical "T27-1234-5678". Returns 13 on success, 0 if invalid.
+pub fn pid_normalize(raw: []const u8, out: []u8) -> usize {
+    if (out.len < PID_LEN) { return 0; }
+    var start : usize = 0;
+    var end : usize = raw.len;
+    while (start < end and pid_is_space(raw[start])) { start = start + 1; }
+    while (end > start and pid_is_space(raw[end - 1])) { end = end - 1; }
+    if (start >= end) { return 0; }
+    // Optional leading "T27" / "t27" prefix (optionally followed by '-' or ' ').
+    if (end - start >= 3 and (raw[start] == 84 or raw[start] == 116) and raw[start + 1] == 50 and raw[start + 2] == 55) {
+        start = start + 3;
+        if (start < end and (raw[start] == 45 or raw[start] == 32)) { start = start + 1; }
+    }
+    var digs : [8]u8 = undefined;
+    var dn : usize = 0;
+    var i : usize = start;
+    while (i < end) {
+        const c : u8 = raw[i];
+        if (pid_is_digit(c)) {
+            if (dn >= PID_DIGITS) { return 0; }
+            digs[dn] = c;
+            dn = dn + 1;
+        } else if (c == 45 or c == 32) {
+            // Separator allowed between digit groups.
+        } else {
+            return 0;
+        }
+        i = i + 1;
+    }
+    if (dn != PID_DIGITS) { return 0; }
+    out[0] = 84;
+    out[1] = 50;
+    out[2] = 55;
+    out[3] = 45;
+    out[4] = digs[0];
+    out[5] = digs[1];
+    out[6] = digs[2];
+    out[7] = digs[3];
+    out[8] = 45;
+    out[9] = digs[4];
+    out[10] = digs[5];
+    out[11] = digs[6];
+    out[12] = digs[7];
+    return PID_LEN;
+}
+
+/// Byte-exact equality helper for two peer IDs or byte slices.
+pub fn pid_equal(a: []const u8, b: []const u8) -> bool {
+    return bytes_eq(a, b);
+}
+
+// ---------------------------------------------------------------- 3. Target address parser
+
+fn pid_host_char_ok(c: u8) -> bool {
+    if (c >= 48 and c <= 57) { return true; }   // 0-9
+    if (c >= 65 and c <= 90) { return true; }   // A-Z
+    if (c >= 97 and c <= 122) { return true; }  // a-z
+    if (c == 46 or c == 45) { return true; }    // . -
+    return false;
+}
+
+/// Parse a peer lookup / dial target:
+///   "T27-1234-5678"                   -> id="T27-1234-5678", host="",            port=47727
+///   "12345678@192.168.1.5"            -> id="T27-1234-5678", host="192.168.1.5", port=47727
+///   "T27-1234-5678@127.0.0.1:47728"   -> id="T27-1234-5678", host="127.0.0.1",   port=47728
+/// Writes out_lens[0]=id_len, out_lens[1]=host_len, out_lens[2]=port.
+/// Returns true if valid, false otherwise.
+pub fn pid_parse_target(raw: []const u8, id_out: []u8, host_out: []u8, out_lens: []u32) -> bool {
+    if (out_lens.len < 3 or id_out.len < PID_LEN) { return false; }
+    out_lens[0] = 0;
+    out_lens[1] = 0;
+    out_lens[2] = PID_DEFAULT_PORT;
+    var s : usize = 0;
+    var e : usize = raw.len;
+    while (s < e and pid_is_space(raw[s])) { s = s + 1; }
+    while (e > s and pid_is_space(raw[e - 1])) { e = e - 1; }
+    if (s >= e) { return false; }
+    // Look for '@' splitting number and host[:port].
+    var at : usize = e;
+    var i : usize = s;
+    while (i < e) {
+        if (raw[i] == 64) {
+            at = i;
+            break;
+        }
+        i = i + 1;
+    }
+    const idn : usize = pid_normalize(raw[s..at], id_out);
+    if (idn != PID_LEN) { return false; }
+    out_lens[0] = @as(u32, @intCast(idn));
+    if (at == e) {
+        return true;
+    }
+    // Parse host[:port] after '@'.
+    const hs : usize = at + 1;
+    if (hs >= e) { return false; }
+    var colon : usize = e;
+    i = hs;
+    while (i < e) {
+        if (raw[i] == 58) {
+            colon = i;
+            break;
+        }
+        i = i + 1;
+    }
+    const hlen : usize = colon - hs;
+    if (hlen == 0 or hlen > PID_HOST_MAX or hlen > host_out.len) { return false; }
+    i = 0;
+    while (i < hlen) {
+        if (pid_host_char_ok(raw[hs + i]) == false) { return false; }
+        host_out[i] = raw[hs + i];
+        i = i + 1;
+    }
+    out_lens[1] = @as(u32, @intCast(hlen));
+    if (colon < e) {
+        const ps : usize = colon + 1;
+        if (ps >= e or e - ps > 5) { return false; }
+        var pval : u32 = 0;
+        i = ps;
+        while (i < e) {
+            if (pid_is_digit(raw[i]) == false) { return false; }
+            pval = pval * 10 + @as(u32, raw[i] - 48);
+            i = i + 1;
+        }
+        if (pval < PID_PORT_MIN or pval > PID_PORT_MAX) { return false; }
+        out_lens[2] = pval;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------- 4. Share text & paths
+
+fn pid_put(out: []u8, pos: usize, s: []const u8) -> usize {
+    var p : usize = pos;
+    var i : usize = 0;
+    while (i < s.len and p < out.len) {
+        out[p] = s[i];
+        p = p + 1;
+        i = i + 1;
+    }
+    return p;
+}
+
+fn pid_put_u32(out: []u8, pos: usize, v: u32) -> usize {
+    var tmp : [12]u8 = undefined;
+    var n : usize = 0;
+    var x : u32 = v;
+    if (x == 0) {
+        tmp[0] = 48;
+        n = 1;
+    } else {
+        while (x > 0 and n < 12) {
+            tmp[n] = @as(u8, @intCast(48 + (x % 10)));
+            x = x / 10;
+            n = n + 1;
+        }
+    }
+    var p : usize = pos;
+    while (n > 0 and p < out.len) {
+        n = n - 1;
+        out[p] = tmp[n];
+        p = p + 1;
+    }
+    return p;
+}
+
+/// Format shareable contact text: "T27-XXXX-XXXX (nick) :47727" or "T27-XXXX-XXXX :47727".
+pub fn pid_share_text(id: []const u8, nick: []const u8, port: u32, out: []u8) -> usize {
+    if (pid_valid(id) == false) { return 0; }
+    var p : usize = pid_put(out, 0, id);
+    if (nick.len > 0) {
+        p = pid_put(out, p, " (");
+        p = pid_put(out, p, nick);
+        p = pid_put(out, p, ")");
+    }
+    if (port >= PID_PORT_MIN and port <= PID_PORT_MAX) {
+        p = pid_put(out, p, " :");
+        p = pid_put_u32(out, p, port);
+    }
+    return p;
+}
+
+/// Build NUL-terminated path "<home>/.t27os/<suffix>" into out; returns byte len excluding NUL.
+pub fn pid_home_path(home: []const u8, suffix: []const u8, out: []u8) -> usize {
+    if (home.len == 0 or home[0] != 47) { return 0; }
+    var hlen : usize = home.len;
+    while (hlen > 1 and home[hlen - 1] == 47) { hlen = hlen - 1; }
+    const need : usize = hlen + 8 + suffix.len + 1;
+    if (need > out.len) { return 0; }
+    var p : usize = pid_put(out, 0, home[0..hlen]);
+    p = pid_put(out, p, "/.t27os/");
+    p = pid_put(out, p, suffix);
+    out[p] = 0;
+    return p;
+}
+
+// ---------------------------------------------------------------- 5. Invariants & tests
+
+invariant pid_constants_valid {
+    assert PID_LEN == 13;
+    assert PID_DIGITS == 8;
+    assert PID_DEFAULT_PORT >= PID_PORT_MIN and PID_DEFAULT_PORT <= PID_PORT_MAX;
+}
+
+test pid_derivation_is_deterministic_and_distinct {
+    var a : [13]u8 = undefined;
+    var b : [13]u8 = undefined;
+    var c : [13]u8 = undefined;
+    assert pid_from_identity("T27OSID_seed_alpha_0001", a[0..13]) == 13;
+    assert pid_from_identity("T27OSID_seed_alpha_0001", b[0..13]) == 13;
+    assert pid_from_identity("T27OSID_seed_beta__0002", c[0..13]) == 13;
+    assert pid_valid(a[0..13]);
+    assert pid_equal(a[0..13], b[0..13]);
+    assert pid_valid(c[0..13]);
+    assert pid_equal(a[0..13], c[0..13]) == false;
+    assert pid_from_identity("short", a[0..13]) == 0;
+}
+
+test pid_normalize_accepts_common_user_formats {
+    var out : [13]u8 = undefined;
+    assert pid_normalize("T27-4821-9304", out[0..13]) == 13;
+    assert pid_equal(out[0..13], "T27-4821-9304");
+    assert pid_normalize("  t27-4821-9304 \n", out[0..13]) == 13;
+    assert pid_equal(out[0..13], "T27-4821-9304");
+    assert pid_normalize("48219304", out[0..13]) == 13;
+    assert pid_equal(out[0..13], "T27-4821-9304");
+    assert pid_normalize("4821 9304", out[0..13]) == 13;
+    assert pid_equal(out[0..13], "T27-4821-9304");
+    assert pid_normalize("T2748219304", out[0..13]) == 13;
+    assert pid_equal(out[0..13], "T27-4821-9304");
+    assert pid_normalize("1234567", out[0..13]) == 0;
+    assert pid_normalize("123456789", out[0..13]) == 0;
+    assert pid_normalize("T27-ABCD-1234", out[0..13]) == 0;
+}
+
+test pid_parse_target_handles_number_and_direct_endpoint {
+    var id : [13]u8 = undefined;
+    var host : [64]u8 = undefined;
+    var lens : [3]u32 = undefined;
+    assert pid_parse_target("4821-9304", id[0..13], host[0..64], lens[0..3]);
+    assert lens[0] == 13 and lens[1] == 0 and lens[2] == 47727;
+    assert pid_equal(id[0..13], "T27-4821-9304");
+
+    assert pid_parse_target("T27-4821-9304@192.168.1.42", id[0..13], host[0..64], lens[0..3]);
+    assert lens[0] == 13 and lens[1] == 12 and lens[2] == 47727;
+    assert pid_equal(host[0..12], "192.168.1.42");
+
+    assert pid_parse_target("48219304@127.0.0.1:47728", id[0..13], host[0..64], lens[0..3]);
+    assert lens[0] == 13 and lens[1] == 9 and lens[2] == 47728;
+    assert pid_equal(id[0..13], "T27-4821-9304");
+    assert pid_equal(host[0..9], "127.0.0.1");
+
+    assert pid_parse_target("T27-4821-9304@127.0.0.1:80", id[0..13], host[0..64], lens[0..3]) == false;
+    assert pid_parse_target("T27-4821-9304@", id[0..13], host[0..64], lens[0..3]) == false;
+}
+
+test pid_share_text_and_paths {
+    var out : [128]u8 = undefined;
+    const n : usize = pid_share_text("T27-4821-9304", "dima", 47727, out[0..128]);
+    assert pid_equal(out[0..n], "T27-4821-9304 (dima) :47727");
+    var p : [128]u8 = undefined;
+    const pn : usize = pid_home_path("/Users/d/", "identity", p[0..128]);
+    assert pn == 24 and pid_equal(p[0..pn], "/Users/d/.t27os/identity") and p[pn] == 0;
+}
diff --git a/specs/t27os/peer_identity.t27 b/specs/t27os/peer_identity.t27
new file mode 100644
index 000000000..10b5506c5
--- /dev/null
+++ b/specs/t27os/peer_identity.t27
@@ -0,0 +1,1886 @@
+// SPDX-License-Identifier: Apache-2.0
+// specs/t27os/peer_identity.t27 -- who a person on this network IS, for the in-OS call (Refs gHashTag/t27#11560).
+// Pure decisions, no @extern, no crypto: the host (peer_identity_host.t27) makes the keys, hashes, reads and writes the
+// files and talks to mDNS; every rule it follows is a tested fn here. (specs/t27os/identity.t27 is the agent identity
+// card of the window and is not touched.) ASCII only (L3), English only (LANG-EN).
+//
+// FINGERPRINT  the first 10 bytes of SHA-256( "t27os-call-id-v1" 0x00 || P-256 public key, 65 bytes uncompressed ).
+//   SHA-256 because the OS already ships it (CC_SHA256, the same primitive keysync.t27 and call_core.t27 use for their
+//   fingerprints), so no new primitive and no new code to trust; the domain prefix stops a digest made for another
+//   purpose from being replayed as an identity. 10 bytes = 80 bits: finding a second key with the same fingerprint
+//   costs about 2^80 hashes; the call still ends in the 6-digit code both people compare (call_core), so the invite
+//   string is a locator and a pin, not the only defence. This spec takes the digest as an input (it cannot hash).
+// INVITE STRING  "T27-" + 4 groups of 4 base32 symbols + "-" + 1 check symbol, 25 characters, e.g.
+//   T27-ABCD-EFGH-JKMN-PQRS-T. The 16 symbols are the 80 bits of the fingerprint (5 bits each, most significant bit
+//   first); the alphabet is 0-9 A-Z without I, L, O, U (no symbol looks like another or spells a rude word). The
+//   check symbol is sum((2*j+1) * value_j) mod 32 over the 16 symbols (j from 0): every single wrong symbol changes
+//   it (the weights are odd, so invertible mod 32); an adjacent swap is caught unless the two symbols differ by
+//   exactly 16. The parser is case-insensitive for letters and refuses everything else: a short string, a long one,
+//   a wrong prefix, a dash in the wrong place, a character outside the alphabet, a wrong check symbol.
+//   NOTE: the shape T27-XXXX-XXXX-XXXX (12 symbols = 60 bits) cannot carry 10 bytes; this format keeps all 80 bits.
+// IDENTITY FILE  ~/.t27os/identity, 207 bytes: magic "T27OSID\n" (8) | version u32 LE (4) | suite u32 LE (4, 1 = P-256)
+//   | public key (65) | private key X9.63 (97) | nick length (1) | nick (24, zero padded) | CRC-32 of all before (4).
+//   No file -> make a new identity. A file that does not check -> NEVER overwrite it, return the error (it may be the
+//   only copy of a key). The private half is the OS's X9.63 export; the file is mode 0600 and written atomically.
+// FRIENDS FILE  ~/.t27os/friends, 1108 bytes: magic "T27OSFR\n" (8) | version u32 LE (4) | count u32 LE (4) | 32 rows
+//   of fingerprint (10) + nick (24, zero padded) | CRC-32 of all before (4). This is version 1; the table in memory
+//   keeps this shape (version 1, FT_LEN) for every caller.
+// FRIENDS FILE v2  3508 bytes: the v1 bytes up to the rows (version u32 = 2) | 32 key slots of fingerprint (10) + P-256
+//   public key (65, uncompressed, first byte 0x04), an all-zero slot is empty | CRC-32 of all before (4). A key is kept
+//   only for a friend in the rows, only one key per friend, and only after the host checked that the key hashes to
+//   that fingerprint (the fingerprint stays derived from the key). The keys live in memory as their own FK_LEN buffer;
+//   ft2_split reads a v1 or v2 file into the table and the keys (a v1 file: no keys, every friend "unverified"),
+//   ft2_join writes v2 and drops the key of a friend who is no longer in the rows. The first save writes v2.
+// IDENTITY IN A SESSION  after the keys of a call or a message session exist, each side sends its identity key and an
+//   ECDSA P-256 signature over the session's transcript (call_core ck_ident_input: the session id, the transcript hash
+//   that holds both ephemeral keys and nonces, the signer's own ephemeral key and both fingerprints). The host checks
+//   that the key hashes to the fingerprint the frames name and that the signature verifies; pid_verdict says what
+//   follows: TRUSTED (a stored key, the same key, a proof that checks: no code needed), CODE (the people compare the
+//   6 digits: a stranger, a friend with no stored key, no proof yet), REFUSE (a stored key and another key or a proof
+//   that does not check: the session ends). A message session has no person to compare the code, so only TRUSTED
+//   opens it. After the people said "match" in a call, a proven key of a friend is stored (pid_pinnable).
+// mDNS  service type _t27call._udp, TXT strings "fp=<invite>", "port=<udp port>", "nick=<nick>" (length-prefixed).
+
+module T27osPeerIdentity;
+use std::mem::bytes_fill;
+use std::mem::bytes_eq;
+
+use t27os::editors::same_bytes;
+
+// ---------------------------------------------------------------- bytes helpers
+
+pub const FP_BYTES : usize = 10;
+pub const PUB_BYTES : usize = 65;
+pub const PRIV_BYTES : usize = 97;
+pub const NICK_MAX : usize = 24;
+
+fn zero_fill(b: []u8) -> void { bytes_fill(b, 0); }
+
+pub fn put_u32le(b: []u8, at: usize, v: u32) -> void {
+    b[at] = @as(u8, @intCast(v & 255));
+    b[at + 1] = @as(u8, @intCast((v >> 8) & 255));
+    b[at + 2] = @as(u8, @intCast((v >> 16) & 255));
+    b[at + 3] = @as(u8, @intCast((v >> 24) & 255));
+}
+
+pub fn get_u32le(b: []const u8, at: usize) -> u32 {
+    return @as(u32, b[at]) | (@as(u32, b[at + 1]) << 8) | (@as(u32, b[at + 2]) << 16) | (@as(u32, b[at + 3]) << 24);
+}
+
+/// CRC-32 (IEEE, reflected 0xEDB88320) of the first n bytes. Corruption detection, not security.
+pub fn crc32(b: []const u8, n: usize) -> u32 {
+    var c : u32 = 4294967295;
+    var i : usize = 0;
+    while (i < n) {
+        c = c ^ @as(u32, b[i]);
+        var k : u32 = 0;
+        while (k < 8) {
+            if ((c & 1) == 1) { c = (c >> 1) ^ 3988292384; } else { c = c >> 1; }
+            k = k + 1;
+        }
+        i = i + 1;
+    }
+    return c ^ 4294967295;
+}
+
+fn same_range(a: []const u8, ao: usize, b: []const u8, bo: usize, n: usize) -> bool {
+    var d : u32 = 0;
+    var i : usize = 0;
+    while (i < n) {
+        d = d | @as(u32, a[ao + i] ^ b[bo + i]);
+        i = i + 1;
+    }
+    return d == 0;
+}
+
+/// A nick is 0..24 printable ASCII bytes (0x20..0x7E): it travels in a TXT string and on the screen.
+pub fn nick_ok(nick: []const u8, n: usize) -> bool {
+    if (n > NICK_MAX or n > nick.len) { return false; }
+    var i : usize = 0;
+    while (i < n) {
+        if (nick[i] < 32 or nick[i] > 126) { return false; }
+        i = i + 1;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------- fingerprint
+
+pub const FP_PREFIX_LEN : usize = 17;
+pub const FP_INPUT_LEN : usize = 82;
+
+/// What the host hashes: "t27os-call-id-v1" 0x00 then the 65-byte public key. 82 bytes into out; 0 on a bad size.
+pub fn pi_fp_input(pubk: []const u8, out: []u8) -> usize {
+    if (pubk.len != PUB_BYTES or out.len < FP_INPUT_LEN) { return 0; }
+    const p : [16]u8 = [116, 50, 55, 111, 115, 45, 99, 97, 108, 108, 45, 105, 100, 45, 118, 49];
+    var i : usize = 0;
+    while (i < 16) {
+        out[i] = p[i];
+        i = i + 1;
+    }
+    out[16] = 0;
+    i = 0;
+    while (i < PUB_BYTES) {
+        out[17 + i] = pubk[i];
+        i = i + 1;
+    }
+    return FP_INPUT_LEN;
+}
+
+/// The fingerprint is the first 10 bytes of the 32-byte SHA-256 digest.
+pub fn pi_fp_from_digest(digest: []const u8, out: []u8) -> bool {
+    if (digest.len != 32 or out.len < FP_BYTES) { return false; }
+    var i : usize = 0;
+    while (i < FP_BYTES) {
+        out[i] = digest[i];
+        i = i + 1;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------- invite string
+
+pub const INVITE_LEN : usize = 25;
+pub const INV_OK : u32 = 0;
+pub const INV_LEN : u32 = 1;
+pub const INV_PREFIX : u32 = 2;
+pub const INV_DASH : u32 = 3;
+pub const INV_CHAR : u32 = 4;
+pub const INV_CHECK : u32 = 5;
+pub const INV_ARG : u32 = 6;
+
+/// Symbol value 0..31 -> ASCII of the alphabet 0-9 A-Z without I L O U.
+pub fn sym_char(v: u32) -> u8 {
+    if (v < 10) { return @as(u8, @intCast(48 + v)); }
+    var c : u32 = 65 + (v - 10);
+    if (v >= 18) { c = c + 1; }
+    if (v >= 20) { c = c + 1; }
+    if (v >= 22) { c = c + 1; }
+    if (v >= 27) { c = c + 1; }
+    return @as(u8, @intCast(c));
+}
+
+/// ASCII -> symbol value, letters case-insensitive; 32 when the character is not in the alphabet.
+pub fn sym_value(ch: u8) -> u32 {
+    var c : u32 = @as(u32, ch);
+    if (c >= 97 and c <= 122) { c = c - 32; }
+    if (c >= 48 and c <= 57) { return c - 48; }
+    if (c < 65 or c > 90) { return 32; }
+    if (c == 73 or c == 76 or c == 79 or c == 85) { return 32; }
+    var v : u32 = c - 65 + 10;
+    if (c > 73) { v = v - 1; }
+    if (c > 76) { v = v - 1; }
+    if (c > 79) { v = v - 1; }
+    if (c > 85) { v = v - 1; }
+    return v;
+}
+
+fn fp_symbol(fp: []const u8, j: usize) -> u32 {
+    const b : usize = 5 * j;
+    const i : usize = b / 8;
+    const o : u32 = @as(u32, @intCast(b % 8));
+    var lo : u32 = 0;
+    if (i + 1 < FP_BYTES) { lo = @as(u32, fp[i + 1]); }
+    const w : u32 = (@as(u32, fp[i]) << 8) | lo;
+    return (w >> (11 - o)) & 31;
+}
+
+fn check_of(vals: []const u32) -> u32 {
+    var s : u32 = 0;
+    var j : u32 = 0;
+    while (j < 16) {
+        s = s + (2 * j + 1) * vals[@as(usize, @intCast(j))];
+        j = j + 1;
+    }
+    return s & 31;
+}
+
+/// "T27-XXXX-XXXX-XXXX-XXXX-C" from the 10-byte fingerprint, 25 bytes into out; 0 on a bad size.
+pub fn invite_make(fp: []const u8, out: []u8) -> usize {
+    if (fp.len != FP_BYTES or out.len < INVITE_LEN) { return 0; }
+    out[0] = 84;
+    out[1] = 50;
+    out[2] = 55;
+    out[3] = 45;
+    var vals : [16]u32 = undefined;
+    var j : usize = 0;
+    while (j < 16) {
+        vals[j] = fp_symbol(fp, j);
+        j = j + 1;
+    }
+    j = 0;
+    while (j < 16) {
+        const g : usize = j / 4;
+        const k : usize = j % 4;
+        out[4 + 5 * g + k] = sym_char(vals[j]);
+        j = j + 1;
+    }
+    out[8] = 45;
+    out[13] = 45;
+    out[18] = 45;
+    out[23] = 45;
+    out[24] = sym_char(check_of(vals[0..16]));
+    return INVITE_LEN;
+}
+
+/// Parse an invite string into its 10-byte fingerprint. Returns INV_OK or the first reason it was refused.
+pub fn invite_parse(s: []const u8, fp: []u8) -> u32 {
+    if (fp.len < FP_BYTES) { return INV_ARG; }
+    if (s.len != INVITE_LEN) { return INV_LEN; }
+    if (s[0] != 84 and s[0] != 116) { return INV_PREFIX; }
+    if (s[1] != 50 or s[2] != 55 or s[3] != 45) { return INV_PREFIX; }
+    if (s[8] != 45 or s[13] != 45 or s[18] != 45 or s[23] != 45) { return INV_DASH; }
+    var vals : [16]u32 = undefined;
+    var j : usize = 0;
+    while (j < 16) {
+        const g : usize = j / 4;
+        const k : usize = j % 4;
+        const v : u32 = sym_value(s[4 + 5 * g + k]);
+        if (v > 31) { return INV_CHAR; }
+        vals[j] = v;
+        j = j + 1;
+    }
+    const cv : u32 = sym_value(s[24]);
+    if (cv > 31) { return INV_CHAR; }
+    if (cv != check_of(vals[0..16])) { return INV_CHECK; }
+    zero_fill(fp[0..FP_BYTES]);
+    j = 0;
+    while (j < 16) {
+        var k : usize = 0;
+        while (k < 5) {
+            const bit : u32 = (vals[j] >> @as(u32, @intCast(4 - k))) & 1;
+            const pos : usize = 5 * j + k;
+            fp[pos / 8] = fp[pos / 8] | @as(u8, @intCast(bit << @as(u32, @intCast(7 - pos % 8))));
+            k = k + 1;
+        }
+        j = j + 1;
+    }
+    return INV_OK;
+}
+
+// ---------------------------------------------------------------- identity file
+
+pub const ID_LEN : usize = 207;
+pub const ID_OFF_VERSION : usize = 8;
+pub const ID_OFF_SUITE : usize = 12;
+pub const ID_OFF_PUB : usize = 16;
+pub const ID_OFF_PRIV : usize = 81;
+pub const ID_OFF_NICK_LEN : usize = 178;
+pub const ID_OFF_NICK : usize = 179;
+pub const ID_OFF_CRC : usize = 203;
+pub const ID_VERSION : u32 = 1;
+pub const ID_SUITE_P256 : u32 = 1;
+
+pub const ID_OK : u32 = 0;
+pub const ID_SHORT : u32 = 1;
+pub const ID_LONG : u32 = 2;
+pub const ID_MAGIC : u32 = 3;
+pub const ID_VERSION_BAD : u32 = 4;
+pub const ID_SUITE_BAD : u32 = 5;
+pub const ID_CRC : u32 = 6;
+pub const ID_NICK_BAD : u32 = 7;
+pub const ID_KEY_BAD : u32 = 8;
+pub const ID_ARG : u32 = 9;
+
+pub const ACT_CREATE : u32 = 1;
+pub const ACT_USE : u32 = 2;
+pub const ACT_REFUSE : u32 = 3;
+
+fn put_magic(b: []u8, kind: u32) -> void {
+    b[0] = 84;
+    b[1] = 50;
+    b[2] = 55;
+    b[3] = 79;
+    b[4] = 83;
+    if (kind == 0) { b[5] = 73; b[6] = 68; } else { b[5] = 70; b[6] = 82; }
+    b[7] = 10;
+}
+
+fn magic_ok(b: []const u8, kind: u32) -> bool {
+    var m : [8]u8 = undefined;
+    put_magic(m[0..8], kind);
+    return same_range(b, 0, m[0..8], 0, 8);
+}
+
+/// Lay out an identity file: the public key, the private key (X9.63, which starts with the public key), the nick.
+/// ID_LEN on success; 0 on a wrong size or a bad nick.
+pub fn id_build(pubk: []const u8, priv: []const u8, nick: []const u8, n: usize, out: []u8) -> usize {
+    if (pubk.len != PUB_BYTES or priv.len != PRIV_BYTES or out.len < ID_LEN) { return 0; }
+    if (nick_ok(nick, n) == false) { return 0; }
+    zero_fill(out[0..ID_LEN]);
+    put_magic(out, 0);
+    put_u32le(out, ID_OFF_VERSION, ID_VERSION);
+    put_u32le(out, ID_OFF_SUITE, ID_SUITE_P256);
+    var i : usize = 0;
+    while (i < PUB_BYTES) {
+        out[ID_OFF_PUB + i] = pubk[i];
+        i = i + 1;
+    }
+    i = 0;
+    while (i < PRIV_BYTES) {
+        out[ID_OFF_PRIV + i] = priv[i];
+        i = i + 1;
+    }
+    out[ID_OFF_NICK_LEN] = @as(u8, @intCast(n));
+    i = 0;
+    while (i < n) {
+        out[ID_OFF_NICK + i] = nick[i];
+        i = i + 1;
+    }
+    put_u32le(out, ID_OFF_CRC, crc32(out, ID_OFF_CRC));
+    return ID_LEN;
+}
+
+/// Does the buffer hold a whole, sane identity file? The first thing wrong is the answer.
+pub fn id_check(b: []const u8) -> u32 {
+    if (b.len < ID_LEN) { return ID_SHORT; }
+    if (b.len > ID_LEN) { return ID_LONG; }
+    if (magic_ok(b, 0) == false) { return ID_MAGIC; }
+    if (get_u32le(b, ID_OFF_VERSION) != ID_VERSION) { return ID_VERSION_BAD; }
+    if (get_u32le(b, ID_OFF_SUITE) != ID_SUITE_P256) { return ID_SUITE_BAD; }
+    if (get_u32le(b, ID_OFF_CRC) != crc32(b, ID_OFF_CRC)) { return ID_CRC; }
+    const n : usize = @as(usize, b[ID_OFF_NICK_LEN]);
+    if (n > NICK_MAX) { return ID_NICK_BAD; }
+    var i : usize = 0;
+    while (i < NICK_MAX) {
+        const c : u8 = b[ID_OFF_NICK + i];
+        if (i < n and (c < 32 or c > 126)) { return ID_NICK_BAD; }
+        if (i >= n and c != 0) { return ID_NICK_BAD; }
+        i = i + 1;
+    }
+    if (b[ID_OFF_PUB] != 4) { return ID_KEY_BAD; }
+    if (same_range(b, ID_OFF_PUB, b, ID_OFF_PRIV, PUB_BYTES) == false) { return ID_KEY_BAD; }
+    return ID_OK;
+}
+
+/// What to do at start: no file -> make one; a good file -> use it; a file that is there but wrong (or could not be
+/// read) -> refuse and leave it alone.
+pub fn id_action(exists: bool, status: u32) -> u32 {
+    if (exists == false) { return ACT_CREATE; }
+    if (status == ID_OK) { return ACT_USE; }
+    return ACT_REFUSE;
+}
+
+// ---------------------------------------------------------------- friends table
+
+pub const FT_MAX : usize = 32;
+pub const FT_ROW : usize = 34;
+pub const FT_HDR : usize = 16;
+pub const FT_LEN : usize = 1108;
+pub const FT_OFF_CRC : usize = 1104;
+
+pub const FT_OK : u32 = 0;
+pub const FT_SHORT : u32 = 1;
+pub const FT_LONG : u32 = 2;
+pub const FT_MAGIC : u32 = 3;
+pub const FT_VERSION_BAD : u32 = 4;
+pub const FT_COUNT : u32 = 5;
+pub const FT_CRC : u32 = 6;
+pub const FT_DUP : u32 = 7;
+
+pub const FA_OK : u32 = 0;
+pub const FA_BAD_INVITE : u32 = 1;
+pub const FA_DUPLICATE : u32 = 2;
+pub const FA_FULL : u32 = 3;
+pub const FA_SELF : u32 = 4;
+pub const FA_DAMAGED : u32 = 5;
+
+fn ft_row_at(i: usize) -> usize { return FT_HDR + i * FT_ROW; }
+
+pub fn ft_count(t: []const u8) -> u32 { return get_u32le(t, 8 + 4); }
+
+/// Recompute the trailing CRC-32 after any change.
+pub fn ft_seal(t: []u8) -> void {
+    put_u32le(t, FT_OFF_CRC, crc32(t, FT_OFF_CRC));
+}
+
+/// An empty table (count 0), sealed.
+pub fn ft_init(t: []u8) -> bool {
+    if (t.len < FT_LEN) { return false; }
+    zero_fill(t[0..FT_LEN]);
+    put_magic(t, 1);
+    put_u32le(t, 8, 1);
+    ft_seal(t);
+    return true;
+}
+
+/// The index of the friend with this fingerprint, FT_MAX when there is none.
+pub fn ft_find(t: []const u8, fp: []const u8) -> usize {
+    if (t.len < FT_LEN or fp.len < FP_BYTES) { return FT_MAX; }
+    const n : usize = @as(usize, ft_count(t));
+    var i : usize = 0;
+    while (i < n and i < FT_MAX) {
+        if (same_range(t, ft_row_at(i), fp, 0, FP_BYTES)) { return i; }
+        i = i + 1;
+    }
+    return FT_MAX;
+}
+
+/// Does the buffer hold a whole, sane table (right size, magic, version, count, CRC, no fingerprint twice)?
+pub fn ft_check(t: []const u8) -> u32 {
+    if (t.len < FT_LEN) { return FT_SHORT; }
+    if (t.len > FT_LEN) { return FT_LONG; }
+    if (magic_ok(t, 1) == false) { return FT_MAGIC; }
+    if (get_u32le(t, 8) != 1) { return FT_VERSION_BAD; }
+    if (get_u32le(t, 12) > 32) { return FT_COUNT; }
+    if (get_u32le(t, FT_OFF_CRC) != crc32(t, FT_OFF_CRC)) { return FT_CRC; }
+    const n : usize = @as(usize, ft_count(t));
+    var i : usize = 0;
+    while (i < n) {
+        var k : usize = i + 1;
+        while (k < n) {
+            if (same_range(t, ft_row_at(i), t, ft_row_at(k), FP_BYTES)) { return FT_DUP; }
+            k = k + 1;
+        }
+        i = i + 1;
+    }
+    return FT_OK;
+}
+
+/// Add a friend by invite string. Own fingerprint is refused (you do not call yourself), so is a second copy.
+/// The nick starts empty; ft_set_nick names the row. The table is sealed again on success.
+pub fn ft_add(t: []u8, invite: []const u8, own_fp: []const u8) -> u32 {
+    if (ft_check(t) != FT_OK) { return FA_DAMAGED; }
+    var fp : [10]u8 = undefined;
+    if (invite_parse(invite, fp[0..10]) != INV_OK) { return FA_BAD_INVITE; }
+    if (own_fp.len == FP_BYTES and same_range(fp[0..10], 0, own_fp, 0, FP_BYTES)) { return FA_SELF; }
+    if (ft_find(t, fp[0..10]) != FT_MAX) { return FA_DUPLICATE; }
+    const n : usize = @as(usize, ft_count(t));
+    if (n >= FT_MAX) { return FA_FULL; }
+    var i : usize = 0;
+    while (i < FP_BYTES) {
+        t[ft_row_at(n) + i] = fp[i];
+        i = i + 1;
+    }
+    put_u32le(t, 12, @as(u32, @intCast(n + 1)));
+    ft_seal(t);
+    return FA_OK;
+}
+
+/// Name a friend (printable ASCII, up to 24). False when the friend is not in the table or the nick is bad.
+pub fn ft_set_nick(t: []u8, fp: []const u8, nick: []const u8, n: usize) -> bool {
+    if (nick_ok(nick, n) == false) { return false; }
+    const idx : usize = ft_find(t, fp);
+    if (idx == FT_MAX) { return false; }
+    var i : usize = 0;
+    while (i < NICK_MAX) {
+        if (i < n) { t[ft_row_at(idx) + FP_BYTES + i] = nick[i]; } else { t[ft_row_at(idx) + FP_BYTES + i] = 0; }
+        i = i + 1;
+    }
+    ft_seal(t);
+    return true;
+}
+
+/// Remove a friend; the rows after it move up, the freed last row is zeroed. False when there is no such friend.
+pub fn ft_remove(t: []u8, fp: []const u8) -> bool {
+    const idx : usize = ft_find(t, fp);
+    if (idx == FT_MAX) { return false; }
+    const n : usize = @as(usize, ft_count(t));
+    var i : usize = idx;
+    while (i + 1 < n) {
+        var k : usize = 0;
+        while (k < FT_ROW) {
+            t[ft_row_at(i) + k] = t[ft_row_at(i + 1) + k];
+            k = k + 1;
+        }
+        i = i + 1;
+    }
+    var k : usize = 0;
+    while (k < FT_ROW) {
+        t[ft_row_at(n - 1) + k] = 0;
+        k = k + 1;
+    }
+    put_u32le(t, 12, @as(u32, @intCast(n - 1)));
+    ft_seal(t);
+    return true;
+}
+
+/// Copy the fingerprint of row i (0-based) into out. False when i is not a row.
+pub fn ft_fp_at(t: []const u8, i: usize, out: []u8) -> bool {
+    if (i >= @as(usize, ft_count(t)) or out.len < FP_BYTES) { return false; }
+    var k : usize = 0;
+    while (k < FP_BYTES) {
+        out[k] = t[ft_row_at(i) + k];
+        k = k + 1;
+    }
+    return true;
+}
+
+// ---------------------------------------------------------------- friends file v2: the friends' public keys
+
+pub const FT2_VERSION : u32 = 2;
+pub const FK_SLOT : usize = 75;
+pub const FK_LEN : usize = 2400;
+pub const FT2_OFF_KEYS : usize = 1104;
+pub const FT2_OFF_CRC : usize = 3504;
+pub const FT2_LEN : usize = 3508;
+/// A v2 key slot that is malformed, names someone who is not a friend, or names a friend twice.
+pub const FT_KEY_BAD : u32 = 8;
+
+pub const PIN_NEW : u32 = 0;
+pub const PIN_SAME : u32 = 1;
+/// Another key is already stored for this friend: it is never replaced (remove and add the friend again).
+pub const PIN_CONFLICT : u32 = 2;
+pub const PIN_NOT_FRIEND : u32 = 3;
+pub const PIN_BAD : u32 = 4;
+pub const PIN_FULL : u32 = 5;
+
+fn fk_used(keys: []const u8, i: usize) -> bool {
+    var d : u32 = 0;
+    var k : usize = 0;
+    while (k < FK_SLOT) {
+        d = d | @as(u32, keys[i * FK_SLOT + k]);
+        k = k + 1;
+    }
+    return d != 0;
+}
+
+/// The slot holding the key of this fingerprint, FT_MAX when there is none.
+pub fn fk_find(keys: []const u8, fp: []const u8) -> usize {
+    if (keys.len < FK_LEN or fp.len < FP_BYTES) { return FT_MAX; }
+    var i : usize = 0;
+    while (i < FT_MAX) {
+        if (fk_used(keys, i) and same_range(keys, i * FK_SLOT, fp, 0, FP_BYTES)) { return i; }
+        i = i + 1;
+    }
+    return FT_MAX;
+}
+
+/// The stored key of this friend into out (65 bytes). False when none is stored.
+pub fn fk_get(keys: []const u8, fp: []const u8, out: []u8) -> bool {
+    const i : usize = fk_find(keys, fp);
+    if (i == FT_MAX or out.len < PUB_BYTES) { return false; }
+    var k : usize = 0;
+    while (k < PUB_BYTES) {
+        out[k] = keys[i * FK_SLOT + FP_BYTES + k];
+        k = k + 1;
+    }
+    return true;
+}
+
+/// How many keys are stored.
+pub fn fk_count(keys: []const u8) -> u32 {
+    if (keys.len < FK_LEN) { return 0; }
+    var n : u32 = 0;
+    var i : usize = 0;
+    while (i < FT_MAX) {
+        if (fk_used(keys, i)) { n = n + 1; }
+        i = i + 1;
+    }
+    return n;
+}
+
+/// Store the key of a friend. The caller (the host) has checked that the key hashes to fp. A friend keeps the first
+/// key stored for it: another key is PIN_CONFLICT and changes nothing.
+pub fn fk_pin(t: []const u8, keys: []u8, fp: []const u8, pubk: []const u8) -> u32 {
+    if (keys.len < FK_LEN or fp.len < FP_BYTES or pubk.len != PUB_BYTES or pubk[0] != 4) { return PIN_BAD; }
+    if (ft_find(t, fp) == FT_MAX) { return PIN_NOT_FRIEND; }
+    const at : usize = fk_find(keys, fp);
+    if (at != FT_MAX) {
+        if (same_range(keys, at * FK_SLOT + FP_BYTES, pubk, 0, PUB_BYTES)) { return PIN_SAME; }
+        return PIN_CONFLICT;
+    }
+    var i : usize = 0;
+    while (i < FT_MAX and fk_used(keys, i)) { i = i + 1; }
+    if (i == FT_MAX) { return PIN_FULL; }
+    var k : usize = 0;
+    while (k < FP_BYTES) {
+        keys[i * FK_SLOT + k] = fp[k];
+        k = k + 1;
+    }
+    k = 0;
+    while (k < PUB_BYTES) {
+        keys[i * FK_SLOT + FP_BYTES + k] = pubk[k];
+        k = k + 1;
+    }
+    return PIN_NEW;
+}
+
+/// Read a friends file of n bytes (v1 or v2) into the table t (v1 shape, sealed) and the keys. FT_OK or the first
+/// thing wrong; a v1 file gives empty keys.
+pub fn ft2_split(f: []const u8, n: usize, t: []u8, keys: []u8) -> u32 {
+    if (n > f.len or t.len < FT_LEN or keys.len < FK_LEN) { return FT_SHORT; }
+    zero_fill(keys[0..FK_LEN]);
+    if (n == FT_LEN) {
+        const r : u32 = ft_check(f[0..FT_LEN]);
+        if (r != FT_OK) { return r; }
+        var i : usize = 0;
+        while (i < FT_LEN) {
+            t[i] = f[i];
+            i = i + 1;
+        }
+        return FT_OK;
+    }
+    if (n < FT2_LEN) { return FT_SHORT; }
+    if (n > FT2_LEN) { return FT_LONG; }
+    if (magic_ok(f, 1) == false) { return FT_MAGIC; }
+    if (get_u32le(f, 8) != FT2_VERSION) { return FT_VERSION_BAD; }
+    if (get_u32le(f, 12) > 32) { return FT_COUNT; }
+    if (get_u32le(f, FT2_OFF_CRC) != crc32(f, FT2_OFF_CRC)) { return FT_CRC; }
+    zero_fill(t[0..FT_LEN]);
+    var i : usize = 0;
+    while (i < FT_OFF_CRC) {
+        t[i] = f[i];
+        i = i + 1;
+    }
+    put_u32le(t, 8, 1);
+    ft_seal(t);
+    const r : u32 = ft_check(t[0..FT_LEN]);
+    if (r != FT_OK) { return r; }
+    i = 0;
+    while (i < FT_MAX) {
+        const at : usize = FT2_OFF_KEYS + i * FK_SLOT;
+        if (fk_used(f[FT2_OFF_KEYS..FT2_OFF_CRC], i)) {
+            if (f[at + FP_BYTES] != 4) { return FT_KEY_BAD; }
+            if (ft_find(t, f[at..at + FP_BYTES]) == FT_MAX) { return FT_KEY_BAD; }
+            if (fk_find(keys, f[at..at + FP_BYTES]) != FT_MAX) { return FT_KEY_BAD; }
+            var k : usize = 0;
+            while (k < FK_SLOT) {
+                keys[i * FK_SLOT + k] = f[at + k];
+                k = k + 1;
+            }
+        }
+        i = i + 1;
+    }
+    return FT_OK;
+}
+
+/// Drop every stored key that does not hash to the fingerprint it is stored under: calc holds, slot by slot (FP_BYTES
+/// each, FT_MAX slots), the fingerprint the host computed from that slot's key (zeros when it could not). A key read
+/// from a file that was changed by hand must not make its friend "verified"; the friend reads not verified (no key)
+/// until a matched code stores the right one. How many were dropped (0 when calc is short: nothing is trusted then
+/// either, every key goes).
+pub fn fk_drop_unhashed(keys: []u8, calc: []const u8) -> u32 {
+    if (keys.len < FK_LEN) { return 0; }
+    var n : u32 = 0;
+    var i : usize = 0;
+    while (i < FT_MAX) {
+        if (fk_used(keys, i)) {
+            if (calc.len < FT_MAX * FP_BYTES or !same_range(keys, i * FK_SLOT, calc, i * FP_BYTES, FP_BYTES)) {
+                zero_fill(keys[i * FK_SLOT .. (i + 1) * FK_SLOT]);
+                n = n + 1;
+            }
+        }
+        i = i + 1;
+    }
+    return n;
+}
+
+/// Lay out the v2 file from a table that checks and the keys: the key of a fingerprint that is not in the rows is
+/// left out, so is a second key for the same friend. FT2_LEN, or 0 on a bad table or size.
+pub fn ft2_join(t: []const u8, keys: []const u8, out: []u8) -> usize {
+    if (t.len < FT_LEN or keys.len < FK_LEN or out.len < FT2_LEN) { return 0; }
+    if (ft_check(t[0..FT_LEN]) != FT_OK) { return 0; }
+    zero_fill(out[0..FT2_LEN]);
+    var i : usize = 0;
+    while (i < FT_OFF_CRC) {
+        out[i] = t[i];
+        i = i + 1;
+    }
+    put_u32le(out, 8, FT2_VERSION);
+    var j : usize = 0;
+    i = 0;
+    while (i < FT_MAX) {
+        const a : usize = i * FK_SLOT;
+        if (fk_used(keys, i) and keys[a + FP_BYTES] == 4 and ft_find(t, keys[a..a + FP_BYTES]) != FT_MAX) {
+            if (fk_find(out[FT2_OFF_KEYS..FT2_OFF_CRC], keys[a..a + FP_BYTES]) == FT_MAX) {
+                var k : usize = 0;
+                while (k < FK_SLOT) {
+                    out[FT2_OFF_KEYS + j * FK_SLOT + k] = keys[a + k];
+                    k = k + 1;
+                }
+                j = j + 1;
+            }
+        }
+        i = i + 1;
+    }
+    put_u32le(out, FT2_OFF_CRC, crc32(out, FT2_OFF_CRC));
+    return FT2_LEN;
+}
+
+// ---------------------------------------------------------------- identity in a session: who may skip the code
+
+pub const PID_CODE : u32 = 0;
+pub const PID_TRUSTED : u32 = 1;
+pub const PID_REFUSE : u32 = 2;
+
+/// pinned: a key is stored for this peer. got: the peer's identity proof arrived. proof_ok: its key hashes to the
+/// fingerprint the frames name and its signature over this session's transcript verifies. same_key: that key is the
+/// stored one.
+pub fn pid_verdict(pinned: bool, got: bool, proof_ok: bool, same_key: bool) -> u32 {
+    if (got == false) { return PID_CODE; }
+    if (pinned) {
+        if (proof_ok and same_key) { return PID_TRUSTED; }
+        return PID_REFUSE;
+    }
+    return PID_CODE;
+}
+
+/// After the people compared the code and said "match": store the proven key of a peer that had none.
+pub fn pid_pinnable(pinned: bool, got: bool, proof_ok: bool) -> bool {
+    return pinned == false and got and proof_ok;
+}
+
+/// The session says "match" by itself only for a peer it already trusts.
+pub fn pid_auto_match(verdict: u32) -> bool { return verdict == PID_TRUSTED; }
+
+/// May a person's "match" count? Not after a refusal, and never in a message session (no person compares a code
+/// there: only TRUSTED opens it).
+pub fn pid_person_may_match(verdict: u32, message_session: bool) -> bool {
+    return verdict != PID_REFUSE and message_session == false;
+}
+
+/// A message session ends at once when the peer's proof arrived and does not make it TRUSTED, or when this device
+/// has no identity to prove itself with.
+pub fn pid_message_refused(have_own: bool, got: bool, verdict: u32) -> bool {
+    if (have_own == false) { return true; }
+    return got and verdict != PID_TRUSTED;
+}
+
+/// How long a session waits for the proof of a peer whose key is stored before it shows the code after all.
+pub const PID_WAIT_MS : u64 = 1500;
+
+/// Show the 6 digits now? Never for a refused peer. A trusted peer needs no code; it is shown only when the call is
+/// still not open after 2 * PID_WAIT_MS (the other side does not know this key yet and its person compares). A peer
+/// with a stored key whose proof has not come gets PID_WAIT_MS before the code is shown. Anyone else at once.
+pub fn pid_show_code(pinned: bool, got: bool, verdict: u32, waited_ms: u64) -> bool {
+    if (verdict == PID_REFUSE) { return false; }
+    if (got and verdict == PID_TRUSTED) { return waited_ms >= 2 * PID_WAIT_MS; }
+    if (pinned and got == false) { return waited_ms >= PID_WAIT_MS; }
+    return true;
+}
+
+// ---------------------------------------------------------------- invitations (owner, 2026-10-22)
+// A person adds a friend by pasting the friend's key string: the fingerprint in it is the person's own input. In a
+// message session (no person compares a code there) the first proof of such a friend whose key is not stored yet is
+// stored as the friend's key (the host checks it hashes to that fingerprint, ih_pin_put); the verdict that follows is
+// pid_verdict's own TRUSTED. A session from someone who is not a friend at all is an invitation: it never opens, the
+// proven key is kept for the person to ACCEPT or DECLINE (invites.t27).
+
+/// Store the proof of a friend whose key is not stored, before the verdict: only in a message session, only for a proof
+/// that checks.
+pub fn pid_store_first(pinned: bool, got: bool, proof_ok: bool, message_session: bool) -> bool {
+    return message_session and pinned == false and got and proof_ok;
+}
+
+/// A message session from a peer who is not a friend, whose proof checks, is an invitation to keep (and to close).
+pub fn pid_is_invitation(friend: bool, got: bool, proof_ok: bool, message_session: bool) -> bool {
+    return message_session and friend == false and got and proof_ok;
+}
+
+// ---------------------------------------------------------------- mDNS TXT record
+
+pub const TXT_MAX : usize = 96;
+
+fn put_str(out: []u8, at: usize, key: []const u8, val: []const u8, vn: usize) -> usize {
+    // one length-prefixed string "key=value"
+    const total : usize = key.len + 1 + vn;
+    out[at] = @as(u8, @intCast(total));
+    var p : usize = at + 1;
+    var i : usize = 0;
+    while (i < key.len) {
+        out[p] = key[i];
+        p = p + 1;
+        i = i + 1;
+    }
+    out[p] = 61;
+    p = p + 1;
+    i = 0;
+    while (i < vn) {
+        out[p] = val[i];
+        p = p + 1;
+        i = i + 1;
+    }
+    return p;
+}
+
+/// TXT bytes for the announcement: fp=<invite>, port=<1..65535>, nick=<nick>. Length, or 0 on a bad input.
+pub fn txt_build(invite: []const u8, port: u32, nick: []const u8, n: usize, out: []u8) -> usize {
+    if (out.len < TXT_MAX or invite.len != INVITE_LEN or port == 0 or port > 65535) { return 0; }
+    var fp : [10]u8 = undefined;
+    if (invite_parse(invite, fp[0..10]) != INV_OK) { return 0; }
+    if (nick_ok(nick, n) == false) { return 0; }
+    var digits : [5]u8 = undefined;
+    var dn : usize = 0;
+    var tmp : [5]u8 = undefined;
+    var x : u32 = port;
+    var tn : usize = 0;
+    while (x > 0) {
+        tmp[tn] = @as(u8, @intCast(48 + x % 10));
+        x = x / 10;
+        tn = tn + 1;
+    }
+    while (tn > 0) {
+        tn = tn - 1;
+        digits[dn] = tmp[tn];
+        dn = dn + 1;
+    }
+    const kfp : [2]u8 = [102, 112];
+    const kport : [4]u8 = [112, 111, 114, 116];
+    const knick : [4]u8 = [110, 105, 99, 107];
+    var p : usize = 0;
+    p = put_str(out, p, kfp[0..2], invite, INVITE_LEN);
+    p = put_str(out, p, kport[0..4], digits[0..5], dn);
+    p = put_str(out, p, knick[0..4], nick, n);
+    return p;
+}
+
+/// The value of "key=" in a TXT record, copied into out; its length, or 0 when the key is absent, the record is
+/// cut short (a length byte that runs past the end) or out is too small. Empty values read as 0 as well.
+pub fn txt_get(txt: []const u8, n: usize, key: []const u8, out: []u8) -> usize {
+    if (n > txt.len) { return 0; }
+    var p : usize = 0;
+    while (p < n) {
+        const l : usize = @as(usize, txt[p]);
+        if (p + 1 + l > n) { return 0; }
+        if (l > key.len and txt[p + 1 + key.len] == 61) {
+            var same : bool = true;
+            var i : usize = 0;
+            while (i < key.len) {
+                if (txt[p + 1 + i] != key[i]) { same = false; }
+                i = i + 1;
+            }
+            if (same) {
+                const vn : usize = l - key.len - 1;
+                if (vn > out.len) { return 0; }
+                i = 0;
+                while (i < vn) {
+                    out[i] = txt[p + 2 + key.len + i];
+                    i = i + 1;
+                }
+                return vn;
+            }
+        }
+        p = p + 1 + l;
+    }
+    return 0;
+}
+
+/// The announced UDP port as a number; 0 for a missing, non-numeric, zero or too large value.
+pub fn txt_port(txt: []const u8, n: usize) -> u32 {
+    var v : [8]u8 = undefined;
+    const key : [4]u8 = [112, 111, 114, 116];
+    const vn : usize = txt_get(txt, n, key[0..4], v[0..8]);
+    if (vn == 0 or vn > 5) { return 0; }
+    var x : u32 = 0;
+    var i : usize = 0;
+    while (i < vn) {
+        if (v[i] < 48 or v[i] > 57) { return 0; }
+        x = x * 10 + @as(u32, v[i]) - 48;
+        i = i + 1;
+    }
+    if (x > 65535) { return 0; }
+    return x;
+}
+
+/// The announced fingerprint, parsed and checked. INV_OK or the reason; a missing "fp" is INV_LEN.
+pub fn txt_fp(txt: []const u8, n: usize, fp: []u8) -> u32 {
+    var v : [32]u8 = undefined;
+    const key : [2]u8 = [102, 112];
+    const vn : usize = txt_get(txt, n, key[0..2], v[0..32]);
+    return invite_parse(v[0..vn], fp);
+}
