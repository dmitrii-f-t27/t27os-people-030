+test five_failed_codes_refuse_the_next_call_for_a_minute_and_a_match_clears_them {
+    var s : [299648]u8 = undefined;
+    cs_t_live(s[0..CS_LEN]);
+    const t : u64 = 1000000;
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_PEER_SAID_DIFFER));
+    var k : u32 = 0;
+    while (k < 4) {
+        cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+        k = k + 1;
+    }
+    // other ends do not count, a match clears the four
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_HANGUP));
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    cs_rate_follow(s[0..CS_LEN], CK_ENDED, t);
+    assert get_u64(s[0..CS_LEN], CS_GRP + @as(usize, LG_RATE) * 8) == 4;
+    cs_rate_follow(s[0..CS_LEN], CK_ACTIVE, t);
+    assert get_u64(s[0..CS_LEN], CS_GRP + @as(usize, LG_RATE) * 8) == 0;
+    // five in a row (differ on either side, a broken commitment): the pause starts
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_I_SAID_DIFFER));
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_COMMITMENT));
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    cs_p(s[0..CS_LEN], CS_REASON, @as(u64, CS_R_PEER_SAID_DIFFER));
+    cs_rate_follow(s[0..CS_LEN], CK_FAILED, t);
+    // the sixth attempt (a call out, a call in) is refused with the reason "too many attempts", nothing else moves
+    cs_p(s[0..CS_LEN], CS_REASON, 0);
+    assert cs_rate_paused(s[0..CS_LEN], t + 1000);
+    assert cs_reason(s[0..CS_LEN]) == CS_R_RATE and cs_state(s[0..CS_LEN]) == CK_IDLE;
+    assert csg_list_stat(s[0..CS_LEN], 6) == 1;
+    // the pause ends 60 s after the fifth failure; it lives in the block only (cs_open wipes it)
+    assert get_u64(s[0..CS_LEN], CS_GRP + @as(usize, LG_RATE) * 8 + 8) == t + CK_PAUSE_MS;
+    assert cs_rate_paused(s[0..CS_LEN], t + CK_PAUSE_MS - 1);
+    assert cs_rate_paused(s[0..CS_LEN], t + CK_PAUSE_MS) == false;
+    assert csg_list_stat(s[0..CS_LEN], 6) == 2;
+}
