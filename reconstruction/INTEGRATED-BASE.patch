+    // never sent: 0, so the first due check sends at once
+    assert cl_last_send(log[0..T_LOG], 0) == 0 and cl_due(log[0..T_LOG], 0, 1) == CH_R_SEND;
+    cl_mark_sent(log[0..T_LOG], 0, 5000);
