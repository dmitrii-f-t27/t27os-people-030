+// Explicitly isolated fixture, no external/session state. Used only by test
+// harnesses and the preview's opt-in QA mode, never as a native login.
+pub fn as_fixture_verdict() -> bool {
+    var store : [AS_WORDS]u64 = undefined; as_clear(store[0..AS_WORDS]);
+    const mac : [4]u64 = [11, 1, 101, 1]; const phone : [4]u64 = [11, 1, 102, 1]; const other : [4]u64 = [22, 1, 201, 1];
+    if (as_enroll(store[0..AS_WORDS], mac[0..4], 1) != AS_OK or as_enroll(store[0..AS_WORDS], phone[0..4], 2) != AS_OK or as_enroll(store[0..AS_WORDS], other[0..4], 1) != AS_OK) { return false; }
+    const request : [6]u64 = [7, 1000, 1300, 1001, 2, 1]; var observations : [16]u64 = undefined; as_clear(observations[0..16]);
+    observations[0] = AS_RESPONDED; observations[1] = AS_SOURCE_RESPONSE;
+    if (as_publish(store[0..AS_WORDS], mac[0..4], request[0..6], observations[0..16]) != AS_OK) { return false; }
+    if (as_read(store[0..AS_WORDS], phone[0..4], 101, 1002) != AS_OK or store[3] != 7) { return false; }
+    if (as_read(store[0..AS_WORDS], other[0..4], 101, 1002) != AS_DENIED) { return false; }
+    if (as_publish(store[0..AS_WORDS], mac[0..4], request[0..6], observations[0..16]) != AS_REPLAY) { return false; }
+    if (as_read(store[0..AS_WORDS], phone[0..4], 101, 1300) != AS_EXPIRED) { return false; }
+    if (as_revoke(store[0..AS_WORDS], phone[0..4], 101) != AS_OK or as_read(store[0..AS_WORDS], phone[0..4], 101, 1002) != AS_EXPIRED) { return false; }
+    return true;
+}
+test isolated_fixture_has_no_production_session_or_network_dependency { assert as_fixture_verdict(); }
