+    ck_wipe(f[0..16]);
+    assert ck_rate_ok(f[0..16], 1000);
+    ck_rate_note(f[0..16], 1000);
+    ck_rate_note(f[0..16], 2000);
+    ck_rate_note(f[0..16], 3000);
+    ck_rate_note(f[0..16], 4000);
+    // four failures: still allowed
+    assert ck_rate_ok(f[0..16], 4500);
+    ck_rate_note(f[0..16], 5000);
+    // the fifth starts a pause of 60 s: the sixth attempt is refused for the whole minute
+    assert ck_rate_ok(f[0..16], 5000) == false;
+    assert ck_rate_ok(f[0..16], 5000 + CK_PAUSE_MS - 1) == false;
+    assert ck_rate_ok(f[0..16], 5000 + CK_PAUSE_MS);
+    // the count started again: four more do not pause
+    assert get_u64(f[0..16], 0) == 0;
+    ck_rate_note(f[0..16], 70000);
+    ck_rate_note(f[0..16], 71000);
+    ck_rate_note(f[0..16], 72000);
+    ck_rate_note(f[0..16], 73000);
+    assert ck_rate_ok(f[0..16], 73500);
+    // a matched code clears the count: two more failures after it do not pause
+    ck_rate_reset(f[0..16]);
+    ck_rate_note(f[0..16], 74000);
+    ck_rate_note(f[0..16], 75000);
+    assert ck_rate_ok(f[0..16], 75500);
+    assert get_u64(f[0..16], 0) == 2;
+    // a short block says no and is not written
+    assert ck_rate_ok(f[0..15], 900000) == false;
+    // what counts: a differ on either side, a broken commitment; nothing else
+    assert ck_rate_counts(true, false);
+    assert ck_rate_counts(false, true);
+    assert ck_rate_counts(false, false) == false;
+}
