+pub fn prfh_subpath(dir: []const u8, leaf: []const u8, out: []u8) -> usize {
+    if (dir.len == 0 or leaf.len == 0) { return 0; }
+    const total : usize = dir.len + 1 + leaf.len;
+    if (total + 1 > out.len) { return 0; }
+    var i : usize = 0;
+    while (i < dir.len) {
+        out[i] = dir[i];
+        i = i + 1;
+    }
+    out[dir.len] = 47;
+    var k : usize = 0;
+    while (k < leaf.len) {
+        out[dir.len + 1 + k] = leaf[k];
+        k = k + 1;
+    }
+    out[total] = 0;
+    return total;
