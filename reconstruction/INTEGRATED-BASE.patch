+// Orca is an official embedded web client, never a PTY agent ID.
+pub const ORCA_LIVE : u64 = 100000;
+pub fn orca_card_hit(x: f64, y: f64, sw: f64, sh: f64, ws: u32, side: f64) -> bool {
+    return x >= orca_left(sw) and x < orca_left(sw) + 72.0 and y >= WS_TOP + 11.0 and y < WS_TOP + 33.0;
+}
+pub fn orca_web_key(live: u64, key: u64, cmd: bool) -> bool {
+    return live == ORCA_LIVE and key != KEY_ESCAPE and (cmd == false or key != 15);
+}
+test orca_native_control_is_separate_from_agent_cells {
+    assert ORCA_LIVE > @as(u64, WIDGET_COUNT);
+    assert orca_card_hit(orca_left(W_PT) + 20.0, WS_TOP + 20.0, W_PT, H_PT, WS_EXPANDED, SIDE_W);
+    assert orca_left(1100.0) + 72.0 < qc_left_of_switch(switch_x(1100.0));
+    assert orca_left(1100.0) > SIDE_W;
+    assert orca_card_hit(orca_left(1100.0), WS_TOP + 33.0, 1100.0, 740.0, WS_EXPANDED, SIDE_W) == false;
+    assert orca_card_hit(0.0, 0.0, W_PT, H_PT, WS_EXPANDED, SIDE_W) == false;
+    assert orca_web_key(ORCA_LIVE, 0, true);
+    assert orca_web_key(ORCA_LIVE, KEY_ESCAPE, false) == false;
+    assert orca_web_key(ORCA_LIVE, 15, true) == false;
+    assert orca_web_key(1, 0, false) == false;
+}
+
+pub fn orca_edit_action(key: u64) -> str {
+    if (key == 0) { return "selectAll:"; }
+    if (key == 8) { return "copy:"; }
+    if (key == 9) { return "paste:"; }
+    if (key == 7) { return "cut:"; }
+    return "";
+}
+test orca_native_editor_commands_use_the_first_responder {
+    assert orca_edit_action(0) == "selectAll:";
+    assert orca_edit_action(8) == "copy:";
+    assert orca_edit_action(9) == "paste:";
+    assert orca_edit_action(7) == "cut:";
+    assert orca_edit_action(15) == "";
+}
