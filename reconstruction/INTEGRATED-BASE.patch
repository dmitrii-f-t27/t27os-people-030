+// SPDX-License-Identifier: Apache-2.0
+// Authenticated, bounded opaque forwarding. No address is carried in a packet.
+use t27os::call_core::ck_same;
+use t27os::call_core::ck_wipe;
+use t27os::call_core::get_u64;
+use t27os::call_core::put_u64;
+use t27os::keysync_host::ks_sha256;
+use t27os::keysync_host::ks_verify;
+pub const MW_BASE:usize=240;
+pub const MW_PROOF:usize=272;
+pub const MW_HOPS:usize=4;
+pub const MW_BODY:usize=2048;
+pub const MW_MAX:usize=3376;
+pub const MW_ORIGIN:usize=64;
+pub const MW_FINAL:usize=129;
+pub const MW_HASH:usize=194;
+pub fn mw_copy(out:[]u8,src:[]const u8)->void { var i:usize=0;while(i<src.len and i<out.len) {out[i]=src[i];i=i+1;} }
+pub fn mw_replay_ok(high:u64,mask:u64,seq:u64)->bool {
+ if(seq==0) {return false;}if(seq>high){return true;}
+ const d:u64=high-seq;return d<64 and (mask&(@as(u64,1)<<@as(u32,@intCast(d))))==0;
+}
+pub fn mw_fresh(now:u64,expiry:u64)->bool {
+ if(expiry==0){return false;}return if(expiry>=now) expiry-now<=12000 else now-expiry<=2000;
+}
+pub fn mw_ttl_ok(ttl:u8,hops:u8)->bool { return ttl>=1 and ttl<=4 and hops>=1 and hops<=ttl; }
+test authenticated_mesh_windows_expiry_and_ttl_are_bounded {
+ assert MW_BASE+MW_HOPS*MW_PROOF+MW_BODY==MW_MAX and MW_MAX<4096;
+ assert mw_replay_ok(0,0,1);assert !mw_replay_ok(1,1,1);
+ assert mw_fresh(3000,13000);assert mw_fresh(3000,1000);assert !mw_fresh(3000,15001);assert !mw_fresh(3000,999);
+ assert mw_ttl_ok(1,1);assert mw_ttl_ok(4,3);assert !mw_ttl_ok(1,2);assert !mw_ttl_ok(5,1);
+}
+
+pub fn mw_replay_mask(high:u64,mask:u64,seq:u64)->u64 {
+ if(!mw_replay_ok(high,mask,seq)){return mask;}
+ if(seq>high){const d:u64=seq-high;return if(d>=64) 1 else (mask<<@as(u32,@intCast(d)))|1;}
+ return mask|(@as(u64,1)<<@as(u32,@intCast(high-seq)));
+}
+pub fn mw_direction(origin:[]const u8,final:[]const u8)->u8 {
+ var i:usize=0;while(i<65 and i<origin.len and i<final.len){if(origin[i]<final[i]){return 0;}if(origin[i]>final[i]){return 1;}i=i+1;}return 2;
+}
+pub fn mw_length(packet:[]const u8)->usize {if(packet.len<12){return 0;}return @as(usize,packet[10])+@as(usize,packet[11])*256;}
+pub fn mw_at(index:usize)->usize {return if(index>=1 and index<=4) MW_BASE+(index-1)*MW_PROOF else MW_MAX;}
+pub fn mw_payload_at(packet:[]const u8)->usize {if(packet.len<8){return 0;}return MW_BASE+@as(usize,packet[7])*MW_PROOF;}
+pub fn mw_zero(bytes:[]const u8)->bool {var i:usize=0;while(i<bytes.len){if(bytes[i]!=0){return false;}i=i+1;}return true;}
+pub fn mw_shape(packet:[]const u8,now:u64)->bool {
+ if(packet.len<MW_BASE+MW_PROOF or packet.len>MW_MAX){return false;}
+ if(packet[0]!=84 or packet[1]!=50 or packet[2]!=55 or packet[3]!=77 or packet[4]!=1 or packet[5]<1 or packet[5]>3){return false;}
+ if(!mw_ttl_ok(packet[6],packet[7]) or !mw_fresh(now,get_u64(packet,24)) or get_u64(packet,16)==0){return false;}
+ const n:usize=mw_length(packet);if(n>MW_BODY or packet.len!=mw_payload_at(packet)+n){return false;}
+ if(packet[MW_ORIGIN]!=4 or packet[MW_FINAL]!=4 or mw_direction(packet[MW_ORIGIN..MW_ORIGIN+65],packet[MW_FINAL..MW_FINAL+65])!=packet[9]){return false;}
+ if(!mw_zero(packet[13..16]) or !mw_zero(packet[226..240]) or mw_zero(packet[32..48]) or mw_zero(packet[48..64])){return false;}
+ if(packet[5]==3){return packet[12]==0 and (packet[8]==1 or packet[8]==2) and n>=52;}
+ return packet[12]<=1 and packet[6]==1 and packet[7]==1 and packet[8]==0 and n==0;
+}
+pub fn mw_canonical(packet:[]const u8,index:usize,out:[]u8)->bool {
+ if(out.len<128 or packet.len<MW_BASE+MW_PROOF or index==0 or index>@as(usize,packet[7]) or index>4){return false;}
+ const at:usize=mw_at(index);if(at+MW_PROOF>packet.len){return false;}
+ ck_wipe(out[0..128]);mw_copy(out[0..16],"T27-MESH-HOP-V1\x00");
+ var immutable:[MW_BASE]u8=undefined;mw_copy(immutable[0..MW_BASE],packet[0..MW_BASE]);immutable[7]=0;
+ if(!ks_sha256(immutable[0..MW_BASE],out[16..48]) or !ks_sha256(packet[MW_BASE..at],out[48..80]) or !ks_sha256(packet[at..at+171],out[80..112])){return false;}
+ var digest:[32]u8=undefined;if(!ks_sha256(packet[at..at+65],digest[0..32])){return false;}mw_copy(out[112..128],digest[0..16]);return true;
+}
+pub fn mw_signable(canonical:[]const u8,own:[]const u8)->bool {
+ if(canonical.len!=128 or own.len!=65 or own[0]!=4 or !ck_same(canonical[0..16],"T27-MESH-HOP-V1\x00")){return false;}
+ var digest:[32]u8=undefined;return ks_sha256(own,digest[0..32]) and ck_same(canonical[112..128],digest[0..16]);
+}
+pub fn mw_seen(packet:[]const u8,key:[]const u8)->bool {
+ if(packet.len<MW_BASE or key.len!=65){return true;}var i:usize=1;
+ while(i<=@as(usize,packet[7]) and i<=4){const at:usize=mw_at(i);if(at+65>packet.len){return true;}if(ck_same(packet[at..at+65],key)){return true;}i=i+1;}return false;
+}
+pub fn mw_verify(packet:[]const u8,own:[]const u8,now:u64)->bool {
+ if(!mw_shape(packet,now) or own.len!=65){return false;}
+ const hops:usize=@as(usize,packet[7]);const last:usize=mw_at(hops);
+ if(!ck_same(packet[last+65..last+130],own) or !ck_same(packet[MW_BASE..MW_BASE+65],packet[MW_ORIGIN..MW_ORIGIN+65])){return false;}
+ if(packet[5]!=3 and !ck_same(packet[MW_FINAL..MW_FINAL+65],own)){return false;}
+ var digest:[32]u8=undefined;const payload:usize=mw_payload_at(packet);
+ if(!ks_sha256(packet[payload..packet.len],digest[0..32]) or !ck_same(digest[0..32],packet[MW_HASH..MW_HASH+32])){return false;}
+ var i:usize=1;
+ while(i<=hops){
+  const at:usize=mw_at(i);const n:usize=@as(usize,packet[at+171]);
+  if(packet[at]!=4 or packet[at+65]!=4 or packet[at+170]!=@as(u8,@intCast(i)) or n<8 or n>80 or !mw_zero(packet[at+172+n..at+MW_PROOF])){return false;}
+  if(i>1){const before:usize=mw_at(i-1);if(!ck_same(packet[before+65..before+130],packet[at..at+65]) or !ck_same(packet[before+146..before+162],packet[at+130..at+146])){return false;}}
+  var j:usize=1;while(j<=i){const before:usize=mw_at(j);if(ck_same(packet[before..before+65],packet[at+65..at+130])){return false;}j=j+1;}
+  var canonical:[128]u8=undefined;if(!mw_canonical(packet,i,canonical[0..128]) or !ks_verify(packet[at..at+65],canonical[0..128],packet[at+172..at+172+n])){return false;}
+  i=i+1;
+ }
+ return true;
+}
+pub fn mw_begin(out:[]u8,kind:u8,ttl:u8,channel:u8,seq:u64,expiry:u64,circuit:[]const u8,epoch:[]const u8,origin:[]const u8,final:[]const u8,body:[]const u8)->usize {
+ if(body.len>MW_BODY){return 0;}
+ const n:usize=MW_BASE+MW_PROOF+body.len;
+ if(out.len<n or circuit.len!=16 or epoch.len!=16 or origin.len!=65 or final.len!=65 or !mw_ttl_ok(ttl,1)){return 0;}
+ ck_wipe(out[0..n]);out[0]=84;out[1]=50;out[2]=55;out[3]=77;out[4]=1;out[5]=kind;out[6]=ttl;out[7]=1;out[8]=channel;out[9]=mw_direction(origin,final);
+ out[10]=@as(u8,@intCast(body.len&255));out[11]=@as(u8,@intCast(body.len/256));put_u64(out,16,seq);put_u64(out,24,expiry);
+ mw_copy(out[32..48],circuit);mw_copy(out[48..64],epoch);mw_copy(out[MW_ORIGIN..MW_ORIGIN+65],origin);mw_copy(out[MW_FINAL..MW_FINAL+65],final);
+ if(!ks_sha256(body,out[MW_HASH..MW_HASH+32])){return 0;}mw_copy(out[MW_BASE+MW_PROOF..n],body);return n;
+}
+pub fn mw_proof(out:[]u8,index:usize,sender:[]const u8,target:[]const u8,send_epoch:[]const u8,recv_epoch:[]const u8,seq:u64)->bool {
+ if(index<1 or index>4){return false;}
+ const at:usize=mw_at(index);if(out.len<at+MW_PROOF or sender.len!=65 or target.len!=65 or send_epoch.len!=16 or recv_epoch.len!=16 or seq==0){return false;}
+ ck_wipe(out[at..at+MW_PROOF]);mw_copy(out[at..at+65],sender);mw_copy(out[at+65..at+130],target);mw_copy(out[at+130..at+146],send_epoch);mw_copy(out[at+146..at+162],recv_epoch);put_u64(out,at+162,seq);out[at+170]=@as(u8,@intCast(index));return true;
+}
+pub fn mw_append(packet:[]u8,n:usize,sender:[]const u8,target:[]const u8,send_epoch:[]const u8,recv_epoch:[]const u8,seq:u64)->usize {
+ if(sender.len!=65 or target.len!=65 or send_epoch.len!=16 or recv_epoch.len!=16 or seq==0){return 0;}
+ if(n>packet.len or n<MW_BASE+MW_PROOF or n>MW_MAX-MW_PROOF or packet[7]<1 or packet[7]>=packet[6] or packet[7]>=4 or n+MW_PROOF>packet.len or mw_seen(packet[0..n],sender) or mw_seen(packet[0..n],target)){return 0;}
+ const previous:usize=mw_at(@as(usize,packet[7]));if(!ck_same(packet[previous+65..previous+130],sender) or !ck_same(packet[previous+146..previous+162],send_epoch)){return 0;}
+ const old:usize=mw_payload_at(packet[0..n]);if(old>n or n-old!=mw_length(packet[0..n]) or n-old>MW_BODY){return 0;}var count:usize=n-old;while(count>0){packet[old+MW_PROOF+count-1]=packet[old+count-1];count=count-1;}
+ packet[7]=packet[7]+1;if(!mw_proof(packet,@as(usize,packet[7]),sender,target,send_epoch,recv_epoch,seq)){return 0;}return n+MW_PROOF;
+}
+pub fn mw_route(final:[]const u8,keys:[]const u8,eligible:[]const u8,explicit_slot:u32)->u32 {
+ if(final.len!=65 or keys.len<260 or eligible.len<4){return 0;}var i:usize=0;var sole:u32=0;var count:u32=0;
+ while(i<4){if(eligible[i]==1){if(ck_same(final,keys[i*65..i*65+65])){return @as(u32,@intCast(i+1));}sole=@as(u32,@intCast(i+1));count=count+1;}i=i+1;}
+ if(explicit_slot!=0){return if(explicit_slot<=4 and eligible[@as(usize,explicit_slot-1)]==1) explicit_slot else 0;}return if(count==1) sole else 0;
+}
+test replay_window_never_reopens_evicted_old_sequences {
+ assert mw_replay_ok(70,1,69);assert !mw_replay_ok(70,1,6);assert !mw_replay_ok(70,3,69);
+ assert mw_replay_mask(1,1,2)==3;assert mw_replay_mask(1,1,100)==1;assert !mw_replay_ok(100,1,1);
+ assert mw_replay_mask(70,1,69)==3;assert mw_replay_mask(70,3,69)==3;
+}
+test routes_prefer_exact_final_neighbors_and_refuse_ambiguous_branches {
+ var keys:[260]u8=undefined;ck_wipe(keys[0..260]);keys[0]=4;keys[65]=4;keys[130]=4;keys[195]=4;
+ keys[1]=1;keys[66]=2;keys[131]=3;keys[196]=4;var final:[65]u8=undefined;ck_wipe(final[0..65]);final[0]=4;final[1]=9;
+ var eligible:[4]u8=undefined;ck_wipe(eligible[0..4]);eligible[1]=1;assert mw_route(final[0..65],keys[0..260],eligible[0..4],0)==2;
+ eligible[2]=1;assert mw_route(final[0..65],keys[0..260],eligible[0..4],0)==0;assert mw_route(final[0..65],keys[0..260],eligible[0..4],2)==2;
+ assert mw_route(keys[130..195],keys[0..260],eligible[0..4],2)==3;
+ eligible[1]=0;assert mw_route(final[0..65],keys[0..260],eligible[0..4],2)==0;
+ assert mw_direction(keys[0..65],keys[65..130])==0;assert mw_direction(keys[65..130],keys[0..65])==1;
+}
+test mesh_signing_domain_is_distinct_and_unopened_messages_are_refused {
+ var zero:[128]u8=undefined;ck_wipe(zero[0..128]);var key:[65]u8=undefined;ck_wipe(key[0..65]);key[0]=4;
+ assert !mw_signable(zero[0..128],key[0..65]);assert !mw_shape(zero[0..128],1000);
+}
+
+test exported_mesh_builders_refuse_bad_bounds_before_mutating {
+ var short:[8]u8=undefined;ck_wipe(short[0..8]);short[0]=99;
+ assert mw_at(0)==MW_MAX;assert !mw_proof(short[0..8],0,short[0..0],short[0..0],short[0..0],short[0..0],1);
+ assert mw_append(short[0..8],8,short[0..0],short[0..0],short[0..0],short[0..0],1)==0;assert short[0]==99;
+ var bad:[MW_MAX]u8=undefined;ck_wipe(bad[0..MW_MAX]);bad[6]=4;bad[7]=3;
+ assert mw_append(bad[0..MW_MAX],MW_BASE+MW_PROOF,bad[0..65],bad[65..130],bad[0..16],bad[0..16],1)==0;
+}
