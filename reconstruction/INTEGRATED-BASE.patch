+use t27os::call_core::get_u64;
+use t27os::call_core::put_u64;
+use t27os::keysync_host::ks_public_valid;
+use t27os::keysync_host::ks_gen_pair;
+use t27os::keysync_host::ks_sign;
+// Native SDK crypto conformance; disposable keys never leave this test.
+fn mc_sign(packet:[]u8,n:usize,key:[]const u8)->bool {
+ const index:usize=@as(usize,packet[7]);const at:usize=mw_at(index);
+ var canonical:[128]u8=undefined;var signature:[80]u8=undefined;
+ if(!mw_canonical(packet[0..n],index,canonical[0..128])){return false;}
+ const len:usize=ks_sign(key,canonical[0..128],signature[0..80]);
+ if(len<8 or len>80){return false;}packet[at+171]=@as(u8,@intCast(len));mw_copy(packet[at+172..at+172+len],signature[0..len]);return true;
+}
+fn mc_crypto_check()->bool {
+ var a:[97]u8=undefined;var ak:[65]u8=undefined;var b:[97]u8=undefined;var bk:[65]u8=undefined;
+ var d:[97]u8=undefined;var dk:[65]u8=undefined;var c:[97]u8=undefined;var ck:[65]u8=undefined;
+ assert ks_gen_pair(a[0..97],ak[0..65]);assert ks_gen_pair(b[0..97],bk[0..65]);assert ks_gen_pair(d[0..97],dk[0..65]);assert ks_gen_pair(c[0..97],ck[0..65]);
+ var epoch:[16]u8=undefined;var circle:[16]u8=undefined;ck_wipe(epoch[0..16]);ck_wipe(circle[0..16]);epoch[0]=1;circle[0]=2;
+ var packet:[MW_MAX]u8=undefined;var body:[MW_BODY]u8=undefined;ck_wipe(body[0..MW_BODY]);body[0]=17;
+ var n:usize=mw_begin(packet[0..MW_MAX],3,4,2,1,9000,circle[0..16],epoch[0..16],ak[0..65],ck[0..65],body[0..MW_BODY]);assert n==2560;
+ assert mw_proof(packet[0..MW_MAX],1,ak[0..65],bk[0..65],epoch[0..16],epoch[0..16],1);assert mc_sign(packet[0..MW_MAX],n,a[0..97]);assert mw_verify(packet[0..n],bk[0..65],1000);
+ n=mw_append(packet[0..MW_MAX],n,bk[0..65],dk[0..65],epoch[0..16],epoch[0..16],2);assert n==2832;assert mc_sign(packet[0..MW_MAX],n,b[0..97]);assert mw_verify(packet[0..n],dk[0..65],1000);
+ n=mw_append(packet[0..MW_MAX],n,dk[0..65],ck[0..65],epoch[0..16],epoch[0..16],3);assert n==3104;assert mc_sign(packet[0..MW_MAX],n,d[0..97]);assert mw_verify(packet[0..n],ck[0..65],1000);
+ assert !mw_verify(packet[0..n],ak[0..65],1000);assert !mw_verify(packet[0..n],ck[0..65],30000);
+ packet[n-1]=1;assert !mw_verify(packet[0..n],ck[0..65],1000);packet[n-1]=0;
+ packet[6]=3;assert !mw_verify(packet[0..n],ck[0..65],1000);packet[6]=4;
+ packet[16]=2;assert !mw_verify(packet[0..n],ck[0..65],1000);packet[16]=1;
+ assert mw_append(packet[0..MW_MAX],n,ck[0..65],ak[0..65],epoch[0..16],epoch[0..16],4)==0;assert packet[7]==3;
+ assert mw_append(packet[0..MW_MAX],n,ck[0..64],bk[0..65],epoch[0..16],epoch[0..16],4)==0;assert packet[7]==3;
+ ck_wipe(a[0..97]);ck_wipe(b[0..97]);ck_wipe(c[0..97]);ck_wipe(d[0..97]);
+ return true;
+}
+
+pub fn main()->i32 {return if(mc_crypto_check()) 0 else 1;}
+fn mc_reachable(run:bool)->i32 {if(run){return main();}return 0;}
+// SDK dlsym needs a native Mach-O object; this gate analyzes entry without interpreter IO.
+test native_crypto_entry_is_analyzed {assert mc_reachable(false)==0;}
