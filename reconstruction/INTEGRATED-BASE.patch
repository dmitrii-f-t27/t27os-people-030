+// ---- 64-key UI labels, packed words and KEYS panel scroll math ----------------------------------------------
+
+/// Slot number label "#1".."#64" for sub-row k (0-based).
+pub fn key_num_label(k: u32, out: []u8) -> usize {
+    if (out.len == 0) { return 0; }
+    out[0] = 35;
+    return put_dec(out, 1, @as(u64, k) + 1);
+}
+
+/// Pack four 16-bit KEYS panel state lanes into one u64 word (TPG_KEYSTATE).
+pub fn keystate_pack(editk: u32, armk: u32, last: u32, kx: u32) -> u64 {
+    return @as(u64, editk & 65535) | (@as(u64, armk & 65535) << 16) | (@as(u64, last & 65535) << 32) | (@as(u64, kx & 65535) << 48);
+}
+
+pub fn keystate_editk(w: u64) -> u32 { return @as(u32, @intCast(w & 65535)); }
+pub fn keystate_armk(w: u64) -> u32 { return @as(u32, @intCast((w >> 16) & 65535)); }
+pub fn keystate_last(w: u64) -> u32 { return @as(u32, @intCast((w >> 32) & 65535)); }
+pub fn keystate_kx(w: u64) -> u32 { return @as(u32, @intCast((w >> 48) & 65535)); }
+
+/// Pack serving and total fleet counts into two 16-bit lanes of one u64 word (TPG_KEYFLEET).
+pub fn keyfleet_pack(serving: u32, total: u32) -> u64 {
+    return @as(u64, serving & 65535) | (@as(u64, total & 65535) << 16);
+}
+
+pub fn keyfleet_serving(w: u64) -> u32 { return @as(u32, @intCast(w & 65535)); }
+pub fn keyfleet_total(w: u64) -> u32 { return @as(u32, @intCast((w >> 16) & 65535)); }
+
+/// Short footer badge "<serving>/<total>"; empty when total is 0.
+pub fn keyfleet_short_text(w: u64, out: []u8) -> usize {
+    const total : u32 = keyfleet_total(w);
+    if (total == 0) { return 0; }
+    var n : usize = put_dec(out, 0, @as(u64, keyfleet_serving(w)));
+    n = put_bytes(out, n, "/");
+    return put_dec(out, n, @as(u64, total));
+}
+
+pub const KY_FOOT_PAD : f64 = 12.0;
+
+/// True when y falls inside the scrollable body below the fixed KEYS header and above the bottom bar.
+pub fn ky_in_body(y: f64, t: f64, bot: f64) -> bool {
+    return y >= t + KY_ROWS_Y and y < bot;
+}
+
+/// Height of the scrollable KEYS viewport.
+pub fn ky_view_h(t: f64, bot: f64) -> f64 {
+    if (bot <= t + KY_ROWS_Y) { return 0.0; }
+    return bot - (t + KY_ROWS_Y);
+}
+
+/// Total scrollable content height of the KEYS body: all provider rows plus footer/chips/devices height.
+pub fn ky_panel_content_h(stored: []const u64, ex: u32, tail_h: f64) -> f64 {
+    return ky_rows_bottom(0.0, stored, ex) - KY_ROWS_Y + tail_h + KY_FOOT_PAD;
+}
+
+/// Maximum vertical scroll offset in whole pixels.
+pub fn ky_scroll_max(content_h: f64, view_h: f64) -> u32 {
+    if (content_h <= view_h) { return 0; }
+    return @as(u32, @intFromFloat(content_h - view_h + 0.999));
+}
+
+/// Clamp `cur + delta` into `[0, ky_scroll_max(content_h, view_h)]`.
+pub fn ky_scroll_clamp(cur: i64, delta: i64, content_h: f64, view_h: f64) -> u32 {
+    const mx : i64 = @as(i64, ky_scroll_max(content_h, view_h));
+    const nx : i64 = cur + delta;
+    if (nx <= 0) { return 0; }
+    if (nx >= mx) { return @as(u32, @intCast(mx)); }
+    return @as(u32, @intCast(nx));
+}
+
+/// Height of the scrollbar thumb (0.0 when everything fits in view_h).
+pub fn ky_thumb_h(content_h: f64, view_h: f64) -> f64 {
+    if (content_h <= view_h or view_h <= 0.0) { return 0.0; }
+    var h : f64 = view_h * view_h / content_h;
+    if (h < 20.0) { h = 20.0; }
+    if (h > view_h) { h = view_h; }
+    return h;
+}
+
+/// Top y of the scrollbar thumb inside `[body_top, body_top + view_h - thumb_h]`.
+pub fn ky_thumb_y(body_top: f64, scroll: u32, content_h: f64, view_h: f64) -> f64 {
+    const mx : u32 = ky_scroll_max(content_h, view_h);
+    if (mx == 0) { return body_top; }
+    const th : f64 = ky_thumb_h(content_h, view_h);
+    var s : u32 = scroll;
+    if (s > mx) { s = mx; }
+    return body_top + (view_h - th) * @as(f64, @floatFromInt(s)) / @as(f64, @floatFromInt(mx));
+}
