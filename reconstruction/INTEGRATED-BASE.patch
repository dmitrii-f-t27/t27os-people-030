+test the_message_sizes_add_up {
+    assert CK_INVITE_LEN == CK_HDR + CK_PUB + CK_HASH;
+    assert CK_ANSWER_LEN == CK_HDR + CK_PUB + CK_NONCE + CK_HASH;
+    assert CK_REVEAL_LEN == CK_HDR + CK_NONCE + CK_HASH;
+    assert CK_TRANSCRIPT_LEN == CK_INVITE_LEN + CK_ANSWER_LEN + CK_REVEAL_LEN;
+    // each message built part by part, the way the session writes it, ends at its length and fits no smaller buffer
+    var fa : [10]u8 = undefined;
+    var fb : [10]u8 = undefined;
+    var sid : [16]u8 = undefined;
+    var pk : [65]u8 = undefined;
+    var nn : [16]u8 = undefined;
+    var hh : [32]u8 = undefined;
+    ck_fill(fa[0..10], 1);
+    ck_fill(fb[0..10], 40);
+    ck_fill(sid[0..16], 80);
+    ck_fill(pk[0..65], 100);
+    ck_fill(nn[0..16], 170);
+    ck_fill(hh[0..32], 190);
+    var b : [CK_ANSWER_LEN]u8 = undefined;
+    // INVITE: the header, the ephemeral public key, the commitment
+    var n : usize = ck_put_header(b[0..CK_ANSWER_LEN], CK_T_INVITE, fa[0..10], fb[0..10], sid[0..16], 1);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, pk[0..65]);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, hh[0..32]);
+    assert n == CK_INVITE_LEN;
+    // ANSWER: the header, the ephemeral public key, N_R, H(INVITE); it fills the buffer, one byte less refuses
+    n = ck_put_header(b[0..CK_ANSWER_LEN], CK_T_ANSWER, fb[0..10], fa[0..10], sid[0..16], 1);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, pk[0..65]);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, nn[0..16]);
+    assert ck_put(b[0..CK_ANSWER_LEN - 1], n, hh[0..32]) == 0;
+    n = ck_put(b[0..CK_ANSWER_LEN], n, hh[0..32]);
+    assert n == CK_ANSWER_LEN;
+    // REVEAL: the header, N_I, H(ANSWER)
+    n = ck_put_header(b[0..CK_ANSWER_LEN], CK_T_REVEAL, fa[0..10], fb[0..10], sid[0..16], 2);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, nn[0..16]);
+    n = ck_put(b[0..CK_ANSWER_LEN], n, hh[0..32]);
+    assert n == CK_REVEAL_LEN;
+}
