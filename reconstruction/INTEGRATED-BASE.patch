new file mode 100644
index 000000000..94b7a06d1
--- /dev/null
+++ b/specs/t27os/queen_chat_cli.t27
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+// Queen's line-oriented native conversation. Codex supplies the authenticated
+// model; the adapter holds only this pane's bounded transcript in memory.
+module T27osQueenChatCli;
+use t27os::pty_sys::sys_write;
+use t27os::pty_sys::sys_read;
+use t27os::pty_sys::sys_close;
+use t27os::pty_sys::sys_execv;
+use t27os::pty_sys::sys_addr;
+use t27os::pty_sys::sys_exit;
+use t27os::pty_sys::sys_waitpid;
+use t27os::pty_sys::sys_open_ro;
+use t27os::pty_sys::sys_poll;
+use t27os::session_store::put_bytes;
+pub fn qc_pipe(p: [2]u32) -> i32 { return @extern("pipe"); }
+pub fn qc_fork() -> i32 { return @extern("fork"); }
+pub fn qc_dup2(a: i32, b: i32) -> i32 { return @extern("dup2"); }
+pub fn qc_time(p: u64) -> u64 { return @extern("time"); }
+pub fn qc_kill(pid: i32, signal: i32) -> i32 { return @extern("kill"); }
+pub fn qc_signal(signal: i32, handler: u64) -> u64 { return @extern("signal"); }
+pub const QC_CAP: usize = 65536;
+pub const QC_ROLE: str = "You are Queen, the T27 OS conversational assistant. Answer the owner in their language. This is a conversation through authenticated Codex, with no orchestration or background agents. Do not use tools, read credentials, modify files, send messages or claim unverified actions. Maintain the supplied conversation context. Be concise and honest.";
+pub const QC_ARGC: usize = 29;
+pub fn qc_arg(i: usize) -> str {
+    if (i == 0) { return "codex"; }
+    if (i == 1) { return "exec"; }
+    if (i == 2) { return "--ignore-user-config"; }
+    if (i == 3) { return "--ignore-rules"; }
+    if (i == 4) { return "--ephemeral"; }
+    if (i == 5) { return "--skip-git-repo-check"; }
+    if (i == 6) { return "--color"; }
+    if (i == 7) { return "never"; }
+    if (i == 8) { return "--disable"; }
+    if (i == 9) { return "shell_tool"; }
+    if (i == 10) { return "--disable"; }
+    if (i == 11) { return "unified_exec"; }
+    if (i == 12) { return "--disable"; }
+    if (i == 13) { return "multi_agent"; }
+    if (i == 14) { return "--disable"; }
+    if (i == 15) { return "multi_agent_v2"; }
+    if (i == 16) { return "--disable"; }
+    if (i == 17) { return "plugins"; }
+    if (i == 18) { return "--disable"; }
+    if (i == 19) { return "apps"; }
+    if (i == 20) { return "-m"; }
+    if (i == 21) { return "gpt-6.2-sol"; }
+    if (i == 22) { return "-s"; }
+    if (i == 23) { return "read-only"; }
+    if (i == 24) { return "-c"; }
+    if (i == 25) { return "project_doc_max_bytes=0"; }
+    if (i == 26) { return "-c"; }
+    if (i == 27) { return "developer_instructions=\"You are Queen, the T27 OS conversational assistant. Never use tools. No orchestration is running. Answer in the user language.\""; }
+    if (i == 28) { return "-"; }
+    return "";
+}
+pub fn qc_execvp(file: []const u8, argv: [32]u64) -> i32 { return @extern("execvp"); }
+pub fn qc_say(s: []const u8) -> void { sys_write(1, s, s.len as u64); }
+pub fn qc_append(out: []u8, n: usize, s: []const u8) -> usize {
+    if (n + s.len > out.len) { return n; }
+    return put_bytes(out, n, s);
+}
+/// The child sees only the transcript on stdin. No prompt or credential in argv.
+pub fn qc_answer(history: []const u8, answer: []u8) -> usize {
+    var input: [2]u32 = undefined;
+    var output: [2]u32 = undefined;
+    if (qc_pipe(input) != 0) { qc_say("Queen unavailable: input pipe failed.\n"); return 0; }
+    if (qc_pipe(output) != 0) { sys_close(input[0] as i32); sys_close(input[1] as i32); qc_say("Queen unavailable: output pipe failed.\n"); return 0; }
+    const pid: i32 = qc_fork();
+    if (pid == 0) {
+        qc_dup2(input[0] as i32, 0);
+        qc_dup2(output[1] as i32, 1);
+        const err: i32 = sys_open_ro("/dev/null", 1);
+        if (err >= 0) { qc_dup2(err, 2); sys_close(err); }
+        sys_close(input[0] as i32); sys_close(input[1] as i32);
+        sys_close(output[0] as i32); sys_close(output[1] as i32);
+        var text: [2048]u8 = undefined; var argv: [32]u64 = undefined;
+        var at: usize = 0; var ai: usize = 0;
+        while (ai < QC_ARGC) {
+            argv[ai] = sys_addr(text[at..2048], text[at..2048], 0);
+            at = put_bytes(text[0..2048], at, qc_arg(ai)); text[at] = 0;
+            at = at + 1; ai = ai + 1;
+        }
+        argv[QC_ARGC] = 0;
+        qc_execvp(text[0..2048], argv); sys_exit(127);
+    }
+    sys_close(input[0] as i32); sys_close(output[1] as i32);
+    if (pid < 0) { sys_close(input[1] as i32); sys_close(output[0] as i32); qc_say("Queen unavailable: could not start backend.\n"); return 0; }
+    var sent: usize = 0;
+    while (sent < history.len) {
+        const w: i64 = sys_write(input[1] as i32, history[sent..history.len], (history.len - sent) as u64);
+        if (w <= 0) { break; } sent = sent + w as usize;
+    }
+    sys_close(input[1] as i32);
+    var n: usize = 0; var buf: [1024]u8 = undefined;
+    var pollfd: [8]u8 = undefined;
+    var pi: usize = 0; while (pi < 8) { pollfd[pi] = 0; pi = pi + 1; }
+    pollfd[0] = (output[0] % 256) as u8; pollfd[1] = (output[0] / 256 % 256) as u8; pollfd[4] = 1;
+    const started: u64 = qc_time(0);
+    var overflow: bool = false;
+    var reading: bool = true;
+    while (reading) {
+        const event: i32 = sys_poll(pollfd[0..8], 1, 1000);
+        if (qc_time(0) >= started + 120) {
+            qc_kill(pid, 15); sys_close(output[0] as i32);
+            var killed: [2]u32 = undefined; sys_waitpid(pid, killed, 0);
+            qc_say("Queen unavailable: model request timed out after 120 seconds.\n"); return 0;
+        }
+        if (event > 0) {
+            const r: i64 = sys_read(output[0] as i32, buf[0..1024], 1024);
+            if (r <= 0) { reading = false; }
+            else if (n + r as usize <= answer.len) { n = put_bytes(answer, n, buf[0..r as usize]); }
+            else { overflow = true; }
+        }
+    }
+    sys_close(output[0] as i32);
+    var status: [2]u32 = undefined; status[0] = 0; status[1] = 0;
+    sys_waitpid(pid, status, 0);
+    if (overflow or status[0] != 0 or n == 0 or sent != history.len) {
+        if (status[0] / 256 == 127) { qc_say("Queen unavailable: Codex CLI is missing from PATH.\n"); }
+        else { qc_say("Queen unavailable: model request failed. Check Codex sign-in or connectivity, then retry.\n"); }
+        return 0;
+    }
+    return n;
+}
+pub fn main() -> void {
+    qc_signal(13, 1);
+    qc_say("QUEEN | Codex gpt-6.2-sol | read-only\nNo orchestration. Messages go to the configured cloud model.\nReady. Type a message and press Return.\n");
+    var history: [65536]u8 = undefined; var answer: [32768]u8 = undefined; var line: [4096]u8 = undefined; var byte: [1]u8 = undefined;
+    var hn: usize = put_bytes(history[0..65536], 0, QC_ROLE);
+    var ln: usize = 0;
+    while (sys_read(0, byte[0..1], 1) > 0) {
+        const b: u8 = byte[0];
+        if (b == 10 or b == 13) {
+            if (ln > 0) {
+                if (hn + ln + 32792 >= QC_CAP) { qc_say("Conversation capacity reached. Open a new Queen session.\n"); sys_exit(0); }
+                const before: usize = hn;
+                hn = qc_append(history[0..65536], hn, "\nOwner: ");
+                hn = qc_append(history[0..65536], hn, line[0..ln]);
+                hn = qc_append(history[0..65536], hn, "\nQueen: ");
+                qc_say("\nQueen is thinking...\n");
+                const an: usize = qc_answer(history[0..hn], answer[0..32768]);
+                if (an > 0) { qc_say("Queen: "); qc_say(answer[0..an]); qc_say("\n"); hn = qc_append(history[0..65536], hn, answer[0..an]); }
+                else { hn = before; }
+                ln = 0; qc_say("Ready.\n");
+            }
+        } else if (b >= 32 and b != 127 and ln < 4096) { line[ln] = b; ln = ln + 1; }
+    }
+    sys_exit(0);
+}
+test transcript_append_is_bounded {
+    var out: [16]u8 = undefined;
+    assert qc_append(out[0..16], 0, "Owner: ") == 7;
+    assert qc_append(out[0..16], 15, "Queen") == 15;
+    assert QC_ARGC == 29;
+    assert qc_arg(28) == "-";
+    assert QC_ROLE.len > 100;
+}
