+    assert first_of(ss, 9, 0) == 7;
+    assert ss % 72057594037927936 == old;
+    var layout : u64 = 0;
+    i = 0;
+    while (i < 8) { layout = task_write(layout, i, 128 + 2 * i); i = i + 1; }
+    assert task_layout_ok(ss, layout);
+    assert task_id(layout, 7) == 142;
+    assert task_find(layout, 142) == 7;
+    assert task_id(task_remove(layout, 0), 6) == 142;
+    assert remove_session(ss, 7) == old;
+}
