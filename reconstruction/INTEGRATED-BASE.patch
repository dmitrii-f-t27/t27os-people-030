+/// App-owned memory pairing. The public key must hash to the actual peer fingerprint;
+/// signed transcript proof and explicit SAS remain mandatory. No file pin adapter.
+pub fn cs_pair_card(s: []u8, public_key: []const u8) -> bool {
+    if (!cs_live(s) or public_key.len != 65 or public_key[0] != 4 or cs_state(s) != CK_IDLE) { return false; }
+    var fp : [10]u8 = undefined; if (!ih_fingerprint(public_key,fp[0..10])) { return false; }
+    ck_put(s,CS_NET+CN_LOCAL_PUBLIC,public_key); ck_put(s,CS_NET+CN_LOCAL_FP,fp[0..10]); s[CS_NET+CN_LOCAL_MODE]=1;s[CS_NET+CN_LOCAL_CARD]=1; return true;
+}
