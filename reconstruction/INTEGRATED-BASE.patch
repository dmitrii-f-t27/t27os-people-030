+        const result:u64=lu_new("NSMutableString");lu_m1(result,lu_sel("appendString:"),sc_card(p));
+        lu_m1(result,lu_sel("appendString:"),lu_cf("|"));lu_m1(result,lu_sel("appendString:"),explicit);
+        lu_m1(result,lu_sel("appendString:"),lu_cf(if(lu_mobile(self)) "|49902" else "|49901"));return result;
+    }
+    var candidates:[145]u8=undefined;
