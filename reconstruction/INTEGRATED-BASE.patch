+    var lb : [16296]u8 = undefined;
+    var asm : [8064]u8 = undefined;
+    assert cl_init(la[0..T_LOG], T_B[0..10], T_CAP) and cl_init(lb[0..T_LOG], T_A[0..10], T_CAP);
+    ck_wipe(asm[0..CA_LEN]);
+    var t : [1500]u8 = undefined;
+    t_fill(t[0..1500], 1500, 8);
+    assert cl_out_add(la[0..T_LOG], t[0..1500], 30) == 1;
+    const order : [3]u32 = [0, 1, 2];
+    assert t_carry(la[0..T_LOG], 0, lb[0..T_LOG], asm[0..CA_LEN], order[0..3]) == CH_RX_NEW;
+    assert t_zero(asm[0..CA_LEN]);
+    // two parts that do not join into UTF-8 (the first ends inside a Cyrillic letter, the second is ASCII)
+    var a : [700]u8 = undefined;
+    t_fill(a[0..700], 700, 2);
+    a[699] = 208;
+    const b : [1]u8 = [97];
+    var p : [720]u8 = undefined;
+    var n : usize = ch_put_part(p[0..720], 5, 0, 2, 40, a[0..700]);
+    assert ch_rx_text(lb[0..T_LOG], asm[0..CA_LEN], p[0..n]) == CH_RX_PART;
+    assert t_zero(asm[0..CA_LEN]) == false;
+    n = ch_put_part(p[0..720], 5, 1, 2, 40, b[0..1]);
+    assert ch_rx_text(lb[0..T_LOG], asm[0..CA_LEN], p[0..n]) == CH_RX_BAD;
+    assert t_zero(asm[0..CA_LEN]);
+}
