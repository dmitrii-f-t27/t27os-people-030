+fn t_deliver(log: []u8, asm: []u8, floors: []u8, me: u32, sender: []const u8, sidx: u32, msg: u32, time: u64, text: []const u8) -> u32 {
+    var r : u32 = CH_RX_BAD;
+    const parts : u32 = ch_parts_for(text.len);
+    var k : u32 = 0;
+    while (k < parts) {
+        var p : [738]u8 = undefined;
+        const n : usize = gm_put_text(p[0..738], T_DIGEST[0..8], sender, msg, k, time, text);
+        r = gl_rx_text(log, asm, floors, me, sidx, p[0..n]);
+        k = k + 1;
+    }
+    return r;
+}
