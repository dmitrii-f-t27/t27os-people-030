+// Read-only service adapter boundary. Authority must come from the real server
+// verifier + device enrollment verifier, never a client body or a local UID.
+pub fn as_service_read(store: []const u64, authority: []const u64, target: u64, now: u64, out: []u8, http_status: []u32) -> usize {
+    if (http_status.len == 0) { as_wipe(out); return 0; }
+    http_status[0] = as_read(store, authority, target, now);
+    if (http_status[0] != AS_OK) { as_wipe(out); return 0; }
+    return as_render(store, authority, target, now, out);
+}
+// Plain read-only renderer shared by native text hosts and generated mobile/web
+// consumers. All strings are allowlisted; untrusted aliases/errors are absent.
+pub fn as_render_text(store: []const u64, authority: []const u64, target: u64, now: u64, out: []u8) -> usize {
+    as_wipe(out);
+    if (as_read(store, authority, target, now) != AS_OK) { return 0; }
+    const at : usize = as_slot(store, target) * AS_STRIDE;
+    var n : usize = as_copy(out, 0, as_device_alias(store[at + 2]));
+    n = as_copy(out, n, " - device-reported account snapshot\nRevision "); n = as_decimal(out, n, store[at + 3]);
+    n = as_copy(out, n, " | updated "); n = as_decimal(out, n, store[at + 4]); n = as_copy(out, n, "\nNVIDIA key count: ");
+    if (store[at + 7] == AS_COUNT_UNKNOWN) { n = as_copy(out, n, "not measured"); } else { n = as_decimal(out, n, store[at + 7]); }
+    n = as_copy(out, n, " | Z.AI key count: ");
+    if (store[at + 8] == AS_COUNT_UNKNOWN) { n = as_copy(out, n, "not measured"); } else { n = as_decimal(out, n, store[at + 8]); }
+    n = as_copy(out, n, "\n\n");
+    var i : usize = 0;
+    while (i < AS_PROVIDERS) {
+        n = as_copy(out, n, as_provider_id(i)); n = as_copy(out, n, ": ");
+        n = as_copy(out, n, as_status_label(store[at + 10 + i * 2], store[at + 11 + i * 2])); n = as_copy(out, n, "\n");
+        i = i + 1;
+    }
+    if (n > out.len) { as_wipe(out); return 0; } return n;
+}
