+    s[EP_ROLE] = 1;
+    assert csg_list_keep(s[0..CS_LEN], l[0..n]) == GR_LR_NOT_INITIATOR;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == 0 and cg(s[0..CS_LEN], LG_L_NOINIT) == 1;
+    // the peer called me but is not a trusted friend (no verified proof of the stored key): refused
+    s[EP_ROLE] = 0;
+    s[CS_ID + CI_OK] = 0;
+    assert csg_list_keep(s[0..CS_LEN], l[0..n]) == GR_LR_UNTRUSTED;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == 0 and cg(s[0..CS_LEN], LG_L_UNTRUST) == 1;
+    s[CS_ID + CI_OK] = 1;
+    s[CS_ID + CI_SAME] = 0;
+    assert csg_list_keep(s[0..CS_LEN], l[0..n]) == GR_LR_UNTRUSTED;
+    assert cg(s[0..CS_LEN], LG_LIST_LEN) == 0 and cg(s[0..CS_LEN], LG_L_UNTRUST) == 2;
+    // nine members: refused before anything else
+    var big : [160]u8 = undefined;
