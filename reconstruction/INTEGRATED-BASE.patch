+        count=count+1;
+        value=value/10;
+        if(value==0) {
+            break;
+        }
+    }
+    while(count>0) {
+        count=count-1;
+        head[at]=digits[count];
+        at=at+1;
+    }
+    head[at]=13;
+    head[at+1]=10;
+    at=at+2;
+    at=qp_line(head[0..512],at,"Connection: close");
