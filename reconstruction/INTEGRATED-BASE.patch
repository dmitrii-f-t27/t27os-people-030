+    t_log(log[0..T_LOG]);
+    const x : [1]u8 = [120];
+    // three own lines written out of order, without placing: times 300, 100, 200
+    assert cl_out_add(log[0..T_LOG], x[0..1], 300) == 1;
+    assert cl_out_add(log[0..T_LOG], x[0..1], 100) == 2;
+    assert cl_out_add(log[0..T_LOG], x[0..1], 200) == 3;
+    assert gl_after(log[0..T_LOG], 0, 1, 0) and gl_after(log[0..T_LOG], 1, 0, 0) == false;
