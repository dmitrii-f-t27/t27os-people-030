+    while (i < 8) { ss = add_session(ss, 0, i % 6); i = i + 1; }
+    assert !card_can_open(ss, 9, 0);
+    assert card_can_open(ss, 0, 0);
+    assert card_can_open(ss, AGENT_QUEEN, 0);
+    assert add_session(ss, 9, 0) == ss;
+}
