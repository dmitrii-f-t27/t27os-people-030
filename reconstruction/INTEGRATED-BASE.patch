+++ b/specs/std/mem.t27
@@ -17,6 +17,27 @@
 
 module std::mem;
 
+/// Fill exactly the supplied byte span; callers choose the value.
+pub fn bytes_fill(x: []u8, value: u8) -> void {
+    var k : usize = 0;
+    while (k < x.len) {
+        x[k] = value;
+        k = k + 1;
+    }
+}
+
+test fill_preserves_sentinels_and_handles_empty_and_zero {
+    var b : [5]u8 = [1, 2, 3, 4, 5];
+    bytes_fill(b[1..4], 17);
+    assert b[0] == 1 and b[4] == 5;
+    assert b[1] == 17 and b[2] == 17 and b[3] == 17;
+    bytes_fill(b[2..2], 99);
+    assert b[2] == 17;
+    bytes_fill(b[1..4], 0);
+    assert b[1] == 0 and b[2] == 0 and b[3] == 0;
+    assert b[0] == 1 and b[4] == 5;
+}
+
 /// The two runs have the same length and the same bytes.
 pub fn bytes_eq(x: []const u8, y: []const u8) -> bool {
     if (x.len != y.len) { return false; }
diff --git a/specs/t27os/account_connector.t27 b/specs/t27os/account_connector.t27
new file mode 100644
index 000000000..a623a764f
--- /dev/null
+++ b/specs/t27os/account_connector.t27
@@ -0,0 +1,81 @@
+use t27os::personal_account_host::pa3_executable;
+use t27os::personal_account_host::pa3_take_request;
+use t27os::personal_account::PA3_USE;
+use t27os::personal_account::PA3_CONNECT;
+// SPDX-License-Identifier: Apache-2.0
+// Native interactive connector. No command interpreter or generated script.
+use t27os::personal_account::account_launch_kind;
+fn ca3_class_named(name: u64) -> u64 { return @extern("NSClassFromString"); }
+fn ca3_selector(name: u64) -> u64 { return @extern("NSSelectorFromString"); }
+fn ca3_string(alloc: u64, bytes: []const u8, n: usize, enc: u32, ext: bool) -> u64 { return @extern("CFStringCreateWithBytes"); }
+fn ca3_msg0(o: u64, s: u64) -> u64 { return @extern("objc_msgSend"); }
+fn ca3_msg1(o: u64, s: u64, a: u64) -> u64 { return @extern("objc_msgSend"); }
+fn ca3_copy_str(o: u64, s: u64, bytes: []u8, n: u64, enc: u64) -> bool { return @extern("objc_msgSend"); }
+fn ca3_exec_native(path: u64, args: [6]u64) -> i32 { return @extern("execv"); }
+fn ca3_marker_write(fd: i32, bytes: []const u8, n: u64) -> i64 { return @extern("write"); }
+fn ca3_marker_close(fd: i32) -> i32 { return @extern("close"); }
+fn ca3_tty(fd: i32) -> i32 { return @extern("isatty"); }
+fn ca3_exit_process(code: i32) -> void { @extern("exit"); }
+fn ca3_print_line(text: u64) -> i32 { return @extern("puts"); }
+fn ca3_cf(s: []const u8) -> u64 { return ca3_string(0, s, s.len, 134217984, false); }
+fn ca3_cls(s: []const u8) -> u64 { return ca3_class_named(ca3_cf(s)); }
+fn ca3_sel(s: []const u8) -> u64 { return ca3_selector(ca3_cf(s)); }
+fn ca3_ptr(s: []const u8) -> u64 { return ca3_msg0(ca3_cf(s), ca3_sel("UTF8String")); }
+pub fn connector_is_interactive() -> bool { return ca3_tty(0) != 0 and ca3_tty(1) != 0; }
+pub fn connector_args_ok(argc: u64, kind: u32, interactive: bool) -> bool { return argc == 1 and (kind == 0 or kind == 1 or kind == 3 or kind == 4) and interactive; }
+pub fn connector_invoke(kind: u32, help_only: bool) -> i32 {
+    var provider : []const u8 = "claude";
+    if (kind == 1) { provider = "codex"; }
+    if (kind == 3) { provider = "opencode"; }
+    if (kind == 4) { provider = "devin"; }
+    var argv : [6]u64 = undefined;
+    const path : u64 = pa3_executable(5);
+    if (path == 0) { return -1; }
+    argv[0] = ca3_msg0(path, ca3_sel("UTF8String"));
+    argv[1] = ca3_ptr("account");
+    argv[2] = ca3_ptr("add");
+    argv[3] = ca3_ptr("--agent");
+    argv[4] = ca3_ptr(provider);
+    argv[5] = 0;
+    if (help_only) { argv[3] = ca3_ptr("--help"); argv[4] = 0; }
+    return ca3_exec_native(argv[0], argv);
+}
+pub fn connector_use(kind: u32, help_only: bool) -> i32 {
+    const path : u64 = pa3_executable(kind);
+    if (path == 0) { return -1; }
+    var argv : [6]u64 = undefined;
+    argv[0] = ca3_msg0(path, ca3_sel("UTF8String"));
+    argv[1] = 0; argv[2] = 0; argv[3] = 0; argv[4] = 0; argv[5] = 0;
+    if (help_only) { argv[1] = ca3_ptr("--help"); }
+    return ca3_exec_native(argv[0], argv);
+}
+pub fn main() -> void {
+    ca3_msg0(ca3_cls("NSAutoreleasePool"), ca3_sel("new"));
+    const args : u64 = ca3_msg0(ca3_msg0(ca3_cls("NSProcessInfo"), ca3_sel("processInfo")), ca3_sel("arguments"));
+    const argc : u64 = ca3_msg0(args, ca3_sel("count"));
+    const name : u64 = ca3_msg0(ca3_msg1(args, ca3_sel("objectAtIndex:"), 0), ca3_sel("lastPathComponent"));
+    var bytes : [128]u8 = undefined;
+    // NSString length is read using the correctly typed one-argument encoding method.
+    const length : u64 = ca3_msg1(name, ca3_sel("lengthOfBytesUsingEncoding:"), 4);
+    if (length >= 128 or ca3_copy_str(name, ca3_sel("getCString:maxLength:encoding:"), bytes[0..128], 128, 4) == false) { ca3_exit_process(64); }
+    const kind : u32 = account_launch_kind(bytes[0 .. @as(usize, @intCast(length))]);
+    if (connector_args_ok(argc, kind, connector_is_interactive()) == false) {
+        ca3_print_line(ca3_ptr("Native connector refused unknown name, arguments or noninteractive session. No provider invoked."));
+        ca3_exit_process(64);
+    }
+    const action : u32 = pa3_take_request(kind);
+    if (action == PA3_USE) { connector_use(kind, false); }
+    else if (action == PA3_CONNECT) { connector_invoke(kind, false); }
+    else { ca3_print_line(ca3_ptr("No current account-window request. Open this agent from Profile > Personal Account. No provider invoked.")); ca3_exit_process(64); }
+    ca3_print_line(ca3_ptr("Could not start official Orca account login. Check Orca is installed. No account changed."));
+    ca3_exit_process(127);
+}
+test connector_requires_an_allowlisted_name_no_extra_arguments_and_a_tty {
+    assert connector_args_ok(1, 0, true);
+    assert connector_args_ok(1, 1, true);
+    assert connector_args_ok(2, 0, true) == false;
+    assert connector_args_ok(1, 99, true) == false;
+    assert connector_args_ok(1, 2, true) == false;
+    assert connector_args_ok(1, 42, true) == false;
+    assert connector_args_ok(1, 0, false) == false;
+}
diff --git a/specs/t27os/account_snapshot.t27 b/specs/t27os/account_snapshot.t27
new file mode 100644
index 000000000..9a01a8040
--- /dev/null
+++ b/specs/t27os/account_snapshot.t27
@@ -0,0 +1,287 @@
+// Canonical sign-in entry from verified trinity signInHref, not the post-login board.
+pub const AS_T27_SIGNIN_URL : str = "https://app.t27.ai/?return=https%3A%2F%2Fapp.t27.ai%2Fqueen%2F%23%2Fqueen";
+pub const AS_T27_BOARD_URL : str = "https://app.t27.ai/queen/";
+pub const AS_T27_HEALTH_URL : str = "https://auth.t27.ai/health";
+// SPDX-License-Identifier: Apache-2.0
+// Draft owner/device read-model. No login, listener or network transport.
+// Authority is supplied ONLY by a real session + enrolled-device verifier in
+// the eventual server adapter. Test authority fixtures are not production auth.
+// Neither owner handles nor device handles are serialized into the reader view.
+pub const AS_DEVICES : usize = 8;
+pub const AS_STRIDE : usize = 32;
+pub const AS_WORDS : usize = 256;
+pub const AS_PROVIDERS : usize = 8;
+pub const AS_TTL_MAX : u64 = 3600;
+pub const AS_COUNT_UNKNOWN : u64 = 65;
+pub const AS_OK : u32 = 200;
+pub const AS_AUTH : u32 = 401;
+pub const AS_DENIED : u32 = 403;
+pub const AS_MISSING : u32 = 404;
+pub const AS_REPLAY : u32 = 409;
+pub const AS_EXPIRED : u32 = 410;
+pub const AS_INVALID : u32 = 422;
+pub const AS_FULL : u32 = 507;
+pub const AS_UNKNOWN : u64 = 0;
+pub const AS_CONFIGURED : u64 = 1;
+pub const AS_SIGNED_IN : u64 = 2;
+pub const AS_RESPONDED : u64 = 3;
+pub const AS_BLOCKED : u64 = 4;
+pub const AS_UNAVAILABLE : u64 = 5;
+pub const AS_SOURCE_NONE : u64 = 0;
+pub const AS_SOURCE_ORCA : u64 = 1;
+pub const AS_SOURCE_SYSTEM : u64 = 2;
+pub const AS_SOURCE_ENV : u64 = 3;
+pub const AS_SOURCE_CREDENTIAL : u64 = 4;
+pub const AS_SOURCE_RESPONSE : u64 = 5;
+pub const AS_SOURCE_QUOTA : u64 = 6;
+pub const AS_SOURCE_CATALOGUE : u64 = 7;
+// Internal slot: owner, enrollment handle, display alias, revision, updated,
+// expires, revoked, NVIDIA count, Z.AI count, reserved, 8*(status,source).
+// Authority: trusted subject, session verified, trusted device, device verified.
+pub fn as_clear(store: []u64) -> void { var i : usize = 0; while (i < store.len) { store[i] = 0; i = i + 1; } }
+pub fn as_authority_ok(authority: []const u64) -> bool {
+    return authority.len == 4 and authority[0] != 0 and authority[1] == 1 and authority[2] != 0 and authority[3] == 1;
+}
+pub fn as_slot(store: []const u64, handle: u64) -> usize {
+    if (store.len != AS_WORDS or handle == 0) { return AS_DEVICES; }
+    var i : usize = 0;
+    while (i < AS_DEVICES) { if (store[i * AS_STRIDE + 1] == handle) { return i; } i = i + 1; }
+    return AS_DEVICES;
+}
+pub fn as_enroll(store: []u64, authority: []const u64, display_alias: u64) -> u32 {
+    if (as_authority_ok(authority) == false) { return AS_AUTH; }
+    if (store.len != AS_WORDS or display_alias < 1 or display_alias > 4) { return AS_INVALID; }
+    const existing : usize = as_slot(store, authority[2]);
+    if (existing < AS_DEVICES) {
+        if (store[existing * AS_STRIDE] != authority[0]) { return AS_DENIED; }
+        if (store[existing * AS_STRIDE + 6] != 0) { return AS_EXPIRED; }
+        return AS_OK;
+    }
+    var i : usize = 0;
+    while (i < AS_DEVICES) {
+        if (store[i * AS_STRIDE + 1] == 0) {
+            store[i * AS_STRIDE] = authority[0]; store[i * AS_STRIDE + 1] = authority[2]; store[i * AS_STRIDE + 2] = display_alias;
+            return AS_OK;
+        }
+        i = i + 1;
+    }
+    return AS_FULL;
+}
+pub fn as_gate(store: []const u64, authority: []const u64, target: u64) -> u32 {
+    if (as_authority_ok(authority) == false) { return AS_AUTH; }
+    const reader : usize = as_slot(store, authority[2]);
+    const device : usize = as_slot(store, target);
+    if (reader >= AS_DEVICES or device >= AS_DEVICES) { return AS_DENIED; }
+    if (store[reader * AS_STRIDE] != authority[0] or store[device * AS_STRIDE] != authority[0]) { return AS_DENIED; }
+    if (store[reader * AS_STRIDE + 6] != 0 or store[device * AS_STRIDE + 6] != 0) { return AS_EXPIRED; }
+    return AS_OK;
+}
+pub fn as_observation_ok(status: u64, source: u64) -> bool {
+    if (status > AS_UNAVAILABLE or source > AS_SOURCE_CATALOGUE) { return false; }
+    if (status == AS_RESPONDED) { return source == AS_SOURCE_RESPONSE; }
+    if (status == AS_CONFIGURED) { return source == AS_SOURCE_ENV or source == AS_SOURCE_CREDENTIAL; }
+    if (status == AS_SIGNED_IN) { return source == AS_SOURCE_SYSTEM or source == AS_SOURCE_ORCA or source == AS_SOURCE_CATALOGUE; }
+    if (status == AS_BLOCKED) { return source == AS_SOURCE_RESPONSE or source == AS_SOURCE_QUOTA; }
+    return true;
+}
+// request: revision,lastUpdated,expiresAt,now,NVIDIA-count,Z.AI-count.
+// observations: one allowlisted status/source pair for each provider ID.
+pub fn as_publish(store: []u64, authority: []const u64, request: []const u64, observations: []const u64) -> u32 {
+    if (as_authority_ok(authority) == false) { return AS_AUTH; }
+    if (request.len != 6 or observations.len != AS_PROVIDERS * 2) { return AS_INVALID; }
+    const gate : u32 = as_gate(store, authority, authority[2]);
+    if (gate != AS_OK) { return gate; }
+    const at : usize = as_slot(store, authority[2]) * AS_STRIDE;
+    if (request[0] <= store[at + 3] or request[1] < store[at + 4]) { return AS_REPLAY; }
+    if (request[1] > request[3]) { return AS_INVALID; }
+    if (request[2] <= request[3] or request[3] - request[1] > AS_TTL_MAX) { return AS_EXPIRED; }
+    if (request[2] - request[3] > AS_TTL_MAX or request[4] > AS_COUNT_UNKNOWN or request[5] > AS_COUNT_UNKNOWN) { return AS_INVALID; }
+    var i : usize = 0;
+    while (i < AS_PROVIDERS) { if (as_observation_ok(observations[i * 2], observations[i * 2 + 1]) == false) { return AS_INVALID; } i = i + 1; }
+    store[at + 3] = request[0]; store[at + 4] = request[1]; store[at + 5] = request[2]; store[at + 7] = request[4]; store[at + 8] = request[5];
+    i = 0;
+    while (i < AS_PROVIDERS * 2) { store[at + 10 + i] = observations[i]; i = i + 1; }
+    return AS_OK;
+}
+pub fn as_read(store: []const u64, authority: []const u64, target: u64, now: u64) -> u32 {
+    const gate : u32 = as_gate(store, authority, target);
+    if (gate != AS_OK) { return gate; }
+    const at : usize = as_slot(store, target) * AS_STRIDE;
+    if (store[at + 3] == 0) { return AS_MISSING; }
+    if (now >= store[at + 5] or now < store[at + 4]) { return AS_EXPIRED; }
+    return AS_OK;
+}
+pub fn as_revoke(store: []u64, authority: []const u64, target: u64) -> u32 {
+    const gate : u32 = as_gate(store, authority, target);
+    if (gate != AS_OK) { return gate; }
+    store[as_slot(store, target) * AS_STRIDE + 6] = 1;
+    return AS_OK;
+}
+pub fn as_provider_id(i: usize) -> []const u8 {
+    if (i == 0) { return "claude"; } if (i == 1) { return "codex"; } if (i == 2) { return "antigravity"; } if (i == 3) { return "opencode"; }
+    if (i == 4) { return "devin"; } if (i == 5) { return "nvidia"; } if (i == 6) { return "zai"; } if (i == 7) { return "zai-coding-plan"; } return "";
+}
+pub fn as_device_alias(i: u64) -> []const u8 { if (i == 1) { return "Mac"; } if (i == 2) { return "iPhone"; } if (i == 3) { return "iPad"; } return "Browser"; }
+pub fn as_status_label(status: u64, source: u64) -> []const u8 {
+    if (status == AS_RESPONDED and source == AS_SOURCE_RESPONSE) { return "Response verified"; }
+    if (source == AS_SOURCE_QUOTA) { if (status == AS_BLOCKED) { return "Quota metadata blocked; response separate"; } return "Quota metadata unavailable; response separate"; }
+    if (source == AS_SOURCE_CATALOGUE) { return "Model catalogue only; response not tested"; }
+    if (status == AS_BLOCKED) { return "Response blocked"; } if (status == AS_UNAVAILABLE) { return "Unavailable observation"; }
+    if (status == AS_CONFIGURED) { return "Configured; response not tested"; } if (status == AS_SIGNED_IN) { return "Login metadata; response not tested"; } return "Not checked";
+}
+pub fn as_copy(out: []u8, at: usize, text: []const u8) -> usize {
+    if (at + text.len > out.len) { return out.len + 1; }
+    var i : usize = 0; while (i < text.len) { out[at + i] = text[i]; i = i + 1; } return at + text.len;
+}
+pub fn as_decimal(out: []u8, at: usize, value: u64) -> usize {
+    var tmp : [20]u8 = undefined; var n : usize = 0; var v : u64 = value;
+    while (v > 0 or n == 0) { tmp[n] = @as(u8, @intCast(v % 10)) + 48; n = n + 1; v = v / 10; }
+    if (at + n > out.len) { return out.len + 1; }
+    var i : usize = 0; while (i < n) { out[at + i] = tmp[n - 1 - i]; i = i + 1; } return at + n;
+}
+// Reused reader rendering: exact same allowlisted view for Mac and phone.
+// No owner, enrollment handle, email, credential or error-blob serializer exists.
+pub fn as_wipe(out: []u8) -> void { var i : usize = 0; while (i < out.len) { out[i] = 0; i = i + 1; } }
+pub fn as_count_render(out: []u8, at: usize, value: u64) -> usize {
+    if (value == AS_COUNT_UNKNOWN) { return as_copy(out, at, "null"); }
+    return as_decimal(out, at, value);
+}
+pub fn as_render(store: []const u64, authority: []const u64, target: u64, now: u64, out: []u8) -> usize {
+    as_wipe(out);
+    if (as_read(store, authority, target, now) != AS_OK) { return 0; }
+    const at : usize = as_slot(store, target) * AS_STRIDE;
+    var n : usize = as_copy(out, 0, "{\"deviceAlias\":\""); n = as_copy(out, n, as_device_alias(store[at + 2]));
+    n = as_copy(out, n, "\",\"revision\":"); n = as_decimal(out, n, store[at + 3]);
+    n = as_copy(out, n, ",\"lastUpdated\":"); n = as_decimal(out, n, store[at + 4]);
+    n = as_copy(out, n, ",\"keyCounts\":{\"nvidia\":"); n = as_count_render(out, n, store[at + 7]);
+    n = as_copy(out, n, ",\"zai\":"); n = as_count_render(out, n, store[at + 8]); n = as_copy(out, n, "},\"providers\":[");
+    var i : usize = 0;
+    while (i < AS_PROVIDERS) {
+        if (i > 0) { n = as_copy(out, n, ","); }
+        n = as_copy(out, n, "{\"provider\":\""); n = as_copy(out, n, as_provider_id(i));
+        n = as_copy(out, n, "\",\"status\":"); n = as_decimal(out, n, store[at + 10 + i * 2]);
+        n = as_copy(out, n, ",\"source\":"); n = as_decimal(out, n, store[at + 11 + i * 2]);
+        n = as_copy(out, n, ",\"label\":\""); n = as_copy(out, n, as_status_label(store[at + 10 + i * 2], store[at + 11 + i * 2])); n = as_copy(out, n, "\"}");
+        i = i + 1;
+    }
+    n = as_copy(out, n, "]}"); if (n > out.len) { as_wipe(out); return 0; } return n;
+}
+
+pub fn as_has(text: []const u8, needle: []const u8) -> bool {
+    if (needle.len == 0 or needle.len > text.len) { return false; }
+    var i : usize = 0;
+    while (i + needle.len <= text.len) {
+        var j : usize = 0;
+        while (j < needle.len and text[i + j] == needle[j]) { j = j + 1; }
+        if (j == needle.len) { return true; }
+        i = i + 1;
+    }
+    return false;
+}
