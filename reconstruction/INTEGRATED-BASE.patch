+    assert fv_row_y(t, FV_ROWS_MAX) <= t + FV_ADD_LABEL_Y;
+    assert t + FV_IFIELD_Y + CV_FIELD_H < t + FV_BTN_Y;
+    assert t + FV_BTN_Y + CV_BTN_H < t + FV_NOTE_Y - 10.0;
+    assert t + FV_NOTE_Y + 28.0 < t + FV_DBG_LABEL_Y;
+    assert t + FV_DFIELD_Y + CV_FIELD_H < t + FV_DCALL_Y;
+    // ALLOW answers only while a public address waits for consent, right of the debug CALL; its row and hint below
+    assert fv_hit(cv_btn_x(l, w, 1) + 4.0, t + FV_DCALL_Y + 4.0, l, w, t, 0, true, false) == FV_H_NONE;
+    assert fv_hit(cv_btn_x(l, w, 1) + 4.0, t + FV_DCALL_Y + 4.0, l, w, t, 0, true, true) == FV_H_DALLOW;
+    assert fv_hit(cv_btn_x(l, w, 1) + 4.0, t + FV_DCALL_Y + 4.0, l, w, t, 0, false, true) == FV_H_NONE;
+    assert fv_hit(cv_btn_x(l, w, 0) + 4.0, t + FV_DCALL_Y + 4.0, l, w, t, 0, true, true) == FV_H_DCALL;
+    assert t + FV_DCALL_Y + CV_BTN_H < t + FV_PUB_Y - 9.0 and FV_PUB_Y < FV_PUBHINT_Y;
+    assert fv_rows_drawn(0) == 0 and fv_rows_drawn(3) == 3 and fv_rows_drawn(8) == FV_ROWS_MAX;
+}
+
+test fv_an_empty_field_shows_a_hint_marked_as_a_hint_and_a_typed_one_shows_none {
+    var o : [40]u8 = undefined;
+    // empty, focused or not (the window draws the caret before it): the hint, led by "e.g. "
+    assert fv_eq(o[0..40], fv_field_hint(0, "192.168.1.10:47727", o[0..40]), "e.g. 192.168.1.10:47727");
+    assert fv_eq(o[0..40], fv_field_hint(0, "T27-XXXX-XXXX-XXXX-XXXX-C", o[0..40]), "e.g. T27-XXXX-XXXX-XXXX-XXXX-C");
+    assert o[0] == 101 and o[1] == 46 and o[2] == 103 and o[3] == 46 and o[4] == 32;
+    // one character typed: no hint at all
+    assert fv_field_hint(1, "192.168.1.10:47727", o[0..40]) == 0;
+    assert fv_field_hint(18, "192.168.1.10:47727", o[0..40]) == 0;
+    // a buffer too short for the prefix and the example is never overrun
+    assert fv_field_hint(0, "192.168.1.10:47727", o[0..20]) == 0;
+}
+
+test fv_get32_reads_little_endian_and_round_trips_put32_at_the_limits {
+    var b : [12]u8 = undefined;
+    b[3] = 1; b[4] = 2; b[5] = 0; b[6] = 0; b[7] = 0;
+    assert fv_get32(b[0..12], 3) == 513;
+    b[3] = 0x78; b[4] = 0x56; b[5] = 0x34; b[6] = 0x12;
+    assert fv_get32(b[0..12], 3) == 0x12345678;
+    b[3] = 255; b[4] = 255; b[5] = 255; b[6] = 255;
+    assert fv_get32(b[0..12], 3) == 4294967295;
+    fv_put32(b[0..12], 7, 0);
+    assert fv_get32(b[0..12], 7) == 0;
+    fv_put32(b[0..12], 7, 4294967296);
+    assert fv_get32(b[0..12], 7) == 4294967295;
+    fv_put32(b[0..12], 0, 0x80000001);
+    assert fv_get32(b[0..12], 0) == 0x80000001;
+    assert b[0] == 1 and b[3] == 0x80;
+}
+
+test fv_hex_gives_lowercase_digits_at_the_boundaries {
+    assert fv_hex(0) == 48;
+    assert fv_hex(9) == 57;
+    assert fv_hex(10) == 97;
+    assert fv_hex(15) == 102;
+}
+
+test fv_check_writes_the_three_byte_check_mark_and_returns_the_next_offset {
+    var b : [8]u8 = undefined;
+    b[0] = 7; b[5] = 9;
+    assert fv_check(b[0..8], 1) == 4;
+    assert b[0] == 7 and b[1] == 226 and b[2] == 156 and b[3] == 147 and b[5] == 9;
+    assert fv_check(b[0..8], 0) == 3;
+    assert b[0] == 226;
+}
+
+test fv_trust_tag_put_writes_the_mark_for_each_state_after_the_given_offset {
+    var o : [40]u8 = undefined;
+    var n : usize = fv_trust_tag_put(o[0..40], 0, FV_T_VERIFIED);
+    assert n == 4 and o[0] == 32 and o[1] == 226 and o[2] == 156 and o[3] == 147;
+    n = fv_trust_tag_put(o[0..40], 2, FV_T_UNVERIFIED);
+    assert fv_eq(o[2..40], n - 2, " not verified");
+    assert n == 2 + 13;
+    n = fv_trust_tag_put(o[0..40], 5, FV_T_MISMATCH);
+    assert fv_eq(o[5..40], n - 5, " key mismatch!");
+    assert n == 5 + 14;
+    // an unknown state reads as not verified
+    n = fv_trust_tag_put(o[0..40], 0, 77);
+    assert fv_eq(o[0..40], n, " not verified");
+}
+
+test fv_in_is_half_open_on_every_edge {
+    assert fv_in(10.0, 20.0, 10.0, 20.0, 5.0, 5.0);
+    assert fv_in(14.9, 24.9, 10.0, 20.0, 5.0, 5.0);
+    assert !fv_in(15.0, 22.0, 10.0, 20.0, 5.0, 5.0);
+    assert !fv_in(12.0, 25.0, 10.0, 20.0, 5.0, 5.0);
+    assert !fv_in(9.9, 22.0, 10.0, 20.0, 5.0, 5.0);
+    assert !fv_in(12.0, 19.9, 10.0, 20.0, 5.0, 5.0);
+    assert !fv_in(12.0, 22.0, 10.0, 20.0, 0.0, 5.0);
+}
diff --git a/specs/t27os/full_app_integration.t27 b/specs/t27os/full_app_integration.t27
new file mode 100644
index 000000000..21a18d6a0
--- /dev/null
+++ b/specs/t27os/full_app_integration.t27
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+module FullAppIntegration;
+use t27os::keys::AGENT_PROVIDERS;
+use t27os::keys::agent_installed;
+use t27os::keys::agent_state;
+use t27os::keys::AS_STOPPED;
+use t27os::agents::AGENT_COUNT;
+use t27os::personal_account::pa3_cli_name;
+
+// Main remains the Carbon dashboard; account routes share its content area.
+pub const FI_MAIN_DASHBOARD:u32=0;
+pub const FI_PERSONAL_ACCOUNT:u32=1;
+pub const FI_COMMUNICATIONS:u32=2;
+pub fn fi_embedded_hit(active:bool,x:f64,y:f64,left:f64,top:f64,width:f64,height:f64)->bool {
+    return active and width>0.0 and height>0.0 and x>=left and x<left+width and y>=top and y<top+height;
+}
+test account_content_does_not_swallow_sidebar_header_or_footer {
+    assert fi_embedded_hit(true,301.0,120.0,300.0,100.0,600.0,500.0);
+    assert !fi_embedded_hit(true,299.0,120.0,300.0,100.0,600.0,500.0);
+    assert !fi_embedded_hit(true,301.0,99.0,300.0,100.0,600.0,500.0);
+    assert !fi_embedded_hit(true,301.0,600.0,300.0,100.0,600.0,500.0);
+    assert !fi_embedded_hit(false,301.0,120.0,300.0,100.0,600.0,500.0);
+}
+test antigravity_public_profile_preserves_master_provider_and_shell_slots {
+    assert AGENT_COUNT==10 and AGENT_PROVIDERS.len==11;
+    assert AGENT_PROVIDERS[9]==0 and AGENT_PROVIDERS[10]==0;
+    assert !agent_installed(0,9) and agent_installed(512,9);
+    assert agent_state(512,9,false,0)==AS_STOPPED;
+    const cli:[]const u8=pa3_cli_name(2);
+    assert cli.len==3 and cli[0]==97 and cli[1]==103 and cli[2]==121;
+}
+// 0 normal app-owned Keychain; 1 explicitly synthetic RAM; 2 refuse before IO.
+pub fn fi_identity_mode(qa:bool,explicit:bool,scoped:bool)->u32 {
+    if(!explicit){return 0;}
+    return if(qa and scoped) 1 else 2;
+}
+test ephemeral_identity_never_changes_the_default_or_falls_back_from_bad_qa {
+    assert fi_identity_mode(false,false,false)==0;
+    assert fi_identity_mode(true,false,true)==0;
+    assert fi_identity_mode(false,true,true)==2;
+    assert fi_identity_mode(true,true,false)==2;
+    assert fi_identity_mode(true,true,true)==1;
+}
+pub fn fi_comms_y(top:f64)->f64 { return top+508.0; }
+pub fn fi_comms_hit(x:f64,y:f64,left:f64,top:f64,width:f64)->bool {
+    return x>=left+20.0 and x<=left+width-20.0 and y>=fi_comms_y(top) and y<=fi_comms_y(top)+28.0;
+}
+pub fn fi_child_event(kind:u64,event_window:u64,child_window:u64)->u64 {
+    if(child_window!=0 and event_window==child_window){return 0;}
+    return kind;
+}
+test explicit_tools_do_not_replace_the_default_dashboard {
+    assert FI_MAIN_DASHBOARD==0 and FI_PERSONAL_ACCOUNT!=FI_COMMUNICATIONS;
+}
+test communication_button_is_separate_from_account_and_outside_clicks {
+    assert fi_comms_hit(30.0,520.0,0.0,0.0,300.0);
+    assert !fi_comms_hit(30.0,480.0,0.0,0.0,300.0);
+    assert !fi_comms_hit(301.0,520.0,0.0,0.0,300.0);
+}
+test native_child_events_are_not_dashboard_clicks {
+    assert fi_child_event(1,42,42)==0;
+    assert fi_child_event(1,43,42)==1;
+    assert fi_child_event(1,0,0)==1;
+}
+
+pub fn fi_account_navigation_click(x:f64,y:f64,width:f64,height:f64)->bool {
+    return x>4.0 and y>4.0 and x<width-4.0 and y<height-4.0;
+}
+test resizing_the_outer_window_does_not_leave_the_account_route {
+    assert !fi_account_navigation_click(1510.0,906.0,1512.0,908.0);
+    assert !fi_account_navigation_click(1080.0,740.0,1082.0,742.0);
+    assert fi_account_navigation_click(120.0,180.0,1512.0,908.0);
+}
diff --git a/specs/t27os/github_avatar.t27 b/specs/t27os/github_avatar.t27
